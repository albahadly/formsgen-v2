// Cloudflare Workers static-assets deployment for builder.albahadly.com.
// Workers Builds runs "bash build.sh" (writes apps/builder/dist/), then "npx wrangler deploy" uploads it.
{
  "name": "formsgen-builder",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./apps/builder/dist",
    "not_found_handling": "single-page-application"
  },
  // Binds the Worker to builder.albahadly.com and creates the DNS record
  // automatically on deploy (the zone lives in the same Cloudflare account).
  "routes": [
    {
      "pattern": "builder.albahadly.com",
      "custom_domain": true
    }
  ]
}
