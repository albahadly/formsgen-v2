            </div>
            <div className="mt-3 d-flex justify-content-between gap-2">
              {fgSec_ks_wizard > 0 && <button type="button" className="btn btn-outline-secondary" onClick={() => fgGo_ks_wizard(fgSec_ks_wizard - 1)}>Back</button>}
              {fgSec_ks_wizard < 1 && <button type="button" className="btn btn-primary" onClick={fgNext_ks_wizard}>Next</button>}
              {fgSec_ks_wizard === 1 && <button type="submit" className="btn btn-primary">Submit</button>}
