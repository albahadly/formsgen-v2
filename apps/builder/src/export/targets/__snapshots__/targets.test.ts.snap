          <label class="text-sm font-semibold" for="fg_days">Available days</label>
          <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
            <input id="fg_days" v-model="fgDateDrafts['days']" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" :class="{ 'border-red-500 focus:ring-red-200': !!errors['days'] }" @keydown.enter.prevent="fgAddDate('days')">
            <button type="button" class="shrink-0 whitespace-nowrap rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @click="fgAddDate('days')">Add date</button>
          </div>
          <div v-if="form.days.length" class="mt-2 flex flex-wrap gap-1.5">
            <span v-for="(date, index) in form.days" :key="date" class="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">{{ date }} <button type="button" class="text-gray-500 hover:text-red-600" :aria-label="'Remove ' + (date)" @click="fgRemoveDate('days', index)">×</button></span>
          </div>
          <p v-if="errors['days']" class="text-sm text-red-600" role="alert">{{ errors['days'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">How did we do?<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></legend>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead><tr><td></td><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Poor</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">OK</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Great</th></tr></thead>
              <tbody>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Speed</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="1" v-model="form.rating['speed']" aria-label="Speed: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="2" v-model="form.rating['speed']" aria-label="Speed: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="3" v-model="form.rating['speed']" aria-label="Speed: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Quality</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-0" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="1" v-model="form.rating['quality']" aria-label="Quality: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="2" v-model="form.rating['quality']" aria-label="Quality: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="3" v-model="form.rating['quality']" aria-label="Quality: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['rating']" class="text-sm text-red-600" role="alert">{{ errors['rating'] }}</p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">Where do you use each feature?</legend>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead><tr><td></td><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Web</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Mobile</th></tr></thead>
              <tbody>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Forms</th><td class="px-2 py-2 text-center leading-5"><input id="fg_usage" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="web" :checked="form.usage['forms'].includes('web')" aria-label="Forms: Web" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-0-1" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="mobile" :checked="form.usage['forms'].includes('mobile')" aria-label="Forms: Mobile" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Reports</th><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-1-0" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="web" :checked="form.usage['reports'].includes('web')" aria-label="Reports: Web" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-1-1" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="mobile" :checked="form.usage['reports'].includes('mobile')" aria-label="Reports: Mobile" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['usage']" class="text-sm text-red-600" role="alert">{{ errors['usage'] }}</p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50" data-fg-repeater="references">
          <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">References</legend>
          <div class="flex flex-col gap-4">
            <fieldset v-for="(item, i) in form.references" :key="fgKeyOf(item)" class="min-w-0 rounded-md border border-gray-300 p-4 dark:border-gray-600 data-[fg-drag]:opacity-50 data-[fg-drop=before]:shadow-[0_-3px_0_0_#4f46e5] data-[fg-drop=after]:shadow-[0_3px_0_0_#4f46e5]" data-fg-item tabindex="-1" :data-fg-drag="fgDragMark('references', i)" :data-fg-drop="fgDropMark('references', i)" @dragover="fgDragOver($event, 'references', i)" @drop="fgDropItem($event, 'references', i)">
              <legend class="px-1 text-sm font-semibold">{{ fgItemLabel('references', i) }}</legend>
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                    <label class="text-sm font-semibold" :for="'fg_references_' + i + '_name'">Name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                    <input :id="'fg_references_' + i + '_name'" v-model="item.name" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" :class="{ 'border-red-500 focus:ring-red-200': !!errors[('references.' + i + '.name')] }" @blur="touch(('references.' + i + '.name'))" @input="revalidate(('references.' + i + '.name'))">
                    <p v-if="errors[('references.' + i + '.name')]" class="text-sm text-red-600" role="alert">{{ errors[('references.' + i + '.name')] }}</p>
                  </div>
