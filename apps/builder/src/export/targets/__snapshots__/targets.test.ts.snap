                <textarea id="fg_account_bio" v-model="form.account.bio" class="form-control form-control-lg rounded" rows="4" :class="{ 'is-invalid': !!errors['account.bio'] }" @blur="touch('account.bio')" @input="revalidate('account.bio')"></textarea>
                <p v-if="errors['account.bio']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['account.bio'] }}</p>
