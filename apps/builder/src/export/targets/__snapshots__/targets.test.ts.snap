  .fg-repeater-remove { padding: 0; font: inherit; font-size: 0.875rem; color: var(--fg-color-error); background: none; border: none; text-decoration: underline; cursor: pointer; }
  .fg-repeater-add { margin-block-start: var(--fg-space); }
  /* File uploads */
  .fg-file-input { font: inherit; font-size: 0.875rem; }
  .fg-file-input::file-selector-button { margin-inline-end: 0.75rem; padding: 0.375rem 0.75rem; font: inherit; font-weight: 600; color: var(--fg-color-primary-contrast); background: var(--fg-color-primary); border: none; border-radius: var(--fg-radius); cursor: pointer; }
  .fg-file-input::file-selector-button:hover { opacity: 0.9; }
  .fg-file-list { display: flex; flex-direction: column; gap: 0.375rem; margin: 0; padding: 0; list-style: none; }
  .fg-file-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.5rem; font-size: 0.875rem; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-surface); }
  .fg-file-thumb { inline-size: 2.5rem; block-size: 2.5rem; object-fit: cover; border-radius: calc(var(--fg-radius) / 2); }
  .fg-file-name { flex: 1; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fg-file-size { color: var(--fg-color-muted); font-size: 0.8125rem; }
  .fg-file-remove { padding: 0 0.375rem; font-size: 1.125rem; line-height: 1; color: var(--fg-color-muted); background: none; border: none; cursor: pointer; }
  .fg-file-remove:hover { color: var(--fg-color-error); }
  @media (prefers-color-scheme: dark) {
    .fg-form:not([data-fg-theme='light']) {
      --fg-color-bg: #0f172a; --fg-color-surface: #1e293b; --fg-color-text: #e2e8f0;
      --fg-color-muted: #94a3b8; --fg-color-border: #334155;
      --fg-color-primary: #818cf8; --fg-color-primary-contrast: #0f172a; --fg-color-error: #f87171;
      --fg-color-error-contrast: #0f172a;
    }
  }
  </style>
</head>
<body>
  <form id="fg-form" class="fg-form" novalidate>
    <div class="fg-grid">
      <div class="fg-cell fg-align-center" style="grid-column: span 12 / span 12">
        <h2 class="fg-heading fg-tone-primary">Kitchen Sink</h2>
      </div>
      <div class="fg-cell fg-align-center" style="grid-column: span 12 / span 12">
        <p class="fg-paragraph">Every implemented element appears in this form.</p>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_full_name">Full name<span class="fg-required" aria-hidden="true">*</span></label>
          <input id="fg_full_name" type="text" class="fg-input" data-fg-path="full_name" data-fg-kind="text" placeholder="Jane Doe">
          <p id="fg_err_full_name" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_email">Email<span class="fg-required" aria-hidden="true">*</span></label>
          <input id="fg_email" type="email" class="fg-input" data-fg-path="email" data-fg-kind="text" placeholder="jane&#64;example.com">
          <p id="fg_err_email" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="fg-input fg-control--sm" data-fg-path="website" data-fg-kind="text">
          <p id="fg_err_website" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_seats">Seats</label>
          <input id="fg_seats" type="number" class="fg-input" data-fg-path="seats" data-fg-kind="number" min="1" max="50">
          <p id="fg_err_seats" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="fg-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_err_satisfaction" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <hr class="fg-divider fg-tone-primary">
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-grid">
          <div class="fg-cell" style="grid-column: span 6 / span 6">
            <div class="fg-field">
              <label class="fg-label" for="fg_city">City</label>
              <input id="fg_city" type="text" class="fg-input" data-fg-path="city" data-fg-kind="text">
              <p id="fg_err_city" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
          <div class="fg-cell" style="grid-column: span 6 / span 6">
            <div class="fg-field">
              <label class="fg-sr-only" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="fg-input" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_err_zip" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="fg-cell account-box" style="grid-column: span 12 / span 12">
        <fieldset class="fg-group">
          <legend class="fg-group-label">Account</legend>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_username">Username<span class="fg-required" aria-hidden="true">*</span></label>
                <input id="fg_account_username" type="text" class="fg-input" data-fg-path="account.username" data-fg-kind="text">
                <p id="fg_err_account_username" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="fg-input" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_err_account_password" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="fg-textarea fg-control--lg" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_err_account_bio" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="fg-input" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_err_account_birthday" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_avatar">Profile picture</label>
                <input id="fg_account_avatar" type="file" class="fg-file-input" accept="image/*" data-fg-path="account.avatar" data-fg-kind="files" data-fg-thumbs>
                <ul class="fg-file-list" data-fg-file-list="account.avatar" hidden></ul>
                <p id="fg_err_account_avatar" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Plan<span class="fg-required" aria-hidden="true">*</span></legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_plan_free">
              <input id="fg_plan_free" type="radio" name="plan" class="fg-checkbox" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="fg-option" for="fg_plan_pro">
              <input id="fg_plan_pro" type="radio" name="plan" class="fg-checkbox" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_err_plan" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Interests</legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_interests_news">
              <input id="fg_interests_news" type="checkbox" class="fg-checkbox" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="fg-option" for="fg_interests_product">
              <input id="fg_interests_product" type="checkbox" class="fg-checkbox" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_err_interests" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="fg-select" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_err_channels" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_topics">Topics</label>
          <div class="fg-tags" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="fg-tags-input" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="fg-description">Free-text tags</p>
          <p id="fg_err_topics" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Billing</legend>
          <div class="fg-options fg-options--buttons">
            <label class="fg-option fg-option--button" for="fg_billing_monthly">
              <input id="fg_billing_monthly" type="radio" name="billing" class="fg-sr-only" value="monthly" data-fg-path="billing" data-fg-kind="radio">
              <span>Monthly</span>
            </label>
            <label class="fg-option fg-option--button" for="fg_billing_yearly">
              <input id="fg_billing_yearly" type="radio" name="billing" class="fg-sr-only" value="yearly" data-fg-path="billing" data-fg-kind="radio">
              <span>Yearly</span>
            </label>
          </div>
          <p id="fg_err_billing" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Extras</legend>
          <div class="fg-options fg-options--blocks">
            <label class="fg-option fg-option--block" for="fg_extras_support">
              <input id="fg_extras_support" type="checkbox" class="fg-checkbox" value="support" data-fg-path="extras" data-fg-kind="checks">
              <span>Priority support</span>
            </label>
            <label class="fg-option fg-option--block" for="fg_extras_backup">
              <input id="fg_extras_backup" type="checkbox" class="fg-checkbox" value="backup" data-fg-path="extras" data-fg-kind="checks">
              <span>Daily backups</span>
            </label>
          </div>
          <p id="fg_err_extras" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_notify" type="checkbox" role="switch" class="fg-switch" data-fg-path="notify" data-fg-kind="checkbox" checked>
            <label class="fg-checkbox-label" for="fg_notify">Email notifications</label>
          </div>
          <p id="fg_err_notify" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_appointment">Appointment</label>
          <input id="fg_appointment" type="datetime-local" class="fg-input" data-fg-path="appointment" data-fg-kind="text">
          <p id="fg_err_appointment" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_brand_color">Brand color</label>
          <input id="fg_brand_color" type="color" class="fg-input fg-input--color" data-fg-path="brand_color" data-fg-kind="text">
          <p id="fg_err_brand_color" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_volume">Volume</label>
          <input id="fg_volume" type="range" class="fg-range" data-fg-path="volume" data-fg-kind="number" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" value="0">
          <p id="fg_err_volume" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <input id="fg_source" type="hidden" value="kitchen-sink" data-fg-path="source" data-fg-kind="text">
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-group" data-fg-repeater="references">
          <legend class="fg-group-label">References</legend>
          <div class="fg-repeater-items" data-fg-items="references"></div>
          <template data-fg-template="references">
            <fieldset class="fg-repeater-item" data-fg-item tabindex="-1">
              <legend class="fg-repeater-item-label" data-fg-item-label></legend>
              <div class="fg-grid">
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_references___i___name">Name<span class="fg-required" aria-hidden="true">*</span></label>
                    <input id="fg_references___i___name" type="text" class="fg-input" data-fg-path="references.__i__.name" data-fg-kind="text">
                    <p id="fg_err_references___i___name" class="fg-error" role="alert" hidden></p>
                  </div>
                </div>
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <div class="fg-checkbox-row">
                      <input id="fg_references___i___may_contact" type="checkbox" class="fg-checkbox" data-fg-path="references.__i__.may_contact" data-fg-kind="checkbox">
                      <label class="fg-checkbox-label" for="fg_references___i___may_contact">May we contact them?</label>
                    </div>
                    <p id="fg_err_references___i___may_contact" class="fg-error" role="alert" hidden></p>
                  </div>
                </div>
                <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-icond="0">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_references___i___email">Their email</label>
                    <input id="fg_references___i___email" type="email" class="fg-input" data-fg-path="references.__i__.email" data-fg-kind="text">
                    <p id="fg_err_references___i___email" class="fg-error" role="alert" hidden></p>
                  </div>
                </div>
              </div>
              <div class="fg-repeater-item-actions">
                <button type="button" class="fg-repeater-remove" data-fg-remove>Remove</button>
              </div>
            </fieldset>
          </template>
          <button type="button" class="fg-button fg-button--secondary fg-repeater-add" data-fg-add="references">Add reference</button>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_attachments">Attachments<span class="fg-required" aria-hidden="true">*</span></label>
          <input id="fg_attachments" type="file" class="fg-file-input" accept=".pdf,.doc,.docx" multiple data-fg-path="attachments" data-fg-kind="files">
          <ul class="fg-file-list" data-fg-file-list="attachments" hidden></ul>
          <p class="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
          <p id="fg_err_attachments" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-cond="0">
        <div class="fg-field">
          <label class="fg-label" for="fg_attachments_note">Notes about the attachments</label>
          <textarea id="fg_attachments_note" class="fg-textarea" rows="3" data-fg-path="attachments_note" data-fg-kind="text"></textarea>
          <p id="fg_err_attachments_note" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <figure class="fg-quote">
          <blockquote class="fg-quote-text">
            <p>Forms are conversations.</p>
          </blockquote>
          <figcaption class="fg-quote-cite">FormsGen</figcaption>
        </figure>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <a class="fg-link" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="fg-sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_method">Preferred contact method<span class="fg-required" aria-hidden="true">*</span></label>
          <select id="fg_contact_method" class="fg-select" data-fg-path="contact_method" data-fg-kind="select">
            <option value="" disabled selected>—</option>
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="other">Other</option>
          </select>
          <p id="fg_err_contact_method" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-cond="1">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_phone">Phone number</label>
          <input id="fg_contact_phone" type="tel" class="fg-input" data-fg-path="contact_phone" data-fg-kind="text">
          <p id="fg_err_contact_phone" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-cond="2">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_other">Describe your preferred method</label>
          <textarea id="fg_contact_other" class="fg-textarea" rows="3" data-fg-path="contact_other" data-fg-kind="text"></textarea>
          <p id="fg_err_contact_other" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div>
          <div class="fg-tab-list" role="tablist">
            <button type="button" class="fg-tab-button fg-tab-button--active" data-fg-sec-btn="ks_social_tabs:0">Social</button>
            <button type="button" class="fg-tab-button" data-fg-sec-btn="ks_social_tabs:1">Code</button>
          </div>
          <div data-fg-sec-panel="ks_social_tabs:0">
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_twitter">Twitter handle</label>
                <input id="fg_twitter" type="text" class="fg-input" data-fg-path="twitter" data-fg-kind="text">
                <p id="fg_err_twitter" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_social_tabs:1" hidden>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_github">GitHub username</label>
                <input id="fg_github" type="text" class="fg-input" data-fg-path="github" data-fg-kind="text">
                <p id="fg_err_github" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div>
          <ol class="fg-step-list">
            <li class="fg-step-item fg-step-item--active" data-fg-sec-item="ks_wizard:0">1. Shipping</li>
            <li class="fg-step-item" data-fg-sec-item="ks_wizard:1">2. Review</li>
          </ol>
          <div data-fg-sec-panel="ks_wizard:0">
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_shipping_city">Shipping city<span class="fg-required" aria-hidden="true">*</span></label>
                <input id="fg_shipping_city" type="text" class="fg-input" data-fg-path="shipping_city" data-fg-kind="text">
                <p id="fg_err_shipping_city" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_wizard:1" hidden>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_order_notes">Order notes</label>
                <textarea id="fg_order_notes" class="fg-textarea" rows="3" data-fg-path="order_notes" data-fg-kind="text"></textarea>
                <p id="fg_err_order_notes" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div class="fg-step-actions">
            <button type="button" class="fg-button fg-button--secondary" data-fg-step-back="ks_wizard" hidden>Back</button>
            <button type="button" class="fg-button fg-button--primary" data-fg-step-next="ks_wizard">Next</button>
            <button type="submit" class="fg-button fg-button--primary" data-fg-submit hidden>Submit</button>
          </div>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_newsletter" type="checkbox" class="fg-checkbox" data-fg-path="newsletter" data-fg-kind="checkbox" checked>
            <label class="fg-checkbox-label" for="fg_newsletter">Subscribe to the newsletter</label>
          </div>
          <p id="fg_err_newsletter" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_terms" type="checkbox" class="fg-checkbox" data-fg-path="terms" data-fg-kind="checkbox">
            <label class="fg-checkbox-label" for="fg_terms">I accept the terms<span class="fg-required" aria-hidden="true">*</span></label>
          </div>
          <p id="fg_err_terms" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <button type="button" class="fg-button fg-button--secondary" data-fg-reset>Start over</button>
      </div>
    </div>
    <div id="fg-live" class="fg-sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <pre id="fg-result" class="fg-payload" hidden></pre>
  </form>
  <script>
  (function () {
    'use strict'
    function fgIsEmpty(v) {
      if (v === null || v === undefined) return true
      if (typeof v === 'string') return v.trim() === ''
      if (Array.isArray(v)) return v.length === 0
      return false
    }
    // Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
    // never compare a string field with false).
    function fgIsBlank(v) {
