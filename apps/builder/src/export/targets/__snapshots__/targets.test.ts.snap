// Prefill from the page address: a list takes repeated parameters or one
// comma-separated value; a value that does not convert is undefined.
function fgQueryString(q: URLSearchParams, name: string): string | undefined {
  const v = q.get(name)
  return v === null ? undefined : v
}
function fgQueryNumber(q: URLSearchParams, name: string): number | undefined {
  const v = q.get(name)
  if (v === null || v.trim() === '') return undefined
  const n = Number(v)
  return Number.isFinite(n) ? n : undefined
}
function fgQueryBool(q: URLSearchParams, name: string): boolean | undefined {
  const w = (q.get(name) ?? '').trim().toLowerCase()
  return ['1', 'true', 'on', 'yes'].includes(w) ? true : ['0', 'false', 'off', 'no'].includes(w) ? false : undefined
}
function fgQueryList(q: URLSearchParams, name: string): string[] | undefined {
  if (!q.has(name)) return undefined
  const all = q.getAll(name)
  const parts = all.length === 1 ? (all[0] ?? '').split(',') : all
  return parts.map((p) => p.trim()).filter((p) => p !== '')
}
// The state with what the page address says; null when it says nothing.
function fgPrefill(current: FormData): FormData | null {
  if (typeof window === 'undefined') return null
  const q = new URLSearchParams(window.location.search)
  const next = structuredClone(current)
  let changed = false
  { const v = fgQueryString(q, "full_name"); if (v !== undefined) { next.full_name = v; changed = true } }
  { const v = fgQueryString(q, "email"); if (v !== undefined) { next.email = v; changed = true } }
  { const v = fgQueryString(q, "website"); if (v !== undefined) { next.website = v; changed = true } }
  { const v = fgQueryNumber(q, "seats"); if (v !== undefined) { next.seats = v; changed = true } }
  { const v = fgQueryNumber(q, "satisfaction"); if (v !== undefined) { next.satisfaction = v; changed = true } }
  { const v = fgQueryString(q, "city"); if (v !== undefined) { next.city = v; changed = true } }
  { const v = fgQueryString(q, "zip"); if (v !== undefined) { next.zip = v; changed = true } }
  { const v = fgQueryString(q, "account.username"); if (v !== undefined) { next.account.username = v; changed = true } }
  { const v = fgQueryString(q, "account.bio"); if (v !== undefined) { next.account.bio = v; changed = true } }
  { const v = fgQueryString(q, "account.birthday"); if (v !== undefined) { next.account.birthday = v; changed = true } }
  { const v = fgQueryString(q, "plan"); if (v !== undefined) { next.plan = v; changed = true } }
  { const v = fgQueryList(q, "interests"); if (v !== undefined) { next.interests = v; changed = true } }
  { const v = fgQueryList(q, "channels"); if (v !== undefined) { next.channels = v; changed = true } }
  { const v = fgQueryList(q, "topics"); if (v !== undefined) { next.topics = v; changed = true } }
  { const v = fgQueryString(q, "billing"); if (v !== undefined) { next.billing = v; changed = true } }
  { const v = fgQueryList(q, "extras"); if (v !== undefined) { next.extras = v; changed = true } }
  { const v = fgQueryBool(q, "notify"); if (v !== undefined) { next.notify = v; changed = true } }
  { const v = fgQueryString(q, "appointment"); if (v !== undefined) { next.appointment = v; changed = true } }
  { const v = fgQueryString(q, "brand_color"); if (v !== undefined) { next.brand_color = v; changed = true } }
  { const v = fgQueryNumber(q, "volume"); if (v !== undefined) { next.volume = v; changed = true } }
  { const v = fgQueryList(q, "days"); if (v !== undefined) { next.days = v; changed = true } }
  { const v = fgQueryString(q, "utm_source"); if (v !== undefined) { next.source = v; changed = true } }
  { const v = fgQueryString(q, "attachments_note"); if (v !== undefined) { next.attachments_note = v; changed = true } }
  { const v = fgQueryString(q, "contact_method"); if (v !== undefined) { next.contact_method = v; changed = true } }
  { const v = fgQueryString(q, "contact_phone"); if (v !== undefined) { next.contact_phone = v; changed = true } }
  { const v = fgQueryString(q, "contact_other"); if (v !== undefined) { next.contact_other = v; changed = true } }
  { const v = fgQueryString(q, "twitter"); if (v !== undefined) { next.twitter = v; changed = true } }
  { const v = fgQueryString(q, "github"); if (v !== undefined) { next.github = v; changed = true } }
  { const v = fgQueryString(q, "shipping_city"); if (v !== undefined) { next.shipping_city = v; changed = true } }
  { const v = fgQueryString(q, "order_notes"); if (v !== undefined) { next.order_notes = v; changed = true } }
  { const v = fgQueryBool(q, "newsletter"); if (v !== undefined) { next.newsletter = v; changed = true } }
  { const v = fgQueryBool(q, "terms"); if (v !== undefined) { next.terms = v; changed = true } }
  return changed ? next : null
}

function fgVisible_attachments_note(data: FormData) {
  return ((!fgIsBlank(data.attachments)))
}
function fgVisible_contact_phone(data: FormData) {
  return ((data.contact_method === "phone"))
}
function fgVisible_contact_other(data: FormData) {
  return ((data.contact_method === "other"))
}

const validators: Record<string, (data: FormData) => string | null> = {
  'full_name': function (data: FormData) {
  const v = data.full_name
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function (data: FormData) {
  const v = data.email
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function (data: FormData) {
  const v = data.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function (data: FormData) {
  const v = data.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'account.avatar': function (data: FormData) {
  const v = data.account.avatar
  { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
  return null
  },
  'plan': function (data: FormData) {
  const v = data.plan
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'topics': function (data: FormData) {
  const v = data.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'stay': function (data: FormData) {
  const v = data.stay
  if (fgIsBlank(v)) return "This field is required"
  { const problem = (fgDateOrder(v) ? "The end date can’t be before the start date" : null); if (problem) return problem }
  return null
  },
  'days': function (data: FormData) {
  const v = data.days
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 3)) return "Must be at most 3"
  return null
  },
  'rating': function (data: FormData) {
  const v = data.rating
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'attachments': function (data: FormData) {
  const v = data.attachments
  if (fgIsBlank(v)) return "This field is required"
  { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
  return null
  },
  'signature': function (data: FormData) {
  const v = data.signature
  { const problem = fgFileProblem(v, "", 0, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 0 MB"}); if (problem) return problem }
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'shipping_city': function (data: FormData) {
  const v = data.shipping_city
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "website": data.website,
    "seats": data.seats,
    "seat_cost": data.seat_cost,
    "satisfaction": data.satisfaction,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "password": data.account.password,
      "bio": data.account.bio,
      "birthday": data.account.birthday,
      "avatar": data.account.avatar,
    },
    "plan": data.plan,
    "interests": data.interests,
    "channels": data.channels,
    "topics": data.topics,
    "billing": data.billing,
    "extras": data.extras,
    "notify": data.notify,
    "appointment": data.appointment,
    "brand_color": data.brand_color,
    "volume": data.volume,
    "budget": data.budget,
    "stay": data.stay,
    "days": data.days,
    "rating": data.rating,
    "usage": data.usage,
    "source": data.source,
    "references": data.references.map((item) => ({ "name": item.name, "may_contact": item.may_contact, ...((item.may_contact === true) ? { "email": item.email } : {}), ...((item.may_contact === true) ? { "phone": item.phone } : {}) })),
    "attachments": data.attachments,
    ...(fgVisible_attachments_note(data) ? { "attachments_note": data.attachments_note } : {}),
    "about": data.about,
    "meet": data.meet,
    "signature": data.signature,
    "contact_method": data.contact_method,
    ...(fgVisible_contact_phone(data) ? { "contact_phone": data.contact_phone } : {}),
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "twitter": data.twitter,
    "github": data.github,
    "shipping_city": data.shipping_city,
    "order_notes": data.order_notes,
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

function fgMovedIndex(n: number, from: number, to: number): number {
  if (n === from) return to
  if (from < to) return n > from && n <= to ? n - 1 : n
  return n >= to && n < from ? n + 1 : n
}

const FG_ITEM_DEFAULTS: Record<string, () => Record<string, unknown>> = {
  'references': () => ({
    name: "",
    may_contact: false,
    email: "",
    phone: ""
  }),
}

const FG_ITEM_LIMITS: Record<string, { min: number; max: number }> = {
  'references': { min: 0, max: 3 },
}

const FG_ITEM_LABELS: Record<string, string> = {
  'references': "Reference {n}",
}

/** Is a repeater (concrete path) shown? An inner one also asks its outer item. */
const FG_REPEATER_VISIBLE: Record<string, (data: FormData, path: string) => boolean> = {
  'references': (_data: FormData) => true,
}

/** Names of each repeater's inner repeaters (one level). */
const FG_INNER_REPEATERS: Record<string, string[]> = {"references":[]}

/** The outer item an inner list (\`travellers.2.bags\`) belongs to. */

const itemValidators: Record<string, Record<string, (item: Record<string, unknown>, data: FormData) => string | null>> = {
  'references': {
    'name': function (item: Record<string, unknown>, _data: FormData) {
      const v = item["name"]
      if (fgIsBlank(v)) return "This field is required"
      return null
    },
    'email': function (item: Record<string, unknown>, _data: FormData) {
      if (!((item["may_contact"] === true))) return null
      const v = item["email"]
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
    },
  },
}

function fgList(data: FormData, path: string): Record<string, unknown>[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as Record<string, unknown>[]
}

function fgItemLabel(path: string, index: number): string {
  return (FG_ITEM_LABELS[fgTpl(path)] ?? '').split('{n}').join(String(index + 1))
}

function fgRemoveLabel(path: string, index: number): string {
  return "Remove {label}".split('{label}').join(fgItemLabel(path, index))
}

/** Every item field path of a visible repeater, inner items included (validation, step gates). */
function fgItemPaths(data: FormData, path: string): string[] {
  const template = fgTpl(path)
  if (!FG_REPEATER_VISIBLE[template]?.(data, path)) return []
  const fields = Object.keys(itemValidators[template] ?? {})
  return fgList(data, path).flatMap((_, i) => [
    ...fields.map((field) => \`\${path}.\${i}.\${field}\`),
    ...(FG_INNER_REPEATERS[template] ?? []).flatMap((name) => fgItemPaths(data, \`\${path}.\${i}.\${name}\`)),
  ])
}

/** Validator for a field path, including item paths like "people.2.name". */
function fgValidatorFor(path: string): ((data: FormData) => string | null) | undefined {
  const direct = validators[path]
  if (direct) return direct
  const match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
  if (!match) return undefined
  const validate = itemValidators[fgTpl(match[1]!)]?.[match[3]!]
  if (!validate) return undefined
  return (data) => {
    const item = fgList(data, match[1]!)[Number(match[2])]
    return item ? validate(item, data) : null
  }
}

/** All field paths to validate on submit (items included). */
function fgAllPaths(data: FormData): string[] {
  return [...Object.keys(validators), ...["references"].flatMap((path) => fgItemPaths(data, path))]
}

/**
 * Re-keys an item path when items move or go: \`to\` maps an old index to
 * its new one (null = gone), e.g. "people.3.x" → "people.2.x".
 */
function fgRemapKey(key: string, path: string, to: (index: number) => number | null): string | null {
  if (!key.startsWith(path + '.')) return key
  const rest = key.slice(path.length + 1)
  const dot = rest.indexOf('.')
  const index = Number(dot === -1 ? rest : rest.slice(0, dot))
  if (!Number.isInteger(index)) return key
  const next = to(index)
  return next === null ? null : \`\${path}.\${next}\${dot === -1 ? '' : rest.slice(dot)}\`
}

/** A per-path store (errors, drafts…) with its item keys re-keyed. */
function fgRemapStore<T>(store: Record<string, T>, path: string, to: (index: number) => number | null): Record<string, T> {
  const next: Record<string, T> = {}
  for (const [key, value] of Object.entries(store)) {
    const target = fgRemapKey(key, path, to)
    if (target !== null) next[target] = value
  }
  return next
}

type FgRangeValue = { from: number; to: number }
function fgDualClamp(v: FgRangeValue, side: 'from' | 'to', n: number): FgRangeValue {
  return side === 'from' ? { from: Math.min(n, v.to), to: v.to } : { from: v.from, to: Math.max(n, v.from) }
}
function fgDualFill(v: FgRangeValue, min: number, max: number): { insetInlineStart: string; insetInlineEnd: string } {
  const pct = (n: number): number => (max > min ? ((n - min) / (max - min)) * 100 : 0)
  return { insetInlineStart: pct(v.from) + '%', insetInlineEnd: 100 - pct(v.to) + '%' }
}
// With both handles together, the one that can still move is on top.
function fgDualFromOnTop(v: FgRangeValue, min: number, max: number): boolean {
  return v.from === v.to && v.from > (min + max) / 2
}
function fgWithDate(list: string[], date: string): string[] {
  return /^\\d{4}-\\d{2}-\\d{2}$/.test(date) && !list.includes(date) ? [...list, date].sort() : list
}
const FG_DIAL: Record<string, string> = {"AD":"376","AE":"971","AF":"93","AG":"1","AI":"1","AL":"355","AM":"374","AO":"244","AR":"54","AS":"1","AT":"43","AU":"61","AW":"297","AX":"358","AZ":"994","BA":"387","BB":"1","BD":"880","BE":"32","BF":"226","BG":"359","BH":"973","BI":"257","BJ":"229","BL":"590","BM":"1","BN":"673","BO":"591","BQ":"599","BR":"55","BS":"1","BT":"975","BW":"267","BY":"375","BZ":"501","CA":"1","CC":"61","CD":"243","CF":"236","CG":"242","CH":"41","CI":"225","CK":"682","CL":"56","CM":"237","CN":"86","CO":"57","CR":"506","CU":"53","CV":"238","CW":"599","CX":"61","CY":"357","CZ":"420","DE":"49","DJ":"253","DK":"45","DM":"1","DO":"1","DZ":"213","EC":"593","EE":"372","EG":"20","EH":"212","ER":"291","ES":"34","ET":"251","FI":"358","FJ":"679","FK":"500","FM":"691","FO":"298","FR":"33","GA":"241","GB":"44","GD":"1","GE":"995","GF":"594","GG":"44","GH":"233","GI":"350","GL":"299","GM":"220","GN":"224","GP":"590","GQ":"240","GR":"30","GT":"502","GU":"1","GW":"245","GY":"592","HK":"852","HN":"504","HR":"385","HT":"509","HU":"36","ID":"62","IE":"353","IL":"972","IM":"44","IN":"91","IO":"246","IQ":"964","IR":"98","IS":"354","IT":"39","JE":"44","JM":"1","JO":"962","JP":"81","KE":"254","KG":"996","KH":"855","KI":"686","KM":"269","KN":"1","KP":"850","KR":"82","KW":"965","KY":"1","KZ":"7","LA":"856","LB":"961","LC":"1","LI":"423","LK":"94","LR":"231","LS":"266","LT":"370","LU":"352","LV":"371","LY":"218","MA":"212","MC":"377","MD":"373","ME":"382","MF":"590","MG":"261","MH":"692","MK":"389","ML":"223","MM":"95","MN":"976","MO":"853","MP":"1","MQ":"596","MR":"222","MS":"1","MT":"356","MU":"230","MV":"960","MW":"265","MX":"52","MY":"60","MZ":"258","NA":"264","NC":"687","NE":"227","NF":"672","NG":"234","NI":"505","NL":"31","NO":"47","NP":"977","NR":"674","NU":"683","NZ":"64","OM":"968","PA":"507","PE":"51","PF":"689","PG":"675","PH":"63","PK":"92","PL":"48","PM":"508","PR":"1","PS":"970","PT":"351","PW":"680","PY":"595","QA":"974","RE":"262","RO":"40","RS":"381","RU":"7","RW":"250","SA":"966","SB":"677","SC":"248","SD":"249","SE":"46","SG":"65","SH":"290","SI":"386","SJ":"47","SK":"421","SL":"232","SM":"378","SN":"221","SO":"252","SR":"597","SS":"211","ST":"239","SV":"503","SX":"1","SY":"963","SZ":"268","TC":"1","TD":"235","TG":"228","TH":"66","TJ":"992","TK":"690","TL":"670","TM":"993","TN":"216","TO":"676","TR":"90","TT":"1","TV":"688","TW":"886","TZ":"255","UA":"380","UG":"256","US":"1","UY":"598","UZ":"998","VA":"39","VC":"1","VE":"58","VG":"1","VI":"1","VN":"84","VU":"678","WF":"681","WS":"685","XK":"383","YE":"967","YT":"262","ZA":"27","ZM":"260","ZW":"263"}
// The number part of "+<code> <number>" for the selected country.
function fgPhoneNumber(value: string, country: string): string {
  var prefix = '+' + FG_DIAL[country] + ' '
  return value.indexOf(prefix) === 0 ? value.slice(prefix.length) : value
}
function fgComposePhone(country: string, number: string): string {
  return number.trim() === '' ? '' : '+' + FG_DIAL[country] + ' ' + number
}
// The country whose code starts the value ("+44 …"; the field's own first), as
// for restored answers; the fallback when none does.
function fgPhoneFrom(value: unknown, fallback: string): string {
  if (typeof value !== 'string' || value.indexOf('+' + FG_DIAL[fallback] + ' ') === 0) return fallback
  for (var code in FG_DIAL) if (value.indexOf('+' + FG_DIAL[code] + ' ') === 0) return code
  return fallback
}
// Starting country per field (template path).
const FG_PHONE_DEFAULTS: Record<string, string> = {"contact_phone":"OM","references.phone":"GB"}

function fgTpl(path: string): string {
  return path.replace(/\\.\\d+(?=\\.|$)/g, '')
}

const fgThumbs = new WeakMap<File, string>()
function fgThumb(file: File): string {
  let url = fgThumbs.get(file)
  if (!url) {
    url = URL.createObjectURL(file)
    fgThumbs.set(file, url)
  }
  return url
}
function fgReleaseThumb(file: File): void {
  const url = fgThumbs.get(file)
  if (url) URL.revokeObjectURL(url)
  fgThumbs.delete(file)
}
function fgFileSize(bytes: number): string {
  return bytes >= 1024 * 1024 ? (bytes / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'
}
function fgRemoveFileLabel(name: string): string {
  return "Remove {name}".split('{name}').join(name)
}
// Marks the drop zone (the input's parent) while files are dragged over it.
function fgDrag(input: EventTarget | null, on: boolean): void {
  ;(input as HTMLElement | null)?.parentElement?.toggleAttribute('data-fg-dragging', on)
}
function fgDropFirst(input: HTMLInputElement, event: { dataTransfer: DataTransfer | null; preventDefault(): void }): string {
  var dropped = event.dataTransfer ? event.dataTransfer.files : null
  if (input.multiple || !dropped || dropped.length < 2) return ''
  event.preventDefault()
  var first = dropped[0]!
  var keep = new DataTransfer()
  keep.items.add(first)
  input.files = keep.files
  input.dispatchEvent(new Event('change', { bubbles: true }))
  return "Only one file fits here, so {name} was added.".split('{name}').join(first.name)
}

const FG_FILE_MULTIPLE: Record<string, boolean> = { 'account.avatar': false, 'attachments': true }

function fgFileList(data: FormData, path: string): File[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as File[]
}

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]

function fgErrorsText(count: number): string {
  const forms: Record<string, string> & { other: string } = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(() => fgCalc(INITIAL))
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgAnnouncement, setFgAnnouncement] = useState('')
  // Prefill from the page address, once mounted (no server/client mismatch).
  useEffect(() => {
    setForm((current) => {
      const next = fgPrefill(current)
      return next ? fgCalc(next) : current
    })
  }, [])
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)
  const [tagDrafts, setTagDrafts] = useState<Record<string, string>>({})
  const [dateDrafts, setDateDrafts] = useState<Record<string, string>>({})
  // The chosen country per field path (else the field's default).
  const [phoneCountry, setPhoneCountry] = useState<Record<string, string>>({})
  const fgRoot = useRef<HTMLFormElement>(null)
  // Stable React keys per item (the form object is cloned on every edit).
  const fgKeys = useRef<Record<string, number[]>>({})
  const fgNextKey = useRef(0)
  const fgPendingFocus = useRef<{ path: string; index: number; move?: 'up' | 'down' | 'item' } | null>(null)

  // Polite aria-live region; cleared first so repeated text re-announces.
  function fgAnnounce(message: string): void {
    setFgAnnouncement('')
    setTimeout(() => setFgAnnouncement(message), 50)
  }

  function fgGo_ks_wizard(index: number): void {
    setFgSec_ks_wizard(index)
    fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
  }

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = fgValidatorFor(path)
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) fgGo_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = fgValidatorFor(path)
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = fgCalc(next as unknown as FormData)
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
    // Calculated fields: after a submit attempt their errors follow new values.
    for (const p of fgCalcPaths(typed)) if (p !== path && touched.current.has(p)) validateField(p, typed)
  }

  // A blur error appearing while a pointer is held reflows the form and the
  // release misses its target; defer blur validation until the press ends.
  // Deferred work reads the latest state through refs, not this closure.
  const formRef = useRef(form)
  formRef.current = form
  const fgPressing = useRef(false)
  const fgDeferred = useRef(new Set<string>())
  const fgFlush = useRef(() => {})
  fgFlush.current = () => {
    const paths = [...fgDeferred.current]
    fgDeferred.current.clear()
    for (const path of paths) {
      touched.current.add(path)
      validateField(path, formRef.current)
    }
  }
  useEffect(() => {
    function end(): void {
      if (!fgPressing.current) return
      fgPressing.current = false
      setTimeout(() => fgFlush.current(), 0)
    }
    window.addEventListener('pointerup', end)
    window.addEventListener('pointercancel', end)
    return () => {
      window.removeEventListener('pointerup', end)
      window.removeEventListener('pointercancel', end)
    }
  }, [])

  function touch(path: string): void {
    if (fgPressing.current) {
      fgDeferred.current.add(path)
      return
    }
    touched.current.add(path)
    validateField(path, form)
  }

  function fgAddTag(path: string, current: string[]): void {
    const draft = (tagDrafts[path] ?? '').trim()
    if (draft !== '' && !current.includes(draft)) setField(path, [...current, draft])
    setTagDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveTag(path: string, current: string[], index: number): void {
    setField(path, current.filter((_, i) => i !== index))
  }

  // Signature pads: wired once on the form; changes go through the latest handler.
  const fgSignChange = useRef<(path: string, file: File | null) => void>(() => {})
  fgSignChange.current = (path, file) => {
    touched.current.add(path)
    setField(path, file ? [file] : [])
  }
  useEffect(() => {
    fgWireSignatures(fgRoot.current, (canvas, file) => fgSignChange.current(canvas.getAttribute('data-fg-signature')!, file))
  }, [])
  // The pads follow the value: a reset clears them, a pad shown again draws its file.
  useEffect(() => {
    fgSignSync(fgRoot.current, (canvas) => (fgFileList(form, canvas.getAttribute('data-fg-signature')!) ?? [])[0] ?? null)
  })

  // Rich-text editors: wired once on the form; changes go through the latest handler.
  const fgRichChange = useRef<(path: string, html: string) => void>(() => {})
  fgRichChange.current = (path, html) => setField(path, html)
  useEffect(() => {
    fgWireRichText(fgRoot.current, (editor, html) => fgRichChange.current(editor.getAttribute('data-fg-richtext')!, html))
  }, [])
  // Values set elsewhere (a reset, saved answers) show in the editors.
  useEffect(() => {
    fgRichSync(fgRoot.current, (editor) =>
      editor.getAttribute('data-fg-richtext')!.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form),
    )
  })

  // Location fields: wired once on the form; changes go through the latest handler.
  const fgLocChange = useRef<(path: string, point: { lat: number; lng: number } | null, touch: boolean) => void>(() => {})
  fgLocChange.current = (path, point, touch) => {
    if (touch) touched.current.add(path)
    setField(path, point)
  }
  useEffect(() => {
    fgWireLocations(fgRoot.current, (group, point, touch) => fgLocChange.current(group.getAttribute('data-fg-loc')!, point, touch))
  }, [])
  // Values set elsewhere (a reset, saved answers) show in the boxes and on the map.
  useEffect(() => {
    fgLocSync(fgRoot.current, (group) =>
      group.getAttribute('data-fg-loc')!.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form),
    )
  })

  // Spam check: the submit button waits for a passed check.
  const fgCaptchaEl = useRef<HTMLDivElement>(null)
  const [fgCaptchaToken, setFgCaptchaToken] = useState('')
  const [fgCaptchaFailed, setFgCaptchaFailed] = useState(false)
  useEffect(() => {
    fgCaptcha(fgCaptchaEl.current, "1x00000000000000000000AA", "en", (token, failed) => {
      setFgCaptchaToken(token)
      setFgCaptchaFailed(failed)
    })
  }, [])

  function fgDualChange(path: string, current: FgRangeValue, side: 'from' | 'to', n: number): void {
    touched.current.add(path)
    setField(path, fgDualClamp(current, side, n))
  }

  function fgAddDate(path: string, current: string[]): void {
    touched.current.add(path)
    setField(path, fgWithDate(current, dateDrafts[path] ?? ''))
    setDateDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveDate(path: string, current: string[], index: number): void {
    touched.current.add(path)
    setField(path, current.filter((_, i) => i !== index))
  }

  function fgPhoneCountryOf(path: string): string {
    const value = path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form)
    return phoneCountry[path] ?? fgPhoneFrom(value, FG_PHONE_DEFAULTS[fgTpl(path)]!)
  }

  function fgPhoneSetCountry(path: string, current: string, next: string): void {
    const typed = fgPhoneNumber(current, fgPhoneCountryOf(path))
    setPhoneCountry((c) => ({ ...c, [path]: next }))
    setField(path, fgComposePhone(next, typed))
  }

  function fgPhoneInput(path: string, number: string): void {
    setField(path, fgComposePhone(fgPhoneCountryOf(path), number))
  }

  // "Only one file fits here, …" per field path, until its next change.
  const [fgFileNotes, setFgFileNotes] = useState<Record<string, string>>({})
  function fgFileNote(path: string, note: string): void {
    setFgFileNotes((notes) => {
      const next = { ...notes }
      if (note) next[path] = note
      else delete next[path]
      return next
    })
  }

  function fgDropFiles(path: string, event: React.DragEvent<HTMLInputElement>): void {
    fgDrag(event.currentTarget, false)
    const note = fgDropFirst(event.currentTarget, event)
    if (!note) return
    fgFileNote(path, note)
    fgAnnounce(note)
  }

  function fgPickFiles(path: string, input: HTMLInputElement): void {
    const picked = Array.from(input.files ?? [])
    input.value = ''
    if (picked.length === 0) return
    fgFileNote(path, '')
    touched.current.add(path)
    setField(path, FG_FILE_MULTIPLE[fgTpl(path)] ? [...fgFileList(form, path), ...picked] : picked.slice(0, 1))
  }

  function fgRemoveFile(path: string, index: number): void {
    const list = fgFileList(form, path)
    const file = list[index]
    if (file) fgReleaseThumb(file)
    fgFileNote(path, '')
    touched.current.add(path)
    setField(path, list.filter((_, i) => i !== index))
  }

  function fgKeyAt(path: string, index: number): number {
    const keys = (fgKeys.current[path] ??= [])
    while (keys.length <= index) keys.push(fgNextKey.current++)
    return keys[index]!
  }

  /** Re-keys per-item state (touched, errors, drafts, countries). */
  function fgRemapItems(path: string, to: (index: number) => number | null): void {
    touched.current = new Set([...touched.current].map((k) => fgRemapKey(k, path, to)).filter((k): k is string => k !== null))
    setErrors((prev) => fgRemapStore(prev, path, to))
    setTagDrafts((prev) => fgRemapStore(prev, path, to))
    setDateDrafts((prev) => fgRemapStore(prev, path, to))
    setPhoneCountry((prev) => fgRemapStore(prev, path, to))
  }

  function fgAddItem(path: string): void {
    const list = fgList(form, path)
    if (list.length >= (FG_ITEM_LIMITS[fgTpl(path)]?.max ?? Number.POSITIVE_INFINITY)) return
    setField(path, [...list, FG_ITEM_DEFAULTS[fgTpl(path)]!()])
    fgPendingFocus.current = { path, index: list.length }
    fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length)))
  }

  function fgMoveLabel(path: string, index: number, direction: 'up' | 'down'): string {
    return (direction === 'up' ? "Move {label} up" : "Move {label} down").split('{label}').join(fgItemLabel(path, index))
  }

  /** Swaps an item with its neighbour; focus stays on the moved item. */
  function fgMoveItem(path: string, index: number, delta: -1 | 1): void {
    const list = fgList(form, path)
    const target = index + delta
    if (target < 0 || target >= list.length) return
    const label = fgItemLabel(path, index)
    fgKeyAt(path, list.length - 1)
    const keys = fgKeys.current[path]!
    ;[keys[index], keys[target]] = [keys[target]!, keys[index]!]
    fgRemapItems(path, (i) => (i === index ? target : i === target ? index : i))
    const next = [...list]
    ;[next[index], next[target]] = [next[target]!, next[index]!]
    setField(path, next)
    fgPendingFocus.current = { path, index: target, move: delta < 0 ? 'up' : 'down' }
    fgAnnounce("{label} moved to position {n}".split('{label}').join(label).split('{n}').join(String(target + 1)))
  }

  // Dragging items by their handle: the list being dragged in, the item and the one under it.
  const [fgItemDrag, setFgItemDrag] = useState<{ path: string; from: number; at: number }>({ path: '', from: -1, at: -1 })

  function fgItemElements(path: string): HTMLElement[] {
    const repeater = fgRoot.current?.querySelector(\`[data-fg-repeater="\${path}"]\`)
    return Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
  }

  function fgDragStart(event: React.DragEvent, path: string, index: number): void {
    setFgItemDrag({ path, from: index, at: -1 })
    if (!event.dataTransfer) return
  event.dataTransfer.effectAllowed = 'move'
  event.dataTransfer.setData('text/plain', fgItemLabel(path, index))
  const item = fgItemElements(path)[index]
  if (item) event.dataTransfer.setDragImage(item, 16, 16)
  }

  function fgDragEnd(): void {
    setFgItemDrag({ path: '', from: -1, at: -1 })
  }

  function fgDragOver(event: React.DragEvent, path: string, index: number): void {
    if (fgItemDrag.path !== path) return
    event.preventDefault()
    event.stopPropagation()
    event.dataTransfer.dropEffect = 'move'
    if (fgItemDrag.at !== index) setFgItemDrag({ ...fgItemDrag, at: index })
  }

  function fgDropItem(event: React.DragEvent, path: string, index: number): void {
    if (fgItemDrag.path !== path) return
    event.preventDefault()
    event.stopPropagation()
    const from = fgItemDrag.from
    fgDragEnd()
    fgMoveItemTo(path, from, index)
  }

  function fgDragMark(path: string, index: number): '' | undefined {
    return fgItemDrag.path === path && fgItemDrag.from === index ? '' : undefined
  }

  function fgDropMark(path: string, index: number): 'before' | 'after' | undefined {
    if (fgItemDrag.path !== path || fgItemDrag.at !== index || fgItemDrag.from === index) return undefined
    return index < fgItemDrag.from ? 'before' : 'after'
  }

  /** Moves item \`from\` to \`to\` (the others close up); the moved item gets focus. */
  function fgMoveItemTo(path: string, from: number, to: number): void {
    const list = fgList(form, path)
    if (from === to || to < 0 || to >= list.length) return
    const label = fgItemLabel(path, from)
    fgKeyAt(path, list.length - 1)
    const keys = fgKeys.current[path]!
    keys.splice(to, 0, keys.splice(from, 1)[0]!)
    fgRemapItems(path, (n) => fgMovedIndex(n, from, to))
    const next = [...list]
    next.splice(to, 0, next.splice(from, 1)[0]!)
    setField(path, next)
    fgPendingFocus.current = { path, index: to, move: 'item' }
    fgAnnounce("{label} moved to position {n}".split('{label}').join(label).split('{n}').join(String(to + 1)))
  }

  function fgRemoveItem(path: string, index: number): void {
    const list = fgList(form, path)
    if (list.length <= (FG_ITEM_LIMITS[fgTpl(path)]?.min ?? 0)) return
    const label = fgItemLabel(path, index)
    fgKeyAt(path, list.length - 1)
    fgKeys.current[path]!.splice(index, 1)
    fgRemapItems(path, (i) => (i === index ? null : i > index ? i - 1 : i))
    setField(path, list.filter((_, i) => i !== index))
    fgPendingFocus.current = { path, index: -1 - index }
    fgAnnounce("{label} removed".split('{label}').join(label))
  }

  // After an add: focus the new item's first control. After a remove
  // (negative index): focus the item that took its place, or the add button.
  useEffect(() => {
    const pending = fgPendingFocus.current
    if (!pending) return
    fgPendingFocus.current = null
    const repeater = fgRoot.current?.querySelector(\`[data-fg-repeater="\${pending.path}"]\`)
    const items = Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
    if (pending.move === 'item') {
      // After a drop: the moved item itself.
      items[pending.index]?.focus()
    } else if (pending.move) {
      // After a move: the same button on the moved item, else its other one.
      const buttons = Array.from(items[pending.index]?.querySelectorAll<HTMLElement>('[data-fg-move]') ?? [])
      ;(buttons.find((b) => b.dataset['fgMove'] === pending.move) ?? buttons[0] ?? items[pending.index])?.focus()
    } else if (pending.index >= 0) {
      const item = items[pending.index]
      const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
      ;(control ?? item)?.focus()
    } else {
      const removed = -1 - pending.index
      const target = items[Math.min(removed, items.length - 1)]
      ;(target ?? repeater?.querySelector<HTMLElement>('[data-fg-add]'))?.focus()
    }
  })

  function fgReset(): void {
    setForm(fgCalc(INITIAL))
    setErrors({})
    touched.current.clear()
    fgKeys.current = {}
    setResult(null)
    setTagDrafts({})
    setDateDrafts({})
    setPhoneCountry({})
    fgAnnounce("The form was reset.")
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of fgAllPaths(form)) {
      touched.current.add(path)
      const message = fgValidatorFor(path)?.(form) ?? null
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) {
      if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_social_tabs(target)
      }
      if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_wizard(target)
      }
      fgAnnounce(fgErrorsText(Object.keys(nextErrors).length))
      return
    }
    const data = buildPayload(form)
    if (fgCaptchaToken === '') {
      fgAnnounce("The form can be sent once the check above has passed.")
      return
    }
    data["cf-turnstile-response"] = fgCaptchaToken
    // A token works once: a new check for the next submission.
    setFgCaptchaToken('')
    fgCaptchaReset(fgCaptchaEl.current)
    setResult(data)
    fgAnnounce("Form submitted.")
    onSubmit?.(data)
  }

  return (
    <form ref={fgRoot} className="p-3" dir="ltr" noValidate onSubmit={handleSubmit} onPointerDownCapture={() => { fgFlush.current(); fgPressing.current = true }}>
      <div className="row g-3">
        <div className="col-12 col-md-12 text-center">
          <h2 className="fg-heading text-primary">Kitchen Sink</h2>
        </div>
        <div className="col-12 col-md-12 text-center">
          <p className="text-secondary mb-0">Every implemented element appears in this form.</p>
        </div>
        <div className="col-12 col-md-12">
          <div className="text-secondary mb-0 fg-rich-text">
            <p>Hi {fgOr(fgAnswer(form.full_name, ", "), "there")}! Fields marked * are <strong>required</strong>. See the <a className="link-primary" href="https://example.com/docs">docs</a>:</p>
            <ul>
              <li><em>one</em> answer per row in Rating</li>
              <li>several in Usage</li>
            </ul>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_full_name">Full name<span className="text-danger fg-required" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "form-control is-invalid" : "form-control"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_email">Email<span className="text-danger fg-required" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "form-control is-invalid" : "form-control"} placeholder="jane&#64;example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "form-control form-control-sm rounded is-invalid" : "form-control form-control-sm rounded"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <div className="fg-label-row"><label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_seats">Seats</label><span className="fg-tip"><button type="button" className="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" className="fg-tip-text">Including yourself</span></span></div>
            <div className="input-group">
              <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "form-control is-invalid" : "form-control"} min="1" max="50" aria-describedby="fg_seats-suffix" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
              <span id="fg_seats-suffix" className="input-group-text">people</span>
            </div>
            {errors['seats'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_seat_cost">Seat cost</label>
            <div className="input-group">
              <span id="fg_seat_cost-prefix" className="input-group-text">$</span>
              <input id="fg_seat_cost" type="text" readOnly className="form-control bg-body-tertiary" value={fgFmt(form.seat_cost, 2)} aria-invalid={errors['seat_cost'] ? true : undefined} aria-describedby="fg_seat_cost-prefix" />
            </div>
            {errors['seat_cost'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['seat_cost']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="form-range" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="form-text mt-0 mb-0 fg-description">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <hr className="border-top my-1 border-primary opacity-100" />
        </div>
        <div className="col-12 col-md-12">
          <div className="row g-3">
            <div className="col-6 col-md-6 col-lg-4">
              <div className="d-flex flex-column fg-field">
                <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="col-6 col-md-6">
              <div className="d-flex flex-column fg-field">
                <label className="visually-hidden" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12 account-box">
          <fieldset className="border rounded p-3 bg-body-tertiary">
            <legend className="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">Account</legend>
            <div className="row g-3">
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column fg-field">
                  <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_account_username">Username<span className="text-danger fg-required" aria-hidden="true">*</span></label>
                  <div className="input-group">
                    <span id="fg_account_username-prefix" className="input-group-text">&#64;</span>
                    <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "form-control is-invalid" : "form-control"} aria-describedby="fg_account_username-prefix" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  </div>
                  {errors['account.username'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column fg-field">
                  <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column fg-field">
                  <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "form-control form-control-lg rounded is-invalid" : "form-control form-control-lg rounded"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['account.bio']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column fg-field">
                  <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_account_birthday">Birthday</label>
                  <input id="fg_account_birthday" type="date" value={form.account.birthday} className={errors['account.birthday'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.birthday', e.target.value)} onBlur={() => touch('account.birthday')} />
                  {errors['account.birthday'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['account.birthday']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column fg-field">
                  <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_account_avatar">Profile picture</label>
                  <div className="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary">
                    <span className="fw-medium">Choose a file or drag it here</span>
                    <input id="fg_account_avatar" type="file" className="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept="image/*" aria-invalid={errors['account.avatar'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('account.avatar', e.target)} onDragEnter={(e) => fgDrag(e.currentTarget, true)} onDragLeave={(e) => fgDrag(e.currentTarget, false)} onDrop={(e) => fgDropFiles('account.avatar', e)} />
                  </div>
                  {form.account.avatar.length > 0 && (
                    <ul className="list-group mt-2">
                      {form.account.avatar.map((file, fi) => (
                        <li key={fi} className="list-group-item d-flex align-items-center gap-2">
                        {file.type.startsWith('image/') && <img className="rounded object-fit-cover" src={fgThumb(file)} alt="" width={40} height={40} />}
                          <span className="flex-grow-1 text-truncate">{file.name}</span>
                          <span className="text-body-secondary small">{fgFileSize(file.size)}</span>
                          <button type="button" className="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('account.avatar', fi)}>×</button>
                        </li>
                      ))}
                    </ul>
                  )}
                  {fgFileNotes['account.avatar'] && <p className="form-text mt-0 mb-0 fg-description" data-fg-file-note>{fgFileNotes['account.avatar']}</p>}
                  {errors['account.avatar'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['account.avatar']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <fieldset className="d-flex flex-column fg-field" aria-labelledby="fg_plan-legend">
            <legend className="form-label fw-semibold small mb-0 fg-label"><span id="fg_plan-legend">Plan</span><span className="text-danger fg-required" aria-hidden="true">*</span><span className="fg-tip"><button type="button" className="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" className="fg-tip-text">You can switch plans at any time</span></span></legend>
            <div className="d-flex flex-column fg-options">
              <label className="form-check mb-0" htmlFor="fg_plan-free">
                <input id="fg_plan-free" type="radio" className="form-check-input" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                <span>Free</span>
              </label>
              <label className="form-check mb-0" htmlFor="fg_plan-pro">
                <input id="fg_plan-pro" type="radio" className="form-check-input" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                <span>Pro</span>
              </label>
            </div>
          </fieldset>
            {errors['plan'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Interests</legend>
            <div className="d-flex flex-column fg-options">
              <label className="form-check mb-0" htmlFor="fg_interests-news">
                <input id="fg_interests-news" type="checkbox" className="form-check-input" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                <span>News</span>
              </label>
              <label className="form-check mb-0" htmlFor="fg_interests-product">
                <input id="fg_interests-product" type="checkbox" className="form-check-input" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                <span>Product updates</span>
              </label>
            </div>
          </fieldset>
            {errors['interests'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "form-select is-invalid" : "form-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['channels']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_topics">Topics</label>
            <div className="form-control d-flex flex-wrap align-items-center gap-1 px-2">
              {form.topics.map((tag, index) => (
                <span key={tag} className="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">{tag} <button type="button" className="border-0 bg-transparent p-0 ms-1 text-white" aria-label={'Remove ' + (tag)} onClick={() => fgRemoveTag('topics', form.topics, index)}>×</button></span>
              ))}
              <input id="fg_topics" type="text" className="border-0 p-0 flex-grow-1 shadow-none bg-transparent" value={tagDrafts['topics'] ?? ''} placeholder="Type and press Enter" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setTagDrafts((d) => ({ ...d, 'topics': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddTag('topics', form.topics) } }} onBlur={() => { fgAddTag('topics', form.topics); touch('topics') }} />
            </div>
            <p className="form-text mt-0 mb-0 fg-description">Free-text tags</p>
            {errors['topics'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['topics']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Billing</legend>
            <div className="btn-group flex-wrap align-self-start">
              <input id="fg_billing-monthly" type="radio" className="btn-check" checked={form.billing === 'monthly'} onChange={() => { setField('billing', 'monthly'); touch('billing') }} />
              <label className="btn btn-outline-primary fg-option-button" htmlFor="fg_billing-monthly">Monthly</label>
              <input id="fg_billing-yearly" type="radio" className="btn-check" checked={form.billing === 'yearly'} onChange={() => { setField('billing', 'yearly'); touch('billing') }} />
              <label className="btn btn-outline-primary fg-option-button" htmlFor="fg_billing-yearly">Yearly</label>
            </div>
          </fieldset>
            {errors['billing'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['billing']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Extras</legend>
            <div className="d-flex flex-column gap-2">
              <label className="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" htmlFor="fg_extras-support">
                <input id="fg_extras-support" type="checkbox" className="form-check-input m-0 flex-shrink-0" checked={form.extras.includes('support')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'support'] : form.extras.filter((v) => v !== 'support')); touch('extras') }} />
                <span>Priority support</span>
              </label>
              <label className="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" htmlFor="fg_extras-backup">
                <input id="fg_extras-backup" type="checkbox" className="form-check-input m-0 flex-shrink-0" checked={form.extras.includes('backup')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'backup'] : form.extras.filter((v) => v !== 'backup')); touch('extras') }} />
                <span>Daily backups</span>
              </label>
            </div>
          </fieldset>
            {errors['extras'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['extras']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <div className="form-check form-switch mb-0 fg-switch-wrap">
              <input id="fg_notify" type="checkbox" role="switch" checked={form.notify} className="form-check-input fg-switch" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('notify', e.target.checked); touch('notify') }} />
              <label className="form-check-label" htmlFor="fg_notify">Email notifications</label>
            </div>
            {errors['notify'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['notify']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_appointment">Appointment</label>
            <input id="fg_appointment" type="datetime-local" value={form.appointment} className={errors['appointment'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('appointment', e.target.value)} onBlur={() => touch('appointment')} />
            {errors['appointment'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['appointment']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_brand_color">Brand color</label>
            <input id="fg_brand_color" type="color" value={form.brand_color} className={errors['brand_color'] ? "form-control form-control-color is-invalid" : "form-control form-control-color"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('brand_color', e.target.value)} onBlur={() => touch('brand_color')} />
            {errors['brand_color'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['brand_color']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_volume">Volume</label>
            <input id="fg_volume" type="range" value={form.volume} className="form-range" min="0" max="10" step="1" aria-orientation="vertical" style={{ writingMode: 'vertical-lr', direction: 'rtl', alignSelf: 'flex-start', width: 'auto', height: '10rem' }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('volume', Number(e.target.value)); touch('volume') }} />
            <p className="form-text mt-0 mb-0 fg-description">{form.volume}</p>
            {errors['volume'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['volume']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_budget">Budget</label>
            <div className="fg-dual">
              <div className="fg-dual-track"><div className="fg-dual-fill" style={fgDualFill(form.budget, 0, 1000)}></div></div>
              <input id="fg_budget" type="range" min="0" max="1000" step="50" value={form.budget.from} aria-label="Budget: Minimum" style={{ zIndex: fgDualFromOnTop(form.budget, 0, 1000) ? 3 : 1 }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgDualChange('budget', form.budget, 'from', Number(e.target.value))} />
              <input id="fg_budget-to" type="range" min="0" max="1000" step="50" value={form.budget.to} aria-label="Budget: Maximum" style={{ zIndex: 2 }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgDualChange('budget', form.budget, 'to', Number(e.target.value))} />
            </div>
            <p className="form-text mt-0 mb-0 fg-description">{form.budget.from} – {form.budget.to}</p>
            {errors['budget'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['budget']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_stay">Stay<span className="text-danger fg-required" aria-hidden="true">*</span></label>
            <div className="d-flex flex-wrap align-items-center gap-2 fg-pair">
              <input id="fg_stay" type="date" value={form.stay.from} className={errors['stay'] ? "form-control is-invalid" : "form-control"} aria-label="Stay: Start date" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('stay', { ...form.stay, from: e.target.value })} onBlur={() => touch('stay')} />
              <span aria-hidden="true">–</span>
              <input id="fg_stay-to" type="date" value={form.stay.to} className={errors['stay'] ? "form-control is-invalid" : "form-control"} min={form.stay.from || undefined} aria-label="Stay: End date" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('stay', { ...form.stay, to: e.target.value })} onBlur={() => touch('stay')} />
            </div>
            {errors['stay'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['stay']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_days">Available days</label>
            <div className="d-flex flex-wrap align-items-center gap-2 fg-pair">
              <input id="fg_days" type="date" value={dateDrafts['days'] ?? ''} className={errors['days'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setDateDrafts((d) => ({ ...d, 'days': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddDate('days', form.days) } }} />
              <button type="button" className="btn btn-outline-secondary fw-semibold px-3 flex-shrink-0 text-nowrap" onClick={() => fgAddDate('days', form.days)}>Add date</button>
            </div>
            {form.days.length > 0 && (
              <div className="d-flex flex-wrap gap-1 mt-2">
                {form.days.map((date, index) => (
                  <span key={date} className="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">{date} <button type="button" className="border-0 bg-transparent p-0 ms-1 text-white" aria-label={'Remove ' + (date)} onClick={() => fgRemoveDate('days', form.days, index)}>×</button></span>
                ))}
              </div>
            )}
            {errors['days'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['days']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">How did we do?<span className="text-danger fg-required" aria-hidden="true">*</span></legend>
            <div className="table-responsive">
              <table className="table table-borderless table-striped align-middle small mb-0 fg-matrix">
                <thead><tr><td></td><th scope="col" className="text-center fw-semibold text-body-secondary">Poor</th><th scope="col" className="text-center fw-semibold text-body-secondary">OK</th><th scope="col" className="text-center fw-semibold text-body-secondary">Great</th></tr></thead>
                <tbody>
                <tr><th scope="row" className="text-start fw-medium">Speed</th><td className="text-center"><input id="fg_rating" type="radio" className="form-check-input" name="fg_rating_speed" value="1" checked={form.rating["speed"] === "1"} aria-label="Speed: Poor" onChange={() => setField('rating', { ...form.rating, ["speed"]: "1" })} onBlur={() => touch('rating')} /></td><td className="text-center"><input id="fg_rating-0-1" type="radio" className="form-check-input" name="fg_rating_speed" value="2" checked={form.rating["speed"] === "2"} aria-label="Speed: OK" onChange={() => setField('rating', { ...form.rating, ["speed"]: "2" })} onBlur={() => touch('rating')} /></td><td className="text-center"><input id="fg_rating-0-2" type="radio" className="form-check-input" name="fg_rating_speed" value="3" checked={form.rating["speed"] === "3"} aria-label="Speed: Great" onChange={() => setField('rating', { ...form.rating, ["speed"]: "3" })} onBlur={() => touch('rating')} /></td></tr>
                <tr><th scope="row" className="text-start fw-medium">Quality</th><td className="text-center"><input id="fg_rating-1-0" type="radio" className="form-check-input" name="fg_rating_quality" value="1" checked={form.rating["quality"] === "1"} aria-label="Quality: Poor" onChange={() => setField('rating', { ...form.rating, ["quality"]: "1" })} onBlur={() => touch('rating')} /></td><td className="text-center"><input id="fg_rating-1-1" type="radio" className="form-check-input" name="fg_rating_quality" value="2" checked={form.rating["quality"] === "2"} aria-label="Quality: OK" onChange={() => setField('rating', { ...form.rating, ["quality"]: "2" })} onBlur={() => touch('rating')} /></td><td className="text-center"><input id="fg_rating-1-2" type="radio" className="form-check-input" name="fg_rating_quality" value="3" checked={form.rating["quality"] === "3"} aria-label="Quality: Great" onChange={() => setField('rating', { ...form.rating, ["quality"]: "3" })} onBlur={() => touch('rating')} /></td></tr>
                </tbody>
              </table>
            </div>
            {errors['rating'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['rating']}</p>}
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Where do you use each feature?</legend>
            <div className="table-responsive">
              <table className="table table-borderless table-striped align-middle small mb-0 fg-matrix">
                <thead><tr><td></td><th scope="col" className="text-center fw-semibold text-body-secondary">Web</th><th scope="col" className="text-center fw-semibold text-body-secondary">Mobile</th></tr></thead>
                <tbody>
                <tr><th scope="row" className="text-start fw-medium">Forms</th><td className="text-center"><input id="fg_usage" type="checkbox" className="form-check-input" name="fg_usage_forms" value="web" checked={form.usage["forms"].includes("web")} aria-label="Forms: Web" onChange={() => setField('usage', { ...form.usage, ["forms"]: fgToggleCell(['web', 'mobile'], form.usage["forms"], 'web') })} onBlur={() => touch('usage')} /></td><td className="text-center"><input id="fg_usage-0-1" type="checkbox" className="form-check-input" name="fg_usage_forms" value="mobile" checked={form.usage["forms"].includes("mobile")} aria-label="Forms: Mobile" onChange={() => setField('usage', { ...form.usage, ["forms"]: fgToggleCell(['web', 'mobile'], form.usage["forms"], 'mobile') })} onBlur={() => touch('usage')} /></td></tr>
                <tr><th scope="row" className="text-start fw-medium">Reports</th><td className="text-center"><input id="fg_usage-1-0" type="checkbox" className="form-check-input" name="fg_usage_reports" value="web" checked={form.usage["reports"].includes("web")} aria-label="Reports: Web" onChange={() => setField('usage', { ...form.usage, ["reports"]: fgToggleCell(['web', 'mobile'], form.usage["reports"], 'web') })} onBlur={() => touch('usage')} /></td><td className="text-center"><input id="fg_usage-1-1" type="checkbox" className="form-check-input" name="fg_usage_reports" value="mobile" checked={form.usage["reports"].includes("mobile")} aria-label="Reports: Mobile" onChange={() => setField('usage', { ...form.usage, ["reports"]: fgToggleCell(['web', 'mobile'], form.usage["reports"], 'mobile') })} onBlur={() => touch('usage')} /></td></tr>
                </tbody>
              </table>
            </div>
            {errors['usage'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['usage']}</p>}
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="border rounded p-3 bg-body-tertiary" data-fg-repeater="references">
            <legend className="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">References</legend>
            <div className="d-flex flex-column gap-3">
              {form.references.map((item, i) => (
                <fieldset key={fgKeyAt('references', i)} className="border rounded p-3" data-fg-item tabIndex={-1} data-fg-drag={fgDragMark('references', i)} data-fg-drop={fgDropMark('references', i)} onDragOver={(e) => fgDragOver(e, 'references', i)} onDrop={(e) => fgDropItem(e, 'references', i)}>
                  <legend className="float-none w-auto px-1 small fw-semibold mb-0 fg-label">{fgItemLabel('references', i)}</legend>
                  <div className="row g-3">
                    <div className="col-12 col-md-12">
                      <div className="d-flex flex-column fg-field">
                        <label className="form-label fw-semibold small mb-0 fg-label" htmlFor={'fg_references_' + i + '_name'}>Name<span className="text-danger fg-required" aria-hidden="true">*</span></label>
                        <input id={'fg_references_' + i + '_name'} type="text" value={item.name} className={errors[('references.' + i + '.name')] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.name'), e.target.value)} onBlur={() => touch(('references.' + i + '.name'))} />
                        {errors[('references.' + i + '.name')] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors[('references.' + i + '.name')]}</p>}
                      </div>
                    </div>
                    <div className="col-12 col-md-12">
                      <div className="d-flex flex-column fg-field">
                        <div className="form-check mb-0">
                          <input id={'fg_references_' + i + '_may_contact'} type="checkbox" checked={item.may_contact} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField(('references.' + i + '.may_contact'), e.target.checked); touch(('references.' + i + '.may_contact')) }} />
                          <label className="form-check-label" htmlFor={'fg_references_' + i + '_may_contact'}>May we contact them?</label>
                        </div>
                        {errors[('references.' + i + '.may_contact')] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors[('references.' + i + '.may_contact')]}</p>}
                      </div>
                    </div>
                    {((item.may_contact === true)) && (
                      <div className="col-12 col-md-12">
                        <div className="d-flex flex-column fg-field">
                          <label className="form-label fw-semibold small mb-0 fg-label" htmlFor={'fg_references_' + i + '_email'}>Their email</label>
                          <input id={'fg_references_' + i + '_email'} type="email" value={item.email} className={errors[('references.' + i + '.email')] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.email'), e.target.value)} onBlur={() => touch(('references.' + i + '.email'))} />
                          {errors[('references.' + i + '.email')] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors[('references.' + i + '.email')]}</p>}
                        </div>
                      </div>
                    )}
                    {((item.may_contact === true)) && (
                      <div className="col-12 col-md-12">
                        <div className="d-flex flex-column fg-field">
                          <label className="form-label fw-semibold small mb-0 fg-label" htmlFor={'fg_references_' + i + '_phone'}>Their phone</label>
                          <div className="d-flex flex-wrap align-items-center gap-2 fg-pair">
                            <select className="form-select flex-grow-0 w-50" aria-label="Country code" value={fgPhoneCountryOf(('references.' + i + '.phone'))} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => fgPhoneSetCountry(('references.' + i + '.phone'), item.phone, e.target.value)} onBlur={() => touch(('references.' + i + '.phone'))}>
                              <option value="AF">Afghanistan (+93)</option>
                              <option value="AX">Åland Islands (+358)</option>
                              <option value="AL">Albania (+355)</option>
                              <option value="DZ">Algeria (+213)</option>
                              <option value="AS">American Samoa (+1)</option>
                              <option value="AD">Andorra (+376)</option>
                              <option value="AO">Angola (+244)</option>
                              <option value="AI">Anguilla (+1)</option>
                              <option value="AG">Antigua &amp; Barbuda (+1)</option>
                              <option value="AR">Argentina (+54)</option>
                              <option value="AM">Armenia (+374)</option>
                              <option value="AW">Aruba (+297)</option>
                              <option value="AU">Australia (+61)</option>
                              <option value="AT">Austria (+43)</option>
                              <option value="AZ">Azerbaijan (+994)</option>
                              <option value="BS">Bahamas (+1)</option>
                              <option value="BH">Bahrain (+973)</option>
                              <option value="BD">Bangladesh (+880)</option>
                              <option value="BB">Barbados (+1)</option>
                              <option value="BY">Belarus (+375)</option>
                              <option value="BE">Belgium (+32)</option>
                              <option value="BZ">Belize (+501)</option>
                              <option value="BJ">Benin (+229)</option>
                              <option value="BM">Bermuda (+1)</option>
                              <option value="BT">Bhutan (+975)</option>
                              <option value="BO">Bolivia (+591)</option>
                              <option value="BA">Bosnia &amp; Herzegovina (+387)</option>
                              <option value="BW">Botswana (+267)</option>
                              <option value="BR">Brazil (+55)</option>
                              <option value="IO">British Indian Ocean Territory (+246)</option>
                              <option value="VG">British Virgin Islands (+1)</option>
                              <option value="BN">Brunei (+673)</option>
                              <option value="BG">Bulgaria (+359)</option>
                              <option value="BF">Burkina Faso (+226)</option>
                              <option value="BI">Burundi (+257)</option>
                              <option value="KH">Cambodia (+855)</option>
                              <option value="CM">Cameroon (+237)</option>
                              <option value="CA">Canada (+1)</option>
                              <option value="CV">Cape Verde (+238)</option>
                              <option value="BQ">Caribbean Netherlands (+599)</option>
                              <option value="KY">Cayman Islands (+1)</option>
                              <option value="CF">Central African Republic (+236)</option>
                              <option value="TD">Chad (+235)</option>
                              <option value="CL">Chile (+56)</option>
                              <option value="CN">China (+86)</option>
                              <option value="CX">Christmas Island (+61)</option>
                              <option value="CC">Cocos (Keeling) Islands (+61)</option>
                              <option value="CO">Colombia (+57)</option>
                              <option value="KM">Comoros (+269)</option>
                              <option value="CG">Congo - Brazzaville (+242)</option>
                              <option value="CD">Congo - Kinshasa (+243)</option>
                              <option value="CK">Cook Islands (+682)</option>
                              <option value="CR">Costa Rica (+506)</option>
                              <option value="CI">Côte d’Ivoire (+225)</option>
                              <option value="HR">Croatia (+385)</option>
                              <option value="CU">Cuba (+53)</option>
                              <option value="CW">Curaçao (+599)</option>
                              <option value="CY">Cyprus (+357)</option>
                              <option value="CZ">Czechia (+420)</option>
                              <option value="DK">Denmark (+45)</option>
                              <option value="DJ">Djibouti (+253)</option>
