            <label className="fg-label" htmlFor="fg_topics">Topics</label>
            <div className="fg-tags">
              {form.topics.map((tag, index) => (
                <span key={tag} className="fg-tag">{tag} <button type="button" className="fg-tag-remove" aria-label={'Remove ' + (tag)} onClick={() => fgRemoveTag('topics', form.topics, index)}>×</button></span>
              ))}
              <input id="fg_topics" type="text" className="fg-tags-input" value={tagDrafts['topics'] ?? ''} placeholder="Type and press Enter" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setTagDrafts((d) => ({ ...d, 'topics': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddTag('topics', form.topics) } }} onBlur={() => { fgAddTag('topics', form.topics); touch('topics') }} />
            </div>
            <p className="fg-description">Free-text tags</p>
            {errors['topics'] && <p className="fg-error" role="alert">{errors['topics']}</p>}
