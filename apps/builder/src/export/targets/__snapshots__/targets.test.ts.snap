                          <input id={'fg_references_' + i + '_email'} type="email" value={item.email} className={errors[('references.' + i + '.email')] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.email'), e.target.value)} onBlur={() => touch(('references.' + i + '.email'))} />
                          {errors[('references.' + i + '.email')] && <p className="invalid-feedback d-block mt-0" role="alert">{errors[('references.' + i + '.email')]}</p>}
