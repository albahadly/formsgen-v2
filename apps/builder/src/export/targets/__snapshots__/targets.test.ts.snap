            </div>
            {errors['terms'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['terms']}</p>}
          </div>
        </div>
      </div>
      <div className="visually-hidden" role="status" aria-live="polite" aria-atomic="true">{fgAnnouncement}</div>
      {result && <pre className="mt-3 p-3 bg-dark text-success rounded small overflow-auto">{JSON.stringify(result, null, 2)}</pre>}
    </form>
  )
}
"
`;

exports[`react target > snapshot (tailwind) 1`] = `
"// Generated by FormsGen — no runtime dependencies beyond React.
import React, { useEffect, useRef, useState } from 'react'

function fgIsEmpty(v) {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
function fgSize(v) {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}

type FormData = {
  full_name: string
  email: string
  website: string
  seats: number | null
  satisfaction: number
  city: string
  zip: string
