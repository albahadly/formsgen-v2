    // Starting country per field (template member); the chosen one per field key.
    private static readonly Dictionary<string, string> FgPhoneDefaults = new() { ["ContactPhone"] = "OM", ["ReferencesIPhone"] = "GB" };

    private readonly FgStore<string> fgPhoneCountry = new(key => FgPhoneDefaults[FgTemplateKey(key)]);

    // The number part of "+<code> <number>" for the selected country.
    private static string FgPhoneNumber(string value, string country)
    {
        var prefix = "+" + FgDial[country] + " ";
        return value.StartsWith(prefix) ? value[prefix.Length..] : value;
    }

    private static string FgComposePhone(string country, string number) =>
        string.IsNullOrWhiteSpace(number) ? "" : "+" + FgDial[country] + " " + number;

    // The chosen country, else the one whose code starts the value ("+44 …";
    // the field's own first, as for restored answers), else the default.
    private string FgPhoneCountryOf(string member, string value)
    {
        if (fgPhoneCountry.TryGetValue(member, out var chosen)) return chosen;
        var fallback = fgPhoneCountry[member];
        if (value.StartsWith("+" + FgDial[fallback] + " ")) return fallback;
        foreach (var (code, dial) in FgDial) if (value.StartsWith("+" + dial + " ")) return code;
        return fallback;
    }

    private string FgPhoneSetCountry(string member, string value, ChangeEventArgs e)
    {
        var typed = FgPhoneNumber(value, FgPhoneCountryOf(member, value));
        fgPhoneCountry[member] = Convert.ToString(e.Value) ?? FgPhoneCountryOf(member, value);
        return FgComposePhone(fgPhoneCountry[member], typed);
    }

    private string FgPhoneInput(string member, string value, ChangeEventArgs e) =>
        FgComposePhone(FgPhoneCountryOf(member, value), Convert.ToString(e.Value) ?? "");

    private readonly FgStore<string> fgDateDrafts = new(_ => "");

    private void FgAddDate(List<string> list, string member)
    {
        var date = fgDateDrafts.TryGetValue(member, out var draft) ? draft ?? "" : "";
        if (System.Text.RegularExpressions.Regex.IsMatch(date, @"^\\d{4}-\\d{2}-\\d{2}$") && !list.Contains(date))
        {
            list.Add(date);
            list.Sort(string.CompareOrdinal);
        }
        fgDateDrafts[member] = "";
        FgChanged(member);
    }

    private void FgRemoveDate(List<string> list, string date, string member)
    {
        list.Remove(date);
        FgChanged(member);
    }

    private static string FgRemoveDateLabel(string date) => "Remove {date}".Replace("{date}", date);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FgFocusRepeaters();
        await FgFocusUploads();
        await FgFocusDual();
        if (firstRender) await FgInteropInit();
        await FgInteropWire();
        // Values from a new model (start, reset, saved answers) into the editors.
        await FgRichShowValues();
        // Values from a new model into the location fields.
        await FgLocShowValues();
        // The signatures the model holds, into pads shown again.
        await FgSignShowValues();
    }

    private async Task FgReset()
    {
        Model = new();
        FgInitEdit();
        FgCalc();
        fgItemRefs.Clear();
        fgDeferredFields.Clear();
        ResultJson = null;
        foreach (var key in fgTagDrafts.Keys.ToList()) fgTagDrafts[key] = "";
        foreach (var key in fgDateDrafts.Keys.ToList()) fgDateDrafts[key] = "";
        fgPhoneCountry.Clear();
        await FgJs.InvokeVoidAsync("fgSignClear", fgFormRoot);
        await FgAnnounce("The form was reset.");
    }

    // Prefill from the page address: ?field=value fills matching fields (a
    // list takes repeated parameters or one comma-separated value); a hidden
    // field takes its named parameter. After a restored draft: the link wins.
    private void FgPrefill()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(FgNav.Uri).Query);
        { var v = FgQueryString(query, "full_name"); if (v is not null) Model.FullName = v; }
        { var v = FgQueryString(query, "email"); if (v is not null) Model.Email = v; }
        { var v = FgQueryString(query, "website"); if (v is not null) Model.Website = v; }
        { var v = FgQueryNumber(query, "seats"); if (v is not null) Model.Seats = v; }
        { var v = FgQueryNumber(query, "satisfaction"); if (v is not null) Model.Satisfaction = v.Value; }
        { var v = FgQueryString(query, "city"); if (v is not null) Model.City = v; }
        { var v = FgQueryString(query, "zip"); if (v is not null) Model.Zip = v; }
        { var v = FgQueryString(query, "account.username"); if (v is not null) Model.AccountUsername = v; }
        { var v = FgQueryString(query, "account.bio"); if (v is not null) Model.AccountBio = v; }
        { var v = FgQueryString(query, "account.birthday"); if (v is not null) Model.AccountBirthday = v; }
        { var v = FgQueryString(query, "plan"); if (v is not null) Model.Plan = v; }
        { var v = FgQueryList(query, "interests"); if (v is not null) Model.Interests = v; }
        { var v = FgQueryList(query, "channels"); if (v is not null) Model.Channels = v.ToArray(); }
        { var v = FgQueryList(query, "topics"); if (v is not null) Model.Topics = v; }
        { var v = FgQueryString(query, "billing"); if (v is not null) Model.Billing = v; }
        { var v = FgQueryList(query, "extras"); if (v is not null) Model.Extras = v; }
        { var v = FgQueryBool(query, "notify"); if (v is not null) Model.Notify = v.Value; }
        { var v = FgQueryString(query, "appointment"); if (v is not null) Model.Appointment = v; }
        { var v = FgQueryString(query, "brand_color"); if (v is not null) Model.BrandColor = v; }
        { var v = FgQueryNumber(query, "volume"); if (v is not null) Model.Volume = v.Value; }
        { var v = FgQueryList(query, "days"); if (v is not null) Model.Days = v; }
        { var v = FgQueryString(query, "utm_source"); if (v is not null) Model.Source = v; }
        { var v = FgQueryString(query, "attachments_note"); if (v is not null) Model.AttachmentsNote = v; }
        { var v = FgQueryString(query, "contact_method"); if (v is not null) Model.ContactMethod = v; }
        { var v = FgQueryString(query, "contact_phone"); if (v is not null) Model.ContactPhone = v; }
        { var v = FgQueryString(query, "contact_other"); if (v is not null) Model.ContactOther = v; }
        { var v = FgQueryString(query, "twitter"); if (v is not null) Model.Twitter = v; }
        { var v = FgQueryString(query, "github"); if (v is not null) Model.Github = v; }
        { var v = FgQueryString(query, "shipping_city"); if (v is not null) Model.ShippingCity = v; }
        { var v = FgQueryString(query, "order_notes"); if (v is not null) Model.OrderNotes = v; }
        { var v = FgQueryBool(query, "newsletter"); if (v is not null) Model.Newsletter = v.Value; }
        { var v = FgQueryBool(query, "terms"); if (v is not null) Model.Terms = v.Value; }
    }

    private static string? FgQueryString(System.Collections.Specialized.NameValueCollection query, string name) =>
        query.GetValues(name) is { Length: > 0 } values ? values[0] : null;

    private static double? FgQueryNumber(System.Collections.Specialized.NameValueCollection query, string name) =>
        FgQueryString(query, name) is { } v && v.Trim().Length > 0 && double.TryParse(v.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    private static bool? FgQueryBool(System.Collections.Specialized.NameValueCollection query, string name) =>
        FgQueryString(query, name)?.Trim().ToLowerInvariant() switch
        {
            "1" or "true" or "on" or "yes" => true,
            "0" or "false" or "off" or "no" => false,
            _ => null,
        };

    private static List<string>? FgQueryList(System.Collections.Specialized.NameValueCollection query, string name)
    {
        var values = query.GetValues(name);
        if (values is null) return null;
        var parts = values.Length == 1 ? values[0].Split(',') : values;
        return parts.Select(p => p.Trim()).Where(p => p.Length > 0).ToList();
    }

    // Scripts on the form's root (loaded once, after the first render) call
    // back into this component through fgSelf. They are wired to the form's
    // element after each render that follows a new EditContext (EditForm
    // then builds new elements).
    private ElementReference fgFormRoot;
    private Microsoft.JSInterop.DotNetObjectReference<KitchenSinkForm>? fgSelf;
    private bool fgWire;
    // One number per render (counted before each render): the interop
    // registries keep the elements stamped with the latest one.
    private int fgRenderGen;

    private async Task FgInteropInit()
    {
        fgSelf = Microsoft.JSInterop.DotNetObjectReference.Create(this);
        await FgJs.InvokeVoidAsync("eval", FgItemDragScript);
        await FgJs.InvokeVoidAsync("eval", FgSignatureScript);
        await FgJs.InvokeVoidAsync("eval", FgRichTextScript);
        await FgJs.InvokeVoidAsync("eval", FgLocationScript);
        await FgJs.InvokeVoidAsync("eval", FgCaptchaScript);
    }

    private async Task FgInteropWire()
    {
        if (!fgWire || fgSelf is null) return;
        fgWire = false;
        await FgJs.InvokeVoidAsync("fgItemDrag", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgSignatures", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgRich", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgLocations", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgCaptchaWire", fgCaptchaEl, fgSelf);
    }

    public void Dispose() => fgSelf?.Dispose();

    // Signature pads: run by a script on the form's root (FgSignatureScript),
    // which reports each change here as a PNG data URL (null when cleared).
    private readonly Dictionary<string, List<FgUpload>> fgSignLists = new();
    // The render that last showed each pad; entries of elements no longer
    // rendered (removed items, fields hidden again) go after a render.
    private readonly Dictionary<string, int> fgSignSeen = new();

    private string FgSignKey(List<FgUpload> list, string key)
    {
        fgSignLists[key] = list;
        fgSignSeen[key] = fgRenderGen;
        return key;
    }

    private const string FgSignatureScript = @"// Signature pads: draw (mouse, finger, pen) or type a name; each change is
// signature.png. Wired once on the form root (pads in new items included).
function fgSignPad(canvas) {
  if (canvas.fgPad) return canvas.fgPad
  var ctx = canvas.getContext('2d')
  var pad = { ink: false, pending: 0, drawing: false, loading: false, last: null }
  pad.size = function () {
    var ratio = window.devicePixelRatio || 1
    var width = Math.round(canvas.clientWidth * ratio)
    var height = Math.round(canvas.clientHeight * ratio)
    if (!ctx || width === 0 || (canvas.width === width && canvas.height === height)) return
    // Keep the ink through the resize (a phone turning, a panel opening).
    var kept = null
    if (pad.ink && canvas.width > 0 && canvas.height > 0) {
      kept = document.createElement('canvas')
      kept.width = canvas.width
      kept.height = canvas.height
      var keptCtx = kept.getContext('2d')
      if (keptCtx) keptCtx.drawImage(canvas, 0, 0)
    }
    canvas.width = width
    canvas.height = height
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
    if (kept) ctx.drawImage(kept, 0, 0, canvas.clientWidth, canvas.clientHeight)
  }
  pad.wipe = function () {
    if (!ctx) return
    ctx.save()
    ctx.setTransform(1, 0, 0, 1, 0, 0)
    ctx.clearRect(0, 0, canvas.width, canvas.height)
    ctx.restore()
    pad.ink = false
  }
  pad.pen = function () {
    if (!ctx) return
    ctx.strokeStyle = ""#0f172a""
    ctx.fillStyle = ""#0f172a""
    ctx.lineWidth = 2.5
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
  }
  // Saved at CSS pixel size (small files whatever the screen density).
  pad.commit = function (done) {
    var ticket = ++pad.pending
    var out = document.createElement('canvas')
    out.width = canvas.clientWidth || canvas.width
    out.height = canvas.clientHeight || canvas.height
    var outCtx = out.getContext('2d')
    if (outCtx) outCtx.drawImage(canvas, 0, 0, out.width, out.height)
    out.toBlob(function (blob) {
      if (ticket !== pad.pending) return
      pad.pending = 0
      done(blob && pad.ink ? new File([blob], ""signature.png"", { type: 'image/png' }) : null)
    }, 'image/png')
  }
  pad.point = function (event) {
    var rect = canvas.getBoundingClientRect()
    return { x: event.clientX - rect.left, y: event.clientY - rect.top }
  }
  pad.type = function (text, done) {
    pad.size()
    pad.wipe()
    if (!ctx || text.trim() === '') {
      pad.pending++
      done(null)
      return
    }
    pad.pen()
    ctx.font = ""italic 2rem \\""Segoe Script\\"", \\""Brush Script MT\\"", \\""Snell Roundhand\\"", cursive""
    ctx.textAlign = 'center'
    ctx.textBaseline = 'middle'
    ctx.fillText(text.trim(), canvas.clientWidth / 2, canvas.clientHeight / 2, canvas.clientWidth - 24)
    pad.ink = true
    pad.commit(done)
  }
  // Draws a saved signature (a file, or a data URL) into a blank pad.
  pad.show = function (source) {
    if (pad.ink || pad.drawing || pad.loading) return
    pad.loading = true
    var url = typeof source === 'string' ? source : URL.createObjectURL(source)
    var image = new Image()
    image.onload = function () {
      pad.loading = false
      if (url !== source) URL.revokeObjectURL(url)
      if (pad.ink || pad.drawing || !ctx) return
      pad.size()
      ctx.drawImage(image, 0, 0, canvas.clientWidth, canvas.clientHeight)
      pad.ink = true
    }
    image.onerror = function () {
      pad.loading = false
      if (url !== source) URL.revokeObjectURL(url)
    }
    image.src = url
  }
  canvas.fgPad = pad
  return pad
}
function fgSignGroup(el) {
  var group = el.closest('[data-fg-sign]')
  return group ? { canvas: group.querySelector('canvas[data-fg-signature]'), typed: group.querySelector('[data-fg-sign-type]') } : null
}
// A commit callback bound to its pad.
function fgSignDone(canvas, onChange) {
  return function (file) { onChange(canvas, file) }
}
function fgWireSignatures(root, onChange) {
  if (!root || root.fgSignWired) return
  root.fgSignWired = true
  var padOf = function (event) {
    var target = event.target
    return target && target.closest ? target.closest('canvas[data-fg-signature]') : null
  }
  root.addEventListener('pointerdown', function (event) {
    var canvas = padOf(event)
    if (!canvas || event.button !== 0) return
    var pad = fgSignPad(canvas)
    pad.size()
    var ctx = canvas.getContext('2d')
    if (!ctx) return
    event.preventDefault()
    if (canvas.setPointerCapture) canvas.setPointerCapture(event.pointerId)
    pad.drawing = true
    pad.pen()
    var at = pad.point(event)
    pad.last = at
    ctx.beginPath()
    ctx.arc(at.x, at.y, 1.25, 0, Math.PI * 2)
    ctx.fill()
    pad.ink = true
  })
  root.addEventListener('pointermove', function (event) {
    var canvas = padOf(event)
    var pad = canvas && canvas.fgPad
    if (!canvas || !pad || !pad.drawing) return
    var last = pad.last
    var ctx = canvas.getContext('2d')
    if (!last || !ctx) return
    var next = pad.point(event)
    ctx.beginPath()
    ctx.moveTo(last.x, last.y)
    ctx.lineTo(next.x, next.y)
    ctx.stroke()
    pad.last = next
  })
  function up(event) {
    var canvas = padOf(event)
    var pad = canvas && canvas.fgPad
    if (!canvas || !pad || !pad.drawing) return
    pad.drawing = false
    pad.last = null
    pad.commit(fgSignDone(canvas, onChange))
  }
  root.addEventListener('pointerup', up)
  root.addEventListener('pointercancel', up)
  root.addEventListener('input', function (event) {
    var input = event.target
    if (!input || !input.matches || !input.matches('[data-fg-sign-type]')) return
    var group = fgSignGroup(input)
    var canvas = group && group.canvas
    if (!canvas) return
    fgSignPad(canvas).type(input.value, fgSignDone(canvas, onChange))
  })
  root.addEventListener('click', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-sign-clear]')
    if (!button) return
    var group = fgSignGroup(button)
    if (!group || !group.canvas) return
    var pad = fgSignPad(group.canvas)
    pad.pending++
    pad.wipe()
    if (group.typed) group.typed.value = ''
    onChange(group.canvas, null)
  })
}
// Pads follow their value: cleared when it went empty elsewhere (a reset),
// typed name too; a blank pad draws the file its value holds (a pad shown
// again by a step or a condition).
function fgSignSync(root, valueOf) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('canvas[data-fg-signature]'), function (canvas) {
    var pad = canvas.fgPad
    if (pad && (pad.pending || pad.drawing)) return
    var value = valueOf(canvas)
    if (value) {
      if (!pad || !pad.ink) fgSignPad(canvas).show(value)
      return
    }
    if (pad && pad.ink) pad.wipe()
    var group = fgSignGroup(canvas)
    if (group && group.typed && group.typed.value !== '') group.typed.value = ''
  })
}
window.fgSignatures = function (root, dotnet) {
  fgWireSignatures(root, function (canvas, file) {
    var key = canvas.getAttribute('data-fg-signature')
    dotnet.invokeMethodAsync('FgSigned', key, file ? DotNet.createJSStreamReference(file) : null)
  })
}
window.fgSignSet = function (root, dotnet, keys) {
  fgSignSync(root, function (canvas) {
    var key = canvas.getAttribute('data-fg-signature')
    if (keys.indexOf(key) === -1) return null
    var pad = fgSignPad(canvas)
    if (!pad.ink && !pad.loading && !pad.drawing) {
      pad.loading = true
      dotnet.invokeMethodAsync('FgSignData', key).then(function (dataUrl) {
        pad.loading = false
        if (dataUrl) pad.show(dataUrl)
      }, function () { pad.loading = false })
    }
    // Holding a value: never cleared here (the drawing goes through pad.show).
    return 'kept'
  })
}
window.fgSignClear = function (root) { fgSignSync(root, function () { return null }) }";

    [Microsoft.JSInterop.JSInvokable]
    public async Task FgSigned(string key, Microsoft.JSInterop.IJSStreamReference? stream)
    {
        if (!fgSignLists.TryGetValue(key, out var list)) return;
        byte[]? bytes = null;
        if (stream is not null)
        {
            await using (stream)
            {
                using var source = await stream.OpenReadStreamAsync(maxAllowedSize: 4L * 1024 * 1024);
                using var buffer = new System.IO.MemoryStream();
                await source.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }
        }
        list.Clear();
        if (bytes is not null) list.Add(new FgUpload("signature.png", bytes.Length, "image/png", bytes, "data:image/png;base64," + Convert.ToBase64String(bytes)));
        fgEdit.NotifyFieldChanged(FgField(key));
        StateHasChanged();
    }

    // The PNG of a signature the model holds, for a pad shown again.
    [Microsoft.JSInterop.JSInvokable]
    public string? FgSignData(string key) =>
        fgSignLists.TryGetValue(key, out var list) && list.Count > 0 ? list[0].Thumb : null;

    private async Task FgSignShowValues()
    {
        foreach (var key in fgSignLists.Keys.Where(key => !fgSignSeen.TryGetValue(key, out var seen) || seen != fgRenderGen).ToList()) { fgSignLists.Remove(key); fgSignSeen.Remove(key); }
        if (fgSelf is null) return;
        await FgJs.InvokeVoidAsync("fgSignSet", fgFormRoot, fgSelf, fgSignLists.Where(entry => entry.Value.Count > 0).Select(entry => entry.Key).ToArray());
    }

    // Rich-text editors: run by a script on the form's root (FgRichTextScript),
    // which reports each change here; the model's values go back to the
    // editors after every render (a reset, saved answers, an editor shown
    // again by a step or a condition).
    private readonly Dictionary<string, (Action<string> Set, string Value)> fgRich = new();
    // The render that last showed each editor; entries of elements no
    // longer rendered (removed items, fields hidden again) go after a render.
    private readonly Dictionary<string, int> fgRichSeen = new();

    private string FgRichKey(string key, Action<string> set, string value)
    {
        fgRich[key] = (set, value);
        fgRichSeen[key] = fgRenderGen;
        return key;
    }

    private const string FgRichTextScript = @"// Rich text: the editor's HTML reduced to p, br, strong, em, u, s, lists and
// http(s)/mailto links (the renderer's cleanRichText); '' when empty.
var FG_RICH_TAGS = {""p"":1,""br"":1,""strong"":1,""em"":1,""u"":1,""s"":1,""ul"":1,""ol"":1,""li"":1,""a"":1}
var FG_RICH_RENAME = { b: 'strong', i: 'em', div: 'p' }
// A paragraph can't hold these (one that does is unwrapped).
function fgRichHoldsBlock(node) {
  return Array.prototype.some.call(node.childNodes, function (child) {
    return child.nodeType === 1 && (/^(p|div|ul|ol|li)$/i.test(child.tagName) || fgRichHoldsBlock(child))
  })
}
// Kept by the HTML parser's rules as content-free (their text goes too).
var FG_RICH_DROP = { script: 1, style: 1, iframe: 1, frame: 1, frameset: 1, object: 1, embed: 1, applet: 1, template: 1, noscript: 1, noembed: 1, noframes: 1, textarea: 1, title: 1, xmp: 1, select: 1, option: 1, button: 1, head: 1, math: 1, svg: 1, canvas: 1, video: 1, audio: 1, form: 1, input: 1, source: 1, track: 1, link: 1, meta: 1, base: 1, param: 1, picture: 1, map: 1, dialog: 1, portal: 1 }
function fgRichHref(href) {
  return /^(https?:\\/\\/|mailto:)[^\\s""<>]+$/i.test(href.trim())
}
function fgRichEsc(text) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}
function fgRichWrite(nodes, inParagraph) {
  var out = ''
  Array.prototype.forEach.call(nodes, function (node) {
    if (node.nodeType === 3) {
      out += fgRichEsc((node.nodeValue || '').replace(/\\u00a0/g, ' '))
      return
    }
    if (node.nodeType !== 1) return
    var el = node
    var tag = el.tagName.toLowerCase()
    if (FG_RICH_DROP[tag]) return
    tag = FG_RICH_RENAME[tag] || tag
    if (!FG_RICH_TAGS[tag] || (tag === 'p' && (inParagraph || fgRichHoldsBlock(el)))) {
      out += fgRichWrite(el.childNodes, inParagraph)
      return
    }
    if (tag === 'br') {
      out += '<br>'
      return
    }
    if (tag === 'a') {
      var href = (el.getAttribute('href') || '').trim()
      out += fgRichHref(href)
        ? '<a href=""' + fgRichEsc(href).replace(/""/g, '&quot;') + '"">' + fgRichWrite(el.childNodes, inParagraph) + '</a>'
        : fgRichWrite(el.childNodes, inParagraph)
      return
    }
    out += '<' + tag + '>' + fgRichWrite(el.childNodes, inParagraph || tag === 'p') + '</' + tag + '>'
  })
  return out
}
function fgRichClean(html) {
  if (typeof html !== 'string' || html.trim() === '') return ''
  var box = document.createElement('template')
  box.innerHTML = html
  var out = fgRichWrite(box.content.childNodes, false)
  return fgRichPlain(out) === '' && out.indexOf('<li>') === -1 ? '' : out
}
// The answer's text (answers inside text): tags as spaces, entities decoded.
function fgRichPlain(html) {
  if (typeof html !== 'string') return ''
  return html
    .replace(/<br>|<\\/?(p|li|ul|ol)>/g, ' ')
    .replace(/<[^>]*>/g, '')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '""')
    .replace(/&#39;/g, ""'"")
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/\\s+/g, ' ')
    .trim()
}
// Toolbars and editors, wired once on the form root.
function fgWireRichText(root, onChange) {
  if (!root || root.fgRichWired) return
  root.fgRichWired = true
  root.addEventListener('mousedown', function (event) {
    // Keep the editor's selection when a toolbar button is pressed.
    var target = event.target
    if (target && target.closest && target.closest('[data-fg-rt-cmd]')) event.preventDefault()
  })
  root.addEventListener('click', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-rt-cmd]')
    if (!button) return
    var wrapper = button.closest('[data-fg-rich]')
    var editor = wrapper && wrapper.querySelector('[data-fg-richtext]')
    var command = button.getAttribute('data-fg-rt-cmd')
    if (!editor || !command) return
    if (command === 'link') {
      var url = window.prompt(""Link address (leave empty to remove the link)"", 'https://')
      if (url === null) return
      editor.focus()
      if (url.trim() === '') document.execCommand('unlink')
      else if (fgRichHref(url)) document.execCommand('createLink', false, url.trim())
    } else {
      editor.focus()
      document.execCommand(command)
    }
    onChange(editor, fgRichClean(editor.innerHTML))
  })
  // One tab stop per toolbar: the last used button; arrows, Home and End
  // move between the buttons (arrows follow the writing direction).
  var toolbarButtons = function (button) {
    var toolbar = button.closest('[role=""toolbar""]')
    return toolbar ? Array.prototype.slice.call(toolbar.querySelectorAll('[data-fg-rt-cmd]')) : []
  }
  root.addEventListener('focusin', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-rich] [role=""toolbar""] [data-fg-rt-cmd]')
    if (!button) return
    toolbarButtons(button).forEach(function (other) { other.setAttribute('tabindex', other === button ? '0' : '-1') })
  })
  root.addEventListener('keydown', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-rich] [role=""toolbar""] [data-fg-rt-cmd]')
    if (!button) return
    var toolbar = button.closest('[role=""toolbar""]')
    var buttons = toolbarButtons(button)
    var index = buttons.indexOf(button)
    var dirHost = toolbar && toolbar.closest('[dir]')
    var rtl = (dirHost ? dirHost.getAttribute('dir') : toolbar ? getComputedStyle(toolbar).direction : '') === 'rtl'
    var next = -1
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') next = (index + ((event.key === 'ArrowRight') !== rtl ? 1 : -1) + buttons.length) % buttons.length
    else if (event.key === 'Home') next = 0
    else if (event.key === 'End') next = buttons.length - 1
    var to = next < 0 ? null : buttons[next]
    if (!to) return
    event.preventDefault()
    to.focus()
  })
  root.addEventListener('input', function (event) {
    var editor = event.target
    if (editor && editor.matches && editor.matches('[data-fg-richtext]')) onChange(editor, fgRichClean(editor.innerHTML))
  })
  root.addEventListener('paste', function (event) {
    var target = event.target
    if (!target || !target.closest || !target.closest('[data-fg-richtext]')) return
    event.preventDefault()
    document.execCommand('insertText', false, event.clipboardData ? event.clipboardData.getData('text/plain') : '')
  })
}
// A value set elsewhere (a reset, saved answers) shows in editors not being typed in.
function fgRichSync(root, valueOf) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('[data-fg-richtext]'), function (editor) {
    if (document.activeElement === editor) return
    var clean = fgRichClean(valueOf(editor))
    if (fgRichClean(editor.innerHTML) !== clean) editor.innerHTML = clean
  })
}
window.fgRich = function (root, dotnet) {
  fgWireRichText(root, function (editor, html) {
    dotnet.invokeMethodAsync('FgRichChanged', editor.getAttribute('data-fg-richtext'), html)
  })
}
window.fgRichSet = function (root, values) {
  fgRichSync(root, function (editor) {
    var key = editor.getAttribute('data-fg-richtext')
    return Object.prototype.hasOwnProperty.call(values, key) ? values[key] : fgRichClean(editor.innerHTML)
  })
}";

    // A rich-text answer's text (rules, answers inside text): tags as spaces, entities decoded.
    private static string FgRichPlain(string? html) => System.Text.RegularExpressions.Regex.Replace(
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(
            System.Text.RegularExpressions.Regex.Replace(html ?? "", "<br>|</?(p|li|ul|ol)>", " "), "<[^>]*>", "")),
        @"\\s+", " ").Trim();

    [Microsoft.JSInterop.JSInvokable]
    public void FgRichChanged(string key, string html)
    {
        if (!fgRich.TryGetValue(key, out var entry)) return;
        entry.Set(html);
        fgRich[key] = (entry.Set, html);
        fgEdit.NotifyFieldChanged(FgField(key));
        StateHasChanged();
    }

    private async Task FgRichShowValues()
    {
        foreach (var key in fgRich.Keys.Where(key => !fgRichSeen.TryGetValue(key, out var seen) || seen != fgRenderGen).ToList()) { fgRich.Remove(key); fgRichSeen.Remove(key); }
        if (fgSelf is null) return;
        await FgJs.InvokeVoidAsync("fgRichSet", fgFormRoot, fgRich.ToDictionary(entry => entry.Key, entry => entry.Value.Value));
    }

    // Location fields: run by a script on the form's root (FgLocationScript),
    // which reports each change here; the model's values go back to the
    // fields after every render (a reset, saved answers, a field shown
    // again by a step or a condition).
    public sealed record FgLatLng(double Lat, double Lng);

    private readonly Dictionary<string, (Action<FgLatLng?> Set, FgLatLng? Value)> fgLoc = new();
    // The render that last showed each field; entries of elements no
    // longer rendered (removed items, fields hidden again) go after a render.
    private readonly Dictionary<string, int> fgLocSeen = new();

    private string FgLocKey(string key, Action<FgLatLng?> set, FgLatLng? value)
    {
        fgLoc[key] = (set, value);
        fgLocSeen[key] = fgRenderGen;
        return key;
    }

    private const string FgLocationScript = @"// Location fields: a map (Leaflet, OpenStreetMap tiles by default), the
// coordinate boxes, ""Use my location"" and Clear; the value is { lat, lng } or null.
var fgLeafletWaiting = null
function fgLoadLeaflet(done, fail) {
  var w = window
  if (w.L) { done(w.L); return }
  if (!fgLeafletWaiting) {
    fgLeafletWaiting = []
    if (!document.querySelector('link[data-fg-leaflet]')) {
      var css = document.createElement('link')
      css.rel = 'stylesheet'
      css.href = ""https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css""
      css.integrity = ""sha512-Zcn6bjR/8RZbLEpLIeOwNtzREBAJnUKESxces60Mpoj+2okopSAcSUIUOseddDm0cxnGQzxIR7vJgsLZbdLE3w==""
      css.crossOrigin = ''
      css.setAttribute('data-fg-leaflet', '')
      document.head.appendChild(css)
    }
    var script = document.createElement('script')
    script.src = ""https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js""
    script.integrity = ""sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg==""
    script.crossOrigin = ''
    var settle = function (ok) {
      var waiting = fgLeafletWaiting
      fgLeafletWaiting = null
      if (waiting) waiting.forEach(function (pair) { if (ok && w.L) pair[0](w.L); else pair[1]() })
    }
    script.onload = function () { settle(true) }
    script.onerror = function () { settle(false) }
    document.head.appendChild(script)
  }
  fgLeafletWaiting.push([done, fail])
}
// A valid point, rounded to 6 decimals (about 10 cm); null for anything else.
function fgLocValue(value) {
  if (!value || typeof value !== 'object') return null
  var given = value
  var lat = given.lat
  var lng = given.lng
  if (typeof lat !== 'number' || typeof lng !== 'number' || !isFinite(lat) || !isFinite(lng)) return null
  if (Math.abs(lat) > 90 || Math.abs(lng) > 180) return null
  return { lat: Math.round(lat * 1e6) / 1e6, lng: Math.round(lng * 1e6) / 1e6 }
}
function fgLocParse(lat, lng) {
  if (lat.trim() === '' || lng.trim() === '') return null
  return fgLocValue({ lat: Number(lat), lng: Number(lng) })
}
function fgLocSame(a, b) {
  return a === null ? b === null : b !== null && a.lat === b.lat && a.lng === b.lng
}
// The field's parts; the boxes and the status line are always in the markup.
function fgLocParts(group) {
  return {
    map: group.querySelector('[data-fg-loc-map]'),
    lat: group.querySelector('[data-fg-loc-lat]'),
    lng: group.querySelector('[data-fg-loc-lng]'),
    status: group.querySelector('[data-fg-loc-status]'),
  }
}
function fgLocTyped(group) {
  var parts = fgLocParts(group)
  return fgLocParse(parts.lat.value, parts.lng.value)
}
// The pin (and the view): 'pan' keeps the zoom, 'zoom' comes closer (with
// no point: back to the starting view, as after a reset).
function fgLocPin(group, point, move) {
  var state = group.fgLocMap
  if (!state || !state.map || !state.L) return
  if (!point) {
    if (state.marker) state.marker.remove()
    state.marker = null
    if (move === 'zoom' && state.start) state.map.setView([state.start[0], state.start[1]], state.start[2])
    return
  }
  var at = [point.lat, point.lng]
  if (state.marker) state.marker.setLatLng(at)
  else {
    // Not a tab stop: the coordinate boxes are the keyboard way.
    var marker = state.L.marker(at, { icon: state.icon, draggable: true, keyboard: false }).addTo(state.map)
    var pick = state.pick
    marker.on('dragend', function () { if (pick) pick(marker.getLatLng()) })
    state.marker = marker
  }
  if (move === 'zoom') state.map.setView(at, Math.max(state.map.getZoom(), 13))
  else if (move === 'pan') state.map.panTo(at)
}
// The boxes and the pin show the point; the status line clears.
function fgLocShow(group, point, move) {
  var parts = fgLocParts(group)
  parts.lat.value = point ? String(point.lat) : ''
  parts.lng.value = point ? String(point.lng) : ''
  if (parts.status) parts.status.textContent = ''
  fgLocPin(group, point, move)
}
function fgLocAttribution(text) {
  return text === ""© OpenStreetMap contributors""
    ? ""&copy; <a href=\\""https://www.openstreetmap.org/copyright\\"">OpenStreetMap</a> contributors""
    : text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}
function fgLocMap(group, onChange) {
  if (group.fgLocMap) return
  var state = { map: null, marker: null }
  group.fgLocMap = state
  fgLoadLeaflet(function (L) {
    var el = fgLocParts(group).map
    if (!el || !el.isConnected) return
    var given = (group.getAttribute('data-fg-loc-start') || '20,0,2').split(',').map(Number)
    var start = [Number(given[0]), Number(given[1]), Number(given[2])]
    state.L = L
    state.start = start
    var map = L.map(el, { center: [start[0], start[1]], zoom: start[2], scrollWheelZoom: false })
    state.map = map
    L.tileLayer(group.getAttribute('data-fg-loc-tiles') || '', { attribution: fgLocAttribution(group.getAttribute('data-fg-loc-attribution') || ''), maxZoom: 19 }).addTo(map)
    state.icon = L.divIcon({ className: 'fg-location-pin', html: ""<svg viewBox=\\""0 0 24 36\\"" width=\\""24\\"" height=\\""36\\"" aria-hidden=\\""true\\""><path d=\\""M12 1C6 1 1 6 1 12c0 8.3 11 23 11 23s11-14.7 11-23C23 6 18 1 12 1z\\"" fill=\\""#2563eb\\"" stroke=\\""#fff\\"" stroke-width=\\""2\\""/><circle cx=\\""12\\"" cy=\\""12\\"" r=\\""4\\"" fill=\\""#fff\\""/></svg>"", iconSize: [24, 36], iconAnchor: [12, 35] })
    var pick = function (at) {
      var point = fgLocValue({ lat: at.lat, lng: at.wrap().lng })
      if (!point) return
      fgLocShow(group, point, 'none')
      onChange(group, point, true)
    }
    state.pick = pick
    map.on('click', function (event) { pick(event.latlng) })
    if (window.ResizeObserver) {
      state.resizer = new ResizeObserver(function () { map.invalidateSize() })
      state.resizer.observe(el)
    }
    fgLocPin(group, fgLocTyped(group), 'zoom')
  }, function () {
    var status = fgLocParts(group).status
    if (status) status.textContent = ""The map didn't load. Type the coordinates instead.""
  })
}
function fgWireLocations(root, onChange) {
  if (!root || root.fgLocWired) return
  root.fgLocWired = true
  var start = function () {
    Array.prototype.forEach.call(root.querySelectorAll('[data-fg-loc]'), function (group) { fgLocMap(group, onChange) })
  }
  start()
  // Fields that appear later (new items, shown by a condition) get their
  // map; the maps of fields taken away (removed items, hidden again) go.
  if (window.MutationObserver) {
    new MutationObserver(function (records) {
      var added = false
      records.forEach(function (record) {
        Array.prototype.forEach.call(record.addedNodes, function (node) {
          var el = node
          if (el.nodeType === 1 && !el.closest('[data-fg-loc-map]') && (el.matches('[data-fg-loc]') || el.querySelector('[data-fg-loc]'))) added = true
        })
        Array.prototype.forEach.call(record.removedNodes, function (node) {
          var el = node
          if (el.nodeType !== 1 || el.closest('[data-fg-loc-map]')) return
          var groups = el.matches('[data-fg-loc]') ? [el] : el.querySelectorAll('[data-fg-loc]')
          Array.prototype.forEach.call(groups, function (group) {
            var state = group.fgLocMap
            if (!state || group.isConnected) return
            if (state.resizer) state.resizer.disconnect()
            if (state.map) state.map.remove()
            group.fgLocMap = null
          })
        })
      })
      if (added) start()
    }).observe(root, { childList: true, subtree: true })
  }
  var boxOf = function (event) {
    var target = event.target
    return target && target.matches && target.matches('[data-fg-loc-lat], [data-fg-loc-lng]') ? target.closest('[data-fg-loc]') : null
  }
  root.addEventListener('input', function (event) {
    var group = boxOf(event)
    if (!group) return
    var point = fgLocTyped(group)
    if (point) fgLocPin(group, point, 'pan')
    onChange(group, point, false)
  })
  root.addEventListener('focusout', function (event) {
    var group = boxOf(event)
    if (group) onChange(group, fgLocTyped(group), true)
  })
  root.addEventListener('click', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-loc-mine], [data-fg-loc-clear]')
    var group = button && button.closest('[data-fg-loc]')
    if (!button || !group) return
    if (button.hasAttribute('data-fg-loc-clear')) {
      fgLocShow(group, null, 'none')
      onChange(group, null, true)
      return
    }
    fgLocMine(group, fgLocParts(group).status, onChange)
  })
}
// ""Use my location"": the device's position into the field (or why not).
function fgLocMine(group, status, onChange) {
  if (!navigator.geolocation) {
    status.textContent = ""Your location isn't available. Place the pin on the map or type the coordinates.""
    return
  }
  status.textContent = ""Finding your location…""
  navigator.geolocation.getCurrentPosition(function (position) {
    var point = fgLocValue({ lat: position.coords.latitude, lng: position.coords.longitude })
    fgLocShow(group, point, 'zoom')
    onChange(group, point, true)
  }, function () {
    status.textContent = ""Your location isn't available. Place the pin on the map or type the coordinates.""
  }, { enableHighAccuracy: true, timeout: 15000 })
}
// The pins follow the boxes (plain HTML: a reset, saved answers put back);
// fields being typed in are left to their own input events.
function fgLocPins(root) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('[data-fg-loc]'), function (group) {
    var state = group.fgLocMap
    if (!state || !state.map || group.contains(document.activeElement)) return
    var at = state.marker ? state.marker.getLatLng() : null
    var point = fgLocTyped(group)
    if (!fgLocSame(point, at ? fgLocValue({ lat: at.lat, lng: at.lng }) : null)) fgLocPin(group, point, point ? 'pan' : 'zoom')
  })
}
// Values set elsewhere (a reset, saved answers) show in the boxes and on the map.
function fgLocSync(root, valueOf) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('[data-fg-loc]'), function (group) {
    var point = fgLocValue(valueOf(group))
    if (!fgLocSame(point, fgLocTyped(group))) fgLocShow(group, point, 'zoom')
  })
}
window.fgLocations = function (root, dotnet) {
  fgWireLocations(root, function (group, point, touch) {
    dotnet.invokeMethodAsync('FgLocated', group.getAttribute('data-fg-loc'), point ? point.lat : null, point ? point.lng : null, touch)
  })
}
window.fgLocSet = function (root, values) {
  fgLocSync(root, function (group) {
    var key = group.getAttribute('data-fg-loc')
    return Object.prototype.hasOwnProperty.call(values, key) ? values[key] : fgLocTyped(group)
  })
}";

    [Microsoft.JSInterop.JSInvokable]
    public void FgLocated(string key, double? lat, double? lng, bool touch)
    {
        if (!fgLoc.TryGetValue(key, out var entry)) return;
        var point = lat.HasValue && lng.HasValue ? new FgLatLng(lat.Value, lng.Value) : null;
        if (point == entry.Value && !touch) return;
        entry.Set(point);
        fgLoc[key] = (entry.Set, point);
        if (touch || point is not null) fgEdit.NotifyFieldChanged(FgField(key));
        StateHasChanged();
    }

    private async Task FgLocShowValues()
    {
        foreach (var key in fgLoc.Keys.Where(key => !fgLocSeen.TryGetValue(key, out var seen) || seen != fgRenderGen).ToList()) { fgLoc.Remove(key); fgLocSeen.Remove(key); }
        if (fgSelf is null) return;
        await FgJs.InvokeVoidAsync("fgLocSet", fgFormRoot, fgLoc.ToDictionary(entry => entry.Key, entry => entry.Value.Value is null ? null : (object)new { lat = entry.Value.Value.Lat, lng = entry.Value.Value.Lng }));
    }

    // Spam check (Cloudflare Turnstile): the widget is run by a script
    // (FgCaptchaScript) that reports each token here; the submit button
    // waits for one, and each submission sends it once.
    private ElementReference fgCaptchaEl;
    private string fgCaptchaToken = "";
    private bool fgCaptchaFailed;

    private const string FgCaptchaScript = @"// Spam check (Cloudflare Turnstile): onToken(token, failed) runs when the
// check passes, and with '' when it expires or fails.
var fgTurnstileWaiting = null
function fgCaptcha(el, siteKey, lang, onToken) {
  if (!el || el.fgCaptcha) return
  el.fgCaptcha = true
  var w = window
  var render = function () {
    var api = w.turnstile
    if (!el.isConnected || !api) return
    el.fgCaptchaId = api.render(el, {
      sitekey: siteKey,
      language: lang,
      callback: function (token) { onToken(token, false) },
      'expired-callback': function () { onToken('', false) },
      'error-callback': function () { onToken('', true) },
    })
  }
  if (w.turnstile) { render(); return }
  if (!fgTurnstileWaiting) {
    fgTurnstileWaiting = []
    var script = document.createElement('script')
    // Cloudflare changes this file in place: no integrity hash is possible.
    script.src = ""https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit""
    script.onload = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { if (w.turnstile) pair[0](); else pair[1]() })
    }
    script.onerror = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { pair[1]() })
    }
    document.head.appendChild(script)
  }
  fgTurnstileWaiting.push([render, function () { onToken('', true) }])
}
// A token works once: a new check for the next submission.
function fgCaptchaReset(el) {
  var w = window
  if (el && el.fgCaptchaId !== undefined && w.turnstile) w.turnstile.reset(el.fgCaptchaId)
}
window.fgCaptchaWire = function (el, dotnet) {
  fgCaptcha(el, ""1x00000000000000000000AA"", ""en"", function (token, failed) {
    dotnet.invokeMethodAsync('FgCaptchaToken', token, failed)
  })
}";

    [Microsoft.JSInterop.JSInvokable]
    public void FgCaptchaToken(string token, bool failed)
    {
        fgCaptchaToken = token;
        fgCaptchaFailed = failed;
        StateHasChanged();
    }

    private static bool FgIsBlank(object? value) => value switch
    {
        null => true,
        string text => string.IsNullOrWhiteSpace(text),
        bool on => !on,
        IDictionary<string, string?> answers => answers.Values.Any(string.IsNullOrEmpty),
        IDictionary<string, List<string>> answers => answers.Values.Any(list => list.Count == 0),
        FgDateRange range => string.IsNullOrWhiteSpace(range.From) || string.IsNullOrWhiteSpace(range.To),
        System.Collections.ICollection list => list.Count == 0,
        _ => false,
    };

    private static bool FgAccepts(FgUpload file, string accept)
    {
        var name = file.Name.ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        return accept.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).Any(t =>
            t.StartsWith('.') ? name.EndsWith(t) : t.EndsWith("/*") ? type.StartsWith(t[..^1]) : type == t);
    }

    private async Task HandleValidSubmit()
    {
        if (fgCaptchaToken == "")
        {
            await FgAnnounce("The form can be sent once the check above has passed.");
            return;
        }
        var parts = new List<(string Path, FgUpload File)>();
        var payload = BuildPayload(parts);
        payload["cf-turnstile-response"] = fgCaptchaToken;
        // A token works once: a new check for the next submission.
        fgCaptchaToken = "";
        await FgJs.InvokeVoidAsync("fgCaptchaReset", fgCaptchaEl);
        ResultJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await FgAnnounce("Form submitted.");
    }

    private Dictionary<string, object?> BuildPayload(List<(string Path, FgUpload File)> parts)
    {
        var payload = new Dictionary<string, object?>();
        payload["full_name"] = Model.FullName;
        payload["email"] = Model.Email;
        payload["website"] = Model.Website;
        payload["seats"] = Model.Seats;
        payload["seat_cost"] = Model.SeatCost;
        payload["satisfaction"] = Model.Satisfaction;
        payload["city"] = Model.City;
        payload["zip"] = Model.Zip;
        var dict0 = new Dictionary<string, object?>();
        dict0["username"] = Model.AccountUsername;
        dict0["password"] = Model.AccountPassword;
        dict0["bio"] = Model.AccountBio;
        dict0["birthday"] = Model.AccountBirthday;
        dict0["avatar"] = FgFilesPart(parts, "account.avatar", Model.AccountAvatar);
        payload["account"] = dict0;
        payload["plan"] = string.IsNullOrEmpty(Model.Plan) ? null : Model.Plan;
        payload["interests"] = Model.Interests;
        payload["channels"] = Model.Channels;
        payload["topics"] = Model.Topics;
        payload["billing"] = string.IsNullOrEmpty(Model.Billing) ? null : Model.Billing;
        payload["extras"] = Model.Extras;
        payload["notify"] = Model.Notify;
        payload["appointment"] = Model.Appointment;
        payload["brand_color"] = Model.BrandColor;
        payload["volume"] = Model.Volume;
        payload["budget"] = new Dictionary<string, object?> { ["from"] = Model.Budget.From, ["to"] = Model.Budget.To };
        payload["stay"] = new Dictionary<string, object?> { ["from"] = Model.Stay.From, ["to"] = Model.Stay.To };
        payload["days"] = Model.Days;
        payload["rating"] = Model.Rating;
        payload["usage"] = Model.Usage;
        payload["source"] = Model.Source;
        var list1 = new List<Dictionary<string, object?>>();
        for (var n1 = 0; n1 < Model.References.Count; n1++)
        {
            var item = Model.References[n1];
            var item1 = new Dictionary<string, object?>();
            item1["name"] = item.Name;
            item1["may_contact"] = item.MayContact;
            if ((Equals(item.MayContact, true))) item1["email"] = item.Email;
            if ((Equals(item.MayContact, true))) item1["phone"] = item.Phone;
            list1.Add(item1);
        }
        payload["references"] = list1;
        payload["attachments"] = FgFilesPart(parts, "attachments", Model.Attachments);
        if (((!FgIsBlank(Model.Attachments)))) payload["attachments_note"] = Model.AttachmentsNote;
        payload["about"] = Model.About;
        payload["meet"] = Model.Meet is null ? null : new Dictionary<string, object?> { ["lat"] = Model.Meet.Lat, ["lng"] = Model.Meet.Lng };
        payload["signature"] = FgFilesPart(parts, "signature", Model.Signature);
        payload["contact_method"] = string.IsNullOrEmpty(Model.ContactMethod) ? null : Model.ContactMethod;
        if (((Equals(Model.ContactMethod, "phone")))) payload["contact_phone"] = Model.ContactPhone;
        if (((Equals(Model.ContactMethod, "other")))) payload["contact_other"] = Model.ContactOther;
        payload["twitter"] = Model.Twitter;
        payload["github"] = Model.Github;
        payload["shipping_city"] = Model.ShippingCity;
        payload["order_notes"] = Model.OrderNotes;
        payload["newsletter"] = Model.Newsletter;
        payload["terms"] = Model.Terms;
        return payload;
    }

    public class KitchenSinkFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "This field is required")]
        [MinLength(2, ErrorMessage = "Must be at least 2")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Must be a valid email address")]
        public string Email { get; set; } = "";

        public string Website { get; set; } = "";

        public double? Seats { get; set; }

        public double? SeatCost { get; set; }

        public double Satisfaction { get; set; } = 5;

        public string City { get; set; } = "";

        [RegularExpression(@"^[0-9]{4,6}$", ErrorMessage = "Invalid format")]
        public string Zip { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [MinLength(3, ErrorMessage = "Must be between 3 and 20")]
        [MaxLength(20, ErrorMessage = "Must be between 3 and 20")]
        public string AccountUsername { get; set; } = "";

        public string AccountPassword { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Must be at most 200")]
        public string AccountBio { get; set; } = "";

        public string AccountBirthday { get; set; } = "";

        public List<FgUpload> AccountAvatar { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string Plan { get; set; } = "";

        public List<string> Interests { get; set; } = new();

        public string[] Channels { get; set; } = Array.Empty<string>();

        public List<string> Topics { get; set; } = new();

        public string Billing { get; set; } = "";

        public List<string> Extras { get; set; } = new();

        public bool Notify { get; set; } = true;

        public string Appointment { get; set; } = "";

        public string BrandColor { get; set; } = "#000000";

        public double Volume { get; set; } = 0;

        public FgRange Budget { get; set; } = new(200, 600);

        public FgDateRange Stay { get; set; } = new();

        public List<string> Days { get; set; } = new();

        public Dictionary<string, string?> Rating { get; set; } = new() { ["speed"] = null, ["quality"] = null };

        public Dictionary<string, List<string>> Usage { get; set; } = new() { ["forms"] = new(), ["reports"] = new() };

        public string Source { get; set; } = "kitchen-sink";

        public List<FgUpload> Attachments { get; set; } = new();

        public string AttachmentsNote { get; set; } = "";

        public string About { get; set; } = "";

        public FgLatLng? Meet { get; set; }

        public List<FgUpload> Signature { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string ContactMethod { get; set; } = "";

        public string ContactPhone { get; set; } = "";

        public string ContactOther { get; set; } = "";

        public string Twitter { get; set; } = "";

        public string Github { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ShippingCity { get; set; } = "";

        public string OrderNotes { get; set; } = "";

        public bool Newsletter { get; set; } = true;

        public bool Terms { get; set; }

        public List<FgReferencesItem> References { get; set; } = new() { new(), };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
        if (!(string.IsNullOrWhiteSpace(Website)) && (!Uri.TryCreate(Website, UriKind.Absolute, out _))) yield return new ValidationResult("Must be a valid URL", new[] { nameof(Website) });
        if (!(!Seats.HasValue) && (Seats!.Value < 1)) yield return new ValidationResult("Must be at least 1", new[] { nameof(Seats) });
        if (!(!Seats.HasValue) && (Seats!.Value > 50)) yield return new ValidationResult("Must be at most 50", new[] { nameof(Seats) });
        if (!(Topics.Count == 0) && (Topics.Count > 5)) yield return new ValidationResult("At most 5 topics", new[] { nameof(Topics) });
        if ((string.IsNullOrWhiteSpace(Stay.From) || string.IsNullOrWhiteSpace(Stay.To))) yield return new ValidationResult("This field is required", new[] { nameof(Stay) });
        if (!string.IsNullOrWhiteSpace(Stay.From) && !string.IsNullOrWhiteSpace(Stay.To) && string.CompareOrdinal(Stay.To, Stay.From) < 0) yield return new ValidationResult("The end date can’t be before the start date", new[] { nameof(Stay) });
        if (!(Days.Count == 0) && (Days.Count > 3)) yield return new ValidationResult("Must be at most 3", new[] { nameof(Days) });
        if (Rating.Values.Any(string.IsNullOrEmpty)) yield return new ValidationResult("This field is required", new[] { nameof(Rating) });
        if (Attachments.Count == 0) yield return new ValidationResult("This field is required", new[] { nameof(Attachments) });
        if (Attachments.Count > 3) yield return new ValidationResult("Choose at most 3 files", new[] { nameof(Attachments) });
        foreach (var file in Attachments)
        {
            if (!FgAccepts(file, ".pdf,.doc,.docx")) { yield return new ValidationResult("{name} is not an accepted file type".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
            if (file.Size > 5242880L) { yield return new ValidationResult("{name} is larger than 5 MB".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
        }
        if (!Terms) yield return new ValidationResult("This field is required", new[] { nameof(Terms) });
        }
    }

    public class FgReferencesItem
    {
        public string Name { get; set; } = "";
        public bool MayContact { get; set; }
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }
}
"
`;

exports[`blazor target > snapshot (tailwind) 1`] = `
"@* Generated by FormsGen (.NET 8). *@
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@inject Microsoft.AspNetCore.Components.NavigationManager FgNav
@inject Microsoft.JSInterop.IJSRuntime FgJs
@implements IDisposable

<EditForm EditContext="fgEdit" OnSubmit="FgSubmit" novalidate dir="ltr">
    <div class="bg-white p-4 font-sans text-gray-900 dark:bg-gray-900 dark:text-gray-100" @onpointerdown="FgPointerDown" @onpointerup="FgPointerEnd" @onpointerleave="FgPointerEnd" @onpointercancel="FgPointerEnd" @ref="fgFormRoot">
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-12 text-center">
          <h2 class="text-2xl font-semibold leading-tight text-indigo-600 dark:text-indigo-400">Kitchen Sink</h2>
        </div>
        <div class="col-span-12 md:col-span-12 text-center">
          <p class="text-base text-gray-600 dark:text-gray-300">Every implemented element appears in this form.</p>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="text-base text-gray-600 dark:text-gray-300 space-y-2">
            <p>Hi @(FgOr(FgAnswer(Model.FullName, ", "), "there"))! Fields marked * are <strong>required</strong>. See the <a class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs">docs</a>:</p>
            <ul class="list-disc ps-5">
              <li><em>one</em> answer per row in Rating</li>
              <li>several in Usage</li>
            </ul>
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_full_name">Full name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputText id="fg_full_name" @bind-Value="Model.FullName" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" placeholder="Jane Doe" />
            <ValidationMessage For="@(() => Model.FullName)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_email">Email<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputText id="fg_email" type="email" @bind-Value="Model.Email" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" placeholder="jane&#64;example.com" />
            <ValidationMessage For="@(() => Model.Email)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_website">Website</label>
            <InputText id="fg_website" type="url" @bind-Value="Model.Website" class="w-full rounded-md border border-gray-300 bg-white px-2 py-1 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
            <ValidationMessage For="@(() => Model.Website)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div class="fg-label-row"><label class="text-sm font-semibold" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
            <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
              <InputNumber id="fg_seats" @bind-Value="Model.Seats" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" aria-describedby="fg_seats-suffix" />
              <span id="fg_seats-suffix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">people</span>
            </div>
            <ValidationMessage For="@(() => Model.Seats)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_seat_cost">Seat cost</label>
            <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
              <span id="fg_seat_cost-prefix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">$</span>
              <input id="fg_seat_cost" type="text" readonly class="w-full cursor-default rounded-md border border-gray-300 bg-gray-50 px-3 py-1.5 text-base tabular-nums shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800/50" value="@FgFmt(Model.SeatCost, 2)" aria-describedby="fg_seat_cost-prefix" />
            </div>
            <ValidationMessage For="@(() => Model.SeatCost)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" @bind="Model.Satisfaction" @bind:event="oninput" class="h-6 w-full accent-indigo-600" min="0" max="10" step="1" />
            <ValidationMessage For="@(() => Model.Satisfaction)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <hr class="my-1 border-t border-indigo-500" />
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="grid grid-cols-12 gap-4">
            <div class="col-span-6 md:col-span-6 lg:col-span-4">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_city">City</label>
                <InputText id="fg_city" @bind-Value="Model.City" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                <ValidationMessage For="@(() => Model.City)" class="text-sm text-red-600" />
              </div>
            </div>
            <div class="col-span-6 md:col-span-6">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="sr-only" for="fg_zip">ZIP</label>
                <InputText id="fg_zip" @bind-Value="Model.Zip" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                <ValidationMessage For="@(() => Model.Zip)" class="text-sm text-red-600" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-12 md:col-span-12 account-box">
          <fieldset class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50">
            <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">Account</legend>
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label class="text-sm font-semibold" for="fg_account_username">Username<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                  <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
                    <span id="fg_account_username-prefix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">&#64;</span>
                    <InputText id="fg_account_username" @bind-Value="Model.AccountUsername" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" aria-describedby="fg_account_username-prefix" />
                  </div>
                  <ValidationMessage For="@(() => Model.AccountUsername)" class="text-sm text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label class="text-sm font-semibold" for="fg_account_password">Password</label>
                  <InputText id="fg_account_password" type="password" @bind-Value="Model.AccountPassword" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                  <ValidationMessage For="@(() => Model.AccountPassword)" class="text-sm text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label class="text-sm font-semibold" for="fg_account_bio">Bio</label>
                  <InputTextArea id="fg_account_bio" @bind-Value="Model.AccountBio" class="w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-xl leading-normal shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="4" />
                  <ValidationMessage For="@(() => Model.AccountBio)" class="text-sm text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label class="text-sm font-semibold" for="fg_account_birthday">Birthday</label>
                  <InputText id="fg_account_birthday" type="date" @bind-Value="Model.AccountBirthday" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                  <ValidationMessage For="@(() => Model.AccountBirthday)" class="text-sm text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label class="text-sm font-semibold" for="fg_account_avatar">Profile picture</label>
                  <div class="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400" data-fg-dragging='@(fgDragging["AccountAvatar"] ? "" : null)'>
                    <span class="font-medium">Choose a file or drag it here</span>
                    <InputFile @key='fgFileKeys["AccountAvatar"]' @ref='fgFileInputs["AccountAvatar"]' id="fg_account_avatar" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept="image/*" multiple OnChange='@(e => FgPickFiles(Model.AccountAvatar, e, false, 2097152L, true, "AccountAvatar"))' @ondragenter='() => fgDragging["AccountAvatar"] = true' @ondragleave='() => fgDragging["AccountAvatar"] = false' @ondrop='() => fgDragging["AccountAvatar"] = false' />
                  </div>
                  @if (Model.AccountAvatar.Count > 0)
                  {
                      <ul class="flex flex-col gap-1.5">
                          @foreach (var file in Model.AccountAvatar.ToList())
                          {
                              <li @key="file" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                                  @if (file.Thumb != null)
                                  {
                                      <img class="h-10 w-10 rounded object-cover" src="@file.Thumb" alt="" width="40" height="40" />
                                  }
                                  <span class="min-w-0 flex-1 truncate">@file.Name</span>
                                  <span class="text-sm text-gray-500 dark:text-gray-400">@FgFileSize(file.Size)</span>
                                  <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.AccountAvatar, file, "AccountAvatar")'>×</button>
                              </li>
                          }
                      </ul>
                  }
                  @if (fgFileNotes["AccountAvatar"] != "")
                {
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>@fgFileNotes["AccountAvatar"]</p>
                }
                  <ValidationMessage For="@(() => Model.AccountAvatar)" class="text-sm text-red-600" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5" aria-labelledby="fg_plan-legend">
            <legend class="text-sm font-semibold"><span id="fg_plan-legend">Plan</span><span class="ms-0.5 text-red-600" aria-hidden="true">*</span><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" class="fg-tip-text">You can switch plans at any time</span></span></legend>
            <InputRadioGroup Name="fg_plan" @bind-Value="Model.Plan">
              <div class="flex flex-col gap-1.5">
                <label class="inline-flex items-center gap-2 text-base" for="fg_plan-free">
                  <InputRadio id="fg_plan-free" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" Value="@("free")" />
                  <span>Free</span>
                </label>
                <label class="inline-flex items-center gap-2 text-base" for="fg_plan-pro">
                  <InputRadio id="fg_plan-pro" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" Value="@("pro")" />
                  <span>Pro</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Plan)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Interests</legend>
            <div class="flex flex-col gap-1.5">
              <label class="inline-flex items-center gap-2 text-base" for="fg_interests-news">
                <input id="fg_interests-news" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked='@Model.Interests.Contains("news")' @onchange='e => FgToggle(Model.Interests, "news", e)' />
                <span>News</span>
              </label>
              <label class="inline-flex items-center gap-2 text-base" for="fg_interests-product">
                <input id="fg_interests-product" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked='@Model.Interests.Contains("product")' @onchange='e => FgToggle(Model.Interests, "product", e)' />
                <span>Product updates</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Interests)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_channels">Notification channels</label>
            <InputSelect id="fg_channels" multiple @bind-Value="Model.Channels" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]">
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.Channels)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_topics">Topics</label>
            <div class="flex flex-wrap items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              @for (var fgTag = 0; fgTag < Model.Topics.Count; fgTag++)
              {
                  var fgIdx_Topics = fgTag;
                  <span class="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">@Model.Topics[fgIdx_Topics] <button type="button" class="text-gray-500 hover:text-red-600" aria-label="Remove @(Model.Topics[fgIdx_Topics])" @onclick='() => FgRemoveTag(Model.Topics, fgIdx_Topics, "Topics")'>&times;</button></span>
              }
              <input id="fg_topics" type="text" class="min-w-24 flex-1 border-none bg-transparent py-0 text-base focus:outline-none" placeholder="Type and press Enter" @bind='fgTagDrafts["Topics"]' @bind:after='() => FgAddTag(Model.Topics, "Topics")'>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">Free-text tags</p>
            <ValidationMessage For="@(() => Model.Topics)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Billing</legend>
            <InputRadioGroup Name="fg_billing" @bind-Value="Model.Billing">
              <div class="flex flex-wrap">
                <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing-monthly">
                  <InputRadio id="fg_billing-monthly" class="sr-only" Value="@("monthly")" />
                  <span>Monthly</span>
                </label>
                <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing-yearly">
                  <InputRadio id="fg_billing-yearly" class="sr-only" Value="@("yearly")" />
                  <span>Yearly</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Billing)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Extras</legend>
            <div class="flex flex-col gap-2">
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-base has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" for="fg_extras-support">
                <input id="fg_extras-support" type="checkbox" class="h-4 w-4 accent-indigo-600" checked='@Model.Extras.Contains("support")' @onchange='e => FgToggle(Model.Extras, "support", e)' />
                <span>Priority support</span>
              </label>
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-base has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" for="fg_extras-backup">
                <input id="fg_extras-backup" type="checkbox" class="h-4 w-4 accent-indigo-600" checked='@Model.Extras.Contains("backup")' @onchange='e => FgToggle(Model.Extras, "backup", e)' />
                <span>Daily backups</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Extras)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_notify" role="switch" @bind-Value="Model.Notify" class="relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-gray-300 transition-colors before:absolute before:start-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-white before:shadow before:transition-all before:content-[''] checked:bg-indigo-600 checked:before:start-[1.125rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300 dark:bg-gray-600" />
              <label class="text-base" for="fg_notify">Email notifications</label>
            </div>
            <ValidationMessage For="@(() => Model.Notify)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_appointment">Appointment</label>
            <InputText id="fg_appointment" type="datetime-local" @bind-Value="Model.Appointment" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
            <ValidationMessage For="@(() => Model.Appointment)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_brand_color">Brand color</label>
            <InputText id="fg_brand_color" type="color" @bind-Value="Model.BrandColor" class="h-[2.375rem] w-12 cursor-pointer rounded-md border border-gray-300 bg-white p-1.5 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
            <ValidationMessage For="@(() => Model.BrandColor)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_volume">Volume</label>
            <input id="fg_volume" type="range" @bind="Model.Volume" @bind:event="oninput" class="h-6 w-full accent-indigo-600" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" />
            <ValidationMessage For="@(() => Model.Volume)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_budget">Budget</label>
            <div class="fg-dual">
              <div class="fg-dual-track"><div class="fg-dual-fill" style="@FgDualFill(Model.Budget, 0, 1000)"></div></div>
              <input @key='$"From{Model.Budget.Version}"' @ref='fgDualRefs["fg_budget"]' id="fg_budget" type="range" min="0" max="1000" step="50" value="@FgNum(Model.Budget.ShownFrom)" aria-label="Budget: Minimum" style="z-index: @(FgDualFromOnTop(Model.Budget, 0, 1000) ? 3 : 1)" @oninput='e => FgDualSet(Model.Budget, true, e, "fg_budget")' />
              <input @key='$"To{Model.Budget.Version}"' @ref='fgDualRefs["fg_budget-to"]' id="fg_budget-to" type="range" min="0" max="1000" step="50" value="@FgNum(Model.Budget.ShownTo)" aria-label="Budget: Maximum" style="z-index: 2" @oninput='e => FgDualSet(Model.Budget, false, e, "fg_budget-to")' />
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">@FgNum(Model.Budget.From) – @FgNum(Model.Budget.To)</p>
            <ValidationMessage For="@(() => Model.Budget)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_stay">Stay<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
              <input id="fg_stay" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" aria-label="Stay: Start date" value="@Model.Stay.From" @onchange='e => FgSetDate(Model.Stay, true, e, "Stay")' />
              <span aria-hidden="true">–</span>
              <input id="fg_stay-to" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" min="@Model.Stay.From" aria-label="Stay: End date" value="@Model.Stay.To" @onchange='e => FgSetDate(Model.Stay, false, e, "Stay")' />
            </div>
            <ValidationMessage For="@(() => Model.Stay)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_days">Available days</label>
            <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
              <input id="fg_days" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" value='@fgDateDrafts["Days"]' @onchange='e => fgDateDrafts["Days"] = Convert.ToString(e.Value) ?? ""' />
              <button type="button" class="shrink-0 whitespace-nowrap rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @onclick='() => FgAddDate(Model.Days, "Days")'>Add date</button>
            </div>
            @if (Model.Days.Count > 0)
            {
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var date in Model.Days.ToList())
                    {
                        <span @key="date" class="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">@date <button type="button" class="text-gray-500 hover:text-red-600" aria-label='@FgRemoveDateLabel(date)' @onclick='() => FgRemoveDate(Model.Days, date, "Days")'>&times;</button></span>
                    }
                </div>
            }
            <ValidationMessage For="@(() => Model.Days)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">How did we do?<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></legend>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead><tr><td></td><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Poor</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">OK</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Great</th></tr></thead>
                <tbody>
                <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Speed</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="1" checked='@(Model.Rating["speed"] == "1")' aria-label="Speed: Poor" @onchange='() => FgSetCell(Model.Rating, "speed", "1", "Rating")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="2" checked='@(Model.Rating["speed"] == "2")' aria-label="Speed: OK" @onchange='() => FgSetCell(Model.Rating, "speed", "2", "Rating")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="3" checked='@(Model.Rating["speed"] == "3")' aria-label="Speed: Great" @onchange='() => FgSetCell(Model.Rating, "speed", "3", "Rating")' /></td></tr>
                <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Quality</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-0" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="1" checked='@(Model.Rating["quality"] == "1")' aria-label="Quality: Poor" @onchange='() => FgSetCell(Model.Rating, "quality", "1", "Rating")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="2" checked='@(Model.Rating["quality"] == "2")' aria-label="Quality: OK" @onchange='() => FgSetCell(Model.Rating, "quality", "2", "Rating")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="3" checked='@(Model.Rating["quality"] == "3")' aria-label="Quality: Great" @onchange='() => FgSetCell(Model.Rating, "quality", "3", "Rating")' /></td></tr>
                </tbody>
              </table>
            </div>
            <ValidationMessage For="@(() => Model.Rating)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Where do you use each feature?</legend>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead><tr><td></td><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Web</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Mobile</th></tr></thead>
                <tbody>
                <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Forms</th><td class="px-2 py-2 text-center leading-5"><input id="fg_usage" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="web" checked='@(Model.Usage["forms"].Contains("web"))' aria-label="Forms: Web" @onchange='() => FgToggleCell(Model.Usage, "forms", "web", new[] { "web", "mobile" }, "Usage")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-0-1" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="mobile" checked='@(Model.Usage["forms"].Contains("mobile"))' aria-label="Forms: Mobile" @onchange='() => FgToggleCell(Model.Usage, "forms", "mobile", new[] { "web", "mobile" }, "Usage")' /></td></tr>
                <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Reports</th><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-1-0" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="web" checked='@(Model.Usage["reports"].Contains("web"))' aria-label="Reports: Web" @onchange='() => FgToggleCell(Model.Usage, "reports", "web", new[] { "web", "mobile" }, "Usage")' /></td><td class="px-2 py-2 text-center leading-5"><input id="fg_usage-1-1" type="checkbox" class="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="mobile" checked='@(Model.Usage["reports"].Contains("mobile"))' aria-label="Reports: Mobile" @onchange='() => FgToggleCell(Model.Usage, "reports", "mobile", new[] { "web", "mobile" }, "Usage")' /></td></tr>
                </tbody>
              </table>
            </div>
            <ValidationMessage For="@(() => Model.Usage)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50" data-fg-repeater="references">
            <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">References</legend>
            <div class="flex flex-col gap-4" data-fg-list='@FgListId(Model.References, "references")'>
              @foreach (var (item, i) in Model.References.Select((x, n) => (x, n)).ToList())
              {
                  <fieldset @key="item" class="min-w-0 rounded-md border border-gray-300 p-4 dark:border-gray-600 data-[fg-drag]:opacity-50 data-[fg-drop=before]:shadow-[0_-3px_0_0_#4f46e5] data-[fg-drop=after]:shadow-[0_3px_0_0_#4f46e5]" data-fg-item tabindex="-1" @ref="fgItemRefs[item]">
                      <legend class="px-1 text-sm font-semibold">@FgItemLabel("references", i)</legend>
                      <div class="grid grid-cols-12 gap-4">
                        <div class="col-span-12 md:col-span-12">
                          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                            <label class="text-sm font-semibold" for="@($"fg_references_{i}_name")">Name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                            <InputText id="@($"fg_references_{i}_name")" @bind-Value="item.Name" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                            <ValidationMessage For="@(() => item.Name)" class="text-sm text-red-600" />
                          </div>
                        </div>
                        <div class="col-span-12 md:col-span-12">
                          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                            <div class="flex items-center gap-2">
                              <InputCheckbox id="@($"fg_references_{i}_may_contact")" @bind-Value="item.MayContact" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
                              <label class="text-base" for="@($"fg_references_{i}_may_contact")">May we contact them?</label>
                            </div>
                            <ValidationMessage For="@(() => item.MayContact)" class="text-sm text-red-600" />
                          </div>
                        </div>
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-span-12 md:col-span-12">
                              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                                <label class="text-sm font-semibold" for="@($"fg_references_{i}_email")">Their email</label>
                                <InputText id="@($"fg_references_{i}_email")" type="email" @bind-Value="item.Email" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                                <ValidationMessage For="@(() => item.Email)" class="text-sm text-red-600" />
                              </div>
                            </div>
                        }
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-span-12 md:col-span-12">
                              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                                <label class="text-sm font-semibold" for="@($"fg_references_{i}_phone")">Their phone</label>
                                <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
                                  <select class="w-auto min-w-0 max-w-[45%] shrink rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" aria-label="Country code" value='@FgPhoneCountryOf(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone)' @onchange='e => { item.Phone = FgPhoneSetCountry(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone, e); FgChanged(FgItemKey(item, "ReferencesIPhone", "Phone")); }'>
                                    <option value="AF">Afghanistan (+93)</option>
                                    <option value="AX">Åland Islands (+358)</option>
                                    <option value="AL">Albania (+355)</option>
                                    <option value="DZ">Algeria (+213)</option>
                                    <option value="AS">American Samoa (+1)</option>
                                    <option value="AD">Andorra (+376)</option>
                                    <option value="AO">Angola (+244)</option>
                                    <option value="AI">Anguilla (+1)</option>
                                    <option value="AG">Antigua &amp; Barbuda (+1)</option>
                                    <option value="AR">Argentina (+54)</option>
                                    <option value="AM">Armenia (+374)</option>
                                    <option value="AW">Aruba (+297)</option>
                                    <option value="AU">Australia (+61)</option>
                                    <option value="AT">Austria (+43)</option>
                                    <option value="AZ">Azerbaijan (+994)</option>
                                    <option value="BS">Bahamas (+1)</option>
                                    <option value="BH">Bahrain (+973)</option>
                                    <option value="BD">Bangladesh (+880)</option>
                                    <option value="BB">Barbados (+1)</option>
                                    <option value="BY">Belarus (+375)</option>
                                    <option value="BE">Belgium (+32)</option>
                                    <option value="BZ">Belize (+501)</option>
                                    <option value="BJ">Benin (+229)</option>
                                    <option value="BM">Bermuda (+1)</option>
                                    <option value="BT">Bhutan (+975)</option>
                                    <option value="BO">Bolivia (+591)</option>
                                    <option value="BA">Bosnia &amp; Herzegovina (+387)</option>
                                    <option value="BW">Botswana (+267)</option>
                                    <option value="BR">Brazil (+55)</option>
                                    <option value="IO">British Indian Ocean Territory (+246)</option>
                                    <option value="VG">British Virgin Islands (+1)</option>
                                    <option value="BN">Brunei (+673)</option>
