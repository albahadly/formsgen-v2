                <div class="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
                  <span class="font-medium">Choose a file or drag it here</span>
                  <input id="fg_account_avatar" type="file" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept="image/*" :aria-invalid="errors['account.avatar'] ? 'true' : undefined" @change="fgPickFiles('account.avatar', $event)" @dragenter="fgDrag($event.currentTarget, true)" @dragleave="fgDrag($event.currentTarget, false)" @drop="fgDropFiles('account.avatar', $event)">
                </div>
                <ul v-if="form.account.avatar.length" class="flex flex-col gap-1.5">
                  <li v-for="(file, fi) in form.account.avatar" :key="fi" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                    <img v-if="file.type.startsWith('image/')" class="h-10 w-10 rounded object-cover" :src="fgThumb(file)" alt="" width="40" height="40">
                    <span class="min-w-0 flex-1 truncate">{{ file.name }}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400">{{ fgFileSize(file.size) }}</span>
                    <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" :aria-label="fgRemoveFileLabel(file.name)" @click="fgRemoveFile('account.avatar', fi)">×</button>
                  </li>
                </ul>
                <p v-if="fgFileNotes['account.avatar']" class="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>{{ fgFileNotes['account.avatar'] }}</p>
