                  </li>
                ))}
              </ul>
            )}
            <p className="form-text mt-0">Up to 3 PDF or Word files, 5 MB each</p>
            {errors['attachments'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['attachments']}</p>}
          </div>
