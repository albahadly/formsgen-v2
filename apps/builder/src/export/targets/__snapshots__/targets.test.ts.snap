                      <input :id="'fg_references_' + i + '_phone'" type="tel" class="fg-input" :class="{ 'fg-invalid': !!errors[('references.' + i + '.phone')] }" autocomplete="tel-national" :value="fgPhoneNumber(item.phone, fgPhoneCountryOf(('references.' + i + '.phone')))" @input="fgPhoneInput(('references.' + i + '.phone'), $event)" @blur="touch(('references.' + i + '.phone'))">
