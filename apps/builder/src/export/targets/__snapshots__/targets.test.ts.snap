        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_volume">Volume</label>
          <input id="fg_volume" v-model.number="form.volume" type="range" class="h-6 w-full accent-indigo-600" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" @change="touch('volume')">
          <p class="text-sm text-gray-500 dark:text-gray-400">{{ form.volume }}</p>
          <p v-if="errors['volume']" class="text-sm text-red-600" role="alert">{{ errors['volume'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_budget">Budget</label>
          <div class="fg-dual">
            <div class="fg-dual-track"><div class="fg-dual-fill" :style="fgDualFill(form.budget, 0, 1000)"></div></div>
            <input id="fg_budget" type="range" min="0" max="1000" step="50" :value="form.budget.from" aria-label="Budget: Minimum" :style="{ zIndex: fgDualFromOnTop(form.budget, 0, 1000) ? 3 : 1 }" @input="fgDualSet(form.budget, 'from', $event)" @change="touch('budget')">
            <input id="fg_budget-to" type="range" min="0" max="1000" step="50" :value="form.budget.to" aria-label="Budget: Maximum" :style="{ zIndex: 2 }" @input="fgDualSet(form.budget, 'to', $event)" @change="touch('budget')">
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400">{{ form.budget.from }} – {{ form.budget.to }}</p>
          <p v-if="errors['budget']" class="text-sm text-red-600" role="alert">{{ errors['budget'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_stay">Stay<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
            <input id="fg_stay" v-model="form.stay.from" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" :class="{ 'border-red-500 focus:ring-red-200': !!errors['stay'] }" aria-label="Stay: Start date" @blur="touch('stay')" @change="revalidate('stay')">
            <span aria-hidden="true">–</span>
            <input id="fg_stay-to" v-model="form.stay.to" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" :class="{ 'border-red-500 focus:ring-red-200': !!errors['stay'] }" :min="form.stay.from || undefined" aria-label="Stay: End date" @blur="touch('stay')" @change="revalidate('stay')">
          </div>
          <p v-if="errors['stay']" class="text-sm text-red-600" role="alert">{{ errors['stay'] }}</p>
        </div>
