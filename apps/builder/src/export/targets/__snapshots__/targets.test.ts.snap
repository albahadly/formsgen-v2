function fgLocParts(group: HTMLElement) {
  return {
    map: group.querySelector<HTMLElement>('[data-fg-loc-map]'),
    lat: group.querySelector<HTMLInputElement>('[data-fg-loc-lat]')!,
    lng: group.querySelector<HTMLInputElement>('[data-fg-loc-lng]')!,
    status: group.querySelector<HTMLElement>('[data-fg-loc-status]')!,
  }
}
function fgLocTyped(group: HTMLElement) {
  var parts = fgLocParts(group)
  return fgLocParse(parts.lat.value, parts.lng.value)
}
// The pin (and the view): 'pan' keeps the zoom, 'zoom' comes closer (with
// no point: back to the starting view, as after a reset).
function fgLocPin(group: FgLocGroup, point: FgLatLng | null, move: string) {
  var state = group.fgLocMap
  if (!state || !state.map || !state.L) return
  if (!point) {
    if (state.marker) state.marker.remove()
    state.marker = null
    if (move === 'zoom' && state.start) state.map.setView([state.start[0], state.start[1]], state.start[2])
    return
  }
  var at: [number, number] = [point.lat, point.lng]
  if (state.marker) state.marker.setLatLng(at)
  else {
    // Not a tab stop: the coordinate boxes are the keyboard way.
    var marker = state.L.marker(at, { icon: state.icon, draggable: true, keyboard: false }).addTo(state.map)
    var pick = state.pick
    marker.on('dragend', function () { if (pick) pick(marker.getLatLng()) })
    state.marker = marker
  }
  if (move === 'zoom') state.map.setView(at, Math.max(state.map.getZoom(), 13))
  else if (move === 'pan') state.map.panTo(at)
}
// The boxes and the pin show the point; the status line clears.
function fgLocShow(group: FgLocGroup, point: FgLatLng | null, move: string) {
  var parts = fgLocParts(group)
  parts.lat.value = point ? String(point.lat) : ''
  parts.lng.value = point ? String(point.lng) : ''
  if (parts.status) parts.status.textContent = ''
  fgLocPin(group, point, move)
}
function fgLocAttribution(text: string): string {
  return text === "© OpenStreetMap contributors"
    ? "&copy; <a href=\\"https://www.openstreetmap.org/copyright\\">OpenStreetMap</a> contributors"
    : text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}
function fgLocMap(group: FgLocGroup, onChange: (group: HTMLElement, point: FgLatLng | null, touch: boolean) => void) {
  if (group.fgLocMap) return
  var state: FgLocState = { map: null, marker: null }
  group.fgLocMap = state
  fgLoadLeaflet(function (L: FgLeaflet) {
    var el = fgLocParts(group).map
    if (!el || !el.isConnected) return
    var given = (group.getAttribute('data-fg-loc-start') || '20,0,2').split(',').map(Number)
    var start: [number, number, number] = [Number(given[0]), Number(given[1]), Number(given[2])]
    state.L = L
    state.start = start
    var map = L.map(el, { center: [start[0], start[1]], zoom: start[2], scrollWheelZoom: false })
    state.map = map
    L.tileLayer(group.getAttribute('data-fg-loc-tiles') || '', { attribution: fgLocAttribution(group.getAttribute('data-fg-loc-attribution') || ''), maxZoom: 19 }).addTo(map)
    state.icon = L.divIcon({ className: 'fg-location-pin', html: "<svg viewBox=\\"0 0 24 36\\" width=\\"24\\" height=\\"36\\" aria-hidden=\\"true\\"><path d=\\"M12 1C6 1 1 6 1 12c0 8.3 11 23 11 23s11-14.7 11-23C23 6 18 1 12 1z\\" fill=\\"#2563eb\\" stroke=\\"#fff\\" stroke-width=\\"2\\"/><circle cx=\\"12\\" cy=\\"12\\" r=\\"4\\" fill=\\"#fff\\"/></svg>", iconSize: [24, 36], iconAnchor: [12, 35] })
    var pick = function (at: FgLeafletPoint) {
      var point = fgLocValue({ lat: at.lat, lng: at.wrap().lng })
      if (!point) return
      fgLocShow(group, point, 'none')
      onChange(group, point, true)
    }
    state.pick = pick
    map.on('click', function (event) { pick(event.latlng) })
    if (window.ResizeObserver) {
      state.resizer = new ResizeObserver(function () { map.invalidateSize() })
      state.resizer.observe(el)
    }
    fgLocPin(group, fgLocTyped(group), 'zoom')
  }, function () {
    var status = fgLocParts(group).status
    if (status) status.textContent = "The map didn't load. Type the coordinates instead."
  })
}
function fgWireLocations(root: FgLocRoot | null, onChange: (group: HTMLElement, point: FgLatLng | null, touch: boolean) => void) {
  if (!root || root.fgLocWired) return
  root.fgLocWired = true
  var start = function () {
    Array.prototype.forEach.call(root.querySelectorAll<FgLocGroup>('[data-fg-loc]'), function (group: FgLocGroup) { fgLocMap(group, onChange) })
  }
  start()
  // Fields that appear later (new items, shown by a condition) get their
  // map; the maps of fields taken away (removed items, hidden again) go.
  if (window.MutationObserver) {
    new MutationObserver(function (records) {
      var added = false
      records.forEach(function (record) {
        Array.prototype.forEach.call(record.addedNodes, function (node: Node) {
          var el = (node as Element)
          if (el.nodeType === 1 && !el.closest('[data-fg-loc-map]') && (el.matches('[data-fg-loc]') || el.querySelector('[data-fg-loc]'))) added = true
        })
        Array.prototype.forEach.call(record.removedNodes, function (node: Node) {
          var el = (node as Element)
          if (el.nodeType !== 1 || el.closest('[data-fg-loc-map]')) return
          var groups = el.matches('[data-fg-loc]') ? [el] : el.querySelectorAll('[data-fg-loc]')
          Array.prototype.forEach.call(groups, function (group: FgLocGroup) {
            var state = group.fgLocMap
            if (!state || group.isConnected) return
            if (state.resizer) state.resizer.disconnect()
            if (state.map) state.map.remove()
            group.fgLocMap = null
          })
        })
      })
      if (added) start()
    }).observe(root, { childList: true, subtree: true })
  }
  var boxOf = function (event: Event): FgLocGroup | null {
    var target = event.target as Element | null
    return target && target.matches && target.matches('[data-fg-loc-lat], [data-fg-loc-lng]') ? target.closest<FgLocGroup>('[data-fg-loc]') : null
  }
  root.addEventListener('input', function (event: Event) {
    var group = boxOf(event)
    if (!group) return
    var point = fgLocTyped(group)
    if (point) fgLocPin(group, point, 'pan')
    onChange(group, point, false)
  })
  root.addEventListener('focusout', function (event: FocusEvent) {
    var group = boxOf(event)
    if (group) onChange(group, fgLocTyped(group), true)
  })
  root.addEventListener('click', function (event: MouseEvent) {
    var target = event.target as Element | null
    var button = target && target.closest && target.closest('[data-fg-loc-mine], [data-fg-loc-clear]')
    var group = button && button.closest<FgLocGroup>('[data-fg-loc]')
    if (!button || !group) return
    if (button.hasAttribute('data-fg-loc-clear')) {
      fgLocShow(group, null, 'none')
      onChange(group, null, true)
      return
    }
    fgLocMine(group, fgLocParts(group).status, onChange)
  })
}
// "Use my location": the device's position into the field (or why not).
function fgLocMine(group: FgLocGroup, status: HTMLElement, onChange: (group: HTMLElement, point: FgLatLng | null, touch: boolean) => void) {
  if (!navigator.geolocation) {
    status.textContent = "Your location isn't available. Place the pin on the map or type the coordinates."
    return
  }
  status.textContent = "Finding your location…"
  navigator.geolocation.getCurrentPosition(function (position) {
    var point = fgLocValue({ lat: position.coords.latitude, lng: position.coords.longitude })
    fgLocShow(group, point, 'zoom')
    onChange(group, point, true)
  }, function () {
    status.textContent = "Your location isn't available. Place the pin on the map or type the coordinates."
  }, { enableHighAccuracy: true, timeout: 15000 })
}
// Values set elsewhere (a reset, saved answers) show in the boxes and on the map.
function fgLocSync(root: HTMLElement | null, valueOf: (group: HTMLElement) => unknown) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll<FgLocGroup>('[data-fg-loc]'), function (group: FgLocGroup) {
    var point = fgLocValue(valueOf(group))
    if (!fgLocSame(point, fgLocTyped(group))) fgLocShow(group, point, 'zoom')
  })
}
onMounted(() => {
  fgWireLocations(fgRoot.value, (group, point, touched) => {
    const path = group.getAttribute('data-fg-loc')!
    fgSet(path, point)
    if (touched) touch(path)
    else revalidate(path)
  })
  fgLocSync(fgRoot.value, (group) => fgGet(group.getAttribute('data-fg-loc')!))
})
watch(form, () => {
  void nextTick(() => fgLocSync(fgRoot.value, (group) => fgGet(group.getAttribute('data-fg-loc')!)))
}, { deep: true })
// Spam check (Cloudflare Turnstile): onToken(token, failed) runs when the
// check passes, and with '' when it expires or fails.
interface FgTurnstile {
  render(el: HTMLElement, options: Record<string, unknown>): string
  reset(widget?: string): void
  remove(widget: string): void
}
type FgTurnstileWindow = Window & { turnstile?: FgTurnstile }
type FgCaptchaEl = HTMLElement & { fgCaptcha?: boolean; fgCaptchaId?: string }
var fgTurnstileWaiting: [() => void, () => void][] | null = null
function fgCaptcha(el: FgCaptchaEl | null, siteKey: string, lang: string, onToken: (token: string, failed: boolean) => void) {
  if (!el || el.fgCaptcha) return
  el.fgCaptcha = true
  var w = window as FgTurnstileWindow
  var render = function () {
    var api = w.turnstile
    if (!el.isConnected || !api) return
    el.fgCaptchaId = api.render(el, {
      sitekey: siteKey,
      language: lang,
      callback: function (token: string) { onToken(token, false) },
      'expired-callback': function () { onToken('', false) },
      'error-callback': function () { onToken('', true) },
    })
  }
  if (w.turnstile) { render(); return }
  if (!fgTurnstileWaiting) {
    fgTurnstileWaiting = []
    var script = document.createElement('script')
    // Cloudflare changes this file in place: no integrity hash is possible.
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    script.onload = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { if (w.turnstile) pair[0](); else pair[1]() })
    }
    script.onerror = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { pair[1]() })
    }
    document.head.appendChild(script)
  }
  fgTurnstileWaiting.push([render, function () { onToken('', true) }])
}
// A token works once: a new check for the next submission.
function fgCaptchaReset(el: FgCaptchaEl | null) {
  var w = window as FgTurnstileWindow
  if (el && el.fgCaptchaId !== undefined && w.turnstile) w.turnstile.reset(el.fgCaptchaId)
}
const fgCaptchaEl = ref<HTMLElement | null>(null)
const fgCaptchaToken = ref('')
const fgCaptchaFailed = ref(false)
onMounted(() => {
  fgCaptcha(fgCaptchaEl.value, "1x00000000000000000000AA", "en", (token, failed) => {
    fgCaptchaToken.value = token
    fgCaptchaFailed.value = failed
  })
})

function fgVisible_attachments_note() {
  return ((!fgIsBlank(form.attachments)))
}
function fgVisible_contact_phone() {
  return ((form.contact_method === "phone"))
}
function fgVisible_contact_other() {
  return ((form.contact_method === "other"))
}

const validators: Record<string, () => string | null> = {
  'full_name': function () {
  const v = form.full_name
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function () {
  const v = form.email
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function () {
  const v = form.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function () {
  const v = form.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function () {
  const v = form.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function () {
  const v = form.account.username
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function () {
  const v = form.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'account.avatar': function () {
  const v = form.account.avatar
  { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
  return null
  },
  'plan': function () {
  const v = form.plan
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'topics': function () {
  const v = form.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'stay': function () {
  const v = form.stay
  if (fgIsBlank(v)) return "This field is required"
  { const problem = (fgDateOrder(v) ? "The end date can’t be before the start date" : null); if (problem) return problem }
  return null
  },
  'days': function () {
  const v = form.days
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 3)) return "Must be at most 3"
  return null
  },
  'rating': function () {
  const v = form.rating
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'attachments': function () {
  const v = form.attachments
  if (fgIsBlank(v)) return "This field is required"
  { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
  return null
  },
  'signature': function () {
  const v = form.signature
  { const problem = fgFileProblem(v, "", 0, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 0 MB"}); if (problem) return problem }
  return null
  },
  'contact_method': function () {
  const v = form.contact_method
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'shipping_city': function () {
  const v = form.shipping_city
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'terms': function () {
  const v = form.terms
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
}

function runValidator(path: string): void {
  const validate = validators[path] ?? fgItemValidator(path)
  if (!validate) return
  const message = validate()
  if (message) errors[path] = message
  else delete errors[path]
}

// A blur error appearing while a pointer is held reflows the form and the
// release misses its target; defer blur validation until the press ends.
let fgPressing = false
const fgDeferred = new Set<string>()
function fgFlushDeferred(): void {
  const paths = [...fgDeferred]
  fgDeferred.clear()
  for (const path of paths) touch(path)
}
function fgPointerDown(): void {
  fgFlushDeferred()
  fgPressing = true
}
function fgPointerEnd(): void {
  if (!fgPressing) return
  fgPressing = false
  setTimeout(fgFlushDeferred, 0)
}
onMounted(() => {
  window.addEventListener('pointerup', fgPointerEnd)
  window.addEventListener('pointercancel', fgPointerEnd)
})
onBeforeUnmount(() => {
  window.removeEventListener('pointerup', fgPointerEnd)
  window.removeEventListener('pointercancel', fgPointerEnd)
})

function touch(path: string): void {
  if (fgPressing) {
    fgDeferred.add(path)
    return
  }
  touched.add(path)
  runValidator(path)
}

function revalidate(path: string): void {
  if (touched.has(path)) runValidator(path)
}

function validateAll(): boolean {
  let ok = true
  for (const path of [...Object.keys(validators), ...["references"].flatMap(fgItemPaths)]) {
    touched.add(path)
    runValidator(path)
    if (errors[path]) ok = false
  }
  return ok
}

const fgSec_ks_social_tabs = ref(0)
const fgSec_ks_wizard = ref(0)

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]

const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]
function fgGo_ks_wizard(index: number): void {
  fgSec_ks_wizard.value = index
  fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
}
function fgNext_ks_wizard(): void {
  let ok = true
  for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard.value] ?? []) {
    touch(path)
    if (errors[path]) ok = false
  }
  if (ok && fgSec_ks_wizard.value < 1) fgGo_ks_wizard(fgSec_ks_wizard.value + 1)
}

function fgJumpToError(): void {
  if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs.value] ?? []).some((p) => errors[p])) {
    const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => errors[p]))
    if (target !== -1) fgSec_ks_social_tabs.value = target
  }
  if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard.value] ?? []).some((p) => errors[p])) {
    const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => errors[p]))
    if (target !== -1) fgSec_ks_wizard.value = target
  }
}

const tagDrafts = reactive<Record<string, string>>({})
function fgAddTag(path: string): void {
  const draft = (tagDrafts[path] ?? '').trim()
  const tags = fgGet(path) as string[]
  if (draft !== '' && !tags.includes(draft)) fgSet(path, [...tags, draft])
  tagDrafts[path] = ''
  revalidate(path)
}
function fgRemoveTag(path: string, index: number): void {
  fgSet(path, (fgGet(path) as string[]).filter((_, i) => i !== index))
  revalidate(path)
}

type FgRangeValue = { from: number; to: number }
function fgDualClamp(v: FgRangeValue, side: 'from' | 'to', n: number): FgRangeValue {
  return side === 'from' ? { from: Math.min(n, v.to), to: v.to } : { from: v.from, to: Math.max(n, v.from) }
}
function fgDualFill(v: FgRangeValue, min: number, max: number): { insetInlineStart: string; insetInlineEnd: string } {
  const pct = (n: number): number => (max > min ? ((n - min) / (max - min)) * 100 : 0)
  return { insetInlineStart: pct(v.from) + '%', insetInlineEnd: 100 - pct(v.to) + '%' }
}
// With both handles together, the one that can still move is on top.
function fgDualFromOnTop(v: FgRangeValue, min: number, max: number): boolean {
  return v.from === v.to && v.from > (min + max) / 2
}
function fgDualSet(v: FgRangeValue, side: 'from' | 'to', event: Event): void {
  const input = event.target as HTMLInputElement
  const next = fgDualClamp(v, side, Number(input.value))
  v.from = next.from
  v.to = next.to
  input.value = String(next[side])
}
function fgWithDate(list: string[], date: string): string[] {
  return /^\\d{4}-\\d{2}-\\d{2}$/.test(date) && !list.includes(date) ? [...list, date].sort() : list
}
const fgDateDrafts = reactive<Record<string, string>>({})
function fgAddDate(path: string): void {
  fgSet(path, fgWithDate(fgGet(path) as string[], fgDateDrafts[path] ?? ''))
  fgDateDrafts[path] = ''
  touch(path)
}
function fgRemoveDate(path: string, index: number): void {
  fgSet(path, (fgGet(path) as string[]).filter((_, i) => i !== index))
  touch(path)
}
const FG_DIAL: Record<string, string> = {"AD":"376","AE":"971","AF":"93","AG":"1","AI":"1","AL":"355","AM":"374","AO":"244","AR":"54","AS":"1","AT":"43","AU":"61","AW":"297","AX":"358","AZ":"994","BA":"387","BB":"1","BD":"880","BE":"32","BF":"226","BG":"359","BH":"973","BI":"257","BJ":"229","BL":"590","BM":"1","BN":"673","BO":"591","BQ":"599","BR":"55","BS":"1","BT":"975","BW":"267","BY":"375","BZ":"501","CA":"1","CC":"61","CD":"243","CF":"236","CG":"242","CH":"41","CI":"225","CK":"682","CL":"56","CM":"237","CN":"86","CO":"57","CR":"506","CU":"53","CV":"238","CW":"599","CX":"61","CY":"357","CZ":"420","DE":"49","DJ":"253","DK":"45","DM":"1","DO":"1","DZ":"213","EC":"593","EE":"372","EG":"20","EH":"212","ER":"291","ES":"34","ET":"251","FI":"358","FJ":"679","FK":"500","FM":"691","FO":"298","FR":"33","GA":"241","GB":"44","GD":"1","GE":"995","GF":"594","GG":"44","GH":"233","GI":"350","GL":"299","GM":"220","GN":"224","GP":"590","GQ":"240","GR":"30","GT":"502","GU":"1","GW":"245","GY":"592","HK":"852","HN":"504","HR":"385","HT":"509","HU":"36","ID":"62","IE":"353","IL":"972","IM":"44","IN":"91","IO":"246","IQ":"964","IR":"98","IS":"354","IT":"39","JE":"44","JM":"1","JO":"962","JP":"81","KE":"254","KG":"996","KH":"855","KI":"686","KM":"269","KN":"1","KP":"850","KR":"82","KW":"965","KY":"1","KZ":"7","LA":"856","LB":"961","LC":"1","LI":"423","LK":"94","LR":"231","LS":"266","LT":"370","LU":"352","LV":"371","LY":"218","MA":"212","MC":"377","MD":"373","ME":"382","MF":"590","MG":"261","MH":"692","MK":"389","ML":"223","MM":"95","MN":"976","MO":"853","MP":"1","MQ":"596","MR":"222","MS":"1","MT":"356","MU":"230","MV":"960","MW":"265","MX":"52","MY":"60","MZ":"258","NA":"264","NC":"687","NE":"227","NF":"672","NG":"234","NI":"505","NL":"31","NO":"47","NP":"977","NR":"674","NU":"683","NZ":"64","OM":"968","PA":"507","PE":"51","PF":"689","PG":"675","PH":"63","PK":"92","PL":"48","PM":"508","PR":"1","PS":"970","PT":"351","PW":"680","PY":"595","QA":"974","RE":"262","RO":"40","RS":"381","RU":"7","RW":"250","SA":"966","SB":"677","SC":"248","SD":"249","SE":"46","SG":"65","SH":"290","SI":"386","SJ":"47","SK":"421","SL":"232","SM":"378","SN":"221","SO":"252","SR":"597","SS":"211","ST":"239","SV":"503","SX":"1","SY":"963","SZ":"268","TC":"1","TD":"235","TG":"228","TH":"66","TJ":"992","TK":"690","TL":"670","TM":"993","TN":"216","TO":"676","TR":"90","TT":"1","TV":"688","TW":"886","TZ":"255","UA":"380","UG":"256","US":"1","UY":"598","UZ":"998","VA":"39","VC":"1","VE":"58","VG":"1","VI":"1","VN":"84","VU":"678","WF":"681","WS":"685","XK":"383","YE":"967","YT":"262","ZA":"27","ZM":"260","ZW":"263"}
// The number part of "+<code> <number>" for the selected country.
function fgPhoneNumber(value: string, country: string): string {
  var prefix = '+' + FG_DIAL[country] + ' '
  return value.indexOf(prefix) === 0 ? value.slice(prefix.length) : value
}
function fgComposePhone(country: string, number: string): string {
  return number.trim() === '' ? '' : '+' + FG_DIAL[country] + ' ' + number
}
// The country whose code starts the value ("+44 …"; the field's own first), as
// for restored answers; the fallback when none does.
function fgPhoneFrom(value: unknown, fallback: string): string {
  if (typeof value !== 'string' || value.indexOf('+' + FG_DIAL[fallback] + ' ') === 0) return fallback
  for (var code in FG_DIAL) if (value.indexOf('+' + FG_DIAL[code] + ' ') === 0) return code
  return fallback
}
// Starting country per field (template path); the chosen one per field path.
const FG_PHONE_DEFAULTS: Record<string, string> = {"contact_phone":"OM","references.phone":"GB"}
const fgPhoneCountry = reactive<Record<string, string>>({})
function fgPhoneCountryOf(path: string): string {
  return fgPhoneCountry[path] ?? fgPhoneFrom(fgGet(path), FG_PHONE_DEFAULTS[fgTpl(path)]!)
}
function fgPhoneSetCountry(path: string, event: Event): void {
  const typed = fgPhoneNumber(fgGet(path) as string, fgPhoneCountryOf(path))
  fgPhoneCountry[path] = (event.target as HTMLSelectElement).value
  fgSet(path, fgComposePhone(fgPhoneCountry[path]!, typed))
  revalidate(path)
}
function fgPhoneInput(path: string, event: Event): void {
  fgSet(path, fgComposePhone(fgPhoneCountryOf(path), (event.target as HTMLInputElement).value))
  revalidate(path)
}

const fgRoot = ref<HTMLElement | null>(null)
const fgItemDefaults: Record<string, () => Record<string, unknown>> = {
  'references': () => ({
    name: "",
    may_contact: false,
    email: "",
    phone: ""
  }),
}
const fgItemLimits: Record<string, { min: number; max: number }> = {
  'references': { min: 0, max: 3 },
}
const fgItemLabels: Record<string, string> = {
  'references': "Reference {n}",
}
/** Is a repeater (concrete path) shown? An inner one also asks its outer item. */
const fgRepeaterVisible: Record<string, (path: string) => boolean> = {
  'references': (_path) => true,
}
/** Names of each repeater's inner repeaters (one level). */
const fgInnerRepeaters: Record<string, string[]> = {"references":[]}
const fgItemValidators: Record<string, Record<string, (item: Record<string, unknown>) => string | null>> = {
  'references': {
    'name': function (item: Record<string, unknown>) {
      const v = item["name"]
      if (fgIsBlank(v)) return "This field is required"
      return null
    },
    'email': function (item: Record<string, unknown>) {
      if (!((item["may_contact"] === true))) return null
      const v = item["email"]
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
    },
  },
}

function fgList(path: string): Record<string, unknown>[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form) as Record<string, unknown>[]
}
/** The outer item an inner list (\`travellers.2.bags\`) belongs to. */
function fgItemLabel(path: string, index: number): string {
  return (fgItemLabels[fgTpl(path)] ?? '').split('{n}').join(String(index + 1))
}
function fgRemoveLabel(path: string, index: number): string {
  return "Remove {label}".split('{label}').join(fgItemLabel(path, index))
}
/** Validator for an item field path like "people.2.name". */
function fgItemValidator(path: string): (() => string | null) | undefined {
  const match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
  if (!match) return undefined
  const validate: ((item: Record<string, unknown>) => string | null) | undefined = fgItemValidators[fgTpl(match[1]!)]?.[match[3]!]
  const item: Record<string, unknown> | undefined = fgList(match[1]!)[Number(match[2])]
  return validate && item ? () => validate(item) : undefined
}
/** Every item field path of a repeater, inner items included (validation, step gates). */
function fgItemPaths(path: string): string[] {
  const template = fgTpl(path)
  if (!fgRepeaterVisible[template]?.(path)) return []
  const fields = Object.keys(fgItemValidators[template] ?? {})
  return fgList(path).flatMap((_, i) => [
    ...fields.map((field) => \`\${path}.\${i}.\${field}\`),
    ...(fgInnerRepeaters[template] ?? []).flatMap((name) => fgItemPaths(\`\${path}.\${i}.\${name}\`)),
  ])
}
const fgItemKeys = new WeakMap<object, number>()
let fgNextItemKey = 0
function fgKeyOf(item: object): number {
  const raw = toRaw(item)
  let key = fgItemKeys.get(raw)
  if (key === undefined) {
    key = fgNextItemKey++
    fgItemKeys.set(raw, key)
  }
  return key
}
function fgItemElements(path: string): HTMLElement[] {
  const repeater = fgRoot.value?.querySelector(\`[data-fg-repeater="\${path}"]\`)
  return Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
}
/**
 * Re-keys per-item state (touched, errors, drafts, chosen countries) when
 * items move or go: \`to\` maps an old index to its new one (null = gone).
 */
function fgRemapItems(path: string, to: (index: number) => number | null): void {
  const pattern = new RegExp('^' + path.replace(/\\./g, '\\\\.') + '\\\\.(\\\\d+)(\\\\..*)$')
  const move = (key: string): string | null => {
    const match = pattern.exec(key)
    if (!match) return key
    const next = to(Number(match[1]))
    return next === null ? null : \`\${path}.\${next}\${match[2]}\`
  }
  const nextTouched = [...touched].map(move).filter((k): k is string => k !== null)
  touched.clear()
  nextTouched.forEach((k) => touched.add(k))
  for (const store of [errors, tagDrafts, fgDateDrafts, fgPhoneCountry]) {
    const next: Record<string, string> = {}
    for (const [key, value] of Object.entries(store)) {
      const target = move(key)
      if (target !== null) next[target] = value
    }
    for (const key of Object.keys(store)) delete store[key]
    Object.assign(store, next)
  }
}
/** A removed item's state goes; later items' state moves up one. */
function fgShiftItems(path: string, removed: number): void {
  fgRemapItems(path, (i) => (i === removed ? null : i > removed ? i - 1 : i))
}
async function fgAddItem(path: string): Promise<void> {
  const list = fgList(path)
  if (list.length >= (fgItemLimits[fgTpl(path)]?.max ?? Number.POSITIVE_INFINITY)) return
  list.push(fgItemDefaults[fgTpl(path)]!())
  await nextTick()
  const item = fgItemElements(path)[list.length - 1]
  const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
  ;(control ?? item)?.focus()
  fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length - 1)))
}
function fgMoveLabel(path: string, index: number, direction: 'up' | 'down'): string {
  return (direction === 'up' ? "Move {label} up" : "Move {label} down").split('{label}').join(fgItemLabel(path, index))
}
/** Swaps an item with its neighbour; focus stays on the moved item. */
async function fgMoveItem(path: string, index: number, delta: -1 | 1): Promise<void> {
  const list = fgList(path)
  const target = index + delta
  if (target < 0 || target >= list.length) return
  const label = fgItemLabel(path, index)
  fgRemapItems(path, (i) => (i === index ? target : i === target ? index : i))
  list.splice(target, 0, list.splice(index, 1)[0]!)
  await nextTick()
  const item = fgItemElements(path)[target]
  const buttons = Array.from(item?.querySelectorAll<HTMLElement>('[data-fg-move]') ?? [])
  ;(buttons.find((b) => b.dataset['fgMove'] === (delta < 0 ? 'up' : 'down')) ?? buttons[0] ?? item)?.focus()
  fgAnnounce("{label} moved to position {n}".split('{label}').join(label).split('{n}').join(String(target + 1)))
}
// Dragging items by their handle: the list being dragged in, the item and the one under it.
const fgItemDrag = reactive<{ path: string; from: number; at: number }>({ path: '', from: -1, at: -1 })
function fgMovedIndex(n: number, from: number, to: number): number {
  if (n === from) return to
  if (from < to) return n > from && n <= to ? n - 1 : n
  return n >= to && n < from ? n + 1 : n
}
function fgDragStart(event: DragEvent, path: string, index: number): void {
  Object.assign(fgItemDrag, { path, from: index, at: -1 })
  if (!event.dataTransfer) return
  event.dataTransfer.effectAllowed = 'move'
  event.dataTransfer.setData('text/plain', fgItemLabel(path, index))
  const item = fgItemElements(path)[index]
  if (item) event.dataTransfer.setDragImage(item, 16, 16)
}
function fgDragEnd(): void {
  Object.assign(fgItemDrag, { path: '', from: -1, at: -1 })
}
function fgDragOver(event: DragEvent, path: string, index: number): void {
  if (fgItemDrag.path !== path) return
  event.preventDefault()
  event.stopPropagation()
  if (event.dataTransfer) event.dataTransfer.dropEffect = 'move'
  fgItemDrag.at = index
}
function fgDropItem(event: DragEvent, path: string, index: number): void {
  if (fgItemDrag.path !== path) return
  event.preventDefault()
  event.stopPropagation()
  const from = fgItemDrag.from
  fgDragEnd()
  void fgMoveItemTo(path, from, index)
}
function fgDragMark(path: string, index: number): '' | undefined {
  return fgItemDrag.path === path && fgItemDrag.from === index ? '' : undefined
}
function fgDropMark(path: string, index: number): 'before' | 'after' | undefined {
  if (fgItemDrag.path !== path || fgItemDrag.at !== index || fgItemDrag.from === index) return undefined
  return index < fgItemDrag.from ? 'before' : 'after'
}
/** Moves item \`from\` to \`to\` (the others close up); the moved item gets focus. */
async function fgMoveItemTo(path: string, from: number, to: number): Promise<void> {
  const list = fgList(path)
  if (from === to || to < 0 || to >= list.length) return
  const label = fgItemLabel(path, from)
  fgRemapItems(path, (n) => fgMovedIndex(n, from, to))
  list.splice(to, 0, list.splice(from, 1)[0]!)
  await nextTick()
  fgItemElements(path)[to]?.focus()
  fgAnnounce("{label} moved to position {n}".split('{label}').join(label).split('{n}').join(String(to + 1)))
}
async function fgRemoveItem(path: string, index: number): Promise<void> {
  const list = fgList(path)
  if (list.length <= (fgItemLimits[fgTpl(path)]?.min ?? 0)) return
  const label = fgItemLabel(path, index)
  fgShiftItems(path, index)
  list.splice(index, 1)
  await nextTick()
  const remaining = fgItemElements(path)
  const target = remaining[Math.min(index, remaining.length - 1)]
  ;(target ?? fgRoot.value?.querySelector<HTMLElement>(\`[data-fg-add="\${path}"]\`))?.focus()
  fgAnnounce("{label} removed".split('{label}').join(label))
}

function fgReset(): void {
  Object.assign(form, {
    full_name: "",
    email: "",
    website: "",
    seats: null,
    seat_cost: null,
    satisfaction: 5,
    city: "",
    zip: "",
    account: {
      username: "",
      password: "",
      bio: "",
      birthday: "",
      avatar: []
    },
    plan: null,
    interests: [],
    channels: [],
    topics: [],
    billing: null,
    extras: [],
    notify: true,
    appointment: "",
    brand_color: "#000000",
    volume: 0,
    budget: {
      from: 200,
      to: 600
    },
    stay: {
      from: "",
      to: ""
    },
    days: [],
    rating: {
      speed: null,
      quality: null
    },
    usage: {
      forms: [],
      reports: []
    },
    source: "kitchen-sink",
    attachments: [],
    attachments_note: "",
    about: "",
    meet: null,
    signature: [],
    contact_method: null,
    contact_phone: "",
    contact_other: "",
    twitter: "",
    github: "",
    shipping_city: "",
    order_notes: "",
    newsletter: true,
    terms: false,
    references: [{
      name: "",
      may_contact: false,
      email: "",
      phone: ""
    }]
  })
  for (const key of Object.keys(errors)) delete errors[key]
  touched.clear()
  result.value = null
  for (const key of Object.keys(tagDrafts)) tagDrafts[key] = ''
  for (const key of Object.keys(fgDateDrafts)) fgDateDrafts[key] = ''
  for (const key of Object.keys(fgPhoneCountry)) delete fgPhoneCountry[key]
  fgAnnounce("The form was reset.")
}

function buildPayload(): Record<string, unknown> {
  return {
    "full_name": form.full_name,
    "email": form.email,
    "website": form.website,
    "seats": form.seats,
    "seat_cost": form.seat_cost,
    "satisfaction": form.satisfaction,
    "city": form.city,
    "zip": form.zip,
    "account": {
      "username": form.account.username,
      "password": form.account.password,
      "bio": form.account.bio,
      "birthday": form.account.birthday,
      "avatar": form.account.avatar,
    },
    "plan": form.plan,
    "interests": form.interests,
    "channels": form.channels,
    "topics": form.topics,
    "billing": form.billing,
    "extras": form.extras,
    "notify": form.notify,
    "appointment": form.appointment,
    "brand_color": form.brand_color,
    "volume": form.volume,
    "budget": form.budget,
    "stay": form.stay,
    "days": form.days,
    "rating": form.rating,
    "usage": form.usage,
    "source": form.source,
    "references": form.references.map((item) => ({ "name": item.name, "may_contact": item.may_contact, ...((item.may_contact === true) ? { "email": item.email } : {}), ...((item.may_contact === true) ? { "phone": item.phone } : {}) })),
    "attachments": form.attachments,
    ...(fgVisible_attachments_note() ? { "attachments_note": form.attachments_note } : {}),
    "about": form.about,
    "meet": form.meet,
    "signature": form.signature,
    "contact_method": form.contact_method,
    ...(fgVisible_contact_phone() ? { "contact_phone": form.contact_phone } : {}),
    ...(fgVisible_contact_other() ? { "contact_other": form.contact_other } : {}),
    "twitter": form.twitter,
    "github": form.github,
    "shipping_city": form.shipping_city,
    "order_notes": form.order_notes,
    "newsletter": form.newsletter,
    "terms": form.terms,
  }
}

async function onSubmit(): Promise<void> {
  if (!validateAll()) {
    fgJumpToError()
    fgAnnounce(fgErrorsText(Object.keys(errors).length))
    return
  }
  const data = buildPayload()
  if (fgCaptchaToken.value === '') {
    fgAnnounce("The form can be sent once the check above has passed.")
    return
  }
  data["cf-turnstile-response"] = fgCaptchaToken.value
  // A token works once: a new check for the next submission.
  fgCaptchaToken.value = ''
  fgCaptchaReset(fgCaptchaEl.value)
  result.value = data
  fgAnnounce("Form submitted.")
  emit('submit', data)
}
</script>

<template>
  <form
    ref="fgRoot"
    class="p-3"
    dir="ltr"
    novalidate
    @submit.prevent="onSubmit"
    @pointerdown.capture="fgPointerDown"
  >
    <div class="row g-3">
      <div class="col-12 col-md-12 text-center">
        <h2 class="fg-heading text-primary">Kitchen Sink</h2>
      </div>
      <div class="col-12 col-md-12 text-center">
        <p class="text-secondary mb-0">Every implemented element appears in this form.</p>
      </div>
      <div class="col-12 col-md-12">
        <div class="text-secondary mb-0 fg-rich-text">
          <p>Hi {{ fgOr(fgAnswer(form.full_name, ", "), 'there') }}! Fields marked * are <strong>required</strong>. See the <a class="link-primary" href="https://example.com/docs">docs</a>:</p>
          <ul>
            <li><em>one</em> answer per row in Rating</li>
            <li>several in Usage</li>
          </ul>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_full_name">Full name<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <input id="fg_full_name" v-model="form.full_name" type="text" class="form-control" :class="{ 'is-invalid': !!errors['full_name'] }" placeholder="Jane Doe" @blur="touch('full_name')" @input="revalidate('full_name')">
          <p v-if="errors['full_name']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['full_name'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_email">Email<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <input id="fg_email" v-model="form.email" type="email" class="form-control" :class="{ 'is-invalid': !!errors['email'] }" placeholder="jane&#64;example.com" @blur="touch('email')" @input="revalidate('email')">
          <p v-if="errors['email']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['email'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_website">Website</label>
          <input id="fg_website" v-model="form.website" type="url" class="form-control form-control-sm rounded" :class="{ 'is-invalid': !!errors['website'] }" @blur="touch('website')" @input="revalidate('website')">
          <p v-if="errors['website']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['website'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="fg-label-row"><label class="form-label fw-semibold small mb-0 fg-label" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
          <div class="input-group">
            <input id="fg_seats" v-model.number="form.seats" type="number" class="form-control" :class="{ 'is-invalid': !!errors['seats'] }" min="1" max="50" aria-describedby="fg_seats-suffix" @blur="touch('seats')" @input="revalidate('seats')">
            <span id="fg_seats-suffix" class="input-group-text">people</span>
          </div>
          <p v-if="errors['seats']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['seats'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_seat_cost">Seat cost</label>
          <div class="input-group">
            <span id="fg_seat_cost-prefix" class="input-group-text">$</span>
            <input id="fg_seat_cost" type="text" readonly class="form-control bg-body-tertiary" :value="fgFmt(form.seat_cost, 2)" :class="{ 'is-invalid': !!errors['seat_cost'] }" aria-describedby="fg_seat_cost-prefix">
          </div>
          <p v-if="errors['seat_cost']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['seat_cost'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" v-model.number="form.satisfaction" type="range" class="form-range" min="0" max="10" step="1" @change="touch('satisfaction')">
          <p class="form-text mt-0 mb-0 fg-description">{{ form.satisfaction }}</p>
          <p v-if="errors['satisfaction']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['satisfaction'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <hr class="border-top my-1 border-primary opacity-100">
      </div>
      <div class="col-12 col-md-12">
        <div class="row g-3">
