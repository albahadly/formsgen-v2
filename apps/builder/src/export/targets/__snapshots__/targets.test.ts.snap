                <select className="form-select flex-grow-0 w-50" aria-label="Country code" value={fgPhoneCountryOf('contact_phone')} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => fgPhoneSetCountry('contact_phone', form.contact_phone, e.target.value)} onBlur={() => touch('contact_phone')}>
