                    <input :id="'fg_references_' + i + '_email'" v-model="item.email" type="email" class="fg-input" :class="{ 'fg-invalid': !!errors[('references.' + i + '.email')] }" @blur="touch(('references.' + i + '.email'))" @input="revalidate(('references.' + i + '.email'))">
                    <p v-if="errors[('references.' + i + '.email')]" class="fg-error" role="alert">{{ errors[('references.' + i + '.email')] }}</p>
