"// Generated by FormsGen — no runtime dependencies beyond React.
import React, { useRef, useState } from 'react'

function fgIsEmpty(v) {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
function fgSize(v) {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}

type FormData = {
  full_name: string
  email: string
  city: string
  zip: string
  account: {
    username: string
    bio: string
  }
  contact_method: string | null
  contact_other: string
  newsletter: boolean
  terms: boolean
}

const INITIAL: FormData = {
  full_name: "",
  email: "",
  city: "",
  zip: "",
  account: {
    username: "",
    bio: ""
  },
  contact_method: null,
  contact_other: "",
  newsletter: true,
  terms: false
}

function fgVisible_contact_other(data: FormData) {
  return ((data.contact_method === "other"))
}

const validators: Record<string, (data: FormData) => string | null> = {
  'full_name': function (data: FormData) {
  const v = data.full_name
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function (data: FormData) {
  const v = data.email
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "bio": data.account.bio,
    },
    "contact_method": data.contact_method,
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())

  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = validators[path]
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
  }

  function touch(path: string): void {
    touched.current.add(path)
    validateField(path, form)
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of Object.keys(validators)) {
      touched.current.add(path)
      const message = validators[path]!(form)
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) return
    const data = buildPayload(form)
    setResult(data)
    onSubmit?.(data)
  }

  return (
    <form className="container py-4" dir="ltr" noValidate onSubmit={handleSubmit}>
      <div className="row g-3">
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_full_name">Full name<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "form-control is-invalid" : "form-control"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_email">Email<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_email" type="text" value={form.email} className={errors['email'] ? "form-control is-invalid" : "form-control"} placeholder="jane@example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="row g-3">
            <div className="col-12 col-md-6">
              <div className="d-flex flex-column gap-1">
