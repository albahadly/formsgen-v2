                <span v-if="form.references.length > 1" class="fg-repeater-handle" data-fg-handle draggable="true" aria-hidden="true" title="Drag to reorder" @dragstart="fgDragStart($event, 'references', i)" @dragend="fgDragEnd()">⠿</span>
                <button v-if="i > 0" type="button" class="fg-repeater-move" data-fg-move="up" :aria-label="fgMoveLabel('references', i, 'up')" @click="fgMoveItem('references', i, -1)">↑</button>
                <button v-if="i < form.references.length - 1" type="button" class="fg-repeater-move" data-fg-move="down" :aria-label="fgMoveLabel('references', i, 'down')" @click="fgMoveItem('references', i, 1)">↓</button>
                <button type="button" class="fg-repeater-remove" :aria-label="fgRemoveLabel('references', i)" @click="fgRemoveItem('references', i)">Remove</button>
              </div>
            </fieldset>
          </div>
          <button v-if="form.references.length < 3" type="button" class="fg-button fg-button--secondary fg-repeater-add" data-fg-add="references" @click="fgAddItem('references')">Add reference</button>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_attachments">Attachments<span class="fg-required" aria-hidden="true">*</span></label>
          <div class="fg-file-drop">
            <span class="fg-file-drop-text">Choose files or drag them here</span>
            <input id="fg_attachments" type="file" class="fg-file-input" accept=".pdf,.doc,.docx" multiple :aria-invalid="errors['attachments'] ? 'true' : undefined" @change="fgPickFiles('attachments', $event)" @dragenter="fgDrag($event.currentTarget, true)" @dragleave="fgDrag($event.currentTarget, false)" @drop="fgDropFiles('attachments', $event)">
          </div>
          <ul v-if="form.attachments.length" class="fg-file-list">
            <li v-for="(file, fi) in form.attachments" :key="fi" class="fg-file-item">
              <span class="fg-file-name">{{ file.name }}</span>
              <span class="fg-file-size">{{ fgFileSize(file.size) }}</span>
              <button type="button" class="fg-file-remove" :aria-label="fgRemoveFileLabel(file.name)" @click="fgRemoveFile('attachments', fi)">×</button>
            </li>
          </ul>
          <p v-if="fgFileNotes['attachments']" class="fg-description" data-fg-file-note>{{ fgFileNotes['attachments'] }}</p>
          <p class="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
          <p v-if="errors['attachments']" class="fg-error" role="alert">{{ errors['attachments'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12" v-if='(!fgIsBlank(form.attachments))'>
        <div class="fg-field">
          <label class="fg-label" for="fg_attachments_note">Notes about the attachments</label>
          <textarea id="fg_attachments_note" v-model="form.attachments_note" class="fg-textarea" rows="3" :class="{ 'fg-invalid': !!errors['attachments_note'] }" @blur="touch('attachments_note')" @input="revalidate('attachments_note')"></textarea>
          <p v-if="errors['attachments_note']" class="fg-error" role="alert">{{ errors['attachments_note'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <div class="fg-label"><span id="fg_about-label">About you</span></div>
          <div class="fg-richtext" data-fg-rich>
            <div class="fg-richtext-toolbar" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
              <button type="button" class="fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
              <button type="button" class="fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
              <button type="button" class="fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
              <button type="button" class="fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
              <button type="button" class="fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
            </div>
            <div id="fg_about" class="fg-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" @blur="touch('about')"></div>
          </div>
          <p class="fg-description">Bold, lists and links are kept.</p>
          <p v-if="errors['about']" class="fg-error" role="alert">{{ errors['about'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Meeting point</legend>
          <div class="fg-location" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
            <div class="fg-location-map" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
            <div class="fg-location-row">
              <label class="fg-location-coord">
                <span>Latitude</span>
                <input id="fg_meet" type="number" class="fg-input" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat>
              </label>
              <label class="fg-location-coord">
                <span>Longitude</span>
                <input id="fg_meet-lng" type="number" class="fg-input" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng>
              </label>
              <button type="button" class="fg-button fg-button--secondary" data-fg-loc-mine>Use my location</button>
              <button type="button" class="fg-button fg-button--secondary" data-fg-loc-clear>Clear</button>
            </div>
            <p class="fg-location-status" aria-live="polite" data-fg-loc-status></p>
          </div>
          <p v-if="errors['meet']" class="fg-error" role="alert">{{ errors['meet'] }}</p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Signature</legend>
          <div class="fg-signature" data-fg-sign>
            <canvas id="fg_signature" class="fg-signature-pad" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature"></canvas>
            <div class="fg-signature-row">
              <input type="text" class="fg-input" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
              <button type="button" class="fg-button fg-button--secondary" data-fg-sign-clear>Clear</button>
            </div>
          </div>
          <p v-if="errors['signature']" class="fg-error" role="alert">{{ errors['signature'] }}</p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <figure class="fg-quote">
          <blockquote class="fg-quote-text">
            <p>Forms are conversations.</p>
          </blockquote>
          <figcaption class="fg-quote-cite">FormsGen</figcaption>
        </figure>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. &#123;&#123; not.vue }} &#64;razor &#123;jsx}</p><a>unsafe link</a><iframe :src="'https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7'" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
