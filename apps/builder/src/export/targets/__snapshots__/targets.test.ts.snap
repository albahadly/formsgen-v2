                  <input id="fg_contact_phone" type="tel" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" autocomplete="tel-national" value='@FgPhoneNumber(Model.ContactPhone, FgPhoneCountryOf("ContactPhone", Model.ContactPhone))' @onchange='e => { Model.ContactPhone = FgPhoneInput("ContactPhone", Model.ContactPhone, e); FgChanged("ContactPhone"); }' />
                </div>
                <ValidationMessage For="@(() => Model.ContactPhone)" class="text-sm text-red-600" />
              </div>
            </div>
        }
        @if ((Equals(Model.ContactMethod, "other")))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_contact_other">Describe your preferred method</label>
                <InputTextArea id="fg_contact_other" @bind-Value="Model.ContactOther" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                <ValidationMessage For="@(() => Model.ContactOther)" class="text-sm text-red-600" />
              </div>
            </div>
        }
        <div class="col-span-12 md:col-span-12">
          <div>
            <div class="mb-4 flex flex-wrap gap-1 border-b border-gray-200 dark:border-gray-700" role="tablist">
              <button type="button" role="tab" aria-selected="@(fgSec_ks_social_tabs == 0 ? "true" : "false")" class="@(fgSec_ks_social_tabs == 0 ? "-mb-px border-b-2 border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600" : "-mb-px border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700")" @onclick="() => fgSec_ks_social_tabs = 0">Social</button>
              <button type="button" role="tab" aria-selected="@(fgSec_ks_social_tabs == 1 ? "true" : "false")" class="@(fgSec_ks_social_tabs == 1 ? "-mb-px border-b-2 border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600" : "-mb-px border-b-2 border-transparent px-4 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700")" @onclick="() => fgSec_ks_social_tabs = 1">Code</button>
            </div>
          @if (fgSec_ks_social_tabs == 0)
          {
              <div role="tabpanel">
                  <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-12 md:col-span-12">
                      <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                        <label class="text-sm font-semibold" for="fg_twitter">Twitter handle</label>
                        <InputText id="fg_twitter" @bind-Value="Model.Twitter" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                        <ValidationMessage For="@(() => Model.Twitter)" class="text-sm text-red-600" />
                      </div>
                    </div>
                  </div>
              </div>
          }
          @if (fgSec_ks_social_tabs == 1)
          {
              <div role="tabpanel">
                  <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-12 md:col-span-12">
                      <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                        <label class="text-sm font-semibold" for="fg_github">GitHub username</label>
                        <InputText id="fg_github" @bind-Value="Model.Github" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                        <ValidationMessage For="@(() => Model.Github)" class="text-sm text-red-600" />
                      </div>
                    </div>
                  </div>
              </div>
          }
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div>
            <ol class="mb-4 flex flex-wrap gap-4 text-sm text-gray-500">
              <li class="@(fgSec_ks_wizard == 0 ? "flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100" : "flex items-center gap-2")">1. Shipping</li>
              <li class="@(fgSec_ks_wizard == 1 ? "flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100" : "flex items-center gap-2")">2. Review</li>
            </ol>
          @if (fgSec_ks_wizard == 0)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                    <label class="text-sm font-semibold" for="fg_shipping_city">Shipping city<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                    <InputText id="fg_shipping_city" @bind-Value="Model.ShippingCity" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" />
                    <ValidationMessage For="@(() => Model.ShippingCity)" class="text-sm text-red-600" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_wizard == 1)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                    <label class="text-sm font-semibold" for="fg_order_notes">Order notes</label>
                    <InputTextArea id="fg_order_notes" @bind-Value="Model.OrderNotes" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                    <ValidationMessage For="@(() => Model.OrderNotes)" class="text-sm text-red-600" />
                  </div>
                </div>
              </div>
          }
            <div class="mt-4 flex justify-between gap-2">
              @if (fgSec_ks_wizard > 0)
              {
                  <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @onclick="() => FgGo_ks_wizard(fgSec_ks_wizard - 1)">Back</button>
              }
              @if (fgSec_ks_wizard < 1)
              {
                  <button type="button" class="rounded-md border border-transparent bg-indigo-600 px-4 py-1.5 text-base font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:cursor-not-allowed disabled:opacity-60" @onclick="FgNext_ks_wizard">Next</button>
              }
              @if (fgSec_ks_wizard == 1)
              {
                  <button class="rounded-md border border-transparent bg-indigo-600 px-4 py-1.5 text-base font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300 disabled:cursor-not-allowed disabled:opacity-60" type="submit" disabled='@(fgCaptchaToken == "")' aria-describedby='@(fgCaptchaToken == "" && !fgCaptchaFailed ? "fg_captcha_hint" : null)'>Submit</button>
              }
            </div>
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_newsletter" @bind-Value="Model.Newsletter" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
              <label class="text-base" for="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            <ValidationMessage For="@(() => Model.Newsletter)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_terms" @bind-Value="Model.Terms" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
              <label class="text-base" for="fg_terms">I accept the terms<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_terms-tip">?</button><span role="tooltip" id="fg_terms-tip" class="fg-tip-text">We never sell your data</span></span>
            </div>
            <ValidationMessage For="@(() => Model.Terms)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @onclick="FgReset">Start over</button>
        </div>
    </div>
    <div class="mt-4 flex flex-col gap-1">
        <div @ref="fgCaptchaEl"></div>
        @if (fgCaptchaFailed)
        {
            <p class="text-sm text-red-600">The check didn't load. Reload the page to try again.</p>
        }
        else if (fgCaptchaToken == "")
        {
            <p id="fg_captcha_hint" class="m-0 text-sm text-gray-600 dark:text-gray-400">The form can be sent once the check above has passed.</p>
        }
    </div>
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">@fgAnnouncement</div>
    @if (ResultJson is not null)
    {
        <pre class="mt-4 overflow-x-auto rounded-md bg-gray-900 p-4 text-sm text-green-300">@ResultJson</pre>
    }
    </div>
</EditForm>

@code {
    private KitchenSinkFormModel Model { get; set; } = new();
    private string? ResultJson { get; set; }

    private int fgSec_ks_social_tabs = 0;
    private int fgSec_ks_wizard = 0;

    private void FgCalc()
    {
        Model.SeatCost = FgCalcValue(((FgNum(Model.Seats) * 25d) * ((FgNum(Model.Seats) >= 10d ? 1d : 0d) != 0 ? 0.8d : 1d)), 2);
    }

    // After a submit attempt, calculated fields' errors follow their new values.
    private bool fgSubmitted;

    private void FgRevalidateCalc()
    {
        if (!fgSubmitted) return;
        FgValidateMembers(new[] { "SeatCost" });
    }

    protected override bool ShouldRender()
    {
        FgCalc();
        fgRenderGen++;
        return true;
    }

    // Calculated fields: an answer as a number (empty 0, yes/no 1/0, a list its size).
    private static double FgNum(object? value) => value switch
    {
        null => 0d,
        bool on => on ? 1d : 0d,
        double number => number,
        int number => number,
        string text when string.IsNullOrWhiteSpace(text) => 0d,
        string text => System.Text.RegularExpressions.Regex.IsMatch(text.Trim(), @"^[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?$")
            ? double.Parse(text.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture)
            : double.NaN,
        System.Collections.IDictionary => double.NaN,
        System.Collections.ICollection list => list.Count,
        _ => double.NaN,
    };

    // Days since 1970-01-01 for a valid ISO date, NaN otherwise.
    private static double FgDay(object? value) =>
        value is string text && text.Length == 10 && System.Text.RegularExpressions.Regex.IsMatch(text, @"^\\d{4}-\\d{2}-\\d{2}$")
            && DateTime.TryParseExact(text, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day)
            ? (day - new DateTime(1970, 1, 1)).TotalDays
            : double.NaN;

    private static double FgRound(double value, double decimals)
    {
        var factor = Math.Pow(10, decimals);
        return Math.Floor(value * factor + 0.5) / factor;
    }

    private static double? FgCalcValue(double value, int decimals) => double.IsFinite(value) ? FgRound(value, decimals) : null;

    private static string FgFmt(double? value, int decimals) =>
        value is double number ? number.ToString("F" + decimals, System.Globalization.CultureInfo.InvariantCulture) : "";

    private static double FgDaysRange(object? value) => value is FgDateRange range ? FgDay(range.To) - FgDay(range.From) : double.NaN;

    // Answers inside text: a value as text ("" when empty).
    private static string FgAnswer(object? value, string sep) => value switch
    {
        null => "",
        string text => text,
        double number => number.ToString(System.Globalization.CultureInfo.InvariantCulture),
        int number => number.ToString(System.Globalization.CultureInfo.InvariantCulture),
        FgDateRange range => string.IsNullOrEmpty(range.From) || string.IsNullOrEmpty(range.To) ? "" : range.From + " – " + range.To,
        FgRange range => range.From.ToString(System.Globalization.CultureInfo.InvariantCulture) + " – " + range.To.ToString(System.Globalization.CultureInfo.InvariantCulture),
        IEnumerable<FgUpload> files => string.Join(sep, files.Select(f => f.Name)),
        FgLatLng point => point.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture) + ", " + point.Lng.ToString(System.Globalization.CultureInfo.InvariantCulture),
        IEnumerable<string> list => string.Join(sep, list),
        _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "",
    };

    private static string FgPick(object? value, Dictionary<string, string> labels, string sep) => value switch
    {
        string text when text == "" => "",
        string text => labels.TryGetValue(text, out var label) ? label : text,
        IEnumerable<string> list => string.Join(sep, list.Select(v => labels.TryGetValue(v, out var label) ? label : v)),
        _ => "",
    };

    private static string FgOr(string text, string fallback) => text == "" ? fallback : text;


    private EditContext fgEdit = default!;
    private ValidationMessageStore fgMessages = default!;
    private bool fgPressing;
    private readonly HashSet<string> fgDeferredFields = new();

    protected override void OnInitialized()
    {
        FgInitEdit();
        FgPrefill();
        FgCalc();
    }

    private void FgInitEdit()
    {
        fgWire = true;
        // New elements, a new check.
        fgCaptchaToken = "";
        fgEdit = new EditContext(Model);
        fgMessages = new ValidationMessageStore(fgEdit);
        fgEdit.OnValidationRequested += (_, _) => FgValidateAll();
        fgEdit.OnFieldChanged += (_, e) => FgFieldChanged(e.FieldIdentifier);
    }

    private void FgPointerDown(PointerEventArgs _)
    {
        FgFlushDeferred();
        fgPressing = true;
    }

    private void FgPointerEnd(PointerEventArgs _)
    {
        fgPressing = false;
        FgFlushDeferred();
    }

    private void FgFieldChanged(string name)
    {
        FgCalc();
        FgRevalidateCalc();
        if (fgPressing)
        {
            fgDeferredFields.Add(name);
            return;
        }
        FgValidateMembers(new[] { name });
    }

    private void FgFlushDeferred()
    {
        if (fgDeferredItemFields.Count > 0)
        {
            var items = fgDeferredItemFields.ToArray();
            fgDeferredItemFields.Clear();
            foreach (var field in items) FgValidateItemField(field);
        }
        if (fgDeferredFields.Count == 0) return;
        var names = fgDeferredFields.ToArray();
        fgDeferredFields.Clear();
        FgValidateMembers(names);
    }

    private void FgValidateAll()
    {
        FgCalc();
        fgSubmitted = true;
        fgDeferredFields.Clear();
        fgMessages.Clear();
        FgValidateMembers(fgAllMembers);
        FgValidateRepeater_references();
    }

    private object? FgValue(string name) => name switch
    {
            "FullName" => Model.FullName,
            "Email" => Model.Email,
            "Website" => Model.Website,
            "Seats" => Model.Seats,
            "SeatCost" => Model.SeatCost,
            "Satisfaction" => Model.Satisfaction,
            "City" => Model.City,
            "Zip" => Model.Zip,
            "AccountUsername" => Model.AccountUsername,
            "AccountPassword" => Model.AccountPassword,
            "AccountBio" => Model.AccountBio,
            "AccountBirthday" => Model.AccountBirthday,
            "AccountAvatar" => Model.AccountAvatar,
            "Plan" => Model.Plan,
            "Interests" => Model.Interests,
            "Channels" => Model.Channels,
            "Topics" => Model.Topics,
            "Billing" => Model.Billing,
            "Extras" => Model.Extras,
            "Notify" => Model.Notify,
            "Appointment" => Model.Appointment,
            "BrandColor" => Model.BrandColor,
            "Volume" => Model.Volume,
            "Budget" => Model.Budget,
            "Stay" => Model.Stay,
            "Days" => Model.Days,
            "Rating" => Model.Rating,
            "Usage" => Model.Usage,
            "Source" => Model.Source,
            "Attachments" => Model.Attachments,
            "AttachmentsNote" => Model.AttachmentsNote,
            "About" => Model.About,
            "Meet" => Model.Meet,
            "Signature" => Model.Signature,
            "ContactMethod" => Model.ContactMethod,
            "ContactPhone" => Model.ContactPhone,
            "ContactOther" => Model.ContactOther,
            "Twitter" => Model.Twitter,
            "Github" => Model.Github,
            "ShippingCity" => Model.ShippingCity,
            "OrderNotes" => Model.OrderNotes,
            "Newsletter" => Model.Newsletter,
            "Terms" => Model.Terms,
        _ => null,
    };

    // Attribute rules per property, plus the model's Validate() results for
    // the same members (DataAnnotations alone skips Validate() while any
    // attribute rule fails, which hid errors such as a required checkbox).
    private bool FgValidateMembers(string[] members)
    {
        var ok = true;
        foreach (var name in members)
        {
            var field = new FieldIdentifier(Model, name);
            fgMessages.Clear(field);
            var results = new List<ValidationResult>();
            var context = new ValidationContext(Model) { MemberName = name };
            if (!Validator.TryValidateProperty(FgValue(name), context, results)) ok = false;
            if (results.Count > 0) fgMessages.Add(field, results[0].ErrorMessage ?? "Invalid");
        }
        foreach (var result in ((IValidatableObject)Model).Validate(new ValidationContext(Model)))
        {
            foreach (var name in result.MemberNames)
            {
                if (Array.IndexOf(members, name) < 0) continue;
                ok = false;
                var field = new FieldIdentifier(Model, name);
                // One message per field (the first), as in the other targets.
                if (!fgMessages[field].Any()) fgMessages.Add(field, result.ErrorMessage ?? "Invalid");
            }
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private async Task FgSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await HandleValidSubmit();
            return;
        }
        await FgOnInvalidSubmit(context);
    }

    private string fgAnnouncement = "";

    private async Task FgAnnounce(string message)
    {
        fgAnnouncement = "";
        StateHasChanged();
        await Task.Delay(50);
        fgAnnouncement = message;
        StateHasChanged();
    }

    private static readonly Dictionary<string, string> fgErrorForms = new() { ["one"] = "1 error. Please fix the highlighted fields.", ["other"] = "{n} errors. Please fix the highlighted fields." };

    private static string FgErrorsText(int count)
    {
        var category = count == 1 ? "one" : "other";
        var text = fgErrorForms.TryGetValue(category, out var form) ? form : fgErrorForms["other"];
        return text.Replace("{n}", count.ToString());
    }

