      return null
    },
    'email': function (item: Record<string, unknown>, _data: FormData) {
      if (!((item["may_contact"] === true))) return null
      const v = item["email"]
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
    },
  },
}

function fgList(data: FormData, path: string): Record<string, unknown>[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as Record<string, unknown>[]
}

function fgItemLabel(path: string, index: number): string {
  return (FG_ITEM_LABELS[path] ?? '').split('{n}').join(String(index + 1))
}

function fgRemoveLabel(path: string, index: number): string {
  return "Remove {label}".split('{label}').join(fgItemLabel(path, index))
}

/** Every item field path of a visible repeater (validation, step gates). */
function fgItemPaths(data: FormData, path: string): string[] {
  if (!FG_REPEATER_VISIBLE[path]?.(data)) return []
  const fields = Object.keys(itemValidators[path] ?? {})
  return fgList(data, path).flatMap((_, i) => fields.map((field) => \`\${path}.\${i}.\${field}\`))
}

/** Validator for a field path, including item paths like "people.2.name". */
function fgValidatorFor(path: string): ((data: FormData) => string | null) | undefined {
  const direct = validators[path]
  if (direct) return direct
  const match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
  if (!match) return undefined
  const validate = itemValidators[match[1]!]?.[match[3]!]
  if (!validate) return undefined
  return (data) => {
    const item = fgList(data, match[1]!)[Number(match[2])]
    return item ? validate(item, data) : null
  }
}

/** All field paths to validate on submit (items included). */
function fgAllPaths(data: FormData): string[] {
  return [...Object.keys(validators), ...Object.keys(itemValidators).flatMap((path) => fgItemPaths(data, path))]
}

/** Moves item keys/paths after a removal: "people.3.x" → "people.2.x". */
function fgShiftKey(key: string, path: string, removed: number): string | null {
  if (!key.startsWith(path + '.')) return key
  const rest = key.slice(path.length + 1)
  const dot = rest.indexOf('.')
  const index = Number(dot === -1 ? rest : rest.slice(0, dot))
  if (!Number.isInteger(index)) return key
  if (index === removed) return null
  return index > removed ? \`\${path}.\${index - 1}\${dot === -1 ? '' : rest.slice(dot)}\` : key
}

const fgThumbs = new WeakMap<File, string>()
function fgThumb(file: File): string {
  let url = fgThumbs.get(file)
  if (!url) {
    url = URL.createObjectURL(file)
    fgThumbs.set(file, url)
  }
  return url
}
function fgReleaseThumb(file: File): void {
  const url = fgThumbs.get(file)
  if (url) URL.revokeObjectURL(url)
  fgThumbs.delete(file)
}
function fgFileSize(bytes: number): string {
  return bytes >= 1024 * 1024 ? (bytes / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'
}
function fgRemoveFileLabel(name: string): string {
  return "Remove {name}".split('{name}').join(name)
}

const FG_FILE_MULTIPLE: Record<string, boolean> = { 'account.avatar': false, 'attachments': true }

function fgFileList(data: FormData, path: string): File[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as File[]
}

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]

function fgErrorsText(count: number): string {
  const forms: Record<string, string> & { other: string } = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgAnnouncement, setFgAnnouncement] = useState('')
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)
  const [tagDrafts, setTagDrafts] = useState<Record<string, string>>({})
  const fgRoot = useRef<HTMLFormElement>(null)
  // Stable React keys per item (the form object is cloned on every edit).
  const fgKeys = useRef<Record<string, number[]>>({})
  const fgNextKey = useRef(0)
  const fgPendingFocus = useRef<{ path: string; index: number } | null>(null)

  // Polite aria-live region; cleared first so repeated text re-announces.
  function fgAnnounce(message: string): void {
    setFgAnnouncement('')
    setTimeout(() => setFgAnnouncement(message), 50)
  }

  function fgGo_ks_wizard(index: number): void {
    setFgSec_ks_wizard(index)
    fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
  }

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = fgValidatorFor(path)
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) fgGo_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = fgValidatorFor(path)
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
  }

  // A blur error appearing while a pointer is held reflows the form and the
  // release misses its target; defer blur validation until the press ends.
  // Deferred work reads the latest state through refs, not this closure.
  const formRef = useRef(form)
  formRef.current = form
  const fgPressing = useRef(false)
  const fgDeferred = useRef(new Set<string>())
  const fgFlush = useRef(() => {})
  fgFlush.current = () => {
    const paths = [...fgDeferred.current]
    fgDeferred.current.clear()
    for (const path of paths) {
      touched.current.add(path)
      validateField(path, formRef.current)
    }
  }
  useEffect(() => {
    function end(): void {
      if (!fgPressing.current) return
      fgPressing.current = false
      setTimeout(() => fgFlush.current(), 0)
    }
    window.addEventListener('pointerup', end)
    window.addEventListener('pointercancel', end)
    return () => {
      window.removeEventListener('pointerup', end)
      window.removeEventListener('pointercancel', end)
    }
  }, [])

  function touch(path: string): void {
    if (fgPressing.current) {
      fgDeferred.current.add(path)
      return
    }
    touched.current.add(path)
    validateField(path, form)
  }

  function fgAddTag(path: string, current: string[]): void {
    const draft = (tagDrafts[path] ?? '').trim()
    if (draft !== '' && !current.includes(draft)) setField(path, [...current, draft])
    setTagDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveTag(path: string, current: string[], index: number): void {
    setField(path, current.filter((_, i) => i !== index))
  }

  function fgPickFiles(path: string, input: HTMLInputElement): void {
    const picked = Array.from(input.files ?? [])
    input.value = ''
    if (picked.length === 0) return
    touched.current.add(path)
    setField(path, FG_FILE_MULTIPLE[path] ? [...fgFileList(form, path), ...picked] : picked.slice(0, 1))
  }

  function fgRemoveFile(path: string, index: number): void {
    const list = fgFileList(form, path)
    const file = list[index]
    if (file) fgReleaseThumb(file)
    touched.current.add(path)
    setField(path, list.filter((_, i) => i !== index))
  }

  function fgKeyAt(path: string, index: number): number {
    const keys = (fgKeys.current[path] ??= [])
    while (keys.length <= index) keys.push(fgNextKey.current++)
    return keys[index]!
  }

  function fgAddItem(path: string): void {
    const list = fgList(form, path)
    if (list.length >= (FG_ITEM_LIMITS[path]?.max ?? Number.POSITIVE_INFINITY)) return
    setField(path, [...list, FG_ITEM_DEFAULTS[path]!()])
    fgPendingFocus.current = { path, index: list.length }
    fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length)))
  }

  function fgRemoveItem(path: string, index: number): void {
    const list = fgList(form, path)
    if (list.length <= (FG_ITEM_LIMITS[path]?.min ?? 0)) return
    const label = fgItemLabel(path, index)
    fgKeyAt(path, list.length - 1)
    fgKeys.current[path]!.splice(index, 1)
    const nextTouched = [...touched.current].map((k) => fgShiftKey(k, path, index)).filter((k): k is string => k !== null)
    touched.current = new Set(nextTouched)
    setErrors((prev) => {
      const next: Record<string, string> = {}
      for (const [key, message] of Object.entries(prev)) {
        const target = fgShiftKey(key, path, index)
        if (target !== null) next[target] = message
      }
      return next
    })
    setField(path, list.filter((_, i) => i !== index))
    fgPendingFocus.current = { path, index: -1 - index }
    fgAnnounce("{label} removed".split('{label}').join(label))
  }

  // After an add: focus the new item's first control. After a remove
  // (negative index): focus the item that took its place, or the add button.
  useEffect(() => {
    const pending = fgPendingFocus.current
    if (!pending) return
    fgPendingFocus.current = null
    const repeater = fgRoot.current?.querySelector(\`[data-fg-repeater="\${pending.path}"]\`)
    const items = Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
    if (pending.index >= 0) {
      const item = items[pending.index]
      const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
      ;(control ?? item)?.focus()
    } else {
      const removed = -1 - pending.index
      const target = items[Math.min(removed, items.length - 1)]
      ;(target ?? repeater?.querySelector<HTMLElement>('[data-fg-add]'))?.focus()
    }
  })

  function fgReset(): void {
    setForm(INITIAL)
    setErrors({})
    touched.current.clear()
    fgKeys.current = {}
    setResult(null)
    setTagDrafts({})
    fgAnnounce("The form was reset.")
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of fgAllPaths(form)) {
      touched.current.add(path)
      const message = fgValidatorFor(path)?.(form) ?? null
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) {
      if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_social_tabs(target)
      }
      if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_wizard(target)
      }
      fgAnnounce(fgErrorsText(Object.keys(nextErrors).length))
      return
    }
    const data = buildPayload(form)
    setResult(data)
    fgAnnounce("Form submitted.")
    onSubmit?.(data)
  }

  return (
    <form ref={fgRoot} className="fg-form" dir="ltr" noValidate onSubmit={handleSubmit} onPointerDownCapture={() => { fgFlush.current(); fgPressing.current = true }}>
      <div className="fg-grid">
        <div className="fg-cell fg-align-center" style={{ gridColumn: 'span 12 / span 12' }}>
          <h2 className="fg-heading fg-tone-primary">Kitchen Sink</h2>
        </div>
        <div className="fg-cell fg-align-center" style={{ gridColumn: 'span 12 / span 12' }}>
          <p className="fg-paragraph">Every implemented element appears in this form.</p>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_full_name">Full name<span className="fg-required" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "fg-input fg-invalid" : "fg-input"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="fg-error" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_email">Email<span className="fg-required" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "fg-input fg-invalid" : "fg-input"} placeholder="jane&#64;example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="fg-error" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "fg-input fg-control--sm fg-invalid" : "fg-input fg-control--sm"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="fg-error" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_seats">Seats</label>
            <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "fg-input fg-invalid" : "fg-input"} min="1" max="50" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
            {errors['seats'] && <p className="fg-error" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="fg-range" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="fg-description">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="fg-error" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <hr className="fg-divider fg-tone-primary" />
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-grid">
            <div className="fg-cell" style={{ gridColumn: 'span 6 / span 6' }}>
              <div className="fg-field">
                <label className="fg-label" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="fg-error" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="fg-cell" style={{ gridColumn: 'span 6 / span 6' }}>
              <div className="fg-field">
                <label className="fg-sr-only" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="fg-error" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="fg-cell account-box" style={{ gridColumn: 'span 12 / span 12' }}>
          <fieldset className="fg-group">
            <legend className="fg-group-label">Account</legend>
            <div className="fg-grid">
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_username">Username<span className="fg-required" aria-hidden="true">*</span></label>
                  <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  {errors['account.username'] && <p className="fg-error" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="fg-error" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "fg-textarea fg-control--lg fg-invalid" : "fg-textarea fg-control--lg"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="fg-error" role="alert">{errors['account.bio']}</p>}
                </div>
              </div>
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_birthday">Birthday</label>
                  <input id="fg_account_birthday" type="date" value={form.account.birthday} className={errors['account.birthday'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.birthday', e.target.value)} onBlur={() => touch('account.birthday')} />
                  {errors['account.birthday'] && <p className="fg-error" role="alert">{errors['account.birthday']}</p>}
                </div>
              </div>
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_avatar">Profile picture</label>
                  <input id="fg_account_avatar" type="file" className="fg-file-input" accept="image/*" aria-invalid={errors['account.avatar'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('account.avatar', e.target)} />
                  {form.account.avatar.length > 0 && (
                    <ul className="fg-file-list">
                      {form.account.avatar.map((file, fi) => (
                        <li key={fi} className="fg-file-item">
                        {file.type.startsWith('image/') && <img className="fg-file-thumb" src={fgThumb(file)} alt="" width={40} height={40} />}
                          <span className="fg-file-name">{file.name}</span>
                          <span className="fg-file-size">{fgFileSize(file.size)}</span>
                          <button type="button" className="fg-file-remove" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('account.avatar', fi)}>×</button>
                        </li>
                      ))}
                    </ul>
                  )}
                  {errors['account.avatar'] && <p className="fg-error" role="alert">{errors['account.avatar']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <fieldset className="fg-field">
            <legend className="fg-label">Plan<span className="fg-required" aria-hidden="true">*</span></legend>
            <div className="fg-options">
              <label className="fg-option" htmlFor="fg_plan_free">
                <input id="fg_plan_free" type="radio" className="fg-checkbox" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                <span>Free</span>
              </label>
              <label className="fg-option" htmlFor="fg_plan_pro">
                <input id="fg_plan_pro" type="radio" className="fg-checkbox" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                <span>Pro</span>
              </label>
            </div>
          </fieldset>
            {errors['plan'] && <p className="fg-error" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <fieldset className="fg-field">
            <legend className="fg-label">Interests</legend>
            <div className="fg-options">
              <label className="fg-option" htmlFor="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" className="fg-checkbox" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                <span>News</span>
              </label>
              <label className="fg-option" htmlFor="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" className="fg-checkbox" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                <span>Product updates</span>
              </label>
            </div>
          </fieldset>
            {errors['interests'] && <p className="fg-error" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "fg-select fg-invalid" : "fg-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="fg-error" role="alert">{errors['channels']}</p>}
