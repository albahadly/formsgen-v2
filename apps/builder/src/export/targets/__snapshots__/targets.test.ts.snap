          <div class="fg-file-drop">
            <span class="fg-file-drop-text">Choose files or drag them here</span>
            <input id="fg_attachments" type="file" class="fg-file-input" accept=".pdf,.doc,.docx" multiple data-fg-path="attachments" data-fg-kind="files">
          </div>
          <ul class="fg-file-list" data-fg-file-list="attachments" hidden></ul>
          <p class="fg-description" data-fg-file-note="attachments" hidden></p>
          <p class="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
          <p id="fg_attachments-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12" data-fg-cond="0">
        <div class="fg-field">
          <label class="fg-label" for="fg_attachments_note">Notes about the attachments</label>
          <textarea id="fg_attachments_note" class="fg-textarea" rows="3" data-fg-path="attachments_note" data-fg-kind="text"></textarea>
          <p id="fg_attachments_note-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <div class="fg-label"><span id="fg_about-label">About you</span></div>
          <div class="fg-richtext" data-fg-rich>
            <div class="fg-richtext-toolbar" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
              <button type="button" class="fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
              <button type="button" class="fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
              <button type="button" class="fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
              <button type="button" class="fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
              <button type="button" class="fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
            </div>
            <div id="fg_about" class="fg-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" data-fg-path="about" data-fg-kind="richtext"></div>
          </div>
          <p class="fg-description">Bold, lists and links are kept.</p>
          <p id="fg_about-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Meeting point</legend>
          <div class="fg-location" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
            <div class="fg-location-map" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
            <div class="fg-location-row">
              <label class="fg-location-coord">
                <span>Latitude</span>
                <input id="fg_meet" type="number" class="fg-input" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat data-fg-path="meet" data-fg-kind="location">
              </label>
              <label class="fg-location-coord">
                <span>Longitude</span>
                <input id="fg_meet-lng" type="number" class="fg-input" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng data-fg-path="meet">
              </label>
              <button type="button" class="fg-button fg-button--secondary" data-fg-loc-mine>Use my location</button>
              <button type="button" class="fg-button fg-button--secondary" data-fg-loc-clear>Clear</button>
            </div>
            <p class="fg-location-status" aria-live="polite" data-fg-loc-status></p>
          </div>
          <p id="fg_meet-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Signature</legend>
          <div class="fg-signature" data-fg-sign>
            <canvas id="fg_signature" class="fg-signature-pad" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature" data-fg-path="signature" data-fg-kind="signature"></canvas>
            <div class="fg-signature-row">
              <input type="text" class="fg-input" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
              <button type="button" class="fg-button fg-button--secondary" data-fg-sign-clear>Clear</button>
            </div>
          </div>
          <p id="fg_signature-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <figure class="fg-quote">
          <blockquote class="fg-quote-text">
            <p>Forms are conversations.</p>
          </blockquote>
          <figcaption class="fg-quote-cite">FormsGen</figcaption>
        </figure>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. {{ not.vue }} &#64;razor {jsx}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
      </div>
