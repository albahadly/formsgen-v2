            <span v-for="(tag, index) in form.topics" :key="tag" class="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">{{ tag }} <button type="button" class="text-gray-500 hover:text-red-600" :aria-label="'Remove ' + (tag)" @click="fgRemoveTag('topics', index)">×</button></span>
            <input id="fg_topics" v-model="tagDrafts['topics']" type="text" class="min-w-24 flex-1 border-none bg-transparent py-0 text-base focus:outline-none" placeholder="Type and press Enter" @keydown.enter.prevent="fgAddTag('topics')" @blur="fgAddTag('topics'); touch('topics')">
          </div>
