                        <input id={'fg_references_' + i + '_name'} type="text" value={item.name} className={errors[('references.' + i + '.name')] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.name'), e.target.value)} onBlur={() => touch(('references.' + i + '.name'))} />
                        {errors[('references.' + i + '.name')] && <p className="fg-error" role="alert">{errors[('references.' + i + '.name')]}</p>}
