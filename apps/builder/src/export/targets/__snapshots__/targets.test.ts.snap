                                  <input id="@($"fg_references_{i}_phone")" type="tel" class="fg-input" autocomplete="tel-national" value='@FgPhoneNumber(item.Phone, FgPhoneCountryOf(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone))' @onchange='e => { item.Phone = FgPhoneInput(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone, e); FgChanged(FgItemKey(item, "ReferencesIPhone", "Phone")); }' />
                                </div>
