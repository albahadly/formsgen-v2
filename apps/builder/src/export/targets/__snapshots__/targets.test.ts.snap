                          @if (i < Model.References.Count - 1)
                          {
                              <button type="button" class="btn btn-outline-secondary fg-repeater-move" data-fg-move="down" aria-label='@FgMoveLabel("references", i, false)' @ref="fgMoveDownRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, 1)'>↓</button>
