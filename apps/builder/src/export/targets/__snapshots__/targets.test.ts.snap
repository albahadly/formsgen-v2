                  <input id="fg_contact_phone" type="tel" class="form-control" autocomplete="tel-national" value='@FgPhoneNumber(Model.ContactPhone, FgPhoneCountryOf("ContactPhone", Model.ContactPhone))' @onchange='e => { Model.ContactPhone = FgPhoneInput("ContactPhone", Model.ContactPhone, e); FgChanged("ContactPhone"); }' />
