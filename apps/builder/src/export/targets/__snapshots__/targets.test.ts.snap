                    <input :id="'fg_references_' + i + '_email'" v-model="item.email" type="email" class="form-control" :class="{ 'is-invalid': !!errors[('references.' + i + '.email')] }" @blur="touch(('references.' + i + '.email'))" @input="revalidate(('references.' + i + '.email'))">
