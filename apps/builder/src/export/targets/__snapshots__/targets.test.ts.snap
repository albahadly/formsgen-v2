                    <input :id="'fg_references_' + i + '_name'" v-model="item.name" type="text" class="form-control" :class="{ 'is-invalid': !!errors[('references.' + i + '.name')] }" @blur="touch(('references.' + i + '.name'))" @input="revalidate(('references.' + i + '.name'))">
