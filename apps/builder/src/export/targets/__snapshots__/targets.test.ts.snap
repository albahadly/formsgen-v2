          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_volume">Volume</label>
          <input id="fg_volume" v-model.number="form.volume" type="range" class="form-range" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" @change="touch('volume')">
          <p class="form-text mt-0 mb-0 fg-description">{{ form.volume }}</p>
          <p v-if="errors['volume']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['volume'] }}</p>
