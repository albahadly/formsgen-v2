      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_attachments">Attachments<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <div class="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary">
            <span class="fw-medium">Choose files or drag them here</span>
            <input id="fg_attachments" type="file" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept=".pdf,.doc,.docx" multiple data-fg-path="attachments" data-fg-kind="files">
          </div>
          <ul class="list-group mt-2" data-fg-file-list="attachments" hidden></ul>
          <p class="form-text mt-0 mb-0 fg-description" data-fg-file-note="attachments" hidden></p>
          <p class="form-text mt-0 mb-0 fg-description">Up to 3 PDF or Word files, 5 MB each</p>
          <p id="fg_attachments-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12" data-fg-cond="0">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_attachments_note">Notes about the attachments</label>
          <textarea id="fg_attachments_note" class="form-control" rows="3" data-fg-path="attachments_note" data-fg-kind="text"></textarea>
          <p id="fg_attachments_note-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="form-label fw-semibold small mb-0 fg-label"><span id="fg_about-label">About you</span></div>
          <div class="border rounded bg-body" data-fg-rich>
            <div class="d-flex flex-wrap gap-1 border-bottom p-1" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
              <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
              <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
              <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
              <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
              <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
            </div>
            <div id="fg_about" class="fg-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" data-fg-path="about" data-fg-kind="richtext"></div>
          </div>
          <p class="form-text mt-0 mb-0 fg-description">Bold, lists and links are kept.</p>
          <p id="fg_about-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Meeting point</legend>
          <div class="d-flex flex-column gap-2" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
            <div class="fg-location-map w-100 border rounded" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
            <div class="d-flex flex-wrap align-items-end gap-2">
              <label class="fg-location-coord d-flex flex-column gap-1 small">
                <span>Latitude</span>
                <input id="fg_meet" type="number" class="form-control" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat data-fg-path="meet" data-fg-kind="location">
              </label>
              <label class="fg-location-coord d-flex flex-column gap-1 small">
                <span>Longitude</span>
                <input id="fg_meet-lng" type="number" class="form-control" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng data-fg-path="meet">
              </label>
              <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-mine>Use my location</button>
              <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-clear>Clear</button>
            </div>
            <p class="fg-location-status small mb-0" aria-live="polite" data-fg-loc-status></p>
          </div>
          <p id="fg_meet-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Signature</legend>
          <div class="d-flex flex-column gap-2" data-fg-sign>
            <canvas id="fg_signature" class="fg-signature-pad d-block w-100 border rounded bg-white" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature" data-fg-path="signature" data-fg-kind="signature"></canvas>
            <div class="d-flex justify-content-end gap-2">
              <input type="text" class="form-control" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
              <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-sign-clear>Clear</button>
            </div>
          </div>
          <p id="fg_signature-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
