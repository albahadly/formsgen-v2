    private static readonly string[] fgSecAnnounce_ks_wizard =
    {
        "Step 1 of 2: Shipping",
        "Step 2 of 2: Review",
    };

    private async Task FgGo_ks_wizard(int index)
    {
        fgSec_ks_wizard = index;
        await FgAnnounce(fgSecAnnounce_ks_wizard[index]);
    }

    private async Task FgNext_ks_wizard()
    {
        var members = fgSec_ks_wizard switch
        {
            0 => new[] { nameof(KitchenSinkFormModel.ShippingCity) },
            1 => new[] { nameof(KitchenSinkFormModel.OrderNotes) },
            _ => Array.Empty<string>(),
        };
        if (FgValidateMembers(members) && fgSec_ks_wizard < 1) await FgGo_ks_wizard(fgSec_ks_wizard + 1);
    }

    private static readonly string[][] fgSecMembers_ks_social_tabs =
    {
        new[] { "Twitter" },
        new[] { "Github" },
    };

    private static readonly string[][] fgSecMembers_ks_wizard =
    {
        new[] { "ShippingCity" },
        new[] { "OrderNotes" },
    };

    private bool FgHasMessages(string[] members)
    {
        foreach (var name in members)
        {
            if (fgEdit.GetValidationMessages(new FieldIdentifier(Model, name)).Any()) return true;
        }
        return false;
    }

    private void FgJumpToError()
    {
        if (!FgHasMessages(fgSecMembers_ks_social_tabs[fgSec_ks_social_tabs]))
        {
            for (var i = 0; i < fgSecMembers_ks_social_tabs.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_social_tabs[i])) { fgSec_ks_social_tabs = i; break; }
            }
        }
        if (!FgHasMessages(fgSecMembers_ks_wizard[fgSec_ks_wizard]))
        {
            for (var i = 0; i < fgSecMembers_ks_wizard.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_wizard[i])) { fgSec_ks_wizard = i; break; }
            }
        }
    }

    private static void FgToggle(List<string> list, string value, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on) { if (!list.Contains(value)) list.Add(value); }
        else { list.Remove(value); }
    }

    private readonly FgStore<string> fgTagDrafts = new(_ => "");

    private void FgAddTag(List<string> list, string key)
    {
        var draft = fgTagDrafts[key].Trim();
        if (draft.Length > 0 && !list.Contains(draft))
        {
            list.Add(draft);
            FgChanged(key);
        }
        fgTagDrafts[key] = "";
    }

    private void FgRemoveTag(List<string> list, int index, string key)
    {
        list.RemoveAt(index);
        FgChanged(key);
    }

    private static readonly string[] fgItemFields_references = { "Name", "Email" };
    private readonly Dictionary<string, ElementReference> fgAddRefs = new();

    private bool FgHasItemErrors(object item, string[] fields) =>
        fields.Any(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any());

    // An outer repeater's checks include its inner repeaters' items.
    private bool FgRepeaterHasErrors_references() =>
        Model.References.Any(item => FgHasItemErrors(item, fgItemFields_references));

    private bool FgValidateRepeater_references()
    {
        var ok = true;
        foreach (var item in Model.References)
        {
            foreach (var name in fgItemFields_references) ok &= FgValidateItemField(new FieldIdentifier(item, name), false);
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private readonly HashSet<FieldIdentifier> fgDeferredItemFields = new();
    private readonly Dictionary<object, ElementReference> fgItemRefs = new();
    private object? fgFocusItem;

    // A stable id per item object (radio group names, field keys).
    private readonly System.Runtime.CompilerServices.ConditionalWeakTable<object, string> fgItemIds = new();
    private int fgNextItemId;

    private string FgItemId(object item) => fgItemIds.GetValue(item, _ => (++fgNextItemId).ToString());
    private readonly Dictionary<object, ElementReference> fgMoveUpRefs = new();
    private readonly Dictionary<object, ElementReference> fgMoveDownRefs = new();
    private (object Item, bool Up)? fgFocusMove;

    private static string FgMoveLabel(string path, int index, bool up) =>
        (up ? "Move {label} up" : "Move {label} down").Replace("{label}", FgItemLabel(path, index));

    /** Swaps an item with its neighbour; focus stays on the moved item. */
    private async Task FgMoveItem<T>(List<T> list, string path, int index, int delta) where T : class
    {
        var target = index + delta;
        if (target < 0 || target >= list.Count) return;
        var label = FgItemLabel(path, index);
        (list[index], list[target]) = (list[target], list[index]);
        // The same button when the moved item still has it, else the other one.
        fgFocusMove = (list[target], delta < 0 ? target > 0 : target == list.Count - 1);
        await FgAnnounce("{label} moved to position {n}".Replace("{label}", label).Replace("{n}", (target + 1).ToString()));
    }

    // Dragging items by their handle: a script on the form's root runs the
    // drag (Razor can't accept a drop only while dragging, nor set drag data)
    // and calls FgItemDropped; lists are known by id (data-fg-list).
    private readonly List<(object List, string Path)> fgLists = new();

    private int FgListId(object list, string path)
    {
        var index = fgLists.FindIndex(entry => ReferenceEquals(entry.List, list));
        if (index != -1) return index;
        fgLists.Add((list, path));
        return fgLists.Count - 1;
    }

    private const string FgItemDragScript = @"window.fgItemDrag = window.fgItemDrag || function (root, dotnet) {
  var drag = null;
  function itemOf(el) { return el && el.closest ? el.closest('[data-fg-item]') : null; }
  function listOf(item) { return item.parentElement.getAttribute('data-fg-list'); }
  function indexOf(item) { return Array.prototype.indexOf.call(item.parentElement.querySelectorAll(':scope > [data-fg-item]'), item); }
  function target(el) {
    var item = itemOf(el);
    while (item && listOf(item) !== drag.list) item = itemOf(item.parentElement);
    return item;
  }
  function paint() {
    Array.prototype.forEach.call(root.querySelectorAll('[data-fg-item]'), function (el) {
      var mine = drag && listOf(el) === drag.list;
      var index = mine ? indexOf(el) : -1;
      el.toggleAttribute('data-fg-drag', Boolean(mine && index === drag.from));
      if (mine && index === drag.at && index !== drag.from) el.setAttribute('data-fg-drop', index < drag.from ? 'before' : 'after');
      else el.removeAttribute('data-fg-drop');
    });
  }
  root.addEventListener('dragstart', function (event) {
    var handle = event.target.closest && event.target.closest('[data-fg-handle]');
    if (!handle) return;
    var item = itemOf(handle);
    drag = { list: listOf(item), from: indexOf(item), at: -1 };
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/plain', '');
    event.dataTransfer.setDragImage(item, 16, 16);
    paint();
  });
  root.addEventListener('dragover', function (event) {
    if (!drag) return;
    var item = target(event.target);
    if (!item) return;
    event.preventDefault();
    event.dataTransfer.dropEffect = 'move';
    var at = indexOf(item);
    if (at !== drag.at) { drag.at = at; paint(); }
  });
  root.addEventListener('drop', function (event) {
    if (!drag) return;
    var item = target(event.target);
    if (!item) return;
    event.preventDefault();
    var done = drag;
    drag = null;
    paint();
    dotnet.invokeMethodAsync('FgItemDropped', Number(done.list), done.from, indexOf(item));
  });
  root.addEventListener('dragend', function () {
    if (!drag) return;
    drag = null;
    paint();
  });
};";

    [Microsoft.JSInterop.JSInvokable]
    public async Task FgItemDropped(int list, int from, int to)
    {
        if (list < 0 || list >= fgLists.Count || fgLists[list].List is not System.Collections.IList items) return;
        if (from == to || from < 0 || to < 0 || from >= items.Count || to >= items.Count) return;
        var label = FgItemLabel(fgLists[list].Path, from);
        var moved = items[from]!;
        items.RemoveAt(from);
        items.Insert(to, moved);
        fgFocusItem = moved;
        await FgAnnounce("{label} moved to position {n}".Replace("{label}", label).Replace("{n}", (to + 1).ToString()));
        StateHasChanged();
    }

    private string? fgFocusAdd;

    private void FgFieldChanged(FieldIdentifier field)
    {
        FgCalc();
        FgRevalidateCalc();
        if (ReferenceEquals(field.Model, Model))
        {
            FgFieldChanged(field.FieldName);
            return;
        }
        if (fgPressing)
        {
            fgDeferredItemFields.Add(field);
            return;
        }
        FgValidateItemField(field);
    }

    /** First rule violation of an item field (null when valid or hidden). */
    private string? FgItemError(object model, string name)
    {
        switch (model)
        {
            case FgReferencesItem item:
                switch (name)
                {
                    case "Name":
                    {
                        if (string.IsNullOrWhiteSpace(item.Name)) return "This field is required";
                        return null;
                    }
                    case "Email":
                    {
                        if (!((Equals(item.MayContact, true)))) return null;
                        if (!(string.IsNullOrWhiteSpace(item.Email)) && (!System.Text.RegularExpressions.Regex.IsMatch(item.Email, @"^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))) return "Must be a valid email address";
                        return null;
                    }
                }
                break;
        }
        return null;
    }

    private bool FgValidateItemField(FieldIdentifier field, bool notify = true)
    {
        fgMessages.Clear(field);
        var error = FgItemError(field.Model, field.FieldName);
        if (error != null) fgMessages.Add(field, error);
        if (notify) fgEdit.NotifyValidationStateChanged();
        return error == null;
    }

    private int FgItemErrorCount()
    {
        var count = 0;
        foreach (var item in Model.References)
        {
            count += fgItemFields_references.Count(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any());
        }
        return count;
    }

    /** A list path without item indexes: "travellers.2.bags" → "travellers.bags". */
    private static string FgTpl(string path) => System.Text.RegularExpressions.Regex.Replace(path, @"\\.\\d+(?=\\.|$)", "");

    private static string FgItemLabel(string path, int index) => (FgTpl(path) switch
    {
        "references" => "Reference {n}",
        _ => "{n}",
    }).Replace("{n}", (index + 1).ToString());

    private static string FgRemoveLabel(string path, int index) =>
        "Remove {label}".Replace("{label}", FgItemLabel(path, index));

    private async Task FgAddItem<T>(List<T> list, string path, int max) where T : class, new()
    {
        if (list.Count >= max) return;
        var item = new T();
        list.Add(item);
        fgFocusItem = item;
        await FgAnnounce("{label} added".Replace("{label}", FgItemLabel(path, list.Count - 1)));
    }

    private async Task FgRemoveItem<T>(List<T> list, string path, int index, int min, string[] fields) where T : class
    {
        if (list.Count <= min || index >= list.Count) return;
        var label = FgItemLabel(path, index);
        var item = list[index];
        foreach (var name in fields) fgMessages.Clear(new FieldIdentifier(item, name));
        fgItemRefs.Remove(item);
        list.RemoveAt(index);
        fgEdit.NotifyValidationStateChanged();
        if (list.Count > 0) fgFocusItem = list[Math.Min(index, list.Count - 1)];
        else fgFocusAdd = path;
        await FgAnnounce("{label} removed".Replace("{label}", label));
    }

    private async Task FgFocusRepeaters()
    {
        if (fgFocusMove is { } move)
        {
            fgFocusMove = null;
            if ((move.Up ? fgMoveUpRefs : fgMoveDownRefs).TryGetValue(move.Item, out var buttonRef)) await buttonRef.FocusAsync();
            return;
        }
        if (fgFocusItem != null && fgItemRefs.TryGetValue(fgFocusItem, out var itemRef))
        {
            fgFocusItem = null;
            await itemRef.FocusAsync();
        }
        else if (fgFocusAdd != null)
        {
            var path = fgFocusAdd;
            fgFocusAdd = null;
            if (fgAddRefs.TryGetValue(path, out var addRef) && addRef.Context != null) await addRef.FocusAsync();
        }
    }

    public sealed record FgUpload(string Name, long Size, string ContentType, byte[]? Data, string? Thumb);

    private readonly FgStore<int> fgFileKeys = new(_ => 0);
    // Drop zones with files dragged over them.
    private readonly FgStore<bool> fgDragging = new(_ => false);
    // "Only one file fits here, …" per field, until its next change.
    private readonly FgStore<string> fgFileNotes = new(_ => "");
    private readonly Dictionary<string, InputFile> fgFileInputs = new();
    private string? fgFocusFile;

    private async Task FgPickFiles(List<FgUpload> list, InputFileChangeEventArgs e, bool multiple, long maxBytes, bool thumbs, string member)
    {
        var picked = new List<FgUpload>();
        // Every input takes several files (a browser rejects a drop of several
        // on one that doesn't); a field that takes one keeps the first and says so.
        var all = e.GetMultipleFiles(int.MaxValue);
        fgFileNotes[member] = !multiple && all.Count > 1 ? "Only one file fits here, so {name} was added.".Replace("{name}", all[0].Name) : "";
        foreach (var file in multiple ? all : all.Take(1))
        {
            byte[]? data = null;
            if (maxBytes <= 0 || file.Size <= maxBytes)
            {
                using var buffer = new System.IO.MemoryStream();
                await file.OpenReadStream(maxBytes > 0 ? maxBytes : long.MaxValue).CopyToAsync(buffer);
                data = buffer.ToArray();
            }
            string? thumb = null;
            if (thumbs && file.ContentType.StartsWith("image/"))
            {
                try
                {
                    var small = await file.RequestImageFileAsync("image/png", 80, 80);
                    using var buffer = new System.IO.MemoryStream();
                    await small.OpenReadStream(long.MaxValue).CopyToAsync(buffer);
                    thumb = "data:image/png;base64," + Convert.ToBase64String(buffer.ToArray());
                }
                catch (Exception) { }
            }
            picked.Add(new FgUpload(file.Name, file.Size, file.ContentType, data, thumb));
        }
        if (picked.Count == 0) return;
        if (!multiple) list.Clear();
        list.AddRange(picked);
        fgFileKeys[member]++;
        fgFocusFile = member;
        fgEdit.NotifyFieldChanged(FgField(member));
        if (fgFileNotes[member] != "") await FgAnnounce(fgFileNotes[member]);
    }

    private void FgRemoveFile(List<FgUpload> list, FgUpload file, string member)
    {
        fgFileNotes[member] = "";
        list.RemoveAll(f => ReferenceEquals(f, file));
        fgEdit.NotifyFieldChanged(FgField(member));
    }

    private static string FgFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024d))} KB";

    private static string FgRemoveFileLabel(string name) => "Remove {name}".Replace("{name}", name);

    /** Payload entry for an upload: { name, size, type } per file; the files become parts named by data path. */
    private static List<Dictionary<string, object?>> FgFilesPart(List<(string Path, FgUpload File)> parts, string path, List<FgUpload> files)
    {
        foreach (var file in files) parts.Add((path, file));
        return files.Select(f => new Dictionary<string, object?> { ["name"] = f.Name, ["size"] = f.Size, ["type"] = f.ContentType }).ToList();
    }

    private async Task FgFocusUploads()
    {
        if (fgFocusFile == null) return;
        var member = fgFocusFile;
        fgFocusFile = null;
        if (fgFileInputs.TryGetValue(member, out var input) && input.Element is ElementReference element) await element.FocusAsync();
    }

    // The two inputs render the Shown values and are re-created (a new
    // Version in their @key) only when a value is corrected (a handle
    // pushed past the other) or reset: re-rendering a live range input's
    // value would fight the user's drag or key presses.
    public sealed class FgRange
    {
        private static int fgVersions;

        public FgRange(double from, double to)
        {
            From = from;
            To = to;
            Redraw();
        }

        public double From { get; set; }
        public double To { get; set; }
        [System.Text.Json.Serialization.JsonIgnore]
        public double ShownFrom { get; private set; }
        [System.Text.Json.Serialization.JsonIgnore]
        public double ShownTo { get; private set; }
        [System.Text.Json.Serialization.JsonIgnore]
        public int Version { get; private set; }

        public void Redraw()
        {
            ShownFrom = From;
            ShownTo = To;
            Version = System.Threading.Interlocked.Increment(ref fgVersions);
        }
    }

    private readonly Dictionary<string, ElementReference> fgDualRefs = new();
    private string? fgFocusDual;

    private static string FgNum(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string FgDualFill(FgRange range, double min, double max)
    {
        double Pct(double n) => max > min ? (n - min) / (max - min) * 100 : 0;
        return $"inset-inline-start: {FgNum(Pct(range.From))}%; inset-inline-end: {FgNum(100 - Pct(range.To))}%";
    }

    // With both handles together, the one that can still move is on top.
    private static bool FgDualFromOnTop(FgRange range, double min, double max) =>
        range.From == range.To && range.From > (min + max) / 2;

    // Handles can't cross: a value past the other handle stops at it (and
    // the input is redrawn there, keeping focus).
    private void FgDualSet(FgRange range, bool from, ChangeEventArgs e, string id)
    {
        var text = Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture);
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var n)) return;
        var crossed = from ? n > range.To : n < range.From;
        if (from) range.From = Math.Min(n, range.To);
        else range.To = Math.Max(n, range.From);
        if (!crossed) return;
        range.Redraw();
        fgFocusDual = id;
    }

    private async Task FgFocusDual()
    {
        if (fgFocusDual == null) return;
        var id = fgFocusDual;
        fgFocusDual = null;
        if (fgDualRefs.TryGetValue(id, out var input)) await input.FocusAsync();
    }

    public sealed class FgDateRange
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
    }

    private void FgSetDate(FgDateRange range, bool from, ChangeEventArgs e, string member)
    {
        var value = Convert.ToString(e.Value) ?? "";
        if (from) range.From = value;
        else range.To = value;
        FgChanged(member);
    }

    // Field keys: a member name ("Stay"), or for a field inside a repeater
    // item its template member plus the item ("CrewIStay#2"). Drafts and
    // chosen countries are stored per key; change notices go to the field.
    private readonly Dictionary<string, (object Item, string Name)> fgItemKeyOwners = new();

    private string FgItemKey(object item, string template, string name)
    {
        var key = template + "#" + FgItemId(item);
        fgItemKeyOwners[key] = (item, name);
        return key;
    }

    private FieldIdentifier FgField(string key) =>
        fgItemKeyOwners.TryGetValue(key, out var owner) ? new FieldIdentifier(owner.Item, owner.Name) : new FieldIdentifier(Model, key);

    private static string FgTemplateKey(string key) => key.Contains('#') ? key[..key.IndexOf('#')] : key;

    /** A dictionary whose missing keys read as a fallback (UI state per field key). */
    public sealed class FgStore<T> : Dictionary<string, T>
    {
        private readonly Func<string, T> fallback;

        public FgStore(Func<string, T> fallback) => this.fallback = fallback;

        public new T this[string key]
        {
            get => TryGetValue(key, out var value) ? value : fallback(key);
            set => base[key] = value;
        }
    }

    private void FgChanged(string member) => fgEdit.NotifyFieldChanged(FgField(member));

    private void FgSetCell(Dictionary<string, string?> answers, string row, string column, string member)
    {
        answers[row] = column;
        FgChanged(member);
    }

    // Ticks or unticks one answer of a row; answers stay in column order.
    private void FgToggleCell(Dictionary<string, List<string>> answers, string row, string column, string[] columns, string member)
    {
        var current = answers[row];
        answers[row] = columns.Where(c => (c == column) != current.Contains(c)).ToList();
        FgChanged(member);
    }

    private static readonly Dictionary<string, string> FgDial = new()
    {
        ["AD"] = "376",
        ["AE"] = "971",
        ["AF"] = "93",
