        "interests": fgGet("interests"),
        "channels": fgGet("channels"),
        "topics": fgGet("topics"),
        "billing": fgGet("billing"),
        "extras": fgGet("extras"),
        "notify": fgGet("notify"),
        "appointment": fgGet("appointment"),
        "brand_color": fgGet("brand_color"),
        "volume": fgGet("volume"),
        "source": fgGet("source"),
        "references": fgItemIndexes("references").map(function (i) { return ({ "name": fgGet("references." + i + ".name"), "may_contact": fgGet("references." + i + ".may_contact"), ...((fgGet("references." + i + ".may_contact") === true) ? { "email": fgGet("references." + i + ".email") } : {}) }) }),
        "attachments": fgGet("attachments"),
        ...(fgVisible_attachments_note() ? { "attachments_note": fgGet("attachments_note") } : {}),
        "contact_method": fgGet("contact_method"),
        ...(fgVisible_contact_phone() ? { "contact_phone": fgGet("contact_phone") } : {}),
        ...(fgVisible_contact_other() ? { "contact_other": fgGet("contact_other") } : {}),
        "twitter": fgGet("twitter"),
        "github": fgGet("github"),
        "shipping_city": fgGet("shipping_city"),
        "order_notes": fgGet("order_notes"),
        "newsletter": fgGet("newsletter"),
        "terms": fgGet("terms"),
      }
    }

    var form = document.getElementById('fg-form')
    // A blur error appearing while a pointer is held reflows the form and
    // the release misses its target; defer blur validation until the press
    // ends (after the click has been dispatched).
    var fgPressing = false
    var fgDeferred = []
    function fgBlurValidate(path) {
      touched[path] = true
      if (fgPressing) {
        if (fgDeferred.indexOf(path) === -1) fgDeferred.push(path)
        return
      }
      validateField(path)
    }
    function fgFlushDeferred() {
      var paths = fgDeferred
      fgDeferred = []
      paths.forEach(function (path) { validateField(path) })
    }
    function fgPointerEnd() {
      if (!fgPressing) return
      fgPressing = false
      setTimeout(fgFlushDeferred, 0)
    }
    form.addEventListener('pointerdown', function () {
      fgFlushDeferred()
      fgPressing = true
    }, true)
    window.addEventListener('pointerup', fgPointerEnd)
    window.addEventListener('pointercancel', fgPointerEnd)
    form.addEventListener('focusout', function (event) {
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path) fgBlurValidate(path)
    })
    form.addEventListener('input', onFieldEvent)
    form.addEventListener('change', onFieldEvent)
    function onFieldEvent(event) {
      updateConditions()
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path && touched[path]) validateField(path)
    }

    Array.prototype.forEach.call(document.querySelectorAll('[data-fg-reset]'), function (button) {
      button.addEventListener('click', function () {
        form.reset()
        Object.keys(fgTags).forEach(function (path) {
          fgTags[path] = []
          if (fgTagsPaint[path]) fgTagsPaint[path]()
        })
        Object.keys(fgFiles).forEach(function (path) {
          fgFiles[path] = []
          fgPaintFiles(path)
        })
        Object.keys(touched).forEach(function (path) { delete touched[path] })
        Object.keys(FG_VALIDATORS).forEach(function (path) { setError(path, null) })
        Object.keys(FG_REPEATERS).forEach(function (path) {
          fgItemElements(path).forEach(function (item) { item.remove() })
          for (var n = 0; n < FG_REPEATERS[path].initial; n++) fgAddItem(path, false)
        })
        document.getElementById('fg-result').hidden = true
        updateConditions()
        fgAnnounce("The form was reset.")
      })
    })

    form.addEventListener('submit', function (event) {
      event.preventDefault()
      var failed = 0
      fgAllPaths().forEach(function (path) {
        touched[path] = true
        if (!validateField(path)) failed++
      })
      if (failed > 0) {
        fgAnnounce(fgErrorsText(failed))
        // Move each tabs/steps host to its first section holding an error
        // (unless the visible one already shows one).
        FG_SECTIONS.forEach(function (meta) {
          var current = fgStepPaths(meta, fgSecState[meta.key])
          if (current.some(fgHasError)) return
          for (var i = 0; i < meta.stepPaths.length; i++) {
            if ((fgStepPaths(meta, i)).some(fgHasError)) { fgSetSec(meta, i); break }
          }
        })
        return
      }
      var data = buildPayload()
      var out = document.getElementById('fg-result')
      out.textContent = JSON.stringify(data, fgFileJson, 2)
      out.hidden = false
      fgAnnounce("Form submitted.")
      console.log('Form submitted', data)
    })

    updateConditions()
  })()
  </script>
</body>
</html>
"
