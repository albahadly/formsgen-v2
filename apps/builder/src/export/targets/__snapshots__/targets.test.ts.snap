  },
  'website': function (data: FormData) {
  const v = data.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function (data: FormData) {
  const v = data.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'plan': function (data: FormData) {
  const v = data.plan
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'shipping_city': function (data: FormData) {
  const v = data.shipping_city
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "website": data.website,
    "seats": data.seats,
    "satisfaction": data.satisfaction,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "password": data.account.password,
      "bio": data.account.bio,
      "birthday": data.account.birthday,
    },
    "plan": data.plan,
    "interests": data.interests,
    "channels": data.channels,
    "contact_method": data.contact_method,
    ...(fgVisible_contact_phone(data) ? { "contact_phone": data.contact_phone } : {}),
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "twitter": data.twitter,
    "github": data.github,
    "shipping_city": data.shipping_city,
    "order_notes": data.order_notes,
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

const fgStepPaths_ks_wizard = [["shipping_city"], ["order_notes"]]

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgStepPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = validators[path]
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) setFgSec_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = validators[path]
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
  }

  function touch(path: string): void {
    touched.current.add(path)
    validateField(path, form)
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of Object.keys(validators)) {
      touched.current.add(path)
      const message = validators[path]!(form)
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) return
    const data = buildPayload(form)
    setResult(data)
    onSubmit?.(data)
  }

  return (
    <form className="container py-4" dir="ltr" noValidate onSubmit={handleSubmit}>
      <div className="row g-3">
        <div className="col-12 col-md-12">
          <h2 className="fw-semibold">Kitchen Sink</h2>
        </div>
        <div className="col-12 col-md-12">
          <p className="text-secondary">Every implemented element appears in this form.</p>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_full_name">Full name<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "form-control is-invalid" : "form-control"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_email">Email<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "form-control is-invalid" : "form-control"} placeholder="jane@example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_seats">Seats</label>
            <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "form-control is-invalid" : "form-control"} min="1" max="50" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
            {errors['seats'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="form-range" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="form-text mt-0">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <hr className="border-top" />
        </div>
        <div className="col-12 col-md-12">
          <div className="row g-3">
            <div className="col-12 col-md-6">
              <div className="d-flex flex-column gap-1">
                <label className="form-label fw-semibold mb-0" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="col-12 col-md-6">
              <div className="d-flex flex-column gap-1">
                <label className="form-label fw-semibold mb-0" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="border rounded p-3 bg-body-tertiary">
            <legend className="fw-semibold text-secondary small px-1">Account</legend>
            <div className="row g-3">
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_username">Username<span className="text-danger ms-1" aria-hidden="true">*</span></label>
                  <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  {errors['account.username'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.bio']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_birthday">Birthday</label>
                  <input id="fg_account_birthday" type="date" value={form.account.birthday} className={errors['account.birthday'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.birthday', e.target.value)} onBlur={() => touch('account.birthday')} />
                  {errors['account.birthday'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.birthday']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
              <legend className="form-label fw-semibold mb-0">Plan<span className="text-danger ms-1" aria-hidden="true">*</span></legend>
              <div className="d-flex flex-column gap-1">
                <label className="form-check" htmlFor="fg_plan_free">
                  <input id="fg_plan_free" type="radio" className="form-check-input" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                  <span>Free</span>
                </label>
                <label className="form-check" htmlFor="fg_plan_pro">
                  <input id="fg_plan_pro" type="radio" className="form-check-input" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                  <span>Pro</span>
                </label>
              </div>
            </fieldset>
            {errors['plan'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
              <legend className="form-label fw-semibold mb-0">Interests</legend>
              <div className="d-flex flex-column gap-1">
                <label className="form-check" htmlFor="fg_interests_news">
                  <input id="fg_interests_news" type="checkbox" className="form-check-input" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                  <span>News</span>
                </label>
                <label className="form-check" htmlFor="fg_interests_product">
                  <input id="fg_interests_product" type="checkbox" className="form-check-input" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                  <span>Product updates</span>
                </label>
              </div>
            </fieldset>
            {errors['interests'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "form-select is-invalid" : "form-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['channels']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_method">Preferred contact method<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <select id="fg_contact_method" value={form.contact_method ?? ''} className={errors['contact_method'] ? "form-select is-invalid" : "form-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => setField('contact_method', e.target.value === '' ? null : e.target.value)} onBlur={() => touch('contact_method')}>
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </select>
            {errors['contact_method'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_method']}</p>}
          </div>
        </div>
        {((form.contact_method === "phone")) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column gap-1">
              <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_phone">Phone number</label>
              <input id="fg_contact_phone" type="tel" value={form.contact_phone} className={errors['contact_phone'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('contact_phone', e.target.value)} onBlur={() => touch('contact_phone')} />
              {errors['contact_phone'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_phone']}</p>}
            </div>
          </div>
        )}
        {((form.contact_method === "other")) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column gap-1">
              <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_other">Describe your preferred method</label>
              <textarea id="fg_contact_other" rows={3} value={form.contact_other} className={errors['contact_other'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('contact_other', e.target.value)} onBlur={() => touch('contact_other')} />
              {errors['contact_other'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_other']}</p>}
            </div>
          </div>
        )}
        <div className="col-12 col-md-12">
          <div>
            <div className="nav nav-tabs mb-3" role="tablist">
              <button type="button" className={fgSec_ks_social_tabs === 0 ? "nav-link active" : "nav-link"} onClick={() => setFgSec_ks_social_tabs(0)}>Social</button>
              <button type="button" className={fgSec_ks_social_tabs === 1 ? "nav-link active" : "nav-link"} onClick={() => setFgSec_ks_social_tabs(1)}>Code</button>
            </div>
            <div style={{ display: fgSec_ks_social_tabs === 0 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_twitter">Twitter handle</label>
                    <input id="fg_twitter" type="text" value={form.twitter} className={errors['twitter'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('twitter', e.target.value)} onBlur={() => touch('twitter')} />
                    {errors['twitter'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['twitter']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div style={{ display: fgSec_ks_social_tabs === 1 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_github">GitHub username</label>
                    <input id="fg_github" type="text" value={form.github} className={errors['github'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('github', e.target.value)} onBlur={() => touch('github')} />
                    {errors['github'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['github']}</p>}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div>
            <ol className="nav mb-3 gap-3 small text-secondary list-unstyled d-flex flex-wrap">
              <li className={fgSec_ks_wizard === 0 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2"}>1. Shipping</li>
              <li className={fgSec_ks_wizard === 1 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2"}>2. Review</li>
            </ol>
            <div style={{ display: fgSec_ks_wizard === 0 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_shipping_city">Shipping city<span className="text-danger ms-1" aria-hidden="true">*</span></label>
                    <input id="fg_shipping_city" type="text" value={form.shipping_city} className={errors['shipping_city'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('shipping_city', e.target.value)} onBlur={() => touch('shipping_city')} />
                    {errors['shipping_city'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['shipping_city']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div style={{ display: fgSec_ks_wizard === 1 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_order_notes">Order notes</label>
                    <textarea id="fg_order_notes" rows={3} value={form.order_notes} className={errors['order_notes'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('order_notes', e.target.value)} onBlur={() => touch('order_notes')} />
                    {errors['order_notes'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['order_notes']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div className="mt-3 d-flex justify-content-between gap-2">
              {fgSec_ks_wizard > 0 && <button type="button" className="btn btn-outline-secondary" onClick={() => setFgSec_ks_wizard(fgSec_ks_wizard - 1)}>Back</button>}
              {fgSec_ks_wizard < 1 && <button type="button" className="btn btn-primary" onClick={fgNext_ks_wizard}>Next</button>}
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <div className="form-check">
              <input id="fg_newsletter" type="checkbox" checked={form.newsletter} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('newsletter', e.target.checked); touch('newsletter') }} />
              <label className="form-check-label" htmlFor="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            {errors['newsletter'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['newsletter']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <div className="form-check">
              <input id="fg_terms" type="checkbox" checked={form.terms} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('terms', e.target.checked); touch('terms') }} />
