// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`blazor target > snapshot (bootstrap5) 1`] = `
"@* Generated by FormsGen (.NET 8). *@
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@inject Microsoft.AspNetCore.Components.NavigationManager FgNav
@inject Microsoft.JSInterop.IJSRuntime FgJs
@implements IDisposable

<EditForm EditContext="fgEdit" OnSubmit="FgSubmit" novalidate dir="ltr">
    <div class="p-3" @onpointerdown="FgPointerDown" @onpointerup="FgPointerEnd" @onpointerleave="FgPointerEnd" @onpointercancel="FgPointerEnd" @ref="fgFormRoot">
    <div class="row g-3">
        <div class="col-12 col-md-12 text-center">
          <h2 class="fg-heading text-primary">Kitchen Sink</h2>
        </div>
        <div class="col-12 col-md-12 text-center">
          <p class="text-secondary mb-0">Every implemented element appears in this form.</p>
        </div>
        <div class="col-12 col-md-12">
          <div class="text-secondary mb-0 fg-rich-text">
            <p>Hi @(FgOr(FgAnswer(Model.FullName, ", "), "there"))! Fields marked * are <strong>required</strong>. See the <a class="link-primary" href="https://example.com/docs">docs</a>:</p>
            <ul>
              <li><em>one</em> answer per row in Rating</li>
              <li>several in Usage</li>
            </ul>
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_full_name">Full name<span class="text-danger fg-required" aria-hidden="true">*</span></label>
            <InputText id="fg_full_name" @bind-Value="Model.FullName" class="form-control" placeholder="Jane Doe" />
            <ValidationMessage For="@(() => Model.FullName)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_email">Email<span class="text-danger fg-required" aria-hidden="true">*</span></label>
            <InputText id="fg_email" type="email" @bind-Value="Model.Email" class="form-control" placeholder="jane&#64;example.com" />
            <ValidationMessage For="@(() => Model.Email)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_website">Website</label>
            <InputText id="fg_website" type="url" @bind-Value="Model.Website" class="form-control form-control-sm rounded" />
            <ValidationMessage For="@(() => Model.Website)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <div class="fg-label-row"><label class="form-label fw-semibold small mb-0 fg-label" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
            <div class="input-group">
              <InputNumber id="fg_seats" @bind-Value="Model.Seats" class="form-control" aria-describedby="fg_seats-suffix" />
              <span id="fg_seats-suffix" class="input-group-text">people</span>
            </div>
            <ValidationMessage For="@(() => Model.Seats)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_seat_cost">Seat cost</label>
            <div class="input-group">
              <span id="fg_seat_cost-prefix" class="input-group-text">$</span>
              <input id="fg_seat_cost" type="text" readonly class="form-control bg-body-tertiary" value="@FgFmt(Model.SeatCost, 2)" aria-describedby="fg_seat_cost-prefix" />
            </div>
            <ValidationMessage For="@(() => Model.SeatCost)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" @bind="Model.Satisfaction" @bind:event="oninput" class="form-range" min="0" max="10" step="1" />
            <ValidationMessage For="@(() => Model.Satisfaction)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <hr class="border-top my-1 border-primary opacity-100" />
        </div>
        <div class="col-12 col-md-12">
          <div class="row g-3">
            <div class="col-6 col-md-6 col-lg-4">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_city">City</label>
                <InputText id="fg_city" @bind-Value="Model.City" class="form-control" />
                <ValidationMessage For="@(() => Model.City)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
              </div>
            </div>
            <div class="col-6 col-md-6">
              <div class="d-flex flex-column fg-field">
                <label class="visually-hidden" for="fg_zip">ZIP</label>
                <InputText id="fg_zip" @bind-Value="Model.Zip" class="form-control" />
                <ValidationMessage For="@(() => Model.Zip)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-12 account-box">
          <fieldset class="border rounded p-3 bg-body-tertiary">
            <legend class="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">Account</legend>
            <div class="row g-3">
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column fg-field">
                  <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_username">Username<span class="text-danger fg-required" aria-hidden="true">*</span></label>
                  <div class="input-group">
                    <span id="fg_account_username-prefix" class="input-group-text">&#64;</span>
                    <InputText id="fg_account_username" @bind-Value="Model.AccountUsername" class="form-control" aria-describedby="fg_account_username-prefix" />
                  </div>
                  <ValidationMessage For="@(() => Model.AccountUsername)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column fg-field">
                  <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_password">Password</label>
                  <InputText id="fg_account_password" type="password" @bind-Value="Model.AccountPassword" class="form-control" />
                  <ValidationMessage For="@(() => Model.AccountPassword)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column fg-field">
                  <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_bio">Bio</label>
                  <InputTextArea id="fg_account_bio" @bind-Value="Model.AccountBio" class="form-control form-control-lg rounded" rows="4" />
                  <ValidationMessage For="@(() => Model.AccountBio)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column fg-field">
                  <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_birthday">Birthday</label>
                  <InputText id="fg_account_birthday" type="date" @bind-Value="Model.AccountBirthday" class="form-control" />
                  <ValidationMessage For="@(() => Model.AccountBirthday)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column fg-field">
                  <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_avatar">Profile picture</label>
                  <div class="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary" data-fg-dragging='@(fgDragging["AccountAvatar"] ? "" : null)'>
                    <span class="fw-medium">Choose a file or drag it here</span>
                    <InputFile @key='fgFileKeys["AccountAvatar"]' @ref='fgFileInputs["AccountAvatar"]' id="fg_account_avatar" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept="image/*" multiple OnChange='@(e => FgPickFiles(Model.AccountAvatar, e, false, 2097152L, true, "AccountAvatar"))' @ondragenter='() => fgDragging["AccountAvatar"] = true' @ondragleave='() => fgDragging["AccountAvatar"] = false' @ondrop='() => fgDragging["AccountAvatar"] = false' />
                  </div>
                  @if (Model.AccountAvatar.Count > 0)
                  {
                      <ul class="list-group mt-2">
                          @foreach (var file in Model.AccountAvatar.ToList())
                          {
                              <li @key="file" class="list-group-item d-flex align-items-center gap-2">
                                  @if (file.Thumb != null)
                                  {
                                      <img class="rounded object-fit-cover" src="@file.Thumb" alt="" width="40" height="40" />
                                  }
                                  <span class="flex-grow-1 text-truncate">@file.Name</span>
                                  <span class="text-body-secondary small">@FgFileSize(file.Size)</span>
                                  <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.AccountAvatar, file, "AccountAvatar")'>×</button>
                              </li>
                          }
                      </ul>
                  }
                  @if (fgFileNotes["AccountAvatar"] != "")
                {
                    <p class="form-text mt-0 mb-0 fg-description" data-fg-file-note>@fgFileNotes["AccountAvatar"]</p>
                }
                  <ValidationMessage For="@(() => Model.AccountAvatar)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field" aria-labelledby="fg_plan-legend">
            <legend class="form-label fw-semibold small mb-0 fg-label"><span id="fg_plan-legend">Plan</span><span class="text-danger fg-required" aria-hidden="true">*</span><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" class="fg-tip-text">You can switch plans at any time</span></span></legend>
            <InputRadioGroup Name="fg_plan" @bind-Value="Model.Plan">
              <div class="d-flex flex-column fg-options">
                <label class="form-check mb-0" for="fg_plan-free">
                  <InputRadio id="fg_plan-free" class="form-check-input" Value="@("free")" />
                  <span>Free</span>
                </label>
                <label class="form-check mb-0" for="fg_plan-pro">
                  <InputRadio id="fg_plan-pro" class="form-check-input" Value="@("pro")" />
                  <span>Pro</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Plan)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Interests</legend>
            <div class="d-flex flex-column fg-options">
              <label class="form-check mb-0" for="fg_interests-news">
                <input id="fg_interests-news" type="checkbox" class="form-check-input" checked='@Model.Interests.Contains("news")' @onchange='e => FgToggle(Model.Interests, "news", e)' />
                <span>News</span>
              </label>
              <label class="form-check mb-0" for="fg_interests-product">
                <input id="fg_interests-product" type="checkbox" class="form-check-input" checked='@Model.Interests.Contains("product")' @onchange='e => FgToggle(Model.Interests, "product", e)' />
                <span>Product updates</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Interests)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_channels">Notification channels</label>
            <InputSelect id="fg_channels" multiple @bind-Value="Model.Channels" class="form-select">
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.Channels)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_topics">Topics</label>
            <div class="form-control d-flex flex-wrap align-items-center gap-1 px-2">
              @for (var fgTag = 0; fgTag < Model.Topics.Count; fgTag++)
              {
                  var fgIdx_Topics = fgTag;
                  <span class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">@Model.Topics[fgIdx_Topics] <button type="button" class="border-0 bg-transparent p-0 ms-1 text-white" aria-label="Remove @(Model.Topics[fgIdx_Topics])" @onclick='() => FgRemoveTag(Model.Topics, fgIdx_Topics, "Topics")'>&times;</button></span>
              }
              <input id="fg_topics" type="text" class="border-0 p-0 flex-grow-1 shadow-none bg-transparent" placeholder="Type and press Enter" @bind='fgTagDrafts["Topics"]' @bind:after='() => FgAddTag(Model.Topics, "Topics")'>
            </div>
            <p class="form-text mt-0 mb-0 fg-description">Free-text tags</p>
            <ValidationMessage For="@(() => Model.Topics)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Billing</legend>
            <InputRadioGroup Name="fg_billing" @bind-Value="Model.Billing">
              <div class="btn-group flex-wrap align-self-start">
                <InputRadio id="fg_billing-monthly" class="btn-check" Value="@("monthly")" />
                <label class="btn btn-outline-primary fg-option-button" for="fg_billing-monthly">Monthly</label>
                <InputRadio id="fg_billing-yearly" class="btn-check" Value="@("yearly")" />
                <label class="btn btn-outline-primary fg-option-button" for="fg_billing-yearly">Yearly</label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Billing)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Extras</legend>
            <div class="d-flex flex-column gap-2">
              <label class="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" for="fg_extras-support">
                <input id="fg_extras-support" type="checkbox" class="form-check-input m-0 flex-shrink-0" checked='@Model.Extras.Contains("support")' @onchange='e => FgToggle(Model.Extras, "support", e)' />
                <span>Priority support</span>
              </label>
              <label class="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" for="fg_extras-backup">
                <input id="fg_extras-backup" type="checkbox" class="form-check-input m-0 flex-shrink-0" checked='@Model.Extras.Contains("backup")' @onchange='e => FgToggle(Model.Extras, "backup", e)' />
                <span>Daily backups</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Extras)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <div class="form-check form-switch mb-0 fg-switch-wrap">
              <InputCheckbox id="fg_notify" role="switch" @bind-Value="Model.Notify" class="form-check-input fg-switch" />
              <label class="form-check-label" for="fg_notify">Email notifications</label>
            </div>
            <ValidationMessage For="@(() => Model.Notify)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_appointment">Appointment</label>
            <InputText id="fg_appointment" type="datetime-local" @bind-Value="Model.Appointment" class="form-control" />
            <ValidationMessage For="@(() => Model.Appointment)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_brand_color">Brand color</label>
            <InputText id="fg_brand_color" type="color" @bind-Value="Model.BrandColor" class="form-control form-control-color" />
            <ValidationMessage For="@(() => Model.BrandColor)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_volume">Volume</label>
            <input id="fg_volume" type="range" @bind="Model.Volume" @bind:event="oninput" class="form-range" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" />
            <ValidationMessage For="@(() => Model.Volume)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_budget">Budget</label>
            <div class="fg-dual">
              <div class="fg-dual-track"><div class="fg-dual-fill" style="@FgDualFill(Model.Budget, 0, 1000)"></div></div>
              <input @key='$"From{Model.Budget.Version}"' @ref='fgDualRefs["fg_budget"]' id="fg_budget" type="range" min="0" max="1000" step="50" value="@FgNum(Model.Budget.ShownFrom)" aria-label="Budget: Minimum" style="z-index: @(FgDualFromOnTop(Model.Budget, 0, 1000) ? 3 : 1)" @oninput='e => FgDualSet(Model.Budget, true, e, "fg_budget")' />
              <input @key='$"To{Model.Budget.Version}"' @ref='fgDualRefs["fg_budget-to"]' id="fg_budget-to" type="range" min="0" max="1000" step="50" value="@FgNum(Model.Budget.ShownTo)" aria-label="Budget: Maximum" style="z-index: 2" @oninput='e => FgDualSet(Model.Budget, false, e, "fg_budget-to")' />
            </div>
            <p class="form-text mt-0 mb-0 fg-description">@FgNum(Model.Budget.From) – @FgNum(Model.Budget.To)</p>
            <ValidationMessage For="@(() => Model.Budget)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_stay">Stay<span class="text-danger fg-required" aria-hidden="true">*</span></label>
            <div class="d-flex flex-wrap align-items-center gap-2 fg-pair">
              <input id="fg_stay" type="date" class="form-control" aria-label="Stay: Start date" value="@Model.Stay.From" @onchange='e => FgSetDate(Model.Stay, true, e, "Stay")' />
              <span aria-hidden="true">–</span>
              <input id="fg_stay-to" type="date" class="form-control" min="@Model.Stay.From" aria-label="Stay: End date" value="@Model.Stay.To" @onchange='e => FgSetDate(Model.Stay, false, e, "Stay")' />
            </div>
            <ValidationMessage For="@(() => Model.Stay)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_days">Available days</label>
            <div class="d-flex flex-wrap align-items-center gap-2 fg-pair">
              <input id="fg_days" type="date" class="form-control" value='@fgDateDrafts["Days"]' @onchange='e => fgDateDrafts["Days"] = Convert.ToString(e.Value) ?? ""' />
              <button type="button" class="btn btn-outline-secondary fw-semibold px-3 flex-shrink-0 text-nowrap" @onclick='() => FgAddDate(Model.Days, "Days")'>Add date</button>
            </div>
            @if (Model.Days.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mt-2">
                    @foreach (var date in Model.Days.ToList())
                    {
                        <span @key="date" class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">@date <button type="button" class="border-0 bg-transparent p-0 ms-1 text-white" aria-label='@FgRemoveDateLabel(date)' @onclick='() => FgRemoveDate(Model.Days, date, "Days")'>&times;</button></span>
                    }
                </div>
            }
            <ValidationMessage For="@(() => Model.Days)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">How did we do?<span class="text-danger fg-required" aria-hidden="true">*</span></legend>
            <div class="table-responsive">
              <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
                <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Poor</th><th scope="col" class="text-center fw-semibold text-body-secondary">OK</th><th scope="col" class="text-center fw-semibold text-body-secondary">Great</th></tr></thead>
                <tbody>
                <tr><th scope="row" class="text-start fw-medium">Speed</th><td class="text-center"><input id="fg_rating" type="radio" class="form-check-input" name="fg_rating_speed" value="1" checked='@(Model.Rating["speed"] == "1")' aria-label="Speed: Poor" @onchange='() => FgSetCell(Model.Rating, "speed", "1", "Rating")' /></td><td class="text-center"><input id="fg_rating-0-1" type="radio" class="form-check-input" name="fg_rating_speed" value="2" checked='@(Model.Rating["speed"] == "2")' aria-label="Speed: OK" @onchange='() => FgSetCell(Model.Rating, "speed", "2", "Rating")' /></td><td class="text-center"><input id="fg_rating-0-2" type="radio" class="form-check-input" name="fg_rating_speed" value="3" checked='@(Model.Rating["speed"] == "3")' aria-label="Speed: Great" @onchange='() => FgSetCell(Model.Rating, "speed", "3", "Rating")' /></td></tr>
                <tr><th scope="row" class="text-start fw-medium">Quality</th><td class="text-center"><input id="fg_rating-1-0" type="radio" class="form-check-input" name="fg_rating_quality" value="1" checked='@(Model.Rating["quality"] == "1")' aria-label="Quality: Poor" @onchange='() => FgSetCell(Model.Rating, "quality", "1", "Rating")' /></td><td class="text-center"><input id="fg_rating-1-1" type="radio" class="form-check-input" name="fg_rating_quality" value="2" checked='@(Model.Rating["quality"] == "2")' aria-label="Quality: OK" @onchange='() => FgSetCell(Model.Rating, "quality", "2", "Rating")' /></td><td class="text-center"><input id="fg_rating-1-2" type="radio" class="form-check-input" name="fg_rating_quality" value="3" checked='@(Model.Rating["quality"] == "3")' aria-label="Quality: Great" @onchange='() => FgSetCell(Model.Rating, "quality", "3", "Rating")' /></td></tr>
                </tbody>
              </table>
            </div>
            <ValidationMessage For="@(() => Model.Rating)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Where do you use each feature?</legend>
            <div class="table-responsive">
              <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
                <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Web</th><th scope="col" class="text-center fw-semibold text-body-secondary">Mobile</th></tr></thead>
                <tbody>
                <tr><th scope="row" class="text-start fw-medium">Forms</th><td class="text-center"><input id="fg_usage" type="checkbox" class="form-check-input" name="fg_usage_forms" value="web" checked='@(Model.Usage["forms"].Contains("web"))' aria-label="Forms: Web" @onchange='() => FgToggleCell(Model.Usage, "forms", "web", new[] { "web", "mobile" }, "Usage")' /></td><td class="text-center"><input id="fg_usage-0-1" type="checkbox" class="form-check-input" name="fg_usage_forms" value="mobile" checked='@(Model.Usage["forms"].Contains("mobile"))' aria-label="Forms: Mobile" @onchange='() => FgToggleCell(Model.Usage, "forms", "mobile", new[] { "web", "mobile" }, "Usage")' /></td></tr>
                <tr><th scope="row" class="text-start fw-medium">Reports</th><td class="text-center"><input id="fg_usage-1-0" type="checkbox" class="form-check-input" name="fg_usage_reports" value="web" checked='@(Model.Usage["reports"].Contains("web"))' aria-label="Reports: Web" @onchange='() => FgToggleCell(Model.Usage, "reports", "web", new[] { "web", "mobile" }, "Usage")' /></td><td class="text-center"><input id="fg_usage-1-1" type="checkbox" class="form-check-input" name="fg_usage_reports" value="mobile" checked='@(Model.Usage["reports"].Contains("mobile"))' aria-label="Reports: Mobile" @onchange='() => FgToggleCell(Model.Usage, "reports", "mobile", new[] { "web", "mobile" }, "Usage")' /></td></tr>
                </tbody>
              </table>
            </div>
            <ValidationMessage For="@(() => Model.Usage)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="border rounded p-3 bg-body-tertiary" data-fg-repeater="references">
            <legend class="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">References</legend>
            <div class="d-flex flex-column gap-3" data-fg-list='@FgListId(Model.References, "references")'>
              @foreach (var (item, i) in Model.References.Select((x, n) => (x, n)).ToList())
              {
                  <fieldset @key="item" class="border rounded p-3" data-fg-item tabindex="-1" @ref="fgItemRefs[item]">
                      <legend class="float-none w-auto px-1 small fw-semibold mb-0 fg-label">@FgItemLabel("references", i)</legend>
                      <div class="row g-3">
                        <div class="col-12 col-md-12">
                          <div class="d-flex flex-column fg-field">
                            <label class="form-label fw-semibold small mb-0 fg-label" for="@($"fg_references_{i}_name")">Name<span class="text-danger fg-required" aria-hidden="true">*</span></label>
                            <InputText id="@($"fg_references_{i}_name")" @bind-Value="item.Name" class="form-control" />
                            <ValidationMessage For="@(() => item.Name)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                          </div>
                        </div>
                        <div class="col-12 col-md-12">
                          <div class="d-flex flex-column fg-field">
                            <div class="form-check mb-0">
                              <InputCheckbox id="@($"fg_references_{i}_may_contact")" @bind-Value="item.MayContact" class="form-check-input" />
                              <label class="form-check-label" for="@($"fg_references_{i}_may_contact")">May we contact them?</label>
                            </div>
                            <ValidationMessage For="@(() => item.MayContact)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                          </div>
                        </div>
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-12 col-md-12">
                              <div class="d-flex flex-column fg-field">
                                <label class="form-label fw-semibold small mb-0 fg-label" for="@($"fg_references_{i}_email")">Their email</label>
                                <InputText id="@($"fg_references_{i}_email")" type="email" @bind-Value="item.Email" class="form-control" />
                                <ValidationMessage For="@(() => item.Email)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
                              </div>
                            </div>
                        }
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-12 col-md-12">
                              <div class="d-flex flex-column fg-field">
