              <legend class="px-1 text-sm font-semibold">{{ fgItemLabel('references', i) }}</legend>
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5">
