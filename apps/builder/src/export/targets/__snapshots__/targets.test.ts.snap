                          @if (i > 0)
                          {
                              <button type="button" class="btn btn-outline-secondary fg-repeater-move" data-fg-move="up" aria-label='@FgMoveLabel("references", i, true)' @ref="fgMoveUpRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, -1)'>↑</button>
