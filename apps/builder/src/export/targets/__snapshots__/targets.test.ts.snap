            <input id="fg_topics" v-model="tagDrafts['topics']" type="text" class="border-0 p-0 flex-grow-1 shadow-none bg-transparent" placeholder="Type and press Enter" @keydown.enter.prevent="fgAddTag('topics')" @blur="fgAddTag('topics'); touch('topics')">
          </div>
          <p class="form-text mt-0">Free-text tags</p>
          <p v-if="errors['topics']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['topics'] }}</p>
