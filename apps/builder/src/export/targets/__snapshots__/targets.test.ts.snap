  .fg-select.fg-control--lg:not([multiple]) { block-size: 3rem; }
  .fg-input::-webkit-datetime-edit-fields-wrapper { padding: 0; }
  .fg-invalid { border-color: var(--fg-color-error); }
  .fg-checkbox-row { display: inline-flex; align-items: center; gap: 0.5rem; }
  .fg-checkbox-label { font-size: 1rem; line-height: 1.5rem; }
  .fg-checkbox { inline-size: 1rem; block-size: 1rem; margin: 0; accent-color: var(--fg-color-primary); }
  .fg-description { margin: 0; font-size: 0.875rem; line-height: 1.25rem; color: var(--fg-color-muted); }
  .fg-error { margin: 0; font-size: 0.875rem; line-height: 1.25rem; color: var(--fg-color-error); }
  .fg-options { display: flex; flex-direction: column; gap: 0.375rem; }
  .fg-option { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1rem; line-height: 1.5rem; }
  .fg-range { inline-size: 100%; block-size: 1.5rem; margin: 0; accent-color: var(--fg-color-primary); }
  .fg-heading { margin: 0; font-weight: 600; line-height: 1.25; }
  h1.fg-heading { font-size: 1.875rem; }
  h2.fg-heading { font-size: 1.5rem; }
  h3.fg-heading { font-size: 1.25rem; }
  h4.fg-heading { font-size: 1.125rem; }
  h5.fg-heading { font-size: 1rem; }
  h6.fg-heading { font-size: 0.875rem; }
  .fg-paragraph { margin: 0; line-height: 1.5rem; color: var(--fg-color-muted); }
  /* HTML blocks: light defaults; the author's own classes and styles win */
  .fg-html { overflow-wrap: anywhere; }
  :where(.fg-html) > :first-child { margin-block-start: 0; }
  :where(.fg-html) > :last-child { margin-block-end: 0; }
  :where(.fg-html) :where(p, ul, ol, dl, table, blockquote, figure, pre, details) { margin-block: 0.5em; }
  :where(.fg-html) :where(h1, h2, h3, h4, h5, h6) { margin-block: 0.75em 0.375em; font-weight: 600; line-height: 1.3; }
  :where(.fg-html) h1 { font-size: 1.5em; }
  :where(.fg-html) h2 { font-size: 1.3em; }
  :where(.fg-html) h3 { font-size: 1.15em; }
  :where(.fg-html) ul { list-style: disc; padding-inline-start: 1.25em; }
  :where(.fg-html) ol { list-style: decimal; padding-inline-start: 1.25em; }
  :where(.fg-html) table { border-collapse: collapse; }
  :where(.fg-html) :where(th, td) { padding: 0.25rem 0.5rem; border: 1px solid var(--fg-color-border); text-align: start; }
  :where(.fg-html) img { max-inline-size: 100%; block-size: auto; }
  :where(.fg-html) iframe { display: block; border: 0; max-inline-size: 100%; }
  :where(.fg-html) a { color: var(--fg-color-primary); }
  /* Signature: a light pad (dark ink in any theme), the typing box and Clear */
  .fg-signature { display: flex; flex-direction: column; gap: 0.5rem; }
  .fg-signature-pad { display: block; box-sizing: border-box; inline-size: 100%; border: 1px dashed var(--fg-color-border); border-radius: var(--fg-radius); background: #fff; touch-action: none; cursor: crosshair; }
  .fg-signature-row { display: flex; gap: 0.5rem; justify-content: flex-end; }
  .fg-signature-row > input { flex: 1 1 auto; min-inline-size: 0; }
  /* Rich text: toolbar and editor */
  .fg-richtext { border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-bg); }
  .fg-richtext:focus-within { border-color: var(--fg-color-primary); outline: 2px solid var(--fg-color-primary); outline-offset: 2px; }
  .fg-richtext-toolbar { display: flex; flex-wrap: wrap; gap: 0.25rem; padding: 0.25rem; border-block-end: 1px solid var(--fg-color-border); }
  .fg-richtext-button { min-inline-size: 2rem; padding: 0.25rem 0.5rem; border: 1px solid transparent; border-radius: var(--fg-radius); background: none; color: inherit; font: inherit; font-size: 0.875rem; line-height: 1.25rem; cursor: pointer; }
  .fg-richtext-button:hover, .fg-richtext-button:focus-visible { border-color: var(--fg-color-border); background: var(--fg-color-surface); }
  .fg-richtext-editor { box-sizing: border-box; min-block-size: 6rem; padding: 0.5rem 0.75rem; outline: none; overflow-wrap: anywhere; }
  .fg-richtext-editor :where(p, ul, ol) { margin: 0 0 0.5em; }
  .fg-richtext-editor :where(ul, ol) { padding-inline-start: 1.5em; }
  .fg-richtext-editor a { color: var(--fg-color-primary); }
  /* Location: the map (Leaflet), the coordinate boxes and buttons, messages */
  .fg-location { display: flex; flex-direction: column; gap: 0.5rem; }
  .fg-location-map { box-sizing: border-box; inline-size: 100%; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); isolation: isolate; z-index: 0; }
  .fg-location-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: flex-end; }
  .fg-location-coord { display: flex; flex: 1 1 8rem; flex-direction: column; gap: 0.25rem; font-size: 0.875rem; }
  .fg-location-coord > .fg-input { font-size: 1rem; }
  .fg-location-status { margin: 0; font-size: 0.875rem; line-height: 1.25rem; min-block-size: 0; }
  .fg-location-status:empty { display: none; }
  /* Spam check: the widget and its hint above the actions row */
  .fg-captcha { display: flex; flex-direction: column; gap: 0.25rem; margin-block-start: 1rem; }
  .fg-captcha-hint { margin: 0; font-size: 0.875rem; color: var(--fg-color-muted); }
  /* Sortable items: drag handle, the dragged item, where it would land */
  .fg-repeater-handle { padding: 0 0.25rem; color: var(--fg-color-muted); font-size: 1.25rem; line-height: 1; cursor: grab; user-select: none; }
  [data-fg-item][data-fg-drag] { opacity: 0.5; }
  [data-fg-item][data-fg-drop="before"] { box-shadow: 0 -3px 0 0 var(--fg-color-primary); }
  [data-fg-item][data-fg-drop="after"] { box-shadow: 0 3px 0 0 var(--fg-color-primary); }
  /* Save and continue later: the note above the form */
  .fg-draft { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; margin-block-end: var(--fg-space); padding: 0.5rem 0.75rem; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-surface); color: var(--fg-color-muted); font-size: 0.875rem; }
  .fg-draft-text { flex: 1 1 16rem; margin: 0; }
  .fg-draft-clear { padding: 0; border: 0; background: none; color: var(--fg-color-primary); font: inherit; text-decoration: underline; cursor: pointer; }
  /* Calculated fields: read-only, looks set apart from inputs */
  .fg-calculated { background: var(--fg-color-surface); font-variant-numeric: tabular-nums; cursor: default; }
  .fg-rich-text > * { margin: 0; }
  .fg-rich-text > * + * { margin-block-start: 0.5em; }
  .fg-rich-text ul, .fg-rich-text ol { padding-inline-start: 1.25em; }
  .fg-rich-text ul { list-style: disc; }
  .fg-rich-text ol { list-style: decimal; }
  .fg-divider { border: none; border-block-start: 1px solid var(--fg-color-border); margin-block: 0.25rem; }
  .fg-tab-list { display: flex; flex-wrap: wrap; gap: 0.25rem; border-block-end: 1px solid var(--fg-color-border); margin-block-end: var(--fg-space); }
  .fg-tab-button { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; font: inherit; font-size: 0.875rem; line-height: 1.25rem; font-weight: 600; color: var(--fg-color-muted); background: none; border: none; border-block-end: 2px solid transparent; cursor: pointer; }
  .fg-tab-button--active { color: var(--fg-color-primary); border-block-end-color: var(--fg-color-primary); }
  .fg-step-list { display: flex; flex-wrap: wrap; gap: var(--fg-space); margin: 0 0 var(--fg-space); padding: 0; font-size: 0.875rem; list-style: none; }
  .fg-step-item { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; line-height: 1.25rem; color: var(--fg-color-muted); }
  .fg-step-item--active { color: var(--fg-color-text); font-weight: 600; }
  .fg-step-actions { display: flex; justify-content: space-between; gap: 0.5rem; margin-block-start: var(--fg-space); }
  .fg-button.fg-button--secondary { background: var(--fg-color-surface); color: var(--fg-color-text); border-color: var(--fg-color-border); }
  .fg-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; padding: 0.375rem 0.5rem; background: var(--fg-color-bg); border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); }
  .fg-tags:focus-within { outline: 2px solid var(--fg-color-primary); outline-offset: 1px; }
  .fg-tag { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.125rem 0.5rem; font-size: 0.75rem; line-height: 1rem; background: var(--fg-color-surface); border: 1px solid var(--fg-color-border); border-radius: 999px; }
  .fg-tag-remove { border: none; background: none; padding: 0; cursor: pointer; color: var(--fg-color-muted); font-size: 0.875rem; line-height: 1; }
  .fg-tags-input { flex: 1; min-inline-size: 6rem; border: none; background: none; font: inherit; line-height: 1.5; color: inherit; padding: 0; }
  .fg-tags-input:focus { outline: none; }
  .fg-control--sm { padding: 0.25rem 0.5rem; font-size: 0.875rem; }
  .fg-control--lg { padding: 0.5rem 1rem; font-size: 1.25rem; }
  .fg-tags.fg-control--sm { padding: 0.125rem 0.375rem; font-size: 0.875rem; }
  .fg-tags.fg-control--lg { padding: 0.5rem 0.75rem; font-size: 1.25rem; }
  .fg-align-center { text-align: center; }
  .fg-align-end { text-align: end; }
  .fg-tone-muted { color: var(--fg-color-muted); }
  .fg-tone-primary { color: var(--fg-color-primary); }
  .fg-tone-danger { color: var(--fg-color-error); }
  .fg-divider.fg-tone-muted { border-block-start-color: var(--fg-color-border); }
  .fg-divider.fg-tone-primary { border-block-start-color: var(--fg-color-primary); }
  .fg-divider.fg-tone-danger { border-block-start-color: var(--fg-color-error); }
  .fg-sr-only { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .fg-group { margin: 0; padding: var(--fg-space); border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-surface); }
  .fg-group-label { padding-inline: 0.25rem; font-size: 0.875rem; line-height: 1.25rem; font-weight: 600; color: var(--fg-color-muted); }
  .fg-actions { margin-block-start: var(--fg-space); }
  .fg-upload { display: flex; flex-direction: column; gap: 0.375rem; margin-block-start: var(--fg-space); }
  .fg-progress { block-size: 0.5rem; overflow: hidden; background: var(--fg-color-border); border-radius: 999px; }
  .fg-progress-bar { block-size: 100%; background: var(--fg-color-primary); border-radius: inherit; transition: inline-size 0.2s ease; }
  .fg-progress-text { margin: 0; font-size: 0.875rem; color: var(--fg-color-muted); }
  .fg-button:disabled { opacity: 0.6; cursor: not-allowed; }
  .fg-button { padding: 0.375rem 1rem; font: inherit; line-height: 1.5; font-weight: 600; border: 1px solid transparent; border-radius: var(--fg-radius); cursor: pointer; }
  .fg-button--primary { background: var(--fg-color-primary); color: var(--fg-color-primary-contrast); }
  .fg-payload { margin-block-start: var(--fg-space); padding: var(--fg-space); background: #0f172a; color: #86efac; border-radius: var(--fg-radius); font-size: 0.875rem; overflow-x: auto; }
  /* Phase 23 elements: switch, choice blocks/buttons, vertical slider, image, link, quote, buttons */
  .fg-switch { appearance: none; position: relative; flex-shrink: 0; inline-size: 2.25rem; block-size: 1.25rem; margin: 0; border: 1px solid transparent; border-radius: 999px; background: var(--fg-color-border); cursor: pointer; transition: background-color 0.15s; }
  .fg-switch::before { content: ''; position: absolute; inset-block-start: 0.0625rem; inset-inline-start: 0.0625rem; inline-size: 1rem; block-size: 1rem; border-radius: 50%; background: #ffffff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.3); transition: inset-inline-start 0.15s; }
  .fg-switch:checked { background: var(--fg-color-primary); }
  .fg-switch:checked::before { inset-inline-start: 1.0625rem; }
  .fg-switch:focus-visible { outline: 2px solid var(--fg-color-primary); outline-offset: 2px; }
  .fg-options--blocks { gap: 0.5rem; }
  .fg-option--block { display: flex; gap: 0.75rem; padding: 0.5rem 0.75rem; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-bg); cursor: pointer; }
  .fg-option--block:has(:checked) { border-color: var(--fg-color-primary); box-shadow: 0 0 0 1px var(--fg-color-primary); }
  .fg-options--buttons { flex-direction: row; flex-wrap: wrap; gap: 0; }
  .fg-option--button { position: relative; padding: 0.5rem 1rem; margin-inline-start: -1px; font-size: 0.875rem; line-height: 1.25rem; font-weight: 600; border: 1px solid var(--fg-color-border); background: var(--fg-color-bg); cursor: pointer; }
  .fg-option--button:first-child { margin-inline-start: 0; border-start-start-radius: var(--fg-radius); border-end-start-radius: var(--fg-radius); }
  .fg-option--button:last-child { border-start-end-radius: var(--fg-radius); border-end-end-radius: var(--fg-radius); }
  .fg-option--button:has(:checked) { z-index: 1; color: var(--fg-color-primary-contrast); background: var(--fg-color-primary); border-color: var(--fg-color-primary); }
  .fg-option--button:has(:focus-visible) { z-index: 2; outline: 2px solid var(--fg-color-primary); outline-offset: 2px; }
  .fg-range--vertical { writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem; }
  .fg-image { display: block; max-inline-size: 100%; block-size: auto; border-radius: var(--fg-radius); }
  .fg-link { color: var(--fg-color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .fg-quote { margin: 0; padding-inline-start: 1rem; border-inline-start: 4px solid var(--fg-color-border); }
  .fg-quote-text { margin: 0; font-size: 1rem; line-height: 1.5rem; font-style: italic; }
  .fg-quote-text p { margin: 0; }
  .fg-quote-cite { margin-block-start: 0.25rem; font-size: 0.875rem; line-height: 1.25rem; color: var(--fg-color-muted); }
  .fg-button--danger { background: var(--fg-color-error); color: var(--fg-color-error-contrast); }
  a.fg-button { display: inline-block; text-decoration: none; }
  .fg-input--color { inline-size: 3rem; block-size: 2.375rem; padding: 0.375rem; cursor: pointer; }
  fieldset.fg-field { margin: 0; padding: 0; border: 0; min-inline-size: 0; }
  fieldset.fg-field > legend { padding: 0; margin-block-end: 0.375rem; }
  /* Repeatable sections */
  .fg-repeater-items { display: flex; flex-direction: column; gap: var(--fg-space); }
  .fg-repeater-item { margin: 0; padding: var(--fg-space); min-inline-size: 0; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-bg); }
  .fg-repeater-item-label { padding-inline: 0.25rem; font-size: 0.875rem; line-height: 1.25rem; font-weight: 600; }
  .fg-repeater-item-actions { display: flex; align-items: center; gap: 0.5rem; margin-block-start: 0.5rem; }
  .fg-repeater-move { display: inline-flex; align-items: center; justify-content: center; inline-size: 2rem; block-size: 2rem; padding: 0; font: inherit; color: var(--fg-color-text); background: none; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); cursor: pointer; }
  .fg-repeater-remove { margin-inline-start: auto; padding: 0; font: inherit; font-size: 0.875rem; line-height: 1.25rem; color: var(--fg-color-error); background: none; border: none; text-decoration: underline; cursor: pointer; }
  .fg-repeater-add { margin-block-start: var(--fg-space); }
  /* File uploads */
  .fg-file-drop { position: relative; box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-block-size: 4.5rem; padding: 1rem; text-align: center; font-size: 0.875rem; color: var(--fg-color-muted); background: var(--fg-color-surface); border: 2px dashed var(--fg-color-border); border-radius: var(--fg-radius); }
  .fg-file-drop:hover, .fg-file-drop[data-fg-dragging] { border-color: var(--fg-color-primary); color: var(--fg-color-text); }
  .fg-file-drop:has(:focus-visible) { outline: 2px solid var(--fg-color-primary); outline-offset: 2px; }
  .fg-file-input { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; opacity: 0; cursor: pointer; }
  .fg-file-drop-text { font-weight: 500; }
  .fg-file-list { display: flex; flex-direction: column; gap: 0.375rem; margin: 0; padding: 0; list-style: none; }
  .fg-file-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.5rem; font-size: 0.875rem; border: 1px solid var(--fg-color-border); border-radius: var(--fg-radius); background: var(--fg-color-surface); }
  .fg-file-thumb { inline-size: 2.5rem; block-size: 2.5rem; object-fit: cover; border-radius: calc(var(--fg-radius) / 2); }
  .fg-file-name { flex: 1; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fg-file-size { color: var(--fg-color-muted); font-size: 0.875rem; }
  .fg-file-remove { padding: 0 0.375rem; font-size: 1.125rem; line-height: 1; color: var(--fg-color-muted); background: none; border: none; cursor: pointer; }
  .fg-file-remove:hover { color: var(--fg-color-error); }
  /* Composite fields (two-handle slider, date range, multiple dates).
     Framework-neutral: the exports embed the slider rules as they are. */
  .fg-dual { position: relative; height: 1.5rem; margin-block: 0.25rem; }
  .fg-dual-track { position: absolute; inset-inline: 0; top: 50%; height: 0.375rem; transform: translateY(-50%); border-radius: 999px; background: var(--fg-color-border, var(--bs-border-color, #d1d5db)); }
  .fg-dual-fill { position: absolute; top: 0; bottom: 0; border-radius: inherit; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }
  .fg-dual input[type='range'] { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; }
  .fg-dual input[type='range']::-webkit-slider-runnable-track { height: 1.5rem; background: none; border: none; }
  .fg-dual input[type='range']::-moz-range-track { background: none; border: none; }
  .fg-dual input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 1.125rem; height: 1.125rem; margin-top: 0.1875rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']::-moz-range-thumb { pointer-events: auto; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']:focus-visible { outline: none; }
  .fg-dual input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-dual input[type='range']:focus-visible::-moz-range-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-pair { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .fg-pair > .fg-input { flex: 1 1 10rem; inline-size: auto; min-inline-size: 0; }
  .fg-pair-button { flex: none; white-space: nowrap; }
  .fg-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-block-start: 0.5rem; }
  /* Capped so a long country name never pushes past the field. */
  .fg-phone-country { flex: 0 1 45%; inline-size: auto; min-inline-size: 0; max-inline-size: 45%; }
  .fg-matrix-scroll { overflow-x: auto; }
  .fg-matrix { inline-size: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .fg-matrix th, .fg-matrix td { padding: 0.5rem; line-height: 1.25rem; text-align: center; }
  .fg-matrix input { inline-size: 1rem; block-size: 1rem; margin: 0; vertical-align: middle; accent-color: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }
  .fg-matrix thead th { font-weight: 600; color: var(--fg-color-muted, var(--bs-secondary-color, #6b7280)); }
  .fg-matrix tbody th { text-align: start; font-weight: 500; }
  .fg-matrix tbody tr { border-block-start: 1px solid var(--fg-color-border, var(--bs-border-color, #d1d5db)); }
  .fg-matrix tbody tr:nth-child(odd) { background: var(--fg-color-surface, var(--bs-tertiary-bg, #f9fafb)); }

  /* Field add-ons and help tooltips (framework-neutral: exports embed them). */
  .fg-affix-group { display: flex; align-items: stretch; }
  .fg-affix-group > input { flex: 1 1 auto; min-inline-size: 0; inline-size: auto; }
  .fg-affix-group > :not(:first-child) { margin-inline-start: -1px; border-start-start-radius: 0; border-end-start-radius: 0; }
  .fg-affix-group > :not(:last-child) { border-start-end-radius: 0; border-end-end-radius: 0; }
  .fg-affix { display: flex; align-items: center; padding-inline: 0.75rem; font-size: 1rem; line-height: 1.5; white-space: nowrap; color: var(--fg-color-muted, var(--bs-secondary-color, #6b7280)); background: var(--fg-color-surface, var(--bs-tertiary-bg, #f9fafb)); border: 1px solid var(--fg-color-border, var(--bs-border-color, #d1d5db)); border-radius: var(--fg-radius, 0.375rem); }
  .fg-label-row { display: flex; align-items: center; gap: 0.375rem; }
  /* The bubble anchors to the row holding the tip (label row, checkbox row or
     legend), from its start edge, so it never runs off a narrow screen. */
  .fg-tip { display: inline-flex; vertical-align: middle; margin-inline-start: 0.25rem; }
  :has(> .fg-tip) { position: relative; }
  .fg-label-row > .fg-tip { margin-inline-start: 0; }
  .fg-tip-button { display: inline-flex; align-items: center; justify-content: center; inline-size: 1.125rem; block-size: 1.125rem; padding: 0; font: 600 0.6875rem/1 system-ui, sans-serif; color: var(--fg-color-muted, var(--bs-secondary-color, #6b7280)); background: transparent; border: 1px solid currentColor; border-radius: 50%; cursor: help; }
  .fg-tip-button:focus-visible { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-tip-text { position: absolute; inset-block-end: calc(100% + 0.375rem); inset-inline-start: 0; z-index: 20; inline-size: max-content; max-inline-size: min(16rem, calc(100vw - 2rem)); padding: 0.375rem 0.5rem; font-size: 0.75rem; font-weight: 400; line-height: 1.4; text-align: start; color: #ffffff; background: #111827; border-radius: 0.375rem; visibility: hidden; opacity: 0; transition: opacity 0.12s; pointer-events: none; }
  .fg-tip:hover .fg-tip-text, .fg-tip-button:focus + .fg-tip-text { visibility: visible; opacity: 1; }

  /* Floating labels (meta.floatingLabels): the label floats when the control is focused or filled. */
  .fg-floating { position: relative; }
  .fg-floating > .fg-input, .fg-floating > .fg-select { block-size: calc(3.5rem + 2px); padding: 1rem 0.75rem; line-height: 1.25; }
  .fg-floating > .fg-select:not([multiple]) { block-size: calc(3.5rem + 2px); }
  .fg-floating > :focus, .fg-floating > :not(:placeholder-shown), .fg-floating > select { padding-block: 1.625rem 0.625rem; }
  .fg-floating > .fg-floating-label { position: absolute; inset-block-start: 0; inset-inline-start: 0; box-sizing: border-box; block-size: 100%; padding: 1rem 0.75rem; border: 1px solid transparent; font-size: 1rem; line-height: 1.5; color: var(--fg-color-muted); pointer-events: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transform-origin: 0 0; transition: transform 0.1s ease-in-out, color 0.1s ease-in-out; }
  [dir='rtl'] .fg-floating > .fg-floating-label { transform-origin: 100% 0; }
  .fg-floating > :focus ~ .fg-floating-label, .fg-floating > :not(:placeholder-shown) ~ .fg-floating-label, .fg-floating > select ~ .fg-floating-label { transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem); }
  [dir='rtl'] .fg-floating > :focus ~ .fg-floating-label, [dir='rtl'] .fg-floating > :not(:placeholder-shown) ~ .fg-floating-label, [dir='rtl'] .fg-floating > select ~ .fg-floating-label { transform: scale(0.85) translateY(-0.5rem) translateX(-0.15rem); }
  .fg-floating > :focus ~ .fg-floating-label { color: var(--fg-color-primary); }
  .fg-floating > :not(:focus)::placeholder { color: transparent; }
  @media (prefers-color-scheme: dark) {
    .fg-form:not([data-fg-theme='light']) {
      --fg-color-bg: #0f172a; --fg-color-surface: #1e293b; --fg-color-text: #e2e8f0;
      --fg-color-muted: #94a3b8; --fg-color-border: #334155;
      --fg-color-primary: #818cf8; --fg-color-primary-contrast: #0f172a; --fg-color-error: #f87171;
      --fg-color-error-contrast: #0f172a;
    }
  }

  body { margin: 0; padding: 1.5rem 1rem; }
  #fg-form { box-sizing: border-box; max-inline-size: 42rem; margin-inline: auto; }
  [hidden] { display: none !important; }
  </style>
</head>
<body>
  <form id="fg-form" class="fg-form" novalidate>
    <div class="fg-grid">
      <div class="fg-cell fg-align-center" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <h2 class="fg-heading fg-tone-primary">Kitchen Sink</h2>
      </div>
      <div class="fg-cell fg-align-center" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <p class="fg-paragraph">Every implemented element appears in this form.</p>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-paragraph fg-rich-text">
          <p>Hi <span data-fg-answer="full_name" data-fg-fallback="there">there</span>! Fields marked * are <strong>required</strong>. See the <a class="fg-link" href="https://example.com/docs">docs</a>:</p>
          <ul>
            <li><em>one</em> answer per row in Rating</li>
            <li>several in Usage</li>
          </ul>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_full_name">Full name<span class="fg-required" aria-hidden="true">*</span></label>
          <input id="fg_full_name" type="text" class="fg-input" data-fg-path="full_name" data-fg-kind="text" placeholder="Jane Doe">
          <p id="fg_full_name-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_email">Email<span class="fg-required" aria-hidden="true">*</span></label>
          <input id="fg_email" type="email" class="fg-input" data-fg-path="email" data-fg-kind="text" placeholder="jane&#64;example.com">
          <p id="fg_email-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="fg-input fg-control--sm" data-fg-path="website" data-fg-kind="text">
          <p id="fg_website-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <div class="fg-label-row"><label class="fg-label" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
          <div class="fg-affix-group">
            <input id="fg_seats" type="number" class="fg-input" data-fg-path="seats" data-fg-kind="number" min="1" max="50" aria-describedby="fg_seats-suffix">
            <span id="fg_seats-suffix" class="fg-affix">people</span>
          </div>
          <p id="fg_seats-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_seat_cost">Seat cost</label>
          <div class="fg-affix-group">
            <span id="fg_seat_cost-prefix" class="fg-affix">$</span>
            <input id="fg_seat_cost" type="text" readonly class="fg-input fg-calculated" data-fg-path="seat_cost" data-fg-kind="calculated" data-fg-value="" aria-describedby="fg_seat_cost-prefix">
          </div>
          <p id="fg_seat_cost-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="fg-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_satisfaction-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <hr class="fg-divider fg-tone-primary">
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-grid">
          <div class="fg-cell" style="--fg-span: 6; --fg-span-sm: 6; --fg-span-lg: 4">
            <div class="fg-field">
              <label class="fg-label" for="fg_city">City</label>
              <input id="fg_city" type="text" class="fg-input" data-fg-path="city" data-fg-kind="text">
              <p id="fg_city-err" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
          <div class="fg-cell" style="--fg-span: 6; --fg-span-sm: 6; --fg-span-lg: 6">
            <div class="fg-field">
              <label class="fg-sr-only" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="fg-input" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_zip-err" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="fg-cell account-box" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-group">
          <legend class="fg-group-label">Account</legend>
          <div class="fg-grid">
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_username">Username<span class="fg-required" aria-hidden="true">*</span></label>
                <div class="fg-affix-group">
                  <span id="fg_account_username-prefix" class="fg-affix">&#64;</span>
                  <input id="fg_account_username" type="text" class="fg-input" data-fg-path="account.username" data-fg-kind="text" aria-describedby="fg_account_username-prefix">
                </div>
                <p id="fg_account_username-err" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="fg-input" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_account_password-err" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="fg-textarea fg-control--lg" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_account_bio-err" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="fg-input" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_account_birthday-err" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_avatar">Profile picture</label>
                <div class="fg-file-drop">
                  <span class="fg-file-drop-text">Choose a file or drag it here</span>
                  <input id="fg_account_avatar" type="file" class="fg-file-input" accept="image/*" data-fg-path="account.avatar" data-fg-kind="files" data-fg-thumbs>
                </div>
                <ul class="fg-file-list" data-fg-file-list="account.avatar" hidden></ul>
                <p class="fg-description" data-fg-file-note="account.avatar" hidden></p>
                <p id="fg_account_avatar-err" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field" aria-labelledby="fg_plan-legend">
          <legend class="fg-label"><span id="fg_plan-legend">Plan</span><span class="fg-required" aria-hidden="true">*</span><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" class="fg-tip-text">You can switch plans at any time</span></span></legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_plan-free">
              <input id="fg_plan-free" type="radio" name="plan" class="fg-checkbox" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="fg-option" for="fg_plan-pro">
              <input id="fg_plan-pro" type="radio" name="plan" class="fg-checkbox" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_plan-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Interests</legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_interests-news">
              <input id="fg_interests-news" type="checkbox" class="fg-checkbox" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="fg-option" for="fg_interests-product">
              <input id="fg_interests-product" type="checkbox" class="fg-checkbox" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_interests-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="fg-select" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_channels-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_topics">Topics</label>
          <div class="fg-tags" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="fg-tags-input" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="fg-description">Free-text tags</p>
          <p id="fg_topics-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Billing</legend>
          <div class="fg-options fg-options--buttons">
            <label class="fg-option fg-option--button" for="fg_billing-monthly">
              <input id="fg_billing-monthly" type="radio" name="billing" class="fg-sr-only" value="monthly" data-fg-path="billing" data-fg-kind="radio">
              <span>Monthly</span>
            </label>
            <label class="fg-option fg-option--button" for="fg_billing-yearly">
              <input id="fg_billing-yearly" type="radio" name="billing" class="fg-sr-only" value="yearly" data-fg-path="billing" data-fg-kind="radio">
              <span>Yearly</span>
            </label>
          </div>
          <p id="fg_billing-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Extras</legend>
          <div class="fg-options fg-options--blocks">
            <label class="fg-option fg-option--block" for="fg_extras-support">
              <input id="fg_extras-support" type="checkbox" class="fg-checkbox" value="support" data-fg-path="extras" data-fg-kind="checks">
              <span>Priority support</span>
            </label>
            <label class="fg-option fg-option--block" for="fg_extras-backup">
              <input id="fg_extras-backup" type="checkbox" class="fg-checkbox" value="backup" data-fg-path="extras" data-fg-kind="checks">
              <span>Daily backups</span>
            </label>
          </div>
          <p id="fg_extras-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_notify" type="checkbox" role="switch" class="fg-switch" data-fg-path="notify" data-fg-kind="checkbox" checked>
            <label class="fg-checkbox-label" for="fg_notify">Email notifications</label>
          </div>
          <p id="fg_notify-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_appointment">Appointment</label>
          <input id="fg_appointment" type="datetime-local" class="fg-input" data-fg-path="appointment" data-fg-kind="text">
          <p id="fg_appointment-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_brand_color">Brand color</label>
          <input id="fg_brand_color" type="color" class="fg-input fg-input--color" data-fg-path="brand_color" data-fg-kind="text">
          <p id="fg_brand_color-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_volume">Volume</label>
          <input id="fg_volume" type="range" class="fg-range" data-fg-path="volume" data-fg-kind="number" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" value="0">
          <p id="fg_volume-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_budget">Budget</label>
          <div class="fg-dual" data-fg-dual="budget">
            <div class="fg-dual-track"><div class="fg-dual-fill" data-fg-dual-fill></div></div>
            <input id="fg_budget" type="range" min="0" max="1000" step="50" value="200" data-fg-path="budget" data-fg-kind="range2" data-fg-part="from" aria-label="Budget: Minimum">
            <input id="fg_budget-to" type="range" min="0" max="1000" step="50" value="600" data-fg-path="budget" data-fg-kind="range2" data-fg-part="to" aria-label="Budget: Maximum">
          </div>
          <p class="fg-description" data-fg-dual-text="budget">200 – 600</p>
          <p id="fg_budget-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_stay">Stay<span class="fg-required" aria-hidden="true">*</span></label>
          <div class="fg-pair">
            <input id="fg_stay" type="date" class="fg-input" data-fg-path="stay" data-fg-kind="daterange" data-fg-part="from" aria-label="Stay: Start date">
            <span aria-hidden="true">–</span>
            <input id="fg_stay-to" type="date" class="fg-input" data-fg-path="stay" data-fg-kind="daterange" data-fg-part="to" aria-label="Stay: End date">
          </div>
          <p id="fg_stay-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_days">Available days</label>
          <div class="fg-pair" data-fg-path="days" data-fg-kind="dates">
            <input id="fg_days" type="date" class="fg-input" data-fg-dates-input="days">
            <button type="button" class="fg-button fg-button--secondary fg-pair-button" data-fg-dates-add="days">Add date</button>
          </div>
          <div class="fg-chips" data-fg-dates-chips="days" hidden></div>
          <p id="fg_days-err" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">How did we do?<span class="fg-required" aria-hidden="true">*</span></legend>
          <div class="fg-matrix-scroll">
            <table class="fg-matrix">
              <thead><tr><td></td><th scope="col">Poor</th><th scope="col">OK</th><th scope="col">Great</th></tr></thead>
              <tbody>
              <tr><th scope="row">Speed</th><td><input id="fg_rating" type="radio" name="fg_rating_speed" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Poor"></td><td><input id="fg_rating-0-1" type="radio" name="fg_rating_speed" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: OK"></td><td><input id="fg_rating-0-2" type="radio" name="fg_rating_speed" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Great"></td></tr>
              <tr><th scope="row">Quality</th><td><input id="fg_rating-1-0" type="radio" name="fg_rating_quality" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Poor"></td><td><input id="fg_rating-1-1" type="radio" name="fg_rating_quality" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: OK"></td><td><input id="fg_rating-1-2" type="radio" name="fg_rating_quality" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Great"></td></tr>
              </tbody>
            </table>
          </div>
          <p id="fg_rating-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Where do you use each feature?</legend>
          <div class="fg-matrix-scroll">
            <table class="fg-matrix">
              <thead><tr><td></td><th scope="col">Web</th><th scope="col">Mobile</th></tr></thead>
              <tbody>
              <tr><th scope="row">Forms</th><td><input id="fg_usage" type="checkbox" name="fg_usage_forms" value="web" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="forms" aria-label="Forms: Web"></td><td><input id="fg_usage-0-1" type="checkbox" name="fg_usage_forms" value="mobile" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="forms" aria-label="Forms: Mobile"></td></tr>
              <tr><th scope="row">Reports</th><td><input id="fg_usage-1-0" type="checkbox" name="fg_usage_reports" value="web" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="reports" aria-label="Reports: Web"></td><td><input id="fg_usage-1-1" type="checkbox" name="fg_usage_reports" value="mobile" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="reports" aria-label="Reports: Mobile"></td></tr>
              </tbody>
            </table>
          </div>
          <p id="fg_usage-err" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <input id="fg_source" type="hidden" value="kitchen-sink" data-fg-path="source" data-fg-kind="text">
