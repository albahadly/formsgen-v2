        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <a className="fg-link" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span className="fg-sr-only"> (opens in a new tab)</span></a>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_contact_method">Preferred contact method<span className="fg-required" aria-hidden="true">*</span></label>
            <select id="fg_contact_method" value={form.contact_method ?? ''} className={errors['contact_method'] ? "fg-select fg-invalid" : "fg-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => setField('contact_method', e.target.value === '' ? null : e.target.value)} onBlur={() => touch('contact_method')}>
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
