          <div class="d-flex flex-wrap align-items-center gap-2 fg-pair">
            <input id="fg_days" v-model="fgDateDrafts['days']" type="date" class="form-control" :class="{ 'is-invalid': !!errors['days'] }" @keydown.enter.prevent="fgAddDate('days')">
            <button type="button" class="btn btn-outline-secondary fw-semibold px-3 flex-shrink-0 text-nowrap" @click="fgAddDate('days')">Add date</button>
          </div>
          <div v-if="form.days.length" class="d-flex flex-wrap gap-1 mt-2">
            <span v-for="(date, index) in form.days" :key="date" class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">{{ date }} <button type="button" class="border-0 bg-transparent p-0 ms-1 text-white" :aria-label="'Remove ' + (date)" @click="fgRemoveDate('days', index)">×</button></span>
          </div>
          <p v-if="errors['days']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['days'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">How did we do?<span class="text-danger fg-required" aria-hidden="true">*</span></legend>
          <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
              <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Poor</th><th scope="col" class="text-center fw-semibold text-body-secondary">OK</th><th scope="col" class="text-center fw-semibold text-body-secondary">Great</th></tr></thead>
              <tbody>
              <tr><th scope="row" class="text-start fw-medium">Speed</th><td class="text-center"><input id="fg_rating" type="radio" class="form-check-input" name="fg_rating_speed" value="1" v-model="form.rating['speed']" aria-label="Speed: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="text-center"><input id="fg_rating-0-1" type="radio" class="form-check-input" name="fg_rating_speed" value="2" v-model="form.rating['speed']" aria-label="Speed: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="text-center"><input id="fg_rating-0-2" type="radio" class="form-check-input" name="fg_rating_speed" value="3" v-model="form.rating['speed']" aria-label="Speed: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              <tr><th scope="row" class="text-start fw-medium">Quality</th><td class="text-center"><input id="fg_rating-1-0" type="radio" class="form-check-input" name="fg_rating_quality" value="1" v-model="form.rating['quality']" aria-label="Quality: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="text-center"><input id="fg_rating-1-1" type="radio" class="form-check-input" name="fg_rating_quality" value="2" v-model="form.rating['quality']" aria-label="Quality: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td class="text-center"><input id="fg_rating-1-2" type="radio" class="form-check-input" name="fg_rating_quality" value="3" v-model="form.rating['quality']" aria-label="Quality: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['rating']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['rating'] }}</p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Where do you use each feature?</legend>
          <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
              <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Web</th><th scope="col" class="text-center fw-semibold text-body-secondary">Mobile</th></tr></thead>
              <tbody>
              <tr><th scope="row" class="text-start fw-medium">Forms</th><td class="text-center"><input id="fg_usage" type="checkbox" class="form-check-input" name="fg_usage_forms" value="web" :checked="form.usage['forms'].includes('web')" aria-label="Forms: Web" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td class="text-center"><input id="fg_usage-0-1" type="checkbox" class="form-check-input" name="fg_usage_forms" value="mobile" :checked="form.usage['forms'].includes('mobile')" aria-label="Forms: Mobile" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              <tr><th scope="row" class="text-start fw-medium">Reports</th><td class="text-center"><input id="fg_usage-1-0" type="checkbox" class="form-check-input" name="fg_usage_reports" value="web" :checked="form.usage['reports'].includes('web')" aria-label="Reports: Web" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td class="text-center"><input id="fg_usage-1-1" type="checkbox" class="form-check-input" name="fg_usage_reports" value="mobile" :checked="form.usage['reports'].includes('mobile')" aria-label="Reports: Mobile" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['usage']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['usage'] }}</p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="border rounded p-3 bg-body-tertiary" data-fg-repeater="references">
          <legend class="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">References</legend>
          <div class="d-flex flex-column gap-3">
            <fieldset v-for="(item, i) in form.references" :key="fgKeyOf(item)" class="border rounded p-3" data-fg-item tabindex="-1" :data-fg-drag="fgDragMark('references', i)" :data-fg-drop="fgDropMark('references', i)" @dragover="fgDragOver($event, 'references', i)" @drop="fgDropItem($event, 'references', i)">
              <legend class="float-none w-auto px-1 small fw-semibold mb-0 fg-label">{{ fgItemLabel('references', i) }}</legend>
              <div class="row g-3">
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column fg-field">
                    <label class="form-label fw-semibold small mb-0 fg-label" :for="'fg_references_' + i + '_name'">Name<span class="text-danger fg-required" aria-hidden="true">*</span></label>
                    <input :id="'fg_references_' + i + '_name'" v-model="item.name" type="text" class="form-control" :class="{ 'is-invalid': !!errors[('references.' + i + '.name')] }" @blur="touch(('references.' + i + '.name'))" @input="revalidate(('references.' + i + '.name'))">
                    <p v-if="errors[('references.' + i + '.name')]" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors[('references.' + i + '.name')] }}</p>
                  </div>
                </div>
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column fg-field">
                    <div class="form-check mb-0">
                      <input :id="'fg_references_' + i + '_may_contact'" v-model="item.may_contact" type="checkbox" class="form-check-input" @change="touch(('references.' + i + '.may_contact'))">
                      <label class="form-check-label" :for="'fg_references_' + i + '_may_contact'">May we contact them?</label>
                    </div>
                    <p v-if="errors[('references.' + i + '.may_contact')]" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors[('references.' + i + '.may_contact')] }}</p>
                  </div>
                </div>
                <div class="col-12 col-md-12" v-if='(item.may_contact === true)'>
                  <div class="d-flex flex-column fg-field">
                    <label class="form-label fw-semibold small mb-0 fg-label" :for="'fg_references_' + i + '_email'">Their email</label>
                    <input :id="'fg_references_' + i + '_email'" v-model="item.email" type="email" class="form-control" :class="{ 'is-invalid': !!errors[('references.' + i + '.email')] }" @blur="touch(('references.' + i + '.email'))" @input="revalidate(('references.' + i + '.email'))">
                    <p v-if="errors[('references.' + i + '.email')]" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors[('references.' + i + '.email')] }}</p>
