              ))}
            </div>
            {form.references.length < 3 && <button type="button" className="mt-4 rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-add="references" onClick={() => fgAddItem('references')}>Add reference</button>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_attachments">Attachments<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <div className="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
              <span className="font-medium">Choose files or drag them here</span>
              <input id="fg_attachments" type="file" className="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept=".pdf,.doc,.docx" multiple aria-invalid={errors['attachments'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('attachments', e.target)} onDragEnter={(e) => fgDrag(e.currentTarget, true)} onDragLeave={(e) => fgDrag(e.currentTarget, false)} onDrop={(e) => fgDropFiles('attachments', e)} />
            </div>
            {form.attachments.length > 0 && (
              <ul className="flex flex-col gap-1.5">
                {form.attachments.map((file, fi) => (
                  <li key={fi} className="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                    <span className="min-w-0 flex-1 truncate">{file.name}</span>
                    <span className="text-sm text-gray-500 dark:text-gray-400">{fgFileSize(file.size)}</span>
                    <button type="button" className="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('attachments', fi)}>×</button>
                  </li>
                ))}
              </ul>
            )}
            {fgFileNotes['attachments'] && <p className="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>{fgFileNotes['attachments']}</p>}
            <p className="text-sm text-gray-500 dark:text-gray-400">Up to 3 PDF or Word files, 5 MB each</p>
            {errors['attachments'] && <p className="text-sm text-red-600" role="alert">{errors['attachments']}</p>}
          </div>
        </div>
        {((!fgIsBlank(form.attachments))) && (
          <div className="col-span-12 md:col-span-12">
            <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
              <label className="text-sm font-semibold" htmlFor="fg_attachments_note">Notes about the attachments</label>
              <textarea id="fg_attachments_note" rows={3} value={form.attachments_note} className={errors['attachments_note'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('attachments_note', e.target.value)} onBlur={() => touch('attachments_note')} />
              {errors['attachments_note'] && <p className="text-sm text-red-600" role="alert">{errors['attachments_note']}</p>}
            </div>
          </div>
        )}
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div className="text-sm font-semibold"><span id="fg_about-label">About you</span></div>
            <div className="rounded-md border border-gray-300 bg-white shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-rich>
              <div className="flex flex-wrap gap-1 border-b border-gray-200 p-1 dark:border-gray-700" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" className="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabIndex={0}><b>B</b></button>
                <button type="button" className="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabIndex={-1}><i>I</i></button>
                <button type="button" className="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabIndex={-1}>•</button>
                <button type="button" className="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabIndex={-1}><span dir="ltr">1.</span></button>
                <button type="button" className="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabIndex={-1}>🔗</button>
              </div>
              <div id="fg_about" className="min-h-24 px-3 py-2 text-base outline-none [overflow-wrap:anywhere] [&_ol]:list-decimal [&_ol]:ps-6 [&_ul]:list-disc [&_ul]:ps-6 [&_a]:text-indigo-600 [&_a]:underline [&_p]:mb-2" contentEditable role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" onBlur={() => touch('about')}></div>
            </div>
            <p className="text-sm text-gray-500 dark:text-gray-400">Bold, lists and links are kept.</p>
            {errors['about'] && <p className="text-sm text-red-600" role="alert">{errors['about']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Meeting point</legend>
            <div className="flex flex-col gap-2" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div className="isolate z-0 w-full rounded-md border border-gray-300 dark:border-gray-600" style={{ height: '220px' }} role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div className="flex flex-wrap items-end gap-2">
                <label className="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" className="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-90" max="90" inputMode="decimal" data-fg-loc-lat />
                </label>
                <label className="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" className="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-180" max="180" inputMode="decimal" data-fg-loc-lng />
                </label>
                <button type="button" className="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-mine>Use my location</button>
                <button type="button" className="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-clear>Clear</button>
              </div>
              <p className="m-0 text-sm text-gray-600 empty:hidden dark:text-gray-400" aria-live="polite" data-fg-loc-status></p>
            </div>
            {errors['meet'] && <p className="text-sm text-red-600" role="alert">{errors['meet']}</p>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Signature</legend>
            <div className="flex flex-col gap-2" data-fg-sign>
              <canvas id="fg_signature" className="block w-full touch-none cursor-crosshair rounded-md border border-dashed border-gray-300 bg-white dark:border-gray-600" style={{ height: '140px' }} role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature"></canvas>
              <div className="flex justify-end gap-2 [&>input]:min-w-0 [&>input]:flex-1">
                <input type="text" className="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type />
                <button type="button" className="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            {errors['signature'] && <p className="text-sm text-red-600" role="alert">{errors['signature']}</p>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <figure className="border-s-4 border-gray-300 ps-4 dark:border-gray-600">
            <blockquote className="text-base italic">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption className="mt-1 text-sm text-gray-500 dark:text-gray-400">FormsGen</figcaption>
          </figure>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="fg-html text-base [&_a]:underline"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style={{ color: "#b91c1c" }}>{"Closed on holidays. {{ not.vue }} @razor {jsx}"}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerPolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <a className="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span className="sr-only"> (opens in a new tab)</span></a>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_contact_method">Preferred contact method<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <select id="fg_contact_method" value={form.contact_method ?? ''} className={errors['contact_method'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem] border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => setField('contact_method', e.target.value === '' ? null : e.target.value)} onBlur={() => touch('contact_method')}>
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </select>
            {errors['contact_method'] && <p className="text-sm text-red-600" role="alert">{errors['contact_method']}</p>}
          </div>
        </div>
        {((form.contact_method === "phone")) && (
