              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_github">GitHub username</label>
                <input id="fg_github" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-path="github" data-fg-kind="text">
                <p id="fg_err_github" class="text-xs text-red-600" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div>
          <ol class="mb-4 flex flex-wrap gap-4 text-sm text-gray-500">
            <li class="flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100" data-fg-sec-item="ks_wizard:0">1. Shipping</li>
            <li class="flex items-center gap-2" data-fg-sec-item="ks_wizard:1">2. Review</li>
          </ol>
          <div data-fg-sec-panel="ks_wizard:0">
          <div class="grid grid-cols-12 gap-4">
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_shipping_city">Shipping city<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                <input id="fg_shipping_city" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-path="shipping_city" data-fg-kind="text">
                <p id="fg_err_shipping_city" class="text-xs text-red-600" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_wizard:1" hidden>
          <div class="grid grid-cols-12 gap-4">
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_order_notes">Order notes</label>
                <textarea id="fg_order_notes" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" data-fg-path="order_notes" data-fg-kind="text"></textarea>
                <p id="fg_err_order_notes" class="text-xs text-red-600" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div class="mt-4 flex justify-between gap-2">
            <button type="button" class="rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-step-back="ks_wizard" hidden>Back</button>
            <button type="button" class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300" data-fg-step-next="ks_wizard">Next</button>
            <button type="submit" class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300" data-fg-submit hidden>Submit</button>
          </div>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center gap-2">
            <input id="fg_newsletter" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" data-fg-path="newsletter" data-fg-kind="checkbox" checked>
            <label class="inline-flex items-center gap-2 text-sm" for="fg_newsletter">Subscribe to the newsletter</label>
          </div>
          <p id="fg_err_newsletter" class="text-xs text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center gap-2">
            <input id="fg_terms" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" data-fg-path="terms" data-fg-kind="checkbox">
            <label class="inline-flex items-center gap-2 text-sm" for="fg_terms">I accept the terms<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          </div>
          <p id="fg_err_terms" class="text-xs text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <button type="button" class="rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-reset>Start over</button>
      </div>
    </div>
    <div id="fg-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <pre id="fg-result" class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-xs text-green-300" hidden></pre>
  </form>
  <script>
  (function () {
    'use strict'
    function fgIsEmpty(v) {
      if (v === null || v === undefined) return true
      if (typeof v === 'string') return v.trim() === ''
      if (Array.isArray(v)) return v.length === 0
      return false
    }
    // Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
    // never compare a string field with false).
    function fgIsBlank(v) {
      return fgIsEmpty(v) || v === false
    }
    function fgSize(v) {
      if (typeof v === 'number') return Number.isFinite(v) ? v : null
      if (typeof v === 'string') return v.length
      if (Array.isArray(v)) return v.length
      return null
    }
    function fgAccepts(file, accept) {
      if (accept.trim() === '') return true
      const name = file.name.toLowerCase()
      const type = (file.type || '').toLowerCase()
      return accept.split(',').map((token) => token.trim().toLowerCase()).filter(Boolean).some((token) =>
        token.startsWith('.') ? name.endsWith(token) : token.endsWith('/*') ? type.startsWith(token.slice(0, -1)) : type === token,
      )
    }
    function fgFileProblem(v, accept, maxMb, maxFiles, m) {
      const files = Array.isArray(v) ? v.filter((f) => f instanceof File) : []
      if (maxFiles > 0 && files.length > maxFiles) return m.tooMany
      for (const file of files) {
        if (!fgAccepts(file, accept)) return m.type.split('{name}').join(file.name)
        if (maxMb > 0 && file.size > maxMb * 1024 * 1024) return m.size.split('{name}').join(file.name)
      }
      return null
    }
    function fgFileJson(_key, value) {
      return value instanceof File ? { name: value.name, size: value.size, type: value.type } : value
    }
    function fgMultipart(payload) {
      const files = []
      const walk = (value, path) => {
        if (value instanceof File) {
          files.push({ path, file: value })
          return fgFileJson('', value)
        }
        if (Array.isArray(value)) {
          const fileList = value.length > 0 && value.every((v) => v instanceof File)
          return value.map((v, i) => walk(v, fileList ? path : path + '.' + i))
        }
        if (value && typeof value === 'object') {
          const out = {}
          for (const [key, v] of Object.entries(value)) out[key] = walk(v, path ? path + '.' + key : key)
          return out
        }
        return value
      }
      const data = walk(payload, '')
      const body = new FormData()
      body.append('data', JSON.stringify(data))
      for (const part of files) body.append(part.path, part.file, part.file.name)
      return body
    }

    var fgTags = {}
    var fgTagsPaint = {}
    function fgControl(path) {
      return document.querySelector('[data-fg-path="' + path + '"]')
    }
    function fgGet(path) {
      var el = fgControl(path)
      if (!el) return undefined
      var kind = el.getAttribute('data-fg-kind')
      if (kind === 'checkbox') return el.checked
      if (kind === 'select') return el.value === '' ? null : el.value
      if (kind === 'number') return el.value === '' ? null : Number(el.value)
      if (kind === 'radio') {
        var checked = document.querySelector('[data-fg-path="' + path + '"]:checked')
        return checked ? checked.value : null
      }
      if (kind === 'multiselect') {
        return Array.prototype.map.call(el.selectedOptions, function (option) { return option.value })
      }
      if (kind === 'tags') return (fgTags[path] || []).slice()
      if (kind === 'files') return (fgFiles[path] || []).slice()
      if (kind === 'checks') {
        return Array.prototype.map.call(
          document.querySelectorAll('[data-fg-path="' + path + '"]:checked'),
          function (box) { return box.value },
        )
      }
      return el.value
    }

    function fgVisible_attachments_note() {
      return ((!fgIsBlank(fgGet("attachments"))))
    }
    function fgVisible_contact_phone() {
      return ((fgGet("contact_method") === "phone"))
    }
    function fgVisible_contact_other() {
      return ((fgGet("contact_method") === "other"))
    }

    var FG_CONDITIONS = [
      { index: 0, test: function () { return (!fgIsBlank(fgGet("attachments"))) } },
      { index: 1, test: function () { return (fgGet("contact_method") === "phone") } },
      { index: 2, test: function () { return (fgGet("contact_method") === "other") } },
    ]

    var FG_VALIDATORS = {
      'full_name': function () {
      const v = fgGet("full_name")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
      return null
      },
      'email': function () {
      const v = fgGet("email")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
      },
      'website': function () {
      const v = fgGet("website")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
      return null
      },
      'seats': function () {
      const v = fgGet("seats")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
      return null
      },
      'zip': function () {
      const v = fgGet("zip")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
      return null
      },
      'account.username': function () {
      const v = fgGet("account.username")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
      return null
      },
      'account.bio': function () {
      const v = fgGet("account.bio")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
      return null
      },
      'account.avatar': function () {
      const v = fgGet("account.avatar")
      { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose at most 1 files","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
      return null
      },
      'plan': function () {
      const v = fgGet("plan")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'topics': function () {
      const v = fgGet("topics")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
      return null
      },
      'attachments': function () {
      const v = fgGet("attachments")
      if (fgIsBlank(v)) return "This field is required"
      { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
      return null
      },
      'contact_method': function () {
      const v = fgGet("contact_method")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'shipping_city': function () {
      const v = fgGet("shipping_city")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'terms': function () {
      const v = fgGet("terms")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
    }

    var touched = {}

    function fgKey(path) { return path.replace(/\\./g, '_') }

    function setError(path, message) {
      var el = document.getElementById('fg_err_' + fgKey(path))
      var control = fgControl(path)
      var invalid = "border-red-500 focus:ring-red-200".split(' ').filter(Boolean)
      if (el) {
        el.textContent = message || ''
        el.hidden = !message
      }
      if (control) {
        invalid.forEach(function (cls) { control.classList.toggle(cls, Boolean(message)) })
      }
    }

    function validateField(path) {
      var validate = fgValidatorFor(path)
      if (!validate) return true
      var message = validate()
      setError(path, message)
      return !message
    }

    function fgHasError(path) {
      var validate = fgValidatorFor(path)
      return validate ? Boolean(validate()) : false
    }

    function updateConditions() {
      FG_CONDITIONS.forEach(function (c) {
        var el = document.querySelector('[data-fg-cond="' + c.index + '"]')
        if (el) el.hidden = !c.test()
      })
      Object.keys(FG_REPEATERS).forEach(function (path) {
        fgItemElements(path).forEach(function (item, i) {
          Array.prototype.forEach.call(item.querySelectorAll('[data-fg-icond]'), function (el) {
            el.hidden = !FG_ITEM_CONDITIONS[Number(el.getAttribute('data-fg-icond'))](i)
          })
        })
      })
    }

    // Repeating sections: items are clones of a <template>; the index in
    // ids and data paths is stamped on add and rewritten when an item above
    // is removed (errors and touched state move with their item).
    var FG_REPEATERS = {"references":{"key":"references","min":0,"max":3,"initial":1,"label":"Reference {n}"}}
    var FG_REPEATER_VISIBLE = {
      "references": function () { return true },
    }
    var FG_ITEM_VALIDATORS = {
      'references': {
        'name': function (i) {
          const v = fgGet("references." + i + ".name")
          if (fgIsBlank(v)) return "This field is required"
          return null
        },
        'email': function (i) {
          if (!((fgGet("references." + i + ".may_contact") === true))) return null
          const v = fgGet("references." + i + ".email")
          if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
          return null
        },
      },
    }
    var FG_ITEM_CONDITIONS = [
      function (i) { return (fgGet("references." + i + ".may_contact") === true) },
    ]
    function fgItemElements(path) {
      var list = document.querySelector('[data-fg-items="' + path + '"]')
      return list ? Array.prototype.slice.call(list.children) : []
    }
    function fgItemIndexes(path) {
      return fgItemElements(path).map(function (_, i) { return i })
    }
    function fgItemLabel(path, index) {
      return FG_REPEATERS[path].label.split('{n}').join(String(index + 1))
    }
    function fgItemPaths(path) {
      if (!FG_REPEATER_VISIBLE[path]()) return []
      var fields = Object.keys(FG_ITEM_VALIDATORS[path] || {})
      var out = []
      fgItemElements(path).forEach(function (_, i) {
        fields.forEach(function (field) { out.push(path + '.' + i + '.' + field) })
      })
      return out
    }
    function fgAllPaths() {
      var out = Object.keys(FG_VALIDATORS)
      Object.keys(FG_REPEATERS).forEach(function (path) { out = out.concat(fgItemPaths(path)) })
      return out
    }
    function fgStepPaths(meta, index) {
      var out = (meta.stepPaths[index] || []).slice()
      ;(meta.stepRepeaters[index] || []).forEach(function (path) { out = out.concat(fgItemPaths(path)) })
      return out
    }
    function fgValidatorFor(path) {
      if (FG_VALIDATORS[path]) return FG_VALIDATORS[path]
      var match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
      var validate = match && FG_ITEM_VALIDATORS[match[1]] && FG_ITEM_VALIDATORS[match[1]][match[3]]
      if (!validate) return null
      return function () { return validate(Number(match[2])) }
    }
    /** Rewrites one item's index in every attribute below it. */
    function fgStampIndex(root, path, from, to) {
      var key = FG_REPEATERS[path].key
      var swaps = [[path + '.' + from + '.', path + '.' + to + '.'], [key + '_' + from + '_', key + '_' + to + '_']]
      var nodes = [root].concat(Array.prototype.slice.call(root.querySelectorAll('*')))
      nodes.forEach(function (el) {
        Array.prototype.forEach.call(el.attributes, function (attr) {
          var value = attr.value
          swaps.forEach(function (s) { value = value.split(s[0]).join(s[1]) })
          if (value !== attr.value) el.setAttribute(attr.name, value)
        })
      })
    }
    function fgRefreshItems(path) {
      var list = fgItemElements(path)
      var meta = FG_REPEATERS[path]
      list.forEach(function (item, index) {
        var current = Number(item.getAttribute('data-fg-index'))
        if (current !== index) {
          fgStampIndex(item, path, current, index)
          item.setAttribute('data-fg-index', String(index))
        }
        item.querySelector('[data-fg-item-label]').textContent = fgItemLabel(path, index)
        var remove = item.querySelector('[data-fg-remove]')
        remove.setAttribute('aria-label', "Remove {label}".split('{label}').join(fgItemLabel(path, index)))
        remove.parentNode.hidden = list.length <= meta.min
      })
      var add = document.querySelector('[data-fg-add="' + path + '"]')
      if (add) add.hidden = meta.max !== null && list.length >= meta.max
    }
    function fgAddItem(path, focus) {
      var meta = FG_REPEATERS[path]
      var list = document.querySelector('[data-fg-items="' + path + '"]')
      var template = document.querySelector('[data-fg-template="' + path + '"]')
      var index = list.children.length
      if (meta.max !== null && index >= meta.max) return
      var item = template.content.firstElementChild.cloneNode(true)
      fgStampIndex(item, path, '__i__', index)
      item.setAttribute('data-fg-index', String(index))
      item.querySelector('[data-fg-remove]').addEventListener('click', function () {
        fgRemoveItem(path, Number(item.getAttribute('data-fg-index')))
      })
      list.appendChild(item)
      fgRefreshItems(path)
      updateConditions()
      if (focus) {
        var control = item.querySelector('input:not([type=hidden]), select, textarea')
        ;(control || item).focus()
        fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, index)))
      }
    }
    function fgRemoveItem(path, index) {
      var items = fgItemElements(path)
      if (items.length <= FG_REPEATERS[path].min) return
      var label = fgItemLabel(path, index)
      var prefix = path + '.'
      var moved = {}
      Object.keys(touched).forEach(function (key) {
        if (key.indexOf(prefix) !== 0) { moved[key] = true; return }
        var rest = key.slice(prefix.length)
        var n = Number(rest.split('.')[0])
        if (n === index) return
        moved[n > index ? prefix + (n - 1) + rest.slice(String(n).length) : key] = true
      })
      Object.keys(touched).forEach(function (key) { delete touched[key] })
      Object.keys(moved).forEach(function (key) { touched[key] = true })
      items[index].remove()
      fgRefreshItems(path)
      updateConditions()
      fgItemPaths(path).forEach(function (p) { if (touched[p]) validateField(p); else setError(p, null) })
      var remaining = fgItemElements(path)
      var target = remaining[Math.min(index, remaining.length - 1)] || document.querySelector('[data-fg-add="' + path + '"]')
      if (target) target.focus()
      fgAnnounce("{label} removed".split('{label}').join(label))
    }
    Object.keys(FG_REPEATERS).forEach(function (path) {
      for (var n = 0; n < FG_REPEATERS[path].initial; n++) fgAddItem(path, false)
      document.querySelector('[data-fg-add="' + path + '"]').addEventListener('click', function () { fgAddItem(path, true) })
    })


    // Tags (chips) fields: value lives in fgTags, chips are painted into
    // the [data-fg-tags-chips] span, Enter/comma/blur adds the draft.
    Array.prototype.forEach.call(document.querySelectorAll('[data-fg-kind="tags"]'), function (wrap) {
      var path = wrap.getAttribute('data-fg-path')
      fgTags[path] = []
      var chips = wrap.querySelector('[data-fg-tags-chips="' + path + '"]')
      var input = wrap.querySelector('[data-fg-tags-input="' + path + '"]')
      if (!chips || !input) return
      function paint() {
        chips.textContent = ''
        fgTags[path].forEach(function (tag, index) {
          var chip = document.createElement('span')
          chip.className = "inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700"
          chip.appendChild(document.createTextNode(tag + ' '))
          var remove = document.createElement('button')
          remove.type = 'button'
          remove.className = "text-gray-500 hover:text-red-600"
          remove.setAttribute('aria-label', 'Remove ' + (tag))
          remove.textContent = '\\u00d7'
          remove.addEventListener('click', function () {
            fgTags[path].splice(index, 1)
            paint()
            if (touched[path]) validateField(path)
            updateConditions()
          })
          chip.appendChild(remove)
          chips.appendChild(chip)
        })
      }
      function addDraft() {
        var draft = input.value.trim()
        if (draft !== '' && fgTags[path].indexOf(draft) === -1) {
          fgTags[path].push(draft)
          paint()
        }
        input.value = ''
        if (touched[path]) validateField(path)
        updateConditions()
      }
      fgTagsPaint[path] = paint
      input.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ',') { event.preventDefault(); addDraft() }
      })
      input.addEventListener('blur', function () {
        addDraft()
        fgBlurValidate(path)
      })
    })

    var fgFiles = {}
    var FG_FILE_MULTIPLE = {"account.avatar":false,"attachments":true}
    function fgFileSize(bytes) {
      return bytes >= 1024 * 1024 ? (bytes / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'
    }
    function fgPaintFiles(path) {
      var list = document.querySelector('[data-fg-file-list="' + path + '"]')
      var input = fgControl(path)
      if (!list || !input) return
      Array.prototype.forEach.call(list.querySelectorAll('img'), function (img) { URL.revokeObjectURL(img.src) })
      list.textContent = ''
      list.hidden = fgFiles[path].length === 0
      fgFiles[path].forEach(function (file, index) {
        var item = document.createElement('li')
        item.className = "flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50"
        if (input.hasAttribute('data-fg-thumbs') && file.type.indexOf('image/') === 0) {
          var img = document.createElement('img')
          img.className = "h-10 w-10 rounded object-cover"
          img.src = URL.createObjectURL(file)
          img.alt = ''
          img.width = 40
          img.height = 40
          item.appendChild(img)
        }
        var name = document.createElement('span')
        name.className = "min-w-0 flex-1 truncate"
        name.textContent = file.name
        var size = document.createElement('span')
        size.className = "text-xs text-gray-500 dark:text-gray-400"
        size.textContent = fgFileSize(file.size)
        var remove = document.createElement('button')
        remove.type = 'button'
        remove.className = "px-1.5 text-lg leading-none text-gray-500 hover:text-red-600"
        remove.textContent = '\\u00d7'
        remove.setAttribute('aria-label', "Remove {name}".split('{name}').join(file.name))
        remove.addEventListener('click', function () {
          fgFiles[path].splice(index, 1)
          fgPaintFiles(path)
          touched[path] = true
          validateField(path)
          updateConditions()
        })
        item.appendChild(name)
        item.appendChild(size)
        item.appendChild(remove)
        list.appendChild(item)
      })
    }
    Array.prototype.forEach.call(document.querySelectorAll('[data-fg-kind="files"]'), function (input) {
      var path = input.getAttribute('data-fg-path')
      fgFiles[path] = []
      input.addEventListener('change', function () {
        var picked = Array.prototype.slice.call(input.files || [])
        input.value = ''
        if (picked.length === 0) return
        fgFiles[path] = FG_FILE_MULTIPLE[path] ? fgFiles[path].concat(picked) : picked.slice(0, 1)
        fgPaintFiles(path)
        touched[path] = true
        validateField(path)
      })
    })

    // Polite aria-live region; cleared first so repeated text re-announces.
    function fgAnnounce(message) {
      var live = document.getElementById('fg-live')
      if (!live) return
      live.textContent = ''
      setTimeout(function () { live.textContent = message }, 50)
    }
    function fgErrorsText(count) {
      const forms = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
      const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
      return text.split('{n}').join(String(count))
    }

    var FG_SECTIONS = [{"key":"ks_social_tabs","kind":"tabs","count":2,"tabActive":"-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600","tabBase":"-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700","stepActive":"flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100","stepBase":"flex items-center gap-2","stepPaths":[["twitter"],["github"]],"stepRepeaters":[[],[]],"announce":[]},{"key":"ks_wizard","kind":"steps","count":2,"tabActive":"-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600","tabBase":"-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700","stepActive":"flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100","stepBase":"flex items-center gap-2","stepPaths":[["shipping_city"],["order_notes"]],"stepRepeaters":[[],[]],"announce":["Step 1 of 2: Shipping","Step 2 of 2: Review"]}]
    var FG_SUBMIT_GATE = ["ks_wizard"]
    var fgSecState = {}
    function fgUpdateSubmit() {
      var btn = document.querySelector('[data-fg-submit]')
      if (!btn || FG_SUBMIT_GATE.length === 0) return
      var ready = FG_SUBMIT_GATE.every(function (key) {
        var meta = null
        FG_SECTIONS.forEach(function (m) { if (m.key === key) meta = m })
        return !meta || (fgSecState[key] || 0) >= meta.count - 1
      })
      btn.hidden = !ready
    }
    function fgSetSec(meta, index, speak) {
      fgSecState[meta.key] = index
      if (speak && meta.announce[index]) fgAnnounce(meta.announce[index])
      var panels = document.querySelectorAll('[data-fg-sec-panel]')
      Array.prototype.forEach.call(panels, function (panel) {
        var value = panel.getAttribute('data-fg-sec-panel')
        if (value.indexOf(meta.key + ':') === 0) panel.hidden = value !== meta.key + ':' + index
      })
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          var active = btn.getAttribute('data-fg-sec-btn') === meta.key + ':' + index
          btn.className = active ? meta.tabActive : meta.tabBase
        },
      )
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-item^="' + meta.key + ':"]'),
        function (item) {
          var active = item.getAttribute('data-fg-sec-item') === meta.key + ':' + index
          item.className = active ? meta.stepActive : meta.stepBase
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.hidden = index === 0
      if (nextBtn) nextBtn.hidden = index >= meta.count - 1
      fgUpdateSubmit()
    }
    FG_SECTIONS.forEach(function (meta) {
      fgSecState[meta.key] = 0
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          btn.addEventListener('click', function () {
            fgSetSec(meta, Number(btn.getAttribute('data-fg-sec-btn').split(':')[1]))
          })
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.addEventListener('click', function () {
        fgSetSec(meta, Math.max(0, fgSecState[meta.key] - 1), true)
      })
      if (nextBtn) nextBtn.addEventListener('click', function () {
        var ok = true
        var paths = fgStepPaths(meta, fgSecState[meta.key])
        paths.forEach(function (path) {
          touched[path] = true
          if (!validateField(path)) ok = false
        })
        if (ok) fgSetSec(meta, Math.min(meta.count - 1, fgSecState[meta.key] + 1), true)
      })
      fgSetSec(meta, 0)
    })

    function buildPayload() {
      return {
        "full_name": fgGet("full_name"),
        "email": fgGet("email"),
        "website": fgGet("website"),
        "seats": fgGet("seats"),
        "satisfaction": fgGet("satisfaction"),
        "city": fgGet("city"),
        "zip": fgGet("zip"),
        "account": {
          "username": fgGet("account.username"),
          "password": fgGet("account.password"),
          "bio": fgGet("account.bio"),
          "birthday": fgGet("account.birthday"),
          "avatar": fgGet("account.avatar"),
        },
