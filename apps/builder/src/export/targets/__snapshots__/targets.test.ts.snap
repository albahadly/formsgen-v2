            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_username">Username<span class="text-danger ms-1" aria-hidden="true">*</span></label>
                <input id="fg_account_username" v-model="form.account.username" type="text" class="form-control" :class="{ 'is-invalid': !!errors['account.username'] }" @blur="touch('account.username')" @input="revalidate('account.username')">
                <p v-if="errors['account.username']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['account.username'] }}</p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_password">Password</label>
                <input id="fg_account_password" v-model="form.account.password" type="password" class="form-control" :class="{ 'is-invalid': !!errors['account.password'] }" @blur="touch('account.password')" @input="revalidate('account.password')">
                <p v-if="errors['account.password']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['account.password'] }}</p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" v-model="form.account.bio" class="form-control form-control-lg" rows="4" :class="{ 'is-invalid': !!errors['account.bio'] }" @blur="touch('account.bio')" @input="revalidate('account.bio')"></textarea>
                <p v-if="errors['account.bio']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['account.bio'] }}</p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" v-model="form.account.birthday" type="date" class="form-control" :class="{ 'is-invalid': !!errors['account.birthday'] }" @blur="touch('account.birthday')" @input="revalidate('account.birthday')">
                <p v-if="errors['account.birthday']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['account.birthday'] }}</p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_avatar">Profile picture</label>
                <input id="fg_account_avatar" type="file" class="form-control" accept="image/*" :aria-invalid="errors['account.avatar'] ? 'true' : undefined" @change="fgPickFiles('account.avatar', $event)">
                <ul v-if="form.account.avatar.length" class="list-group mt-2">
                  <li v-for="(file, fi) in form.account.avatar" :key="fi" class="list-group-item d-flex align-items-center gap-2">
                    <img v-if="file.type.startsWith('image/')" class="rounded object-fit-cover" :src="fgThumb(file)" alt="" width="40" height="40">
                    <span class="flex-grow-1 text-truncate">{{ file.name }}</span>
                    <span class="text-body-secondary small">{{ fgFileSize(file.size) }}</span>
                    <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" :aria-label="fgRemoveFileLabel(file.name)" @click="fgRemoveFile('account.avatar', fi)">×</button>
                  </li>
                </ul>
                <p v-if="errors['account.avatar']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['account.avatar'] }}</p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column gap-1">
