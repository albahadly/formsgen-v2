        {((!fgIsBlank(form.attachments))) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column gap-1">
              <label className="form-label fw-semibold mb-0" htmlFor="fg_attachments_note">Notes about the attachments</label>
              <textarea id="fg_attachments_note" rows={3} value={form.attachments_note} className={errors['attachments_note'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('attachments_note', e.target.value)} onBlur={() => touch('attachments_note')} />
              {errors['attachments_note'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['attachments_note']}</p>}
            </div>
          </div>
        )}
        <div className="col-12 col-md-12">
          <figure className="mb-0">
            <blockquote className="blockquote">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption className="blockquote-footer mb-0">FormsGen</figcaption>
          </figure>
        </div>
        <div className="col-12 col-md-12">
          <a className="link-primary" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span className="visually-hidden"> (opens in a new tab)</span></a>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_method">Preferred contact method<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <select id="fg_contact_method" value={form.contact_method ?? ''} className={errors['contact_method'] ? "form-select is-invalid" : "form-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => setField('contact_method', e.target.value === '' ? null : e.target.value)} onBlur={() => touch('contact_method')}>
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </select>
            {errors['contact_method'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_method']}</p>}
          </div>
        </div>
        {((form.contact_method === "phone")) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column gap-1">
              <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_phone">Phone number</label>
              <input id="fg_contact_phone" type="tel" value={form.contact_phone} className={errors['contact_phone'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('contact_phone', e.target.value)} onBlur={() => touch('contact_phone')} />
              {errors['contact_phone'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_phone']}</p>}
            </div>
          </div>
        )}
        {((form.contact_method === "other")) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column gap-1">
              <label className="form-label fw-semibold mb-0" htmlFor="fg_contact_other">Describe your preferred method</label>
              <textarea id="fg_contact_other" rows={3} value={form.contact_other} className={errors['contact_other'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('contact_other', e.target.value)} onBlur={() => touch('contact_other')} />
              {errors['contact_other'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['contact_other']}</p>}
            </div>
          </div>
        )}
        <div className="col-12 col-md-12">
          <div>
            <div className="nav nav-tabs mb-3" role="tablist">
              <button type="button" className={fgSec_ks_social_tabs === 0 ? "nav-link active" : "nav-link"} onClick={() => setFgSec_ks_social_tabs(0)}>Social</button>
              <button type="button" className={fgSec_ks_social_tabs === 1 ? "nav-link active" : "nav-link"} onClick={() => setFgSec_ks_social_tabs(1)}>Code</button>
            </div>
            <div style={{ display: fgSec_ks_social_tabs === 0 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_twitter">Twitter handle</label>
                    <input id="fg_twitter" type="text" value={form.twitter} className={errors['twitter'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('twitter', e.target.value)} onBlur={() => touch('twitter')} />
                    {errors['twitter'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['twitter']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div style={{ display: fgSec_ks_social_tabs === 1 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_github">GitHub username</label>
                    <input id="fg_github" type="text" value={form.github} className={errors['github'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('github', e.target.value)} onBlur={() => touch('github')} />
                    {errors['github'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['github']}</p>}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div>
            <ol className="nav mb-3 gap-3 small text-secondary list-unstyled d-flex flex-wrap">
              <li className={fgSec_ks_wizard === 0 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2"}>1. Shipping</li>
              <li className={fgSec_ks_wizard === 1 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2"}>2. Review</li>
            </ol>
            <div style={{ display: fgSec_ks_wizard === 0 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_shipping_city">Shipping city<span className="text-danger ms-1" aria-hidden="true">*</span></label>
                    <input id="fg_shipping_city" type="text" value={form.shipping_city} className={errors['shipping_city'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('shipping_city', e.target.value)} onBlur={() => touch('shipping_city')} />
                    {errors['shipping_city'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['shipping_city']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div style={{ display: fgSec_ks_wizard === 1 ? undefined : 'none' }}>
              <div className="row g-3">
                <div className="col-12 col-md-12">
                  <div className="d-flex flex-column gap-1">
                    <label className="form-label fw-semibold mb-0" htmlFor="fg_order_notes">Order notes</label>
                    <textarea id="fg_order_notes" rows={3} value={form.order_notes} className={errors['order_notes'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('order_notes', e.target.value)} onBlur={() => touch('order_notes')} />
                    {errors['order_notes'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['order_notes']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div className="mt-3 d-flex justify-content-between gap-2">
              {fgSec_ks_wizard > 0 && <button type="button" className="btn btn-outline-secondary" onClick={() => fgGo_ks_wizard(fgSec_ks_wizard - 1)}>Back</button>}
              {fgSec_ks_wizard < 1 && <button type="button" className="btn btn-primary" onClick={fgNext_ks_wizard}>Next</button>}
              {fgSec_ks_wizard === 1 && <button type="submit" className="btn btn-primary">Submit</button>}
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <div className="form-check">
              <input id="fg_newsletter" type="checkbox" checked={form.newsletter} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('newsletter', e.target.checked); touch('newsletter') }} />
              <label className="form-check-label" htmlFor="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            {errors['newsletter'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['newsletter']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <div className="form-check">
              <input id="fg_terms" type="checkbox" checked={form.terms} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('terms', e.target.checked); touch('terms') }} />
              <label className="form-check-label" htmlFor="fg_terms">I accept the terms<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            </div>
            {errors['terms'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['terms']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <button type="button" className="btn btn-outline-secondary" onClick={fgReset}>Start over</button>
        </div>
      </div>
      <div className="visually-hidden" role="status" aria-live="polite" aria-atomic="true">{fgAnnouncement}</div>
      {result && <pre className="mt-3 p-3 bg-dark text-success rounded small overflow-auto">{JSON.stringify(result, fgFileJson, 2)}</pre>}
    </form>
  )
}
"
`;

exports[`react target > snapshot (tailwind) 1`] = `
"// Generated by FormsGen — no runtime dependencies beyond React.
import React, { useEffect, useRef, useState } from 'react'

function fgIsEmpty(v: unknown): boolean {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
// Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
// never compare a string field with false).
function fgIsBlank(v: unknown): boolean {
  return fgIsEmpty(v) || v === false
}
function fgSize(v: unknown): number | null {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}
function fgAccepts(file: File, accept: string): boolean {
  if (accept.trim() === '') return true
  const name = file.name.toLowerCase()
  const type = (file.type || '').toLowerCase()
  return accept.split(',').map((token) => token.trim().toLowerCase()).filter(Boolean).some((token) =>
    token.startsWith('.') ? name.endsWith(token) : token.endsWith('/*') ? type.startsWith(token.slice(0, -1)) : type === token,
  )
}
function fgFileProblem(v: unknown, accept: string, maxMb: number, maxFiles: number, m: { tooMany: string; type: string; size: string }): string | null {
  const files = Array.isArray(v) ? v.filter((f) => f instanceof File) as File[] : []
  if (maxFiles > 0 && files.length > maxFiles) return m.tooMany
  for (const file of files) {
    if (!fgAccepts(file, accept)) return m.type.split('{name}').join(file.name)
    if (maxMb > 0 && file.size > maxMb * 1024 * 1024) return m.size.split('{name}').join(file.name)
  }
  return null
}
function fgFileJson(_key: string, value: unknown): unknown {
  return value instanceof File ? { name: value.name, size: value.size, type: value.type } : value
}
function fgMultipart(payload: Record<string, unknown>) {
  const files: { path: string; file: File }[] = []
  const walk = (value: unknown, path: string): unknown => {
    if (value instanceof File) {
      files.push({ path, file: value })
      return fgFileJson('', value)
    }
    if (Array.isArray(value)) {
      const fileList = value.length > 0 && value.every((v) => v instanceof File)
      return value.map((v, i) => walk(v, fileList ? path : path + '.' + i))
    }
    if (value && typeof value === 'object') {
      const out: Record<string, unknown> = {}
      for (const [key, v] of Object.entries(value)) out[key] = walk(v, path ? path + '.' + key : key)
      return out
    }
    return value
  }
  const data = walk(payload, '')
  const body = new FormData()
  body.append('data', JSON.stringify(data))
  for (const part of files) body.append(part.path, part.file, part.file.name)
  return body
}

type FormData = {
  full_name: string
  email: string
  website: string
  seats: number | null
  satisfaction: number
  city: string
  zip: string
  account: {
    username: string
    password: string
    bio: string
    birthday: string
    avatar: File[]
  }
  plan: string | null
  interests: string[]
  channels: string[]
  topics: string[]
  billing: string | null
  extras: string[]
  notify: boolean
  appointment: string
  brand_color: string
  volume: number
  source: string
  attachments: File[]
  attachments_note: string
  contact_method: string | null
  contact_phone: string
  contact_other: string
  twitter: string
  github: string
  shipping_city: string
  order_notes: string
  newsletter: boolean
  terms: boolean
  references: Array<{
    name: string
    may_contact: boolean
    email: string
  }>
}

const INITIAL: FormData = {
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: "",
    avatar: []
  },
  plan: null,
  interests: [],
  channels: [],
  topics: [],
  billing: null,
  extras: [],
  notify: true,
  appointment: "",
  brand_color: "#000000",
  volume: 0,
  source: "kitchen-sink",
  attachments: [],
  attachments_note: "",
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false,
  references: [{
    name: "",
    may_contact: false,
    email: ""
  }]
}

function fgVisible_attachments_note(data: FormData) {
  return ((!fgIsBlank(data.attachments)))
}
function fgVisible_contact_phone(data: FormData) {
  return ((data.contact_method === "phone"))
}
function fgVisible_contact_other(data: FormData) {
  return ((data.contact_method === "other"))
}

const validators: Record<string, (data: FormData) => string | null> = {
  'full_name': function (data: FormData) {
  const v = data.full_name
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function (data: FormData) {
  const v = data.email
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function (data: FormData) {
  const v = data.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function (data: FormData) {
  const v = data.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'account.avatar': function (data: FormData) {
  const v = data.account.avatar
  { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose at most 1 files","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
  return null
  },
  'plan': function (data: FormData) {
  const v = data.plan
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'topics': function (data: FormData) {
  const v = data.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'attachments': function (data: FormData) {
  const v = data.attachments
  if (fgIsBlank(v)) return "This field is required"
  { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'shipping_city': function (data: FormData) {
  const v = data.shipping_city
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "website": data.website,
    "seats": data.seats,
    "satisfaction": data.satisfaction,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "password": data.account.password,
      "bio": data.account.bio,
      "birthday": data.account.birthday,
      "avatar": data.account.avatar,
    },
    "plan": data.plan,
    "interests": data.interests,
    "channels": data.channels,
    "topics": data.topics,
    "billing": data.billing,
    "extras": data.extras,
    "notify": data.notify,
    "appointment": data.appointment,
    "brand_color": data.brand_color,
    "volume": data.volume,
    "source": data.source,
    "references": data.references.map((item) => ({ "name": item.name, "may_contact": item.may_contact, ...((item.may_contact === true) ? { "email": item.email } : {}) })),
    "attachments": data.attachments,
    ...(fgVisible_attachments_note(data) ? { "attachments_note": data.attachments_note } : {}),
    "contact_method": data.contact_method,
    ...(fgVisible_contact_phone(data) ? { "contact_phone": data.contact_phone } : {}),
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "twitter": data.twitter,
    "github": data.github,
    "shipping_city": data.shipping_city,
    "order_notes": data.order_notes,
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

const FG_ITEM_DEFAULTS: Record<string, () => Record<string, unknown>> = {
  'references': () => ({
    name: "",
    may_contact: false,
    email: ""
  }),
}

const FG_ITEM_LIMITS: Record<string, { min: number; max: number }> = {
  'references': { min: 0, max: 3 },
}

const FG_ITEM_LABELS: Record<string, string> = {
  'references': "Reference {n}",
}

const FG_REPEATER_VISIBLE: Record<string, (data: FormData) => boolean> = {
  'references': (_data: FormData) => true,
}

const itemValidators: Record<string, Record<string, (item: Record<string, unknown>, data: FormData) => string | null>> = {
  'references': {
    'name': function (item: Record<string, unknown>, _data: FormData) {
      const v = item["name"]
      if (fgIsBlank(v)) return "This field is required"
      return null
    },
    'email': function (item: Record<string, unknown>, _data: FormData) {
      if (!((item["may_contact"] === true))) return null
      const v = item["email"]
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
    },
  },
}

function fgList(data: FormData, path: string): Record<string, unknown>[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as Record<string, unknown>[]
}

function fgItemLabel(path: string, index: number): string {
  return (FG_ITEM_LABELS[path] ?? '').split('{n}').join(String(index + 1))
}

function fgRemoveLabel(path: string, index: number): string {
  return "Remove {label}".split('{label}').join(fgItemLabel(path, index))
}

/** Every item field path of a visible repeater (validation, step gates). */
function fgItemPaths(data: FormData, path: string): string[] {
  if (!FG_REPEATER_VISIBLE[path]?.(data)) return []
  const fields = Object.keys(itemValidators[path] ?? {})
  return fgList(data, path).flatMap((_, i) => fields.map((field) => \`\${path}.\${i}.\${field}\`))
}

/** Validator for a field path, including item paths like "people.2.name". */
function fgValidatorFor(path: string): ((data: FormData) => string | null) | undefined {
  const direct = validators[path]
  if (direct) return direct
  const match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
  if (!match) return undefined
  const validate = itemValidators[match[1]!]?.[match[3]!]
  if (!validate) return undefined
  return (data) => {
    const item = fgList(data, match[1]!)[Number(match[2])]
    return item ? validate(item, data) : null
  }
}

/** All field paths to validate on submit (items included). */
function fgAllPaths(data: FormData): string[] {
  return [...Object.keys(validators), ...Object.keys(itemValidators).flatMap((path) => fgItemPaths(data, path))]
}

/** Moves item keys/paths after a removal: "people.3.x" → "people.2.x". */
function fgShiftKey(key: string, path: string, removed: number): string | null {
  if (!key.startsWith(path + '.')) return key
  const rest = key.slice(path.length + 1)
  const dot = rest.indexOf('.')
  const index = Number(dot === -1 ? rest : rest.slice(0, dot))
  if (!Number.isInteger(index)) return key
  if (index === removed) return null
  return index > removed ? \`\${path}.\${index - 1}\${dot === -1 ? '' : rest.slice(dot)}\` : key
}

const fgThumbs = new WeakMap<File, string>()
function fgThumb(file: File): string {
  let url = fgThumbs.get(file)
  if (!url) {
    url = URL.createObjectURL(file)
    fgThumbs.set(file, url)
  }
  return url
}
function fgReleaseThumb(file: File): void {
  const url = fgThumbs.get(file)
  if (url) URL.revokeObjectURL(url)
  fgThumbs.delete(file)
}
function fgFileSize(bytes: number): string {
  return bytes >= 1024 * 1024 ? (bytes / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'
}
function fgRemoveFileLabel(name: string): string {
  return "Remove {name}".split('{name}').join(name)
}

const FG_FILE_MULTIPLE: Record<string, boolean> = { 'account.avatar': false, 'attachments': true }

function fgFileList(data: FormData, path: string): File[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], data) as File[]
}

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]

function fgErrorsText(count: number): string {
  const forms: Record<string, string> & { other: string } = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgAnnouncement, setFgAnnouncement] = useState('')
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)
  const [tagDrafts, setTagDrafts] = useState<Record<string, string>>({})
  const fgRoot = useRef<HTMLFormElement>(null)
  // Stable React keys per item (the form object is cloned on every edit).
  const fgKeys = useRef<Record<string, number[]>>({})
  const fgNextKey = useRef(0)
  const fgPendingFocus = useRef<{ path: string; index: number } | null>(null)

  // Polite aria-live region; cleared first so repeated text re-announces.
  function fgAnnounce(message: string): void {
    setFgAnnouncement('')
    setTimeout(() => setFgAnnouncement(message), 50)
  }

  function fgGo_ks_wizard(index: number): void {
    setFgSec_ks_wizard(index)
    fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
  }

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = fgValidatorFor(path)
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) fgGo_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = fgValidatorFor(path)
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
  }

  // A blur error appearing while a pointer is held reflows the form and the
  // release misses its target; defer blur validation until the press ends.
  // Deferred work reads the latest state through refs, not this closure.
  const formRef = useRef(form)
  formRef.current = form
  const fgPressing = useRef(false)
  const fgDeferred = useRef(new Set<string>())
  const fgFlush = useRef(() => {})
  fgFlush.current = () => {
    const paths = [...fgDeferred.current]
    fgDeferred.current.clear()
    for (const path of paths) {
      touched.current.add(path)
      validateField(path, formRef.current)
    }
  }
  useEffect(() => {
    function end(): void {
      if (!fgPressing.current) return
      fgPressing.current = false
      setTimeout(() => fgFlush.current(), 0)
    }
    window.addEventListener('pointerup', end)
    window.addEventListener('pointercancel', end)
    return () => {
      window.removeEventListener('pointerup', end)
      window.removeEventListener('pointercancel', end)
    }
  }, [])

  function touch(path: string): void {
    if (fgPressing.current) {
      fgDeferred.current.add(path)
      return
    }
    touched.current.add(path)
    validateField(path, form)
  }

  function fgAddTag(path: string, current: string[]): void {
    const draft = (tagDrafts[path] ?? '').trim()
    if (draft !== '' && !current.includes(draft)) setField(path, [...current, draft])
    setTagDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveTag(path: string, current: string[], index: number): void {
    setField(path, current.filter((_, i) => i !== index))
  }

  function fgPickFiles(path: string, input: HTMLInputElement): void {
    const picked = Array.from(input.files ?? [])
    input.value = ''
    if (picked.length === 0) return
    touched.current.add(path)
    setField(path, FG_FILE_MULTIPLE[path] ? [...fgFileList(form, path), ...picked] : picked.slice(0, 1))
  }

  function fgRemoveFile(path: string, index: number): void {
    const list = fgFileList(form, path)
    const file = list[index]
    if (file) fgReleaseThumb(file)
    touched.current.add(path)
    setField(path, list.filter((_, i) => i !== index))
  }

  function fgKeyAt(path: string, index: number): number {
    const keys = (fgKeys.current[path] ??= [])
    while (keys.length <= index) keys.push(fgNextKey.current++)
    return keys[index]!
  }

  function fgAddItem(path: string): void {
    const list = fgList(form, path)
    if (list.length >= (FG_ITEM_LIMITS[path]?.max ?? Number.POSITIVE_INFINITY)) return
    setField(path, [...list, FG_ITEM_DEFAULTS[path]!()])
    fgPendingFocus.current = { path, index: list.length }
    fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length)))
  }

  function fgRemoveItem(path: string, index: number): void {
    const list = fgList(form, path)
    if (list.length <= (FG_ITEM_LIMITS[path]?.min ?? 0)) return
    const label = fgItemLabel(path, index)
    fgKeyAt(path, list.length - 1)
    fgKeys.current[path]!.splice(index, 1)
    const nextTouched = [...touched.current].map((k) => fgShiftKey(k, path, index)).filter((k): k is string => k !== null)
    touched.current = new Set(nextTouched)
    setErrors((prev) => {
      const next: Record<string, string> = {}
      for (const [key, message] of Object.entries(prev)) {
        const target = fgShiftKey(key, path, index)
        if (target !== null) next[target] = message
      }
      return next
    })
    setField(path, list.filter((_, i) => i !== index))
    fgPendingFocus.current = { path, index: -1 - index }
    fgAnnounce("{label} removed".split('{label}').join(label))
  }

  // After an add: focus the new item's first control. After a remove
  // (negative index): focus the item that took its place, or the add button.
  useEffect(() => {
    const pending = fgPendingFocus.current
    if (!pending) return
    fgPendingFocus.current = null
    const repeater = fgRoot.current?.querySelector(\`[data-fg-repeater="\${pending.path}"]\`)
    const items = Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
    if (pending.index >= 0) {
      const item = items[pending.index]
      const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
      ;(control ?? item)?.focus()
    } else {
      const removed = -1 - pending.index
      const target = items[Math.min(removed, items.length - 1)]
      ;(target ?? repeater?.querySelector<HTMLElement>('[data-fg-add]'))?.focus()
    }
  })

  function fgReset(): void {
    setForm(INITIAL)
    setErrors({})
    touched.current.clear()
    fgKeys.current = {}
    setResult(null)
    setTagDrafts({})
    fgAnnounce("The form was reset.")
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of fgAllPaths(form)) {
      touched.current.add(path)
      const message = fgValidatorFor(path)?.(form) ?? null
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) {
      if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_social_tabs(target)
      }
      if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_wizard(target)
      }
      fgAnnounce(fgErrorsText(Object.keys(nextErrors).length))
      return
    }
    const data = buildPayload(form)
    setResult(data)
    fgAnnounce("Form submitted.")
    onSubmit?.(data)
  }

  return (
    <form ref={fgRoot} className="mx-auto max-w-2xl p-6 font-sans text-gray-900 dark:text-gray-100" dir="ltr" noValidate onSubmit={handleSubmit} onPointerDownCapture={() => { fgFlush.current(); fgPressing.current = true }}>
      <div className="grid grid-cols-12 gap-4">
        <div className="col-span-12 md:col-span-12 text-center">
          <h2 className="font-semibold text-indigo-600 dark:text-indigo-400">Kitchen Sink</h2>
        </div>
        <div className="col-span-12 md:col-span-12 text-center">
          <p className="text-sm text-gray-600 dark:text-gray-300">Every implemented element appears in this form.</p>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_full_name">Full name<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="text-xs text-red-600" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_email">Email<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} placeholder="jane&#64;example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="text-xs text-red-600" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "w-full rounded-md border border-gray-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="text-xs text-red-600" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_seats">Seats</label>
            <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} min="1" max="50" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
            {errors['seats'] && <p className="text-xs text-red-600" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="w-full accent-indigo-600" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="text-xs text-gray-500 dark:text-gray-400">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="text-xs text-red-600" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <hr className="border-t border-indigo-500" />
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="grid grid-cols-12 gap-4">
            <div className="col-span-12 md:col-span-6">
              <div className="flex flex-col gap-1.5">
                <label className="text-sm font-semibold" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="text-xs text-red-600" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="col-span-12 md:col-span-6">
              <div className="flex flex-col gap-1.5">
                <label className="sr-only" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="text-xs text-red-600" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="col-span-12 md:col-span-12 account-box">
          <fieldset className="rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50">
            <legend className="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">Account</legend>
            <div className="grid grid-cols-12 gap-4">
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_username">Username<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                  <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  {errors['account.username'] && <p className="text-xs text-red-600" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="text-xs text-red-600" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="text-xs text-red-600" role="alert">{errors['account.bio']}</p>}
