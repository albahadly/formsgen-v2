            <table class="w-full border-collapse text-sm">
              <thead><tr><td></td><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Poor</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">OK</th><th scope="col" class="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Great</th></tr></thead>
              <tbody>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Speed</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Poor"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: OK"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-0-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Great"></td></tr>
              <tr class="border-t border-gray-200 dark:border-gray-700"><th scope="row" class="px-2 py-2 text-start font-medium leading-5">Quality</th><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-0" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Poor"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-1" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: OK"></td><td class="px-2 py-2 text-center leading-5"><input id="fg_rating-1-2" type="radio" class="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Great"></td></tr>
              </tbody>
