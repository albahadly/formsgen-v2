      </div>
    </div>
    <div id="fg-live" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <pre id="fg-result" class="mt-3 p-3 bg-dark text-success rounded small overflow-auto" hidden></pre>
  </form>
  <script>
  (function () {
    'use strict'
    function fgIsEmpty(v) {
      if (v === null || v === undefined) return true
      if (typeof v === 'string') return v.trim() === ''
      if (Array.isArray(v)) return v.length === 0
      return false
    }
    // Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
    // never compare a string field with false).
    function fgIsBlank(v) {
      return fgIsEmpty(v) || v === false
    }
    function fgSize(v) {
      if (typeof v === 'number') return Number.isFinite(v) ? v : null
      if (typeof v === 'string') return v.length
      if (Array.isArray(v)) return v.length
      return null
    }
    function fgAccepts(file, accept) {
      if (accept.trim() === '') return true
      const name = file.name.toLowerCase()
      const type = (file.type || '').toLowerCase()
      return accept.split(',').map((token) => token.trim().toLowerCase()).filter(Boolean).some((token) =>
        token.startsWith('.') ? name.endsWith(token) : token.endsWith('/*') ? type.startsWith(token.slice(0, -1)) : type === token,
      )
    }
    function fgFileProblem(v, accept, maxMb, maxFiles, m) {
      const files = Array.isArray(v) ? v.filter((f) => f instanceof File) : []
      if (maxFiles > 0 && files.length > maxFiles) return m.tooMany
      for (const file of files) {
        if (!fgAccepts(file, accept)) return m.type.split('{name}').join(file.name)
        if (maxMb > 0 && file.size > maxMb * 1024 * 1024) return m.size.split('{name}').join(file.name)
      }
      return null
    }
    function fgFileJson(_key, value) {
      return value instanceof File ? { name: value.name, size: value.size, type: value.type } : value
    }
    function fgMultipart(payload) {
      const files = []
      const walk = (value, path) => {
        if (value instanceof File) {
          files.push({ path, file: value })
          return fgFileJson('', value)
        }
        if (Array.isArray(value)) {
          const fileList = value.length > 0 && value.every((v) => v instanceof File)
          return value.map((v, i) => walk(v, fileList ? path : path + '.' + i))
        }
        if (value && typeof value === 'object') {
          const out = {}
          for (const [key, v] of Object.entries(value)) out[key] = walk(v, path ? path + '.' + key : key)
          return out
        }
        return value
      }
      const data = walk(payload, '')
      const body = new FormData()
      body.append('data', JSON.stringify(data))
      for (const part of files) body.append(part.path, part.file, part.file.name)
      return body
    }

    var fgTags = {}
    var fgTagsPaint = {}
    function fgControl(path) {
      return document.querySelector('[data-fg-path="' + path + '"]')
    }
    function fgGet(path) {
      var el = fgControl(path)
      if (!el) return undefined
      var kind = el.getAttribute('data-fg-kind')
      if (kind === 'checkbox') return el.checked
      if (kind === 'select') return el.value === '' ? null : el.value
      if (kind === 'number') return el.value === '' ? null : Number(el.value)
      if (kind === 'radio') {
        var checked = document.querySelector('[data-fg-path="' + path + '"]:checked')
        return checked ? checked.value : null
      }
      if (kind === 'multiselect') {
        return Array.prototype.map.call(el.selectedOptions, function (option) { return option.value })
      }
      if (kind === 'tags') return (fgTags[path] || []).slice()
      if (kind === 'files') return (fgFiles[path] || []).slice()
      if (kind === 'checks') {
        return Array.prototype.map.call(
          document.querySelectorAll('[data-fg-path="' + path + '"]:checked'),
          function (box) { return box.value },
        )
      }
      return el.value
    }

    function fgVisible_attachments_note() {
      return ((!fgIsBlank(fgGet("attachments"))))
    }
    function fgVisible_contact_phone() {
      return ((fgGet("contact_method") === "phone"))
    }
    function fgVisible_contact_other() {
      return ((fgGet("contact_method") === "other"))
    }

    var FG_CONDITIONS = [
      { index: 0, test: function () { return (!fgIsBlank(fgGet("attachments"))) } },
      { index: 1, test: function () { return (fgGet("contact_method") === "phone") } },
      { index: 2, test: function () { return (fgGet("contact_method") === "other") } },
    ]

    var FG_VALIDATORS = {
      'full_name': function () {
      const v = fgGet("full_name")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
      return null
      },
      'email': function () {
      const v = fgGet("email")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
      },
      'website': function () {
      const v = fgGet("website")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
      return null
      },
      'seats': function () {
      const v = fgGet("seats")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
      return null
      },
      'zip': function () {
      const v = fgGet("zip")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
      return null
      },
      'account.username': function () {
      const v = fgGet("account.username")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
      return null
      },
      'account.bio': function () {
      const v = fgGet("account.bio")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
      return null
      },
      'account.avatar': function () {
      const v = fgGet("account.avatar")
      { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose at most 1 files","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
      return null
      },
      'plan': function () {
      const v = fgGet("plan")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'topics': function () {
      const v = fgGet("topics")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
      return null
      },
      'attachments': function () {
      const v = fgGet("attachments")
      if (fgIsBlank(v)) return "This field is required"
      { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
      return null
      },
      'contact_method': function () {
      const v = fgGet("contact_method")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'shipping_city': function () {
      const v = fgGet("shipping_city")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'terms': function () {
      const v = fgGet("terms")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
    }

    var touched = {}

    function fgKey(path) { return path.replace(/\\./g, '_') }

    function setError(path, message) {
      var el = document.getElementById('fg_err_' + fgKey(path))
      var control = fgControl(path)
      var invalid = "is-invalid".split(' ').filter(Boolean)
      if (el) {
        el.textContent = message || ''
        el.hidden = !message
      }
      if (control) {
        invalid.forEach(function (cls) { control.classList.toggle(cls, Boolean(message)) })
      }
    }

    function validateField(path) {
      var validate = fgValidatorFor(path)
      if (!validate) return true
      var message = validate()
      setError(path, message)
      return !message
    }

    function fgHasError(path) {
      var validate = fgValidatorFor(path)
      return validate ? Boolean(validate()) : false
    }

    function updateConditions() {
      FG_CONDITIONS.forEach(function (c) {
        var el = document.querySelector('[data-fg-cond="' + c.index + '"]')
        if (el) el.hidden = !c.test()
      })
      Object.keys(FG_REPEATERS).forEach(function (path) {
        fgItemElements(path).forEach(function (item, i) {
          Array.prototype.forEach.call(item.querySelectorAll('[data-fg-icond]'), function (el) {
            el.hidden = !FG_ITEM_CONDITIONS[Number(el.getAttribute('data-fg-icond'))](i)
          })
        })
      })
    }

    // Repeating sections: items are clones of a <template>; the index in
    // ids and data paths is stamped on add and rewritten when an item above
    // is removed (errors and touched state move with their item).
    var FG_REPEATERS = {"references":{"key":"references","min":0,"max":3,"initial":1,"label":"Reference {n}"}}
    var FG_REPEATER_VISIBLE = {
      "references": function () { return true },
    }
    var FG_ITEM_VALIDATORS = {
      'references': {
        'name': function (i) {
          const v = fgGet("references." + i + ".name")
          if (fgIsBlank(v)) return "This field is required"
          return null
        },
        'email': function (i) {
          if (!((fgGet("references." + i + ".may_contact") === true))) return null
          const v = fgGet("references." + i + ".email")
          if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
          return null
        },
      },
    }
    var FG_ITEM_CONDITIONS = [
      function (i) { return (fgGet("references." + i + ".may_contact") === true) },
    ]
    function fgItemElements(path) {
      var list = document.querySelector('[data-fg-items="' + path + '"]')
