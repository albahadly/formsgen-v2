  contact_phone: string
  contact_other: string
  twitter: string
  github: string
  shipping_city: string
  order_notes: string
  newsletter: boolean
  terms: boolean
}

const INITIAL: FormData = {
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: ""
  },
  plan: null,
  interests: [],
  channels: [],
  topics: [],
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false
}

