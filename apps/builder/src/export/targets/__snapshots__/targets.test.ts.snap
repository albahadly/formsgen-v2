                              <option value="TC">Turks &amp; Caicos Islands (+1)</option>
                              <option value="TV">Tuvalu (+688)</option>
                              <option value="VI">U.S. Virgin Islands (+1)</option>
                              <option value="UG">Uganda (+256)</option>
                              <option value="UA">Ukraine (+380)</option>
                              <option value="AE">United Arab Emirates (+971)</option>
                              <option value="GB">United Kingdom (+44)</option>
                              <option value="US">United States (+1)</option>
                              <option value="UY">Uruguay (+598)</option>
                              <option value="UZ">Uzbekistan (+998)</option>
                              <option value="VU">Vanuatu (+678)</option>
                              <option value="VA">Vatican City (+39)</option>
                              <option value="VE">Venezuela (+58)</option>
                              <option value="VN">Vietnam (+84)</option>
                              <option value="WF">Wallis &amp; Futuna (+681)</option>
                              <option value="EH">Western Sahara (+212)</option>
                              <option value="YE">Yemen (+967)</option>
                              <option value="ZM">Zambia (+260)</option>
                              <option value="ZW">Zimbabwe (+263)</option>
                            </select>
                            <input id={'fg_references_' + i + '_phone'} type="tel" className={errors[('references.' + i + '.phone')] ? "fg-input fg-invalid" : "fg-input"} autoComplete="tel-national" value={fgPhoneNumber(item.phone, fgPhoneCountryOf(('references.' + i + '.phone')))} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPhoneInput(('references.' + i + '.phone'), e.target.value)} onBlur={() => touch(('references.' + i + '.phone'))} />
                          </div>
                          {errors[('references.' + i + '.phone')] && <p className="fg-error" role="alert">{errors[('references.' + i + '.phone')]}</p>}
                        </div>
                      </div>
                    )}
                  </div>
                  <div className="fg-repeater-item-actions">
                    {form.references.length > 1 && <span className="fg-repeater-handle" data-fg-handle draggable aria-hidden="true" title="Drag to reorder" onDragStart={(e) => fgDragStart(e, 'references', i)} onDragEnd={fgDragEnd}>⠿</span>}
                    {i > 0 && <button type="button" className="fg-repeater-move" data-fg-move="up" aria-label={fgMoveLabel('references', i, 'up')} onClick={() => fgMoveItem('references', i, -1)}>↑</button>}
                    {i < form.references.length - 1 && <button type="button" className="fg-repeater-move" data-fg-move="down" aria-label={fgMoveLabel('references', i, 'down')} onClick={() => fgMoveItem('references', i, 1)}>↓</button>}
                    <button type="button" className="fg-repeater-remove" aria-label={fgRemoveLabel('references', i)} onClick={() => fgRemoveItem('references', i)}>Remove</button>
                  </div>
                </fieldset>
              ))}
            </div>
            {form.references.length < 3 && <button type="button" className="fg-button fg-button--secondary fg-repeater-add" data-fg-add="references" onClick={() => fgAddItem('references')}>Add reference</button>}
          </fieldset>
        </div>
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_attachments">Attachments<span className="fg-required" aria-hidden="true">*</span></label>
            <div className="fg-file-drop">
              <span className="fg-file-drop-text">Choose files or drag them here</span>
              <input id="fg_attachments" type="file" className="fg-file-input" accept=".pdf,.doc,.docx" multiple aria-invalid={errors['attachments'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('attachments', e.target)} onDragEnter={(e) => fgDrag(e.currentTarget, true)} onDragLeave={(e) => fgDrag(e.currentTarget, false)} onDrop={(e) => fgDropFiles('attachments', e)} />
            </div>
            {form.attachments.length > 0 && (
              <ul className="fg-file-list">
                {form.attachments.map((file, fi) => (
                  <li key={fi} className="fg-file-item">
                    <span className="fg-file-name">{file.name}</span>
                    <span className="fg-file-size">{fgFileSize(file.size)}</span>
                    <button type="button" className="fg-file-remove" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('attachments', fi)}>×</button>
                  </li>
                ))}
              </ul>
            )}
            {fgFileNotes['attachments'] && <p className="fg-description" data-fg-file-note>{fgFileNotes['attachments']}</p>}
            <p className="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
            {errors['attachments'] && <p className="fg-error" role="alert">{errors['attachments']}</p>}
          </div>
        </div>
        {((!fgIsBlank(form.attachments))) && (
          <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
            <div className="fg-field">
              <label className="fg-label" htmlFor="fg_attachments_note">Notes about the attachments</label>
              <textarea id="fg_attachments_note" rows={3} value={form.attachments_note} className={errors['attachments_note'] ? "fg-textarea fg-invalid" : "fg-textarea"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('attachments_note', e.target.value)} onBlur={() => touch('attachments_note')} />
              {errors['attachments_note'] && <p className="fg-error" role="alert">{errors['attachments_note']}</p>}
            </div>
          </div>
        )}
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <div className="fg-field">
            <div className="fg-label"><span id="fg_about-label">About you</span></div>
            <div className="fg-richtext" data-fg-rich>
              <div className="fg-richtext-toolbar" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" className="fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabIndex={0}><b>B</b></button>
                <button type="button" className="fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabIndex={-1}><i>I</i></button>
                <button type="button" className="fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabIndex={-1}>•</button>
                <button type="button" className="fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabIndex={-1}><span dir="ltr">1.</span></button>
                <button type="button" className="fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabIndex={-1}>🔗</button>
              </div>
              <div id="fg_about" className="fg-richtext-editor" contentEditable role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" onBlur={() => touch('about')}></div>
            </div>
            <p className="fg-description">Bold, lists and links are kept.</p>
            {errors['about'] && <p className="fg-error" role="alert">{errors['about']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <fieldset className="fg-field">
            <legend className="fg-label">Meeting point</legend>
            <div className="fg-location" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div className="fg-location-map" style={{ height: '220px' }} role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div className="fg-location-row">
                <label className="fg-location-coord">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" className="fg-input" step="any" min="-90" max="90" inputMode="decimal" data-fg-loc-lat />
                </label>
                <label className="fg-location-coord">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" className="fg-input" step="any" min="-180" max="180" inputMode="decimal" data-fg-loc-lng />
                </label>
                <button type="button" className="fg-button fg-button--secondary" data-fg-loc-mine>Use my location</button>
                <button type="button" className="fg-button fg-button--secondary" data-fg-loc-clear>Clear</button>
              </div>
              <p className="fg-location-status" aria-live="polite" data-fg-loc-status></p>
            </div>
            {errors['meet'] && <p className="fg-error" role="alert">{errors['meet']}</p>}
          </fieldset>
        </div>
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <fieldset className="fg-field">
            <legend className="fg-label">Signature</legend>
            <div className="fg-signature" data-fg-sign>
              <canvas id="fg_signature" className="fg-signature-pad" style={{ height: '140px' }} role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature"></canvas>
              <div className="fg-signature-row">
                <input type="text" className="fg-input" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type />
                <button type="button" className="fg-button fg-button--secondary" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            {errors['signature'] && <p className="fg-error" role="alert">{errors['signature']}</p>}
          </fieldset>
        </div>
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <figure className="fg-quote">
            <blockquote className="fg-quote-text">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption className="fg-quote-cite">FormsGen</figcaption>
          </figure>
        </div>
        <div className="fg-cell" style={{ '--fg-span': '12', '--fg-span-sm': '12', '--fg-span-lg': '12' } as React.CSSProperties}>
          <div className="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style={{ color: "#b91c1c" }}>{"Closed on holidays. {{ not.vue }} @razor {jsx}"}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerPolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
