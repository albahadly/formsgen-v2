              <label className="form-check-label" htmlFor="fg_terms">I accept the terms<span className="text-danger fg-required" aria-hidden="true">*</span></label><span className="fg-tip"><button type="button" className="fg-tip-button" aria-label="More information" aria-describedby="fg_terms-tip">?</button><span role="tooltip" id="fg_terms-tip" className="fg-tip-text">We never sell your data</span></span>
            </div>
            {errors['terms'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['terms']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <button type="button" className="btn btn-outline-secondary fw-semibold px-3" onClick={fgReset}>Start over</button>
        </div>
      </div>
      <div className="mt-3 d-flex flex-column gap-1">
        <div ref={fgCaptchaEl}></div>
