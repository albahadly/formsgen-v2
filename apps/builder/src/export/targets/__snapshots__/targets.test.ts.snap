  .fg-dual { position: relative; height: 1.5rem; margin-block: 0.25rem; }
  .fg-dual-track { position: absolute; inset-inline: 0; top: 50%; height: 0.375rem; transform: translateY(-50%); border-radius: 999px; background: var(--fg-color-border, var(--bs-border-color, #d1d5db)); }
  .fg-dual-fill { position: absolute; top: 0; bottom: 0; border-radius: inherit; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }
  .fg-dual input[type='range'] { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; }
  .fg-dual input[type='range']::-webkit-slider-runnable-track { height: 1.5rem; background: none; border: none; }
  .fg-dual input[type='range']::-moz-range-track { background: none; border: none; }
  .fg-dual input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 1.125rem; height: 1.125rem; margin-top: 0.1875rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']::-moz-range-thumb { pointer-events: auto; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']:focus-visible { outline: none; }
  .fg-dual input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-dual input[type='range']:focus-visible::-moz-range-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }

  /* Help tooltips */
  .fg-label-row { display: flex; align-items: center; gap: 0.375rem; }
  /* The bubble anchors to the row holding the tip (label row, checkbox row or
     legend), from its start edge, so it never runs off a narrow screen. */
  .fg-tip { display: inline-flex; vertical-align: middle; margin-inline-start: 0.25rem; }
  :has(> .fg-tip) { position: relative; }
  .fg-label-row > .fg-tip { margin-inline-start: 0; }
  .fg-tip-button { display: inline-flex; align-items: center; justify-content: center; inline-size: 1.125rem; block-size: 1.125rem; padding: 0; font: 600 0.6875rem/1 system-ui, sans-serif; color: var(--fg-color-muted, var(--bs-secondary-color, #6b7280)); background: transparent; border: 1px solid currentColor; border-radius: 50%; cursor: help; }
  .fg-tip-button:focus-visible { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-tip-text { position: absolute; inset-block-end: calc(100% + 0.375rem); inset-inline-start: 0; z-index: 20; inline-size: max-content; max-inline-size: min(16rem, calc(100vw - 2rem)); padding: 0.375rem 0.5rem; font-size: 0.75rem; font-weight: 400; line-height: 1.4; text-align: start; color: #ffffff; background: #111827; border-radius: 0.375rem; visibility: hidden; opacity: 0; transition: opacity 0.12s; pointer-events: none; }
  .fg-tip:hover .fg-tip-text, .fg-tip-button:focus + .fg-tip-text { visibility: visible; opacity: 1; }

  /* HTML blocks */
  .fg-html { overflow-wrap: anywhere; }
  .fg-html > :first-child { margin-block-start: 0; }
  .fg-html > :last-child { margin-block-end: 0; }
  .fg-html :where(p, ul, ol, dl, table, blockquote, figure, pre, details) { margin-block: 0.5em; }
  .fg-html :where(h1, h2, h3, h4, h5, h6) { margin-block: 0.75em 0.375em; font-weight: 600; line-height: 1.3; }
  .fg-html :where(h1) { font-size: 1.5em; }
  .fg-html :where(h2) { font-size: 1.3em; }
  .fg-html :where(h3) { font-size: 1.15em; }
  .fg-html :where(ul) { list-style: disc; padding-inline-start: 1.25em; }
  .fg-html :where(ol) { list-style: decimal; padding-inline-start: 1.25em; }
  .fg-html :where(table) { border-collapse: collapse; }
  .fg-html :where(th, td) { padding: 0.25rem 0.5rem; border: 1px solid var(--fg-color-border, var(--bs-border-color, #d1d5db)); text-align: start; }
  .fg-html :where(img) { max-inline-size: 100%; block-size: auto; }
  .fg-html :where(iframe) { display: block; border: 0; max-inline-size: 100%; }
  .fg-html :where(a) { color: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }

  body { margin: 0; padding: 1.5rem 1rem; }
  #fg-form { box-sizing: border-box; max-inline-size: 42rem; margin-inline: auto; }
  [hidden] { display: none !important; }
  </style>
</head>
<body>
  <form id="fg-form" class="bg-white p-4 font-sans text-gray-900 dark:bg-gray-900 dark:text-gray-100" novalidate>
    <div class="grid grid-cols-12 gap-4">
      <div class="col-span-12 md:col-span-12 text-center">
        <h2 class="text-2xl font-semibold leading-tight text-indigo-600 dark:text-indigo-400">Kitchen Sink</h2>
      </div>
      <div class="col-span-12 md:col-span-12 text-center">
        <p class="text-base text-gray-600 dark:text-gray-300">Every implemented element appears in this form.</p>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="text-base text-gray-600 dark:text-gray-300 space-y-2">
          <p>Hi <span data-fg-answer="full_name" data-fg-fallback="there">there</span>! Fields marked * are <strong>required</strong>. See the <a class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs">docs</a>:</p>
          <ul class="list-disc ps-5">
            <li><em>one</em> answer per row in Rating</li>
            <li>several in Usage</li>
          </ul>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_full_name">Full name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          <input id="fg_full_name" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="full_name" data-fg-kind="text" placeholder="Jane Doe">
          <p id="fg_full_name-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_email">Email<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          <input id="fg_email" type="email" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="email" data-fg-kind="text" placeholder="jane&#64;example.com">
          <p id="fg_email-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="w-full rounded-md border border-gray-300 bg-white px-2 py-1 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="website" data-fg-kind="text">
          <p id="fg_website-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <div class="fg-label-row"><label class="text-sm font-semibold" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
          <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
            <input id="fg_seats" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="seats" data-fg-kind="number" min="1" max="50" aria-describedby="fg_seats-suffix">
            <span id="fg_seats-suffix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">people</span>
          </div>
          <p id="fg_seats-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_seat_cost">Seat cost</label>
          <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
            <span id="fg_seat_cost-prefix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">$</span>
            <input id="fg_seat_cost" type="text" readonly class="w-full cursor-default rounded-md border border-gray-300 bg-gray-50 px-3 py-1.5 text-base tabular-nums shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800/50" data-fg-path="seat_cost" data-fg-kind="calculated" data-fg-value="" aria-describedby="fg_seat_cost-prefix">
          </div>
          <p id="fg_seat_cost-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="h-6 w-full accent-indigo-600" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_satisfaction-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <hr class="my-1 border-t border-indigo-500">
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-6 md:col-span-6 lg:col-span-4">
            <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
              <label class="text-sm font-semibold" for="fg_city">City</label>
              <input id="fg_city" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="city" data-fg-kind="text">
              <p id="fg_city-err" class="text-sm text-red-600" role="alert" hidden></p>
            </div>
          </div>
          <div class="col-span-6 md:col-span-6">
            <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
              <label class="sr-only" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_zip-err" class="text-sm text-red-600" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12 account-box">
        <fieldset class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">Account</legend>
          <div class="grid grid-cols-12 gap-4">
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_account_username">Username<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                <div class="flex [&>:not(:first-child)]:-ms-px [&>:not(:first-child)]:rounded-s-none [&>:not(:last-child)]:rounded-e-none">
                  <span id="fg_account_username-prefix" class="inline-flex items-center whitespace-nowrap rounded-md border border-gray-300 bg-gray-50 px-3 text-base text-gray-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">&#64;</span>
                  <input id="fg_account_username" type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="account.username" data-fg-kind="text" aria-describedby="fg_account_username-prefix">
                </div>
                <p id="fg_account_username-err" class="text-sm text-red-600" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_account_password-err" class="text-sm text-red-600" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-xl leading-normal shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_account_bio-err" class="text-sm text-red-600" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_account_birthday-err" class="text-sm text-red-600" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_account_avatar">Profile picture</label>
                <div class="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
                  <span class="font-medium">Choose a file or drag it here</span>
                  <input id="fg_account_avatar" type="file" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept="image/*" data-fg-path="account.avatar" data-fg-kind="files" data-fg-thumbs>
                </div>
                <ul class="flex flex-col gap-1.5" data-fg-file-list="account.avatar" hidden></ul>
                <p class="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note="account.avatar" hidden></p>
                <p id="fg_account_avatar-err" class="text-sm text-red-600" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5" aria-labelledby="fg_plan-legend">
          <legend class="text-sm font-semibold"><span id="fg_plan-legend">Plan</span><span class="ms-0.5 text-red-600" aria-hidden="true">*</span><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" class="fg-tip-text">You can switch plans at any time</span></span></legend>
          <div class="flex flex-col gap-1.5">
            <label class="inline-flex items-center gap-2 text-base" for="fg_plan-free">
              <input id="fg_plan-free" type="radio" name="plan" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="inline-flex items-center gap-2 text-base" for="fg_plan-pro">
              <input id="fg_plan-pro" type="radio" name="plan" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_plan-err" class="text-sm text-red-600" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">Interests</legend>
          <div class="flex flex-col gap-1.5">
            <label class="inline-flex items-center gap-2 text-base" for="fg_interests-news">
              <input id="fg_interests-news" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="inline-flex items-center gap-2 text-base" for="fg_interests-product">
              <input id="fg_interests-product" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_interests-err" class="text-sm text-red-600" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_channels-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_topics">Topics</label>
          <div class="flex flex-wrap items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="min-w-24 flex-1 border-none bg-transparent py-0 text-base focus:outline-none" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400">Free-text tags</p>
          <p id="fg_topics-err" class="text-sm text-red-600" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">Billing</legend>
          <div class="flex flex-wrap">
            <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing-monthly">
              <input id="fg_billing-monthly" type="radio" name="billing" class="sr-only" value="monthly" data-fg-path="billing" data-fg-kind="radio">
              <span>Monthly</span>
            </label>
            <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing-yearly">
