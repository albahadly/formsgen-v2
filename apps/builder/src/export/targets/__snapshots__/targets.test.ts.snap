    // Starting country per field (template member); the chosen one per field key.
    private static readonly Dictionary<string, string> FgPhoneDefaults = new() { ["ContactPhone"] = "OM", ["ReferencesIPhone"] = "GB" };

    private readonly FgStore<string> fgPhoneCountry = new(key => FgPhoneDefaults[FgTemplateKey(key)]);

    // The number part of "+<code> <number>" for the selected country.
    private static string FgPhoneNumber(string value, string country)
    {
        var prefix = "+" + FgDial[country] + " ";
        return value.StartsWith(prefix) ? value[prefix.Length..] : value;
    }

    private static string FgComposePhone(string country, string number) =>
        string.IsNullOrWhiteSpace(number) ? "" : "+" + FgDial[country] + " " + number;

    // The chosen country, else the one whose code starts the value ("+44 …";
    // the field's own first, as for restored answers), else the default.
    private string FgPhoneCountryOf(string member, string value)
    {
        if (fgPhoneCountry.TryGetValue(member, out var chosen)) return chosen;
        var fallback = fgPhoneCountry[member];
        if (value.StartsWith("+" + FgDial[fallback] + " ")) return fallback;
        foreach (var (code, dial) in FgDial) if (value.StartsWith("+" + dial + " ")) return code;
        return fallback;
    }

    private string FgPhoneSetCountry(string member, string value, ChangeEventArgs e)
    {
        var typed = FgPhoneNumber(value, FgPhoneCountryOf(member, value));
        fgPhoneCountry[member] = Convert.ToString(e.Value) ?? FgPhoneCountryOf(member, value);
        return FgComposePhone(fgPhoneCountry[member], typed);
    }

    private string FgPhoneInput(string member, string value, ChangeEventArgs e) =>
        FgComposePhone(FgPhoneCountryOf(member, value), Convert.ToString(e.Value) ?? "");

    private readonly FgStore<string> fgDateDrafts = new(_ => "");

    private void FgAddDate(List<string> list, string member)
    {
        var date = fgDateDrafts.TryGetValue(member, out var draft) ? draft ?? "" : "";
        if (System.Text.RegularExpressions.Regex.IsMatch(date, @"^\\d{4}-\\d{2}-\\d{2}$") && !list.Contains(date))
        {
            list.Add(date);
            list.Sort(string.CompareOrdinal);
        }
        fgDateDrafts[member] = "";
        FgChanged(member);
    }

    private void FgRemoveDate(List<string> list, string date, string member)
    {
        list.Remove(date);
        FgChanged(member);
    }

    private static string FgRemoveDateLabel(string date) => "Remove {date}".Replace("{date}", date);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FgFocusRepeaters();
        await FgFocusUploads();
        await FgFocusDual();
        if (firstRender) await FgInteropInit();
        await FgInteropWire();
        // Values from a new model (start, reset, saved answers) into the editors.
        await FgRichShowValues();
        // Values from a new model into the location fields.
        await FgLocShowValues();
        // The signatures the model holds, into pads shown again.
        await FgSignShowValues();
    }

    private async Task FgReset()
    {
        Model = new();
        FgInitEdit();
        FgCalc();
        fgItemRefs.Clear();
        fgDeferredFields.Clear();
        ResultJson = null;
        foreach (var key in fgTagDrafts.Keys.ToList()) fgTagDrafts[key] = "";
        foreach (var key in fgDateDrafts.Keys.ToList()) fgDateDrafts[key] = "";
        fgPhoneCountry.Clear();
        await FgJs.InvokeVoidAsync("fgSignClear", fgFormRoot);
        await FgAnnounce("The form was reset.");
    }

    // Prefill from the page address: ?field=value fills matching fields (a
    // list takes repeated parameters or one comma-separated value); a hidden
    // field takes its named parameter. After a restored draft: the link wins.
    private void FgPrefill()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(FgNav.Uri).Query);
        { var v = FgQueryString(query, "full_name"); if (v is not null) Model.FullName = v; }
        { var v = FgQueryString(query, "email"); if (v is not null) Model.Email = v; }
        { var v = FgQueryString(query, "website"); if (v is not null) Model.Website = v; }
        { var v = FgQueryNumber(query, "seats"); if (v is not null) Model.Seats = v; }
        { var v = FgQueryNumber(query, "satisfaction"); if (v is not null) Model.Satisfaction = v.Value; }
        { var v = FgQueryString(query, "city"); if (v is not null) Model.City = v; }
        { var v = FgQueryString(query, "zip"); if (v is not null) Model.Zip = v; }
        { var v = FgQueryString(query, "account.username"); if (v is not null) Model.AccountUsername = v; }
        { var v = FgQueryString(query, "account.bio"); if (v is not null) Model.AccountBio = v; }
        { var v = FgQueryString(query, "account.birthday"); if (v is not null) Model.AccountBirthday = v; }
        { var v = FgQueryString(query, "plan"); if (v is not null) Model.Plan = v; }
        { var v = FgQueryList(query, "interests"); if (v is not null) Model.Interests = v; }
        { var v = FgQueryList(query, "channels"); if (v is not null) Model.Channels = v.ToArray(); }
        { var v = FgQueryList(query, "topics"); if (v is not null) Model.Topics = v; }
        { var v = FgQueryString(query, "billing"); if (v is not null) Model.Billing = v; }
        { var v = FgQueryList(query, "extras"); if (v is not null) Model.Extras = v; }
        { var v = FgQueryBool(query, "notify"); if (v is not null) Model.Notify = v.Value; }
        { var v = FgQueryString(query, "appointment"); if (v is not null) Model.Appointment = v; }
        { var v = FgQueryString(query, "brand_color"); if (v is not null) Model.BrandColor = v; }
        { var v = FgQueryNumber(query, "volume"); if (v is not null) Model.Volume = v.Value; }
        { var v = FgQueryList(query, "days"); if (v is not null) Model.Days = v; }
        { var v = FgQueryString(query, "utm_source"); if (v is not null) Model.Source = v; }
        { var v = FgQueryString(query, "attachments_note"); if (v is not null) Model.AttachmentsNote = v; }
        { var v = FgQueryString(query, "contact_method"); if (v is not null) Model.ContactMethod = v; }
        { var v = FgQueryString(query, "contact_phone"); if (v is not null) Model.ContactPhone = v; }
        { var v = FgQueryString(query, "contact_other"); if (v is not null) Model.ContactOther = v; }
        { var v = FgQueryString(query, "twitter"); if (v is not null) Model.Twitter = v; }
        { var v = FgQueryString(query, "github"); if (v is not null) Model.Github = v; }
        { var v = FgQueryString(query, "shipping_city"); if (v is not null) Model.ShippingCity = v; }
        { var v = FgQueryString(query, "order_notes"); if (v is not null) Model.OrderNotes = v; }
        { var v = FgQueryBool(query, "newsletter"); if (v is not null) Model.Newsletter = v.Value; }
        { var v = FgQueryBool(query, "terms"); if (v is not null) Model.Terms = v.Value; }
    }

    private static string? FgQueryString(System.Collections.Specialized.NameValueCollection query, string name) =>
        query.GetValues(name) is { Length: > 0 } values ? values[0] : null;

    private static double? FgQueryNumber(System.Collections.Specialized.NameValueCollection query, string name) =>
        FgQueryString(query, name) is { } v && v.Trim().Length > 0 && double.TryParse(v.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    private static bool? FgQueryBool(System.Collections.Specialized.NameValueCollection query, string name) =>
        FgQueryString(query, name)?.Trim().ToLowerInvariant() switch
        {
            "1" or "true" or "on" or "yes" => true,
            "0" or "false" or "off" or "no" => false,
            _ => null,
        };

    private static List<string>? FgQueryList(System.Collections.Specialized.NameValueCollection query, string name)
    {
        var values = query.GetValues(name);
        if (values is null) return null;
        var parts = values.Length == 1 ? values[0].Split(',') : values;
        return parts.Select(p => p.Trim()).Where(p => p.Length > 0).ToList();
    }

    // Scripts on the form's root (loaded once, after the first render) call
    // back into this component through fgSelf. They are wired to the form's
    // element after each render that follows a new EditContext (EditForm
    // then builds new elements).
    private ElementReference fgFormRoot;
    private Microsoft.JSInterop.DotNetObjectReference<KitchenSinkForm>? fgSelf;
    private bool fgWire;
    // One number per render (counted before each render): the interop
    // registries keep the elements stamped with the latest one.
    private int fgRenderGen;

    private async Task FgInteropInit()
    {
        fgSelf = Microsoft.JSInterop.DotNetObjectReference.Create(this);
        await FgJs.InvokeVoidAsync("eval", FgItemDragScript);
        await FgJs.InvokeVoidAsync("eval", FgSignatureScript);
        await FgJs.InvokeVoidAsync("eval", FgRichTextScript);
        await FgJs.InvokeVoidAsync("eval", FgLocationScript);
        await FgJs.InvokeVoidAsync("eval", FgCaptchaScript);
    }

    private async Task FgInteropWire()
    {
        if (!fgWire || fgSelf is null) return;
        fgWire = false;
        await FgJs.InvokeVoidAsync("fgItemDrag", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgSignatures", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgRich", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgLocations", fgFormRoot, fgSelf);
        await FgJs.InvokeVoidAsync("fgCaptchaWire", fgCaptchaEl, fgSelf);
    }

    public void Dispose() => fgSelf?.Dispose();

    // Signature pads: run by a script on the form's root (FgSignatureScript),
    // which reports each change here as a PNG data URL (null when cleared).
    private readonly Dictionary<string, List<FgUpload>> fgSignLists = new();
    // The render that last showed each pad; entries of elements no longer
    // rendered (removed items, fields hidden again) go after a render.
    private readonly Dictionary<string, int> fgSignSeen = new();

    private string FgSignKey(List<FgUpload> list, string key)
    {
        fgSignLists[key] = list;
        fgSignSeen[key] = fgRenderGen;
        return key;
    }

    private const string FgSignatureScript = @"// Signature pads: draw (mouse, finger, pen) or type a name; each change is
// signature.png. Wired once on the form root (pads in new items included).
function fgSignPad(canvas) {
  if (canvas.fgPad) return canvas.fgPad
  var ctx = canvas.getContext('2d')
  var pad = { ink: false, pending: 0, drawing: false, loading: false, last: null }
  pad.size = function () {
    var ratio = window.devicePixelRatio || 1
    var width = Math.round(canvas.clientWidth * ratio)
    var height = Math.round(canvas.clientHeight * ratio)
    if (!ctx || width === 0 || (canvas.width === width && canvas.height === height)) return
    // Keep the ink through the resize (a phone turning, a panel opening).
    var kept = null
    if (pad.ink && canvas.width > 0 && canvas.height > 0) {
      kept = document.createElement('canvas')
      kept.width = canvas.width
      kept.height = canvas.height
      var keptCtx = kept.getContext('2d')
      if (keptCtx) keptCtx.drawImage(canvas, 0, 0)
    }
    canvas.width = width
    canvas.height = height
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
    if (kept) ctx.drawImage(kept, 0, 0, canvas.clientWidth, canvas.clientHeight)
  }
  pad.wipe = function () {
    if (!ctx) return
    ctx.save()
    ctx.setTransform(1, 0, 0, 1, 0, 0)
    ctx.clearRect(0, 0, canvas.width, canvas.height)
    ctx.restore()
    pad.ink = false
  }
  pad.pen = function () {
    if (!ctx) return
    ctx.strokeStyle = ""#0f172a""
    ctx.fillStyle = ""#0f172a""
    ctx.lineWidth = 2.5
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
  }
  // Saved at CSS pixel size (small files whatever the screen density).
  pad.commit = function (done) {
    var ticket = ++pad.pending
    var out = document.createElement('canvas')
    out.width = canvas.clientWidth || canvas.width
    out.height = canvas.clientHeight || canvas.height
    var outCtx = out.getContext('2d')
    if (outCtx) outCtx.drawImage(canvas, 0, 0, out.width, out.height)
    out.toBlob(function (blob) {
      if (ticket !== pad.pending) return
      pad.pending = 0
      done(blob && pad.ink ? new File([blob], ""signature.png"", { type: 'image/png' }) : null)
    }, 'image/png')
  }
  pad.point = function (event) {
    var rect = canvas.getBoundingClientRect()
    return { x: event.clientX - rect.left, y: event.clientY - rect.top }
  }
  pad.type = function (text, done) {
    pad.size()
    pad.wipe()
    if (!ctx || text.trim() === '') {
      pad.pending++
      done(null)
      return
    }
    pad.pen()
    ctx.font = ""italic 2rem \\""Segoe Script\\"", \\""Brush Script MT\\"", \\""Snell Roundhand\\"", cursive""
    ctx.textAlign = 'center'
    ctx.textBaseline = 'middle'
    ctx.fillText(text.trim(), canvas.clientWidth / 2, canvas.clientHeight / 2, canvas.clientWidth - 24)
    pad.ink = true
    pad.commit(done)
  }
  // Draws a saved signature (a file, or a data URL) into a blank pad.
  pad.show = function (source) {
    if (pad.ink || pad.drawing || pad.loading) return
    pad.loading = true
    var url = typeof source === 'string' ? source : URL.createObjectURL(source)
    var image = new Image()
    image.onload = function () {
      pad.loading = false
      if (url !== source) URL.revokeObjectURL(url)
      if (pad.ink || pad.drawing || !ctx) return
      pad.size()
      ctx.drawImage(image, 0, 0, canvas.clientWidth, canvas.clientHeight)
      pad.ink = true
    }
    image.onerror = function () {
      pad.loading = false
      if (url !== source) URL.revokeObjectURL(url)
    }
    image.src = url
  }
  canvas.fgPad = pad
  return pad
}
function fgSignGroup(el) {
  var group = el.closest('[data-fg-sign]')
  return group ? { canvas: group.querySelector('canvas[data-fg-signature]'), typed: group.querySelector('[data-fg-sign-type]') } : null
}
// A commit callback bound to its pad.
function fgSignDone(canvas, onChange) {
  return function (file) { onChange(canvas, file) }
}
function fgWireSignatures(root, onChange) {
  if (!root || root.fgSignWired) return
  root.fgSignWired = true
  var padOf = function (event) {
    var target = event.target
    return target && target.closest ? target.closest('canvas[data-fg-signature]') : null
  }
  root.addEventListener('pointerdown', function (event) {
    var canvas = padOf(event)
    if (!canvas || event.button !== 0) return
    var pad = fgSignPad(canvas)
    pad.size()
    var ctx = canvas.getContext('2d')
    if (!ctx) return
    event.preventDefault()
    if (canvas.setPointerCapture) canvas.setPointerCapture(event.pointerId)
    pad.drawing = true
    pad.pen()
    var at = pad.point(event)
    pad.last = at
    ctx.beginPath()
    ctx.arc(at.x, at.y, 1.25, 0, Math.PI * 2)
    ctx.fill()
    pad.ink = true
  })
  root.addEventListener('pointermove', function (event) {
    var canvas = padOf(event)
    var pad = canvas && canvas.fgPad
    if (!canvas || !pad || !pad.drawing) return
    var last = pad.last
    var ctx = canvas.getContext('2d')
    if (!last || !ctx) return
    var next = pad.point(event)
    ctx.beginPath()
    ctx.moveTo(last.x, last.y)
    ctx.lineTo(next.x, next.y)
    ctx.stroke()
    pad.last = next
  })
  function up(event) {
    var canvas = padOf(event)
    var pad = canvas && canvas.fgPad
    if (!canvas || !pad || !pad.drawing) return
    pad.drawing = false
    pad.last = null
    pad.commit(fgSignDone(canvas, onChange))
  }
  root.addEventListener('pointerup', up)
  root.addEventListener('pointercancel', up)
  root.addEventListener('input', function (event) {
    var input = event.target
    if (!input || !input.matches || !input.matches('[data-fg-sign-type]')) return
    var group = fgSignGroup(input)
    var canvas = group && group.canvas
    if (!canvas) return
    fgSignPad(canvas).type(input.value, fgSignDone(canvas, onChange))
  })
  root.addEventListener('click', function (event) {
    var target = event.target
    var button = target && target.closest && target.closest('[data-fg-sign-clear]')
    if (!button) return
    var group = fgSignGroup(button)
    if (!group || !group.canvas) return
    var pad = fgSignPad(group.canvas)
    pad.pending++
    pad.wipe()
    if (group.typed) group.typed.value = ''
    onChange(group.canvas, null)
  })
}
// Pads follow their value: cleared when it went empty elsewhere (a reset),
// typed name too; a blank pad draws the file its value holds (a pad shown
// again by a step or a condition).
function fgSignSync(root, valueOf) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('canvas[data-fg-signature]'), function (canvas) {
    var pad = canvas.fgPad
    if (pad && (pad.pending || pad.drawing)) return
    var value = valueOf(canvas)
