exports[`vue-standalone target > snapshot (bootstrap5) 1`] = `
"<script setup lang="ts">
// Generated by FormsGen — no runtime dependencies beyond Vue.
import { reactive, ref } from 'vue'

const emit = defineEmits<{ submit: [data: Record<string, unknown>] }>()

const form = reactive({
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: ""
  },
  plan: null,
  interests: [],
  channels: [],
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false
})

const errors = reactive<Record<string, string>>({})
const touched = new Set<string>()
const result = ref<Record<string, unknown> | null>(null)

function fgIsEmpty(v) {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
function fgSize(v) {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}

function fgVisible_contact_phone() {
  return ((form.contact_method === "phone"))
}
function fgVisible_contact_other() {
  return ((form.contact_method === "other"))
}

const validators: Record<string, () => string | null> = {
  'full_name': function () {
  const v = form.full_name
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function () {
  const v = form.email
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function () {
  const v = form.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function () {
  const v = form.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function () {
  const v = form.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function () {
  const v = form.account.username
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function () {
  const v = form.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'plan': function () {
  const v = form.plan
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'contact_method': function () {
  const v = form.contact_method
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'shipping_city': function () {
  const v = form.shipping_city
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'terms': function () {
  const v = form.terms
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
}

function runValidator(path: string): void {
  const validate = validators[path]
  if (!validate) return
  const message = validate()
  if (message) errors[path] = message
  else delete errors[path]
}

function touch(path: string): void {
  touched.add(path)
  runValidator(path)
}

function revalidate(path: string): void {
  if (touched.has(path)) runValidator(path)
}

function validateAll(): boolean {
  let ok = true
  for (const path of Object.keys(validators)) {
    touched.add(path)
    runValidator(path)
    if (errors[path]) ok = false
  }
  return ok
}

const fgSec_ks_social_tabs = ref(0)
const fgSec_ks_wizard = ref(0)

const fgStepPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
function fgNext_ks_wizard(): void {
  let ok = true
  for (const path of fgStepPaths_ks_wizard[fgSec_ks_wizard.value] ?? []) {
    touch(path)
    if (errors[path]) ok = false
  }
  if (ok && fgSec_ks_wizard.value < 1) fgSec_ks_wizard.value++
}

function buildPayload(): Record<string, unknown> {
  return {
    "full_name": form.full_name,
    "email": form.email,
    "website": form.website,
    "seats": form.seats,
    "satisfaction": form.satisfaction,
    "city": form.city,
    "zip": form.zip,
    "account": {
      "username": form.account.username,
      "password": form.account.password,
      "bio": form.account.bio,
      "birthday": form.account.birthday,
    },
    "plan": form.plan,
    "interests": form.interests,
    "channels": form.channels,
    "contact_method": form.contact_method,
    ...(fgVisible_contact_phone() ? { "contact_phone": form.contact_phone } : {}),
    ...(fgVisible_contact_other() ? { "contact_other": form.contact_other } : {}),
    "twitter": form.twitter,
    "github": form.github,
    "shipping_city": form.shipping_city,
    "order_notes": form.order_notes,
    "newsletter": form.newsletter,
    "terms": form.terms,
  }
}

async function onSubmit(): Promise<void> {
  if (!validateAll()) return
  const data = buildPayload()
  result.value = data
  emit('submit', data)
}
</script>

<template>
  <form
    class="container py-4"
    dir="ltr"
    novalidate
    @submit.prevent="onSubmit"
  >
    <div class="row g-3">
      <div class="col-12 col-md-12">
        <h2 class="fw-semibold">Kitchen Sink</h2>
      </div>
      <div class="col-12 col-md-12">
        <p class="text-secondary">Every implemented element appears in this form.</p>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_full_name">Full name<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_full_name" v-model="form.full_name" type="text" class="form-control" :class="{ 'is-invalid': !!errors['full_name'] }" placeholder="Jane Doe" @blur="touch('full_name')" @input="revalidate('full_name')">
          <p v-if="errors['full_name']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['full_name'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_email">Email<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_email" v-model="form.email" type="email" class="form-control" :class="{ 'is-invalid': !!errors['email'] }" placeholder="jane@example.com" @blur="touch('email')" @input="revalidate('email')">
          <p v-if="errors['email']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['email'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
