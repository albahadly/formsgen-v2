          <div class="fg-tab-list" role="tablist">
            <button type="button" role="tab" :aria-selected="fgSec_ks_social_tabs === 0" :class="fgSec_ks_social_tabs === 0 ? 'fg-tab-button fg-tab-button--active' : 'fg-tab-button'" @click="fgSec_ks_social_tabs = 0">Social</button>
            <button type="button" role="tab" :aria-selected="fgSec_ks_social_tabs === 1" :class="fgSec_ks_social_tabs === 1 ? 'fg-tab-button fg-tab-button--active' : 'fg-tab-button'" @click="fgSec_ks_social_tabs = 1">Code</button>
          </div>
          <div v-show="fgSec_ks_social_tabs === 0" role="tabpanel">
            <div class="fg-grid">
              <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_twitter">Twitter handle</label>
                  <input id="fg_twitter" v-model="form.twitter" type="text" class="fg-input" :class="{ 'fg-invalid': !!errors['twitter'] }" @blur="touch('twitter')" @input="revalidate('twitter')">
                  <p v-if="errors['twitter']" class="fg-error" role="alert">{{ errors['twitter'] }}</p>
                </div>
              </div>
            </div>
          </div>
          <div v-show="fgSec_ks_social_tabs === 1" role="tabpanel">
            <div class="fg-grid">
              <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_github">GitHub username</label>
                  <input id="fg_github" v-model="form.github" type="text" class="fg-input" :class="{ 'fg-invalid': !!errors['github'] }" @blur="touch('github')" @input="revalidate('github')">
                  <p v-if="errors['github']" class="fg-error" role="alert">{{ errors['github'] }}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
