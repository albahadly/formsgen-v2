                    )}
                  </div>
                  <div className="mt-2 d-flex justify-content-end">
                    <button type="button" className="btn btn-link link-danger p-0" aria-label={fgRemoveLabel('references', i)} onClick={() => fgRemoveItem('references', i)}>Remove</button>
                  </div>
                </fieldset>
