                  <div className="fg-field">
                    <label className="fg-label" htmlFor="fg_github">GitHub username</label>
                    <input id="fg_github" type="text" value={form.github} className={errors['github'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('github', e.target.value)} onBlur={() => touch('github')} />
                    {errors['github'] && <p className="fg-error" role="alert">{errors['github']}</p>}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div>
            <ol className="fg-step-list">
              <li className={fgSec_ks_wizard === 0 ? "fg-step-item fg-step-item--active" : "fg-step-item"}>1. Shipping</li>
              <li className={fgSec_ks_wizard === 1 ? "fg-step-item fg-step-item--active" : "fg-step-item"}>2. Review</li>
            </ol>
            <div style={{ display: fgSec_ks_wizard === 0 ? undefined : 'none' }}>
              <div className="fg-grid">
                <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                  <div className="fg-field">
                    <label className="fg-label" htmlFor="fg_shipping_city">Shipping city<span className="fg-required" aria-hidden="true">*</span></label>
                    <input id="fg_shipping_city" type="text" value={form.shipping_city} className={errors['shipping_city'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('shipping_city', e.target.value)} onBlur={() => touch('shipping_city')} />
                    {errors['shipping_city'] && <p className="fg-error" role="alert">{errors['shipping_city']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div style={{ display: fgSec_ks_wizard === 1 ? undefined : 'none' }}>
              <div className="fg-grid">
                <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                  <div className="fg-field">
                    <label className="fg-label" htmlFor="fg_order_notes">Order notes</label>
                    <textarea id="fg_order_notes" rows={3} value={form.order_notes} className={errors['order_notes'] ? "fg-textarea fg-invalid" : "fg-textarea"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('order_notes', e.target.value)} onBlur={() => touch('order_notes')} />
                    {errors['order_notes'] && <p className="fg-error" role="alert">{errors['order_notes']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div className="fg-step-actions">
              {fgSec_ks_wizard > 0 && <button type="button" className="fg-button fg-button--secondary" onClick={() => fgGo_ks_wizard(fgSec_ks_wizard - 1)}>Back</button>}
              {fgSec_ks_wizard < 1 && <button type="button" className="fg-button fg-button--primary" onClick={fgNext_ks_wizard}>Next</button>}
              {fgSec_ks_wizard === 1 && <button type="submit" className="fg-button fg-button--primary">Submit</button>}
            </div>
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <div className="fg-checkbox-row">
              <input id="fg_newsletter" type="checkbox" checked={form.newsletter} className="fg-checkbox" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('newsletter', e.target.checked); touch('newsletter') }} />
              <label className="fg-checkbox-label" htmlFor="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            {errors['newsletter'] && <p className="fg-error" role="alert">{errors['newsletter']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <div className="fg-checkbox-row">
              <input id="fg_terms" type="checkbox" checked={form.terms} className="fg-checkbox" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('terms', e.target.checked); touch('terms') }} />
              <label className="fg-checkbox-label" htmlFor="fg_terms">I accept the terms<span className="fg-required" aria-hidden="true">*</span></label>
            </div>
            {errors['terms'] && <p className="fg-error" role="alert">{errors['terms']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <button type="button" className="fg-button fg-button--secondary" onClick={fgReset}>Start over</button>
        </div>
      </div>
      <div className="fg-sr-only" role="status" aria-live="polite" aria-atomic="true">{fgAnnouncement}</div>
      {result && <pre className="fg-payload">{JSON.stringify(result, fgFileJson, 2)}</pre>}
    </form>
  )
}
"
`;

exports[`vue-standalone target > snapshot (bootstrap5) 1`] = `
"<script setup lang="ts">
// Generated by FormsGen — no runtime dependencies beyond Vue.
import { nextTick, onBeforeUnmount, onMounted, reactive, ref, toRaw } from 'vue'

const emit = defineEmits<{ submit: [data: Record<string, unknown>] }>()

type FormData = {
  full_name: string
  email: string
  website: string
  seats: number | null
  satisfaction: number
  city: string
  zip: string
  account: {
    username: string
    password: string
    bio: string
    birthday: string
    avatar: File[]
  }
  plan: string | null
  interests: string[]
  channels: string[]
  topics: string[]
  billing: string | null
  extras: string[]
  notify: boolean
  appointment: string
  brand_color: string
  volume: number
  source: string
  attachments: File[]
  attachments_note: string
  contact_method: string | null
  contact_phone: string
  contact_other: string
  twitter: string
  github: string
  shipping_city: string
  order_notes: string
  newsletter: boolean
  terms: boolean
  references: Array<{
    name: string
    may_contact: boolean
    email: string
  }>
}

const form = reactive<FormData>({
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: "",
    avatar: []
  },
  plan: null,
  interests: [],
  channels: [],
  topics: [],
  billing: null,
  extras: [],
  notify: true,
  appointment: "",
  brand_color: "#000000",
  volume: 0,
  source: "kitchen-sink",
  attachments: [],
  attachments_note: "",
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false,
  references: [{
    name: "",
    may_contact: false,
    email: ""
  }]
})

const errors = reactive<Record<string, string>>({})
const touched = new Set<string>()
const result = ref<Record<string, unknown> | null>(null)

// Polite aria-live region; cleared first so repeated text re-announces.
const fgAnnouncement = ref('')
function fgAnnounce(message: string): void {
  fgAnnouncement.value = ''
  void nextTick(() => {
    fgAnnouncement.value = message
  })
}
function fgErrorsText(count: number): string {
  const forms: Record<string, string> & { other: string } = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

function fgIsEmpty(v: unknown): boolean {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
// Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
// never compare a string field with false).
function fgIsBlank(v: unknown): boolean {
  return fgIsEmpty(v) || v === false
}
function fgSize(v: unknown): number | null {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}
function fgAccepts(file: File, accept: string): boolean {
  if (accept.trim() === '') return true
  const name = file.name.toLowerCase()
  const type = (file.type || '').toLowerCase()
  return accept.split(',').map((token) => token.trim().toLowerCase()).filter(Boolean).some((token) =>
    token.startsWith('.') ? name.endsWith(token) : token.endsWith('/*') ? type.startsWith(token.slice(0, -1)) : type === token,
  )
}
function fgFileProblem(v: unknown, accept: string, maxMb: number, maxFiles: number, m: { tooMany: string; type: string; size: string }): string | null {
  const files = Array.isArray(v) ? v.filter((f) => f instanceof File) as File[] : []
  if (maxFiles > 0 && files.length > maxFiles) return m.tooMany
  for (const file of files) {
    if (!fgAccepts(file, accept)) return m.type.split('{name}').join(file.name)
    if (maxMb > 0 && file.size > maxMb * 1024 * 1024) return m.size.split('{name}').join(file.name)
  }
  return null
}
function fgFileJson(_key: string, value: unknown): unknown {
  return value instanceof File ? { name: value.name, size: value.size, type: value.type } : value
}
function fgMultipart(payload: Record<string, unknown>) {
  const files: { path: string; file: File }[] = []
  const walk = (value: unknown, path: string): unknown => {
    if (value instanceof File) {
      files.push({ path, file: value })
      return fgFileJson('', value)
    }
    if (Array.isArray(value)) {
      const fileList = value.length > 0 && value.every((v) => v instanceof File)
      return value.map((v, i) => walk(v, fileList ? path : path + '.' + i))
    }
    if (value && typeof value === 'object') {
      const out: Record<string, unknown> = {}
      for (const [key, v] of Object.entries(value)) out[key] = walk(v, path ? path + '.' + key : key)
      return out
    }
    return value
  }
  const data = walk(payload, '')
  const body = new FormData()
  body.append('data', JSON.stringify(data))
  for (const part of files) body.append(part.path, part.file, part.file.name)
  return body
}
const fgThumbs = new WeakMap<File, string>()
function fgThumb(file: File): string {
  let url = fgThumbs.get(file)
  if (!url) {
    url = URL.createObjectURL(file)
    fgThumbs.set(file, url)
  }
  return url
}
function fgReleaseThumb(file: File): void {
  const url = fgThumbs.get(file)
  if (url) URL.revokeObjectURL(url)
  fgThumbs.delete(file)
}
function fgFileSize(bytes: number): string {
  return bytes >= 1024 * 1024 ? (bytes / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB'
}
function fgRemoveFileLabel(name: string): string {
  return "Remove {name}".split('{name}').join(name)
}
const fgFileMultiple: Record<string, boolean> = { 'account.avatar': false, 'attachments': true }
function fgFileList(path: string): File[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form) as File[]
}
function fgSetFiles(path: string, files: File[]): void {
  const keys = path.split('.')
  const last = keys.pop()!
  const target = keys.reduce<Record<string, unknown>>((o, k) => o[k] as Record<string, unknown>, form as unknown as Record<string, unknown>)
  target[last] = files
}
function fgPickFiles(path: string, event: Event): void {
  const input = event.target as HTMLInputElement
  const picked = Array.from(input.files ?? [])
  input.value = ''
  if (picked.length === 0) return
  fgSetFiles(path, fgFileMultiple[path] ? [...fgFileList(path), ...picked] : picked.slice(0, 1))
  touch(path)
}
function fgRemoveFile(path: string, index: number): void {
  const list = fgFileList(path)
  const file = list[index]
  if (file) fgReleaseThumb(file)
  fgSetFiles(path, list.filter((_, i) => i !== index))
  touch(path)
}

function fgVisible_attachments_note() {
  return ((!fgIsBlank(form.attachments)))
}
function fgVisible_contact_phone() {
  return ((form.contact_method === "phone"))
}
function fgVisible_contact_other() {
  return ((form.contact_method === "other"))
}

const validators: Record<string, () => string | null> = {
  'full_name': function () {
  const v = form.full_name
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function () {
  const v = form.email
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function () {
  const v = form.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function () {
  const v = form.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function () {
  const v = form.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function () {
  const v = form.account.username
  if (fgIsBlank(v)) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function () {
  const v = form.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'account.avatar': function () {
  const v = form.account.avatar
  { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose at most 1 files","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
  return null
  },
  'plan': function () {
  const v = form.plan
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'topics': function () {
  const v = form.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'attachments': function () {
  const v = form.attachments
  if (fgIsBlank(v)) return "This field is required"
  { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
  return null
  },
  'contact_method': function () {
  const v = form.contact_method
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'shipping_city': function () {
  const v = form.shipping_city
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
  'terms': function () {
  const v = form.terms
  if (fgIsBlank(v)) return "This field is required"
  return null
  },
}

function runValidator(path: string): void {
  const validate = validators[path] ?? fgItemValidator(path)
  if (!validate) return
  const message = validate()
  if (message) errors[path] = message
  else delete errors[path]
}

// A blur error appearing while a pointer is held reflows the form and the
// release misses its target; defer blur validation until the press ends.
let fgPressing = false
const fgDeferred = new Set<string>()
function fgFlushDeferred(): void {
  const paths = [...fgDeferred]
  fgDeferred.clear()
  for (const path of paths) touch(path)
}
function fgPointerDown(): void {
  fgFlushDeferred()
  fgPressing = true
}
function fgPointerEnd(): void {
  if (!fgPressing) return
  fgPressing = false
  setTimeout(fgFlushDeferred, 0)
}
onMounted(() => {
  window.addEventListener('pointerup', fgPointerEnd)
  window.addEventListener('pointercancel', fgPointerEnd)
})
onBeforeUnmount(() => {
  window.removeEventListener('pointerup', fgPointerEnd)
  window.removeEventListener('pointercancel', fgPointerEnd)
})

function touch(path: string): void {
  if (fgPressing) {
    fgDeferred.add(path)
    return
  }
  touched.add(path)
  runValidator(path)
}

function revalidate(path: string): void {
  if (touched.has(path)) runValidator(path)
}

function validateAll(): boolean {
  let ok = true
  for (const path of [...Object.keys(validators), ...Object.keys(fgItemValidators).flatMap(fgItemPaths)]) {
    touched.add(path)
    runValidator(path)
    if (errors[path]) ok = false
  }
  return ok
}

const fgSec_ks_social_tabs = ref(0)
const fgSec_ks_wizard = ref(0)

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]

const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]
function fgGo_ks_wizard(index: number): void {
  fgSec_ks_wizard.value = index
  fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
}
function fgNext_ks_wizard(): void {
  let ok = true
  for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard.value] ?? []) {
    touch(path)
    if (errors[path]) ok = false
  }
  if (ok && fgSec_ks_wizard.value < 1) fgGo_ks_wizard(fgSec_ks_wizard.value + 1)
}

function fgJumpToError(): void {
  if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs.value] ?? []).some((p) => errors[p])) {
    const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => errors[p]))
    if (target !== -1) fgSec_ks_social_tabs.value = target
  }
  if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard.value] ?? []).some((p) => errors[p])) {
    const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => errors[p]))
    if (target !== -1) fgSec_ks_wizard.value = target
  }
}

const tagDrafts = reactive<Record<string, string>>({ 'topics': '' })
const tagFields: Record<string, { get: () => string[]; set: (v: string[]) => void }> = {
  'topics': { get: () => form.topics, set: (v) => { form.topics = v } },
}
function fgAddTag(path: string): void {
  const draft = (tagDrafts[path] ?? '').trim()
  const field = tagFields[path]!
  if (draft !== '' && !field.get().includes(draft)) field.set([...field.get(), draft])
  tagDrafts[path] = ''
  revalidate(path)
}
function fgRemoveTag(path: string, index: number): void {
  const field = tagFields[path]!
  field.set(field.get().filter((_, i) => i !== index))
  revalidate(path)
}

const fgRoot = ref<HTMLElement | null>(null)
const fgItemDefaults: Record<string, () => Record<string, unknown>> = {
  'references': () => ({
    name: "",
    may_contact: false,
    email: ""
  }),
}
const fgItemLimits: Record<string, { min: number; max: number }> = {
  'references': { min: 0, max: 3 },
}
const fgItemLabels: Record<string, string> = {
  'references': "Reference {n}",
}
const fgRepeaterVisible: Record<string, () => boolean> = {
  'references': () => true,
}
const fgItemValidators: Record<string, Record<string, (item: Record<string, unknown>) => string | null>> = {
  'references': {
    'name': function (item: Record<string, unknown>) {
      const v = item["name"]
      if (fgIsBlank(v)) return "This field is required"
      return null
    },
    'email': function (item: Record<string, unknown>) {
      if (!((item["may_contact"] === true))) return null
      const v = item["email"]
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
    },
  },
}

function fgList(path: string): Record<string, unknown>[] {
  return path.split('.').reduce<unknown>((o, k) => (o as Record<string, unknown>)[k], form) as Record<string, unknown>[]
}
function fgItemLabel(path: string, index: number): string {
  return (fgItemLabels[path] ?? '').split('{n}').join(String(index + 1))
}
function fgRemoveLabel(path: string, index: number): string {
  return "Remove {label}".split('{label}').join(fgItemLabel(path, index))
}
/** Validator for an item field path like "people.2.name". */
function fgItemValidator(path: string): (() => string | null) | undefined {
  const match = /^(.+)\\.(\\d+)\\.([^.]+)$/.exec(path)
  if (!match) return undefined
  const validate = fgItemValidators[match[1]!]?.[match[3]!]
  const item = fgList(match[1]!)[Number(match[2])]
  return validate && item ? () => validate(item) : undefined
}
/** Every item field path of a repeater (for validation and step gates). */
function fgItemPaths(path: string): string[] {
  if (!fgRepeaterVisible[path]?.()) return []
  const fields = Object.keys(fgItemValidators[path] ?? {})
  return fgList(path).flatMap((_, i) => fields.map((field) => \`\${path}.\${i}.\${field}\`))
}
const fgItemKeys = new WeakMap<object, number>()
let fgNextItemKey = 0
function fgKeyOf(item: object): number {
  const raw = toRaw(item)
  let key = fgItemKeys.get(raw)
  if (key === undefined) {
    key = fgNextItemKey++
    fgItemKeys.set(raw, key)
  }
  return key
}
function fgItemElements(path: string): HTMLElement[] {
  const repeater = fgRoot.value?.querySelector(\`[data-fg-repeater="\${path}"]\`)
  return Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
}
/** A removed item's errors/touched state go; later items' move up one. */
function fgShiftItems(path: string, removed: number): void {
  const pattern = new RegExp('^' + path.replace(/\\./g, '\\\\.') + '\\\\.(\\\\d+)(\\\\..*)$')
  const move = (key: string): string | null => {
    const match = pattern.exec(key)
    if (!match) return key
    const index = Number(match[1])
    if (index === removed) return null
    return index > removed ? \`\${path}.\${index - 1}\${match[2]}\` : key
  }
  const nextTouched = [...touched].map(move).filter((k): k is string => k !== null)
  touched.clear()
  nextTouched.forEach((k) => touched.add(k))
  const nextErrors: Record<string, string> = {}
  for (const [key, message] of Object.entries(errors)) {
    const target = move(key)
    if (target !== null) nextErrors[target] = message
  }
  for (const key of Object.keys(errors)) delete errors[key]
  Object.assign(errors, nextErrors)
}
async function fgAddItem(path: string): Promise<void> {
  const list = fgList(path)
  if (list.length >= (fgItemLimits[path]?.max ?? Number.POSITIVE_INFINITY)) return
  list.push(fgItemDefaults[path]!())
  await nextTick()
  const item = fgItemElements(path)[list.length - 1]
  const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
  ;(control ?? item)?.focus()
  fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length - 1)))
}
async function fgRemoveItem(path: string, index: number): Promise<void> {
  const list = fgList(path)
  if (list.length <= (fgItemLimits[path]?.min ?? 0)) return
  const label = fgItemLabel(path, index)
  fgShiftItems(path, index)
  list.splice(index, 1)
  await nextTick()
  const remaining = fgItemElements(path)
  const target = remaining[Math.min(index, remaining.length - 1)]
  ;(target ?? fgRoot.value?.querySelector<HTMLElement>(\`[data-fg-add="\${path}"]\`))?.focus()
  fgAnnounce("{label} removed".split('{label}').join(label))
}

function fgReset(): void {
  Object.assign(form, {
    full_name: "",
    email: "",
    website: "",
    seats: null,
    satisfaction: 5,
    city: "",
    zip: "",
    account: {
      username: "",
      password: "",
      bio: "",
      birthday: "",
      avatar: []
    },
    plan: null,
    interests: [],
    channels: [],
    topics: [],
    billing: null,
    extras: [],
    notify: true,
    appointment: "",
    brand_color: "#000000",
    volume: 0,
    source: "kitchen-sink",
    attachments: [],
    attachments_note: "",
    contact_method: null,
    contact_phone: "",
    contact_other: "",
    twitter: "",
    github: "",
    shipping_city: "",
    order_notes: "",
    newsletter: true,
    terms: false,
    references: [{
      name: "",
      may_contact: false,
      email: ""
    }]
  })
  for (const key of Object.keys(errors)) delete errors[key]
  touched.clear()
  result.value = null
  for (const key of Object.keys(tagDrafts)) tagDrafts[key] = ''
  fgAnnounce("The form was reset.")
}

function buildPayload(): Record<string, unknown> {
  return {
    "full_name": form.full_name,
    "email": form.email,
    "website": form.website,
    "seats": form.seats,
    "satisfaction": form.satisfaction,
    "city": form.city,
    "zip": form.zip,
    "account": {
      "username": form.account.username,
      "password": form.account.password,
      "bio": form.account.bio,
      "birthday": form.account.birthday,
      "avatar": form.account.avatar,
    },
    "plan": form.plan,
    "interests": form.interests,
    "channels": form.channels,
    "topics": form.topics,
    "billing": form.billing,
    "extras": form.extras,
    "notify": form.notify,
    "appointment": form.appointment,
    "brand_color": form.brand_color,
    "volume": form.volume,
    "source": form.source,
    "references": form.references.map((item) => ({ "name": item.name, "may_contact": item.may_contact, ...((item.may_contact === true) ? { "email": item.email } : {}) })),
    "attachments": form.attachments,
    ...(fgVisible_attachments_note() ? { "attachments_note": form.attachments_note } : {}),
    "contact_method": form.contact_method,
    ...(fgVisible_contact_phone() ? { "contact_phone": form.contact_phone } : {}),
    ...(fgVisible_contact_other() ? { "contact_other": form.contact_other } : {}),
    "twitter": form.twitter,
    "github": form.github,
    "shipping_city": form.shipping_city,
    "order_notes": form.order_notes,
    "newsletter": form.newsletter,
    "terms": form.terms,
  }
}

async function onSubmit(): Promise<void> {
  if (!validateAll()) {
    fgJumpToError()
    fgAnnounce(fgErrorsText(Object.keys(errors).length))
    return
  }
  const data = buildPayload()
  result.value = data
  fgAnnounce("Form submitted.")
  emit('submit', data)
}
</script>

<template>
  <form
    ref="fgRoot"
    class="container py-4"
    dir="ltr"
    novalidate
    @submit.prevent="onSubmit"
    @pointerdown.capture="fgPointerDown"
  >
    <div class="row g-3">
      <div class="col-12 col-md-12 text-center">
        <h2 class="fw-semibold text-primary">Kitchen Sink</h2>
      </div>
      <div class="col-12 col-md-12 text-center">
        <p class="text-secondary">Every implemented element appears in this form.</p>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_full_name">Full name<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_full_name" v-model="form.full_name" type="text" class="form-control" :class="{ 'is-invalid': !!errors['full_name'] }" placeholder="Jane Doe" @blur="touch('full_name')" @input="revalidate('full_name')">
          <p v-if="errors['full_name']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['full_name'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_email">Email<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_email" v-model="form.email" type="email" class="form-control" :class="{ 'is-invalid': !!errors['email'] }" placeholder="jane&#64;example.com" @blur="touch('email')" @input="revalidate('email')">
          <p v-if="errors['email']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['email'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_website">Website</label>
          <input id="fg_website" v-model="form.website" type="url" class="form-control form-control-sm" :class="{ 'is-invalid': !!errors['website'] }" @blur="touch('website')" @input="revalidate('website')">
          <p v-if="errors['website']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['website'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_seats">Seats</label>
          <input id="fg_seats" v-model.number="form.seats" type="number" class="form-control" :class="{ 'is-invalid': !!errors['seats'] }" min="1" max="50" @blur="touch('seats')" @input="revalidate('seats')">
          <p v-if="errors['seats']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['seats'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" v-model.number="form.satisfaction" type="range" class="form-range" min="0" max="10" step="1" @change="touch('satisfaction')">
          <p class="form-text mt-0">{{ form.satisfaction }}</p>
          <p v-if="errors['satisfaction']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['satisfaction'] }}</p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <hr class="border-top border-primary opacity-100">
      </div>
      <div class="col-12 col-md-12">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-1">
              <label class="form-label fw-semibold mb-0" for="fg_city">City</label>
              <input id="fg_city" v-model="form.city" type="text" class="form-control" :class="{ 'is-invalid': !!errors['city'] }" @blur="touch('city')" @input="revalidate('city')">
              <p v-if="errors['city']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['city'] }}</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-1">
              <label class="visually-hidden" for="fg_zip">ZIP</label>
              <input id="fg_zip" v-model="form.zip" type="text" class="form-control" :class="{ 'is-invalid': !!errors['zip'] }" @blur="touch('zip')" @input="revalidate('zip')">
              <p v-if="errors['zip']" class="invalid-feedback d-block mt-0" role="alert">{{ errors['zip'] }}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12 account-box">
        <fieldset class="border rounded p-3 bg-body-tertiary">
