                    {i > 0 && <button type="button" className="btn btn-outline-secondary fg-repeater-move" data-fg-move="up" aria-label={fgMoveLabel('references', i, 'up')} onClick={() => fgMoveItem('references', i, -1)}>↑</button>}
                    {i < form.references.length - 1 && <button type="button" className="btn btn-outline-secondary fg-repeater-move" data-fg-move="down" aria-label={fgMoveLabel('references', i, 'down')} onClick={() => fgMoveItem('references', i, 1)}>↓</button>}
                    <button type="button" className="btn btn-link link-danger p-0 ms-auto fg-repeater-remove" aria-label={fgRemoveLabel('references', i)} onClick={() => fgRemoveItem('references', i)}>Remove</button>
