// ""Use my location"": the device's position into the field (or why not).
function fgLocMine(group, status, onChange) {
  if (!navigator.geolocation) {
    status.textContent = ""Your location isn't available. Place the pin on the map or type the coordinates.""
    return
  }
  status.textContent = ""Finding your location…""
  navigator.geolocation.getCurrentPosition(function (position) {
    var point = fgLocValue({ lat: position.coords.latitude, lng: position.coords.longitude })
    fgLocShow(group, point, 'zoom')
    onChange(group, point, true)
  }, function () {
    status.textContent = ""Your location isn't available. Place the pin on the map or type the coordinates.""
  }, { enableHighAccuracy: true, timeout: 15000 })
}
// The pins follow the boxes (plain HTML: a reset, saved answers put back);
// fields being typed in are left to their own input events.
function fgLocPins(root) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('[data-fg-loc]'), function (group) {
    var state = group.fgLocMap
    if (!state || !state.map || group.contains(document.activeElement)) return
    var at = state.marker ? state.marker.getLatLng() : null
    var point = fgLocTyped(group)
    if (!fgLocSame(point, at ? fgLocValue({ lat: at.lat, lng: at.lng }) : null)) fgLocPin(group, point, point ? 'pan' : 'zoom')
  })
}
// Values set elsewhere (a reset, saved answers) show in the boxes and on the map.
function fgLocSync(root, valueOf) {
  if (!root) return
  Array.prototype.forEach.call(root.querySelectorAll('[data-fg-loc]'), function (group) {
    var point = fgLocValue(valueOf(group))
    if (!fgLocSame(point, fgLocTyped(group))) fgLocShow(group, point, 'zoom')
  })
}
window.fgLocations = function (root, dotnet) {
  fgWireLocations(root, function (group, point, touch) {
    dotnet.invokeMethodAsync('FgLocated', group.getAttribute('data-fg-loc'), point ? point.lat : null, point ? point.lng : null, touch)
  })
}
window.fgLocSet = function (root, values) {
  fgLocSync(root, function (group) {
    var key = group.getAttribute('data-fg-loc')
    return Object.prototype.hasOwnProperty.call(values, key) ? values[key] : fgLocTyped(group)
  })
}";

    [Microsoft.JSInterop.JSInvokable]
    public void FgLocated(string key, double? lat, double? lng, bool touch)
    {
        if (!fgLoc.TryGetValue(key, out var entry)) return;
        var point = lat.HasValue && lng.HasValue ? new FgLatLng(lat.Value, lng.Value) : null;
        if (point == entry.Value && !touch) return;
        entry.Set(point);
        fgLoc[key] = (entry.Set, point);
        if (touch || point is not null) fgEdit.NotifyFieldChanged(FgField(key));
        StateHasChanged();
    }

    private async Task FgLocShowValues()
    {
        foreach (var key in fgLoc.Keys.Where(key => !fgLocSeen.TryGetValue(key, out var seen) || seen != fgRenderGen).ToList()) { fgLoc.Remove(key); fgLocSeen.Remove(key); }
        if (fgSelf is null) return;
        await FgJs.InvokeVoidAsync("fgLocSet", fgFormRoot, fgLoc.ToDictionary(entry => entry.Key, entry => entry.Value.Value is null ? null : (object)new { lat = entry.Value.Value.Lat, lng = entry.Value.Value.Lng }));
    }

    // Spam check (Cloudflare Turnstile): the widget is run by a script
    // (FgCaptchaScript) that reports each token here; the submit button
    // waits for one, and each submission sends it once.
    private ElementReference fgCaptchaEl;
    private string fgCaptchaToken = "";
    private bool fgCaptchaFailed;

    private const string FgCaptchaScript = @"// Spam check (Cloudflare Turnstile): onToken(token, failed) runs when the
// check passes, and with '' when it expires or fails.
var fgTurnstileWaiting = null
function fgCaptcha(el, siteKey, lang, onToken) {
  if (!el || el.fgCaptcha) return
  el.fgCaptcha = true
  var w = window
  var render = function () {
    var api = w.turnstile
    if (!el.isConnected || !api) return
    el.fgCaptchaId = api.render(el, {
      sitekey: siteKey,
      language: lang,
      callback: function (token) { onToken(token, false) },
      'expired-callback': function () { onToken('', false) },
      'error-callback': function () { onToken('', true) },
    })
  }
  if (w.turnstile) { render(); return }
  if (!fgTurnstileWaiting) {
    fgTurnstileWaiting = []
    var script = document.createElement('script')
    // Cloudflare changes this file in place: no integrity hash is possible.
    script.src = ""https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit""
    script.onload = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { if (w.turnstile) pair[0](); else pair[1]() })
    }
    script.onerror = function () {
      var waiting = fgTurnstileWaiting
      fgTurnstileWaiting = null
      if (waiting) waiting.forEach(function (pair) { pair[1]() })
    }
    document.head.appendChild(script)
  }
  fgTurnstileWaiting.push([render, function () { onToken('', true) }])
}
// A token works once: a new check for the next submission.
function fgCaptchaReset(el) {
  var w = window
  if (el && el.fgCaptchaId !== undefined && w.turnstile) w.turnstile.reset(el.fgCaptchaId)
}
window.fgCaptchaWire = function (el, dotnet) {
  fgCaptcha(el, ""1x00000000000000000000AA"", ""en"", function (token, failed) {
    dotnet.invokeMethodAsync('FgCaptchaToken', token, failed)
  })
}";

    [Microsoft.JSInterop.JSInvokable]
    public void FgCaptchaToken(string token, bool failed)
    {
        fgCaptchaToken = token;
        fgCaptchaFailed = failed;
        StateHasChanged();
    }

    private static bool FgIsBlank(object? value) => value switch
    {
        null => true,
        string text => string.IsNullOrWhiteSpace(text),
        bool on => !on,
        IDictionary<string, string?> answers => answers.Values.Any(string.IsNullOrEmpty),
        IDictionary<string, List<string>> answers => answers.Values.Any(list => list.Count == 0),
        FgDateRange range => string.IsNullOrWhiteSpace(range.From) || string.IsNullOrWhiteSpace(range.To),
        System.Collections.ICollection list => list.Count == 0,
        _ => false,
    };

    private static bool FgAccepts(FgUpload file, string accept)
    {
        var name = file.Name.ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        return accept.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).Any(t =>
            t.StartsWith('.') ? name.EndsWith(t) : t.EndsWith("/*") ? type.StartsWith(t[..^1]) : type == t);
    }

    private async Task HandleValidSubmit()
    {
        if (fgCaptchaToken == "")
        {
            await FgAnnounce("The form can be sent once the check above has passed.");
            return;
        }
        var parts = new List<(string Path, FgUpload File)>();
        var payload = BuildPayload(parts);
        payload["cf-turnstile-response"] = fgCaptchaToken;
        // A token works once: a new check for the next submission.
        fgCaptchaToken = "";
        await FgJs.InvokeVoidAsync("fgCaptchaReset", fgCaptchaEl);
        ResultJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await FgAnnounce("Form submitted.");
    }

    private Dictionary<string, object?> BuildPayload(List<(string Path, FgUpload File)> parts)
    {
        var payload = new Dictionary<string, object?>();
        payload["full_name"] = Model.FullName;
        payload["email"] = Model.Email;
        payload["website"] = Model.Website;
        payload["seats"] = Model.Seats;
        payload["seat_cost"] = Model.SeatCost;
        payload["satisfaction"] = Model.Satisfaction;
        payload["city"] = Model.City;
        payload["zip"] = Model.Zip;
        var dict0 = new Dictionary<string, object?>();
        dict0["username"] = Model.AccountUsername;
        dict0["password"] = Model.AccountPassword;
        dict0["bio"] = Model.AccountBio;
        dict0["birthday"] = Model.AccountBirthday;
        dict0["avatar"] = FgFilesPart(parts, "account.avatar", Model.AccountAvatar);
        payload["account"] = dict0;
        payload["plan"] = string.IsNullOrEmpty(Model.Plan) ? null : Model.Plan;
        payload["interests"] = Model.Interests;
        payload["channels"] = Model.Channels;
        payload["topics"] = Model.Topics;
        payload["billing"] = string.IsNullOrEmpty(Model.Billing) ? null : Model.Billing;
        payload["extras"] = Model.Extras;
        payload["notify"] = Model.Notify;
        payload["appointment"] = Model.Appointment;
        payload["brand_color"] = Model.BrandColor;
        payload["volume"] = Model.Volume;
        payload["budget"] = new Dictionary<string, object?> { ["from"] = Model.Budget.From, ["to"] = Model.Budget.To };
        payload["stay"] = new Dictionary<string, object?> { ["from"] = Model.Stay.From, ["to"] = Model.Stay.To };
        payload["days"] = Model.Days;
        payload["rating"] = Model.Rating;
        payload["usage"] = Model.Usage;
        payload["source"] = Model.Source;
        var list1 = new List<Dictionary<string, object?>>();
        for (var n1 = 0; n1 < Model.References.Count; n1++)
        {
            var item = Model.References[n1];
            var item1 = new Dictionary<string, object?>();
            item1["name"] = item.Name;
            item1["may_contact"] = item.MayContact;
            if ((Equals(item.MayContact, true))) item1["email"] = item.Email;
            if ((Equals(item.MayContact, true))) item1["phone"] = item.Phone;
            list1.Add(item1);
        }
        payload["references"] = list1;
        payload["attachments"] = FgFilesPart(parts, "attachments", Model.Attachments);
        if (((!FgIsBlank(Model.Attachments)))) payload["attachments_note"] = Model.AttachmentsNote;
        payload["about"] = Model.About;
        payload["meet"] = Model.Meet is null ? null : new Dictionary<string, object?> { ["lat"] = Model.Meet.Lat, ["lng"] = Model.Meet.Lng };
        payload["signature"] = FgFilesPart(parts, "signature", Model.Signature);
        payload["contact_method"] = string.IsNullOrEmpty(Model.ContactMethod) ? null : Model.ContactMethod;
        if (((Equals(Model.ContactMethod, "phone")))) payload["contact_phone"] = Model.ContactPhone;
        if (((Equals(Model.ContactMethod, "other")))) payload["contact_other"] = Model.ContactOther;
        payload["twitter"] = Model.Twitter;
        payload["github"] = Model.Github;
        payload["shipping_city"] = Model.ShippingCity;
        payload["order_notes"] = Model.OrderNotes;
        payload["newsletter"] = Model.Newsletter;
        payload["terms"] = Model.Terms;
        return payload;
    }

    public class KitchenSinkFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "This field is required")]
        [MinLength(2, ErrorMessage = "Must be at least 2")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Must be a valid email address")]
        public string Email { get; set; } = "";

        public string Website { get; set; } = "";

        public double? Seats { get; set; }

        public double? SeatCost { get; set; }

        public double Satisfaction { get; set; } = 5;

        public string City { get; set; } = "";

        [RegularExpression(@"^[0-9]{4,6}$", ErrorMessage = "Invalid format")]
        public string Zip { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [MinLength(3, ErrorMessage = "Must be between 3 and 20")]
        [MaxLength(20, ErrorMessage = "Must be between 3 and 20")]
        public string AccountUsername { get; set; } = "";

        public string AccountPassword { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Must be at most 200")]
        public string AccountBio { get; set; } = "";

        public string AccountBirthday { get; set; } = "";

        public List<FgUpload> AccountAvatar { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string Plan { get; set; } = "";

        public List<string> Interests { get; set; } = new();

        public string[] Channels { get; set; } = Array.Empty<string>();

        public List<string> Topics { get; set; } = new();

        public string Billing { get; set; } = "";

        public List<string> Extras { get; set; } = new();

        public bool Notify { get; set; } = true;

        public string Appointment { get; set; } = "";

        public string BrandColor { get; set; } = "#000000";

        public double Volume { get; set; } = 0;

        public FgRange Budget { get; set; } = new(200, 600);

        public FgDateRange Stay { get; set; } = new();

        public List<string> Days { get; set; } = new();

        public Dictionary<string, string?> Rating { get; set; } = new() { ["speed"] = null, ["quality"] = null };

        public Dictionary<string, List<string>> Usage { get; set; } = new() { ["forms"] = new(), ["reports"] = new() };

        public string Source { get; set; } = "kitchen-sink";

        public List<FgUpload> Attachments { get; set; } = new();

        public string AttachmentsNote { get; set; } = "";

        public string About { get; set; } = "";

        public FgLatLng? Meet { get; set; }

        public List<FgUpload> Signature { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string ContactMethod { get; set; } = "";

        public string ContactPhone { get; set; } = "";

        public string ContactOther { get; set; } = "";

        public string Twitter { get; set; } = "";

        public string Github { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ShippingCity { get; set; } = "";

        public string OrderNotes { get; set; } = "";

        public bool Newsletter { get; set; } = true;

        public bool Terms { get; set; }

        public List<FgReferencesItem> References { get; set; } = new() { new(), };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
        if (!(string.IsNullOrWhiteSpace(Website)) && (!Uri.TryCreate(Website, UriKind.Absolute, out _))) yield return new ValidationResult("Must be a valid URL", new[] { nameof(Website) });
        if (!(!Seats.HasValue) && (Seats!.Value < 1)) yield return new ValidationResult("Must be at least 1", new[] { nameof(Seats) });
        if (!(!Seats.HasValue) && (Seats!.Value > 50)) yield return new ValidationResult("Must be at most 50", new[] { nameof(Seats) });
        if (!(Topics.Count == 0) && (Topics.Count > 5)) yield return new ValidationResult("At most 5 topics", new[] { nameof(Topics) });
        if ((string.IsNullOrWhiteSpace(Stay.From) || string.IsNullOrWhiteSpace(Stay.To))) yield return new ValidationResult("This field is required", new[] { nameof(Stay) });
        if (!string.IsNullOrWhiteSpace(Stay.From) && !string.IsNullOrWhiteSpace(Stay.To) && string.CompareOrdinal(Stay.To, Stay.From) < 0) yield return new ValidationResult("The end date can’t be before the start date", new[] { nameof(Stay) });
        if (!(Days.Count == 0) && (Days.Count > 3)) yield return new ValidationResult("Must be at most 3", new[] { nameof(Days) });
        if (Rating.Values.Any(string.IsNullOrEmpty)) yield return new ValidationResult("This field is required", new[] { nameof(Rating) });
        if (Attachments.Count == 0) yield return new ValidationResult("This field is required", new[] { nameof(Attachments) });
        if (Attachments.Count > 3) yield return new ValidationResult("Choose at most 3 files", new[] { nameof(Attachments) });
        foreach (var file in Attachments)
        {
            if (!FgAccepts(file, ".pdf,.doc,.docx")) { yield return new ValidationResult("{name} is not an accepted file type".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
            if (file.Size > 5242880L) { yield return new ValidationResult("{name} is larger than 5 MB".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
        }
        if (!Terms) yield return new ValidationResult("This field is required", new[] { nameof(Terms) });
        }
    }

    public class FgReferencesItem
    {
        public string Name { get; set; } = "";
        public bool MayContact { get; set; }
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
    }
}
"
`;

exports[`html target > snapshot (bootstrap5) 1`] = `
"<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kitchen Sink</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
  /* FormsGen parity: the same shape as the other flavours */
  .fg-field { gap: 0.375rem; }
  .fg-field > legend { margin-block-end: 0.375rem; }
  .fg-options { gap: 0.375rem; }
  .fg-required { margin-inline-start: 0.125rem; }
  .fg-label, .fg-description, .fg-error { line-height: 1.25rem; }
  .fg-heading { margin: 0; font-weight: 600; line-height: 1.25; }
  h1.fg-heading { font-size: 1.875rem; }
  h2.fg-heading { font-size: 1.5rem; }
  h3.fg-heading { font-size: 1.25rem; }
  h4.fg-heading { font-size: 1.125rem; }
  h5.fg-heading { font-size: 1rem; }
  h6.fg-heading { font-size: 0.875rem; }
  .fg-option-block { cursor: pointer; gap: 0.75rem; padding-inline: 0.75rem; }
  .fg-option-block:has(:checked) { border-color: var(--bs-primary) !important; box-shadow: 0 0 0 1px var(--bs-primary); }
  .fg-richtext-button { min-inline-size: 2rem; --bs-btn-line-height: 1.25rem; --bs-btn-border-radius: 0.375rem; }
  .fg-option-button { --bs-btn-font-size: 0.875rem; --bs-btn-line-height: 1.25rem; --bs-btn-padding-y: 0.5rem; --bs-btn-padding-x: 1rem; --bs-btn-font-weight: 600; }
  .fg-repeater-remove { --bs-btn-font-size: 0.875rem; --bs-btn-line-height: 1.25rem; --bs-btn-border-width: 0; --bs-btn-border-radius: 0; }
  .fg-tab-list { --bs-nav-link-font-size: 0.875rem; }
  .fg-tab-list .nav-link { line-height: 1.25rem; }
  .fg-switch-wrap { padding-inline-start: 2.75rem; min-block-size: 1.5rem; }
  .fg-switch-wrap .form-check-input.fg-switch { inline-size: 2.25rem; block-size: 1.25rem; margin-inline-start: -2.75rem; margin-block-start: 0.125rem; }
  .fg-matrix th, .fg-matrix td { line-height: 1.25rem; }
  .fg-matrix tbody tr { border-block-start: 1px solid var(--bs-border-color); }
  .fg-matrix .form-check-input { inline-size: 1rem; block-size: 1rem; margin: 0; vertical-align: middle; }
  .fg-rich-text > * { margin: 0; }
  .fg-rich-text > * + * { margin-block-start: 0.5em; }
  .fg-rich-text ul, .fg-rich-text ol { padding-inline-start: 1.25em; }
  .fg-pair > .form-control { flex: 1 1 10rem; inline-size: auto; min-inline-size: 0; }
  .form-control.is-invalid, .was-validated .form-control:invalid { padding-inline-end: 0.75rem; background-image: none; }
  .form-select.is-invalid { --bs-form-select-bg-icon: none; padding-inline-end: 2.25rem; }
  .form-check-input.is-invalid ~ .form-check-label { color: inherit; }
  .fg-repeater-move { inline-size: 2rem; block-size: 2rem; padding: 0; }

  /* Two-handle range slider */
  .fg-dual { position: relative; height: 1.5rem; margin-block: 0.25rem; }
  .fg-dual-track { position: absolute; inset-inline: 0; top: 50%; height: 0.375rem; transform: translateY(-50%); border-radius: 999px; background: var(--fg-color-border, var(--bs-border-color, #d1d5db)); }
  .fg-dual-fill { position: absolute; top: 0; bottom: 0; border-radius: inherit; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }
  .fg-dual input[type='range'] { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; padding: 0; background: none; pointer-events: none; -webkit-appearance: none; appearance: none; }
  .fg-dual input[type='range']::-webkit-slider-runnable-track { height: 1.5rem; background: none; border: none; }
  .fg-dual input[type='range']::-moz-range-track { background: none; border: none; }
  .fg-dual input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; width: 1.125rem; height: 1.125rem; margin-top: 0.1875rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']::-moz-range-thumb { pointer-events: auto; width: 1.125rem; height: 1.125rem; border-radius: 50%; background: var(--fg-color-primary, var(--bs-primary, #4f46e5)); border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); cursor: pointer; }
  .fg-dual input[type='range']:focus-visible { outline: none; }
  .fg-dual input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-dual input[type='range']:focus-visible::-moz-range-thumb { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }

  /* Rich text editors */
  .fg-richtext-editor { min-height: 6rem; padding: 0.5rem 0.75rem; outline: none; overflow-wrap: anywhere; }
  .fg-richtext-editor p { margin-bottom: 0.5rem; }
  [data-fg-rich]:focus-within { outline: 2px solid var(--bs-primary); outline-offset: 2px; }

  /* Location fields: the map under page overlays, coordinate boxes side by side */
  .fg-location-map { isolation: isolate; z-index: 0; }
  .fg-location-coord { flex: 1 1 8rem; }
  .fg-location-status:empty { display: none; }

  /* Signature pads: dashed, drawing instead of scrolling */
  .fg-signature-pad { border-style: dashed !important; touch-action: none; cursor: crosshair; }

  /* Sortable items: the dragged item, where it would land */
  .fg-repeater-handle { cursor: grab; }
  [data-fg-item][data-fg-drag] { opacity: 0.5; }
  [data-fg-item][data-fg-drop="before"] { box-shadow: 0 -3px 0 0 var(--bs-primary); }
  [data-fg-item][data-fg-drop="after"] { box-shadow: 0 3px 0 0 var(--bs-primary); }

  /* Help tooltips */
  .fg-label-row { display: flex; align-items: center; gap: 0.375rem; }
  /* The bubble anchors to the row holding the tip (label row, checkbox row or
     legend), from its start edge, so it never runs off a narrow screen. */
  .fg-tip { display: inline-flex; vertical-align: middle; margin-inline-start: 0.25rem; }
  :has(> .fg-tip) { position: relative; }
  .fg-label-row > .fg-tip { margin-inline-start: 0; }
  .fg-tip-button { display: inline-flex; align-items: center; justify-content: center; inline-size: 1.125rem; block-size: 1.125rem; padding: 0; font: 600 0.6875rem/1 system-ui, sans-serif; color: var(--fg-color-muted, var(--bs-secondary-color, #6b7280)); background: transparent; border: 1px solid currentColor; border-radius: 50%; cursor: help; }
  .fg-tip-button:focus-visible { outline: 2px solid var(--fg-color-primary, var(--bs-primary, #4f46e5)); outline-offset: 2px; }
  .fg-tip-text { position: absolute; inset-block-end: calc(100% + 0.375rem); inset-inline-start: 0; z-index: 20; inline-size: max-content; max-inline-size: min(16rem, calc(100vw - 2rem)); padding: 0.375rem 0.5rem; font-size: 0.75rem; font-weight: 400; line-height: 1.4; text-align: start; color: #ffffff; background: #111827; border-radius: 0.375rem; visibility: hidden; opacity: 0; transition: opacity 0.12s; pointer-events: none; }
  .fg-tip:hover .fg-tip-text, .fg-tip-button:focus + .fg-tip-text { visibility: visible; opacity: 1; }

  /* HTML blocks */
  .fg-html { overflow-wrap: anywhere; }
  .fg-html > :first-child { margin-block-start: 0; }
  .fg-html > :last-child { margin-block-end: 0; }
  .fg-html :where(p, ul, ol, dl, table, blockquote, figure, pre, details) { margin-block: 0.5em; }
  .fg-html :where(h1, h2, h3, h4, h5, h6) { margin-block: 0.75em 0.375em; font-weight: 600; line-height: 1.3; }
  .fg-html :where(h1) { font-size: 1.5em; }
  .fg-html :where(h2) { font-size: 1.3em; }
  .fg-html :where(h3) { font-size: 1.15em; }
  .fg-html :where(ul) { list-style: disc; padding-inline-start: 1.25em; }
  .fg-html :where(ol) { list-style: decimal; padding-inline-start: 1.25em; }
  .fg-html :where(table) { border-collapse: collapse; }
  .fg-html :where(th, td) { padding: 0.25rem 0.5rem; border: 1px solid var(--fg-color-border, var(--bs-border-color, #d1d5db)); text-align: start; }
  .fg-html :where(img) { max-inline-size: 100%; block-size: auto; }
  .fg-html :where(iframe) { display: block; border: 0; max-inline-size: 100%; }
  .fg-html :where(a) { color: var(--fg-color-primary, var(--bs-primary, #4f46e5)); }

  /* Upload drop zones */
  .fg-file-drop { min-block-size: 4.5rem; border-style: dashed !important; }
  .fg-file-drop:hover, .fg-file-drop[data-fg-dragging] { color: var(--bs-body-color) !important; border-color: var(--bs-primary) !important; }
  .fg-file-drop:has(:focus-visible) { box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25); }
  .fg-file-drop > input { cursor: pointer; }

  body { margin: 0; padding: 1.5rem 1rem; }
  #fg-form { box-sizing: border-box; max-inline-size: 42rem; margin-inline: auto; }
  [hidden] { display: none !important; }
  </style>
</head>
<body>
  <form id="fg-form" class="p-3" novalidate>
    <div class="row g-3">
      <div class="col-12 col-md-12 text-center">
        <h2 class="fg-heading text-primary">Kitchen Sink</h2>
      </div>
      <div class="col-12 col-md-12 text-center">
        <p class="text-secondary mb-0">Every implemented element appears in this form.</p>
      </div>
      <div class="col-12 col-md-12">
        <div class="text-secondary mb-0 fg-rich-text">
          <p>Hi <span data-fg-answer="full_name" data-fg-fallback="there">there</span>! Fields marked * are <strong>required</strong>. See the <a class="link-primary" href="https://example.com/docs">docs</a>:</p>
          <ul>
            <li><em>one</em> answer per row in Rating</li>
            <li>several in Usage</li>
          </ul>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_full_name">Full name<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <input id="fg_full_name" type="text" class="form-control" data-fg-path="full_name" data-fg-kind="text" placeholder="Jane Doe">
          <p id="fg_full_name-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_email">Email<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <input id="fg_email" type="email" class="form-control" data-fg-path="email" data-fg-kind="text" placeholder="jane&#64;example.com">
          <p id="fg_email-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="form-control form-control-sm rounded" data-fg-path="website" data-fg-kind="text">
          <p id="fg_website-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="fg-label-row"><label class="form-label fw-semibold small mb-0 fg-label" for="fg_seats">Seats</label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_seats-tip">?</button><span role="tooltip" id="fg_seats-tip" class="fg-tip-text">Including yourself</span></span></div>
          <div class="input-group">
            <input id="fg_seats" type="number" class="form-control" data-fg-path="seats" data-fg-kind="number" min="1" max="50" aria-describedby="fg_seats-suffix">
            <span id="fg_seats-suffix" class="input-group-text">people</span>
          </div>
          <p id="fg_seats-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_seat_cost">Seat cost</label>
          <div class="input-group">
            <span id="fg_seat_cost-prefix" class="input-group-text">$</span>
            <input id="fg_seat_cost" type="text" readonly class="form-control bg-body-tertiary" data-fg-path="seat_cost" data-fg-kind="calculated" data-fg-value="" aria-describedby="fg_seat_cost-prefix">
          </div>
          <p id="fg_seat_cost-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="form-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_satisfaction-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <hr class="border-top my-1 border-primary opacity-100">
      </div>
      <div class="col-12 col-md-12">
        <div class="row g-3">
          <div class="col-6 col-md-6 col-lg-4">
            <div class="d-flex flex-column fg-field">
              <label class="form-label fw-semibold small mb-0 fg-label" for="fg_city">City</label>
              <input id="fg_city" type="text" class="form-control" data-fg-path="city" data-fg-kind="text">
              <p id="fg_city-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
            </div>
          </div>
          <div class="col-6 col-md-6">
            <div class="d-flex flex-column fg-field">
              <label class="visually-hidden" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="form-control" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_zip-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12 account-box">
        <fieldset class="border rounded p-3 bg-body-tertiary">
          <legend class="float-none w-auto px-1 small fw-semibold text-secondary mb-0 fg-label">Account</legend>
          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_username">Username<span class="text-danger fg-required" aria-hidden="true">*</span></label>
                <div class="input-group">
                  <span id="fg_account_username-prefix" class="input-group-text">&#64;</span>
                  <input id="fg_account_username" type="text" class="form-control" data-fg-path="account.username" data-fg-kind="text" aria-describedby="fg_account_username-prefix">
                </div>
                <p id="fg_account_username-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="form-control" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_account_password-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="form-control form-control-lg rounded" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_account_bio-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="form-control" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_account_birthday-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_avatar">Profile picture</label>
                <div class="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary">
                  <span class="fw-medium">Choose a file or drag it here</span>
                  <input id="fg_account_avatar" type="file" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept="image/*" data-fg-path="account.avatar" data-fg-kind="files" data-fg-thumbs>
                </div>
                <ul class="list-group mt-2" data-fg-file-list="account.avatar" hidden></ul>
                <p class="form-text mt-0 mb-0 fg-description" data-fg-file-note="account.avatar" hidden></p>
                <p id="fg_account_avatar-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field" aria-labelledby="fg_plan-legend">
          <legend class="form-label fw-semibold small mb-0 fg-label"><span id="fg_plan-legend">Plan</span><span class="text-danger fg-required" aria-hidden="true">*</span><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" class="fg-tip-text">You can switch plans at any time</span></span></legend>
          <div class="d-flex flex-column fg-options">
            <label class="form-check mb-0" for="fg_plan-free">
              <input id="fg_plan-free" type="radio" name="plan" class="form-check-input" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="form-check mb-0" for="fg_plan-pro">
              <input id="fg_plan-pro" type="radio" name="plan" class="form-check-input" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_plan-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Interests</legend>
          <div class="d-flex flex-column fg-options">
            <label class="form-check mb-0" for="fg_interests-news">
              <input id="fg_interests-news" type="checkbox" class="form-check-input" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="form-check mb-0" for="fg_interests-product">
              <input id="fg_interests-product" type="checkbox" class="form-check-input" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_interests-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="form-select" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_channels-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_topics">Topics</label>
          <div class="form-control d-flex flex-wrap align-items-center gap-1 px-2" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="border-0 p-0 flex-grow-1 shadow-none bg-transparent" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="form-text mt-0 mb-0 fg-description">Free-text tags</p>
          <p id="fg_topics-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Billing</legend>
          <div class="btn-group flex-wrap align-self-start">
            <input id="fg_billing-monthly" type="radio" name="billing" class="btn-check" value="monthly" data-fg-path="billing" data-fg-kind="radio">
            <label class="btn btn-outline-primary fg-option-button" for="fg_billing-monthly">Monthly</label>
            <input id="fg_billing-yearly" type="radio" name="billing" class="btn-check" value="yearly" data-fg-path="billing" data-fg-kind="radio">
            <label class="btn btn-outline-primary fg-option-button" for="fg_billing-yearly">Yearly</label>
          </div>
          <p id="fg_billing-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Extras</legend>
          <div class="d-flex flex-column gap-2">
            <label class="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" for="fg_extras-support">
              <input id="fg_extras-support" type="checkbox" class="form-check-input m-0 flex-shrink-0" value="support" data-fg-path="extras" data-fg-kind="checks">
              <span>Priority support</span>
            </label>
            <label class="fg-option-block d-flex align-items-center border rounded py-2 mb-0 bg-body" for="fg_extras-backup">
              <input id="fg_extras-backup" type="checkbox" class="form-check-input m-0 flex-shrink-0" value="backup" data-fg-path="extras" data-fg-kind="checks">
              <span>Daily backups</span>
            </label>
          </div>
          <p id="fg_extras-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="form-check form-switch mb-0 fg-switch-wrap">
            <input id="fg_notify" type="checkbox" role="switch" class="form-check-input fg-switch" data-fg-path="notify" data-fg-kind="checkbox" checked>
            <label class="form-check-label" for="fg_notify">Email notifications</label>
          </div>
          <p id="fg_notify-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_appointment">Appointment</label>
          <input id="fg_appointment" type="datetime-local" class="form-control" data-fg-path="appointment" data-fg-kind="text">
          <p id="fg_appointment-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_brand_color">Brand color</label>
          <input id="fg_brand_color" type="color" class="form-control form-control-color" data-fg-path="brand_color" data-fg-kind="text">
          <p id="fg_brand_color-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_volume">Volume</label>
          <input id="fg_volume" type="range" class="form-range" data-fg-path="volume" data-fg-kind="number" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" value="0">
          <p id="fg_volume-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_budget">Budget</label>
          <div class="fg-dual" data-fg-dual="budget">
            <div class="fg-dual-track"><div class="fg-dual-fill" data-fg-dual-fill></div></div>
            <input id="fg_budget" type="range" min="0" max="1000" step="50" value="200" data-fg-path="budget" data-fg-kind="range2" data-fg-part="from" aria-label="Budget: Minimum">
            <input id="fg_budget-to" type="range" min="0" max="1000" step="50" value="600" data-fg-path="budget" data-fg-kind="range2" data-fg-part="to" aria-label="Budget: Maximum">
          </div>
          <p class="form-text mt-0 mb-0 fg-description" data-fg-dual-text="budget">200 – 600</p>
          <p id="fg_budget-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_stay">Stay<span class="text-danger fg-required" aria-hidden="true">*</span></label>
          <div class="d-flex flex-wrap align-items-center gap-2 fg-pair">
            <input id="fg_stay" type="date" class="form-control" data-fg-path="stay" data-fg-kind="daterange" data-fg-part="from" aria-label="Stay: Start date">
            <span aria-hidden="true">–</span>
            <input id="fg_stay-to" type="date" class="form-control" data-fg-path="stay" data-fg-kind="daterange" data-fg-part="to" aria-label="Stay: End date">
          </div>
          <p id="fg_stay-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <label class="form-label fw-semibold small mb-0 fg-label" for="fg_days">Available days</label>
          <div class="d-flex flex-wrap align-items-center gap-2 fg-pair" data-fg-path="days" data-fg-kind="dates">
            <input id="fg_days" type="date" class="form-control" data-fg-dates-input="days">
            <button type="button" class="btn btn-outline-secondary fw-semibold px-3 flex-shrink-0 text-nowrap" data-fg-dates-add="days">Add date</button>
          </div>
          <div class="d-flex flex-wrap gap-1 mt-2" data-fg-dates-chips="days" hidden></div>
          <p id="fg_days-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">How did we do?<span class="text-danger fg-required" aria-hidden="true">*</span></legend>
          <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
              <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Poor</th><th scope="col" class="text-center fw-semibold text-body-secondary">OK</th><th scope="col" class="text-center fw-semibold text-body-secondary">Great</th></tr></thead>
              <tbody>
              <tr><th scope="row" class="text-start fw-medium">Speed</th><td class="text-center"><input id="fg_rating" type="radio" class="form-check-input" name="fg_rating_speed" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Poor"></td><td class="text-center"><input id="fg_rating-0-1" type="radio" class="form-check-input" name="fg_rating_speed" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: OK"></td><td class="text-center"><input id="fg_rating-0-2" type="radio" class="form-check-input" name="fg_rating_speed" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="speed" aria-label="Speed: Great"></td></tr>
              <tr><th scope="row" class="text-start fw-medium">Quality</th><td class="text-center"><input id="fg_rating-1-0" type="radio" class="form-check-input" name="fg_rating_quality" value="1" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Poor"></td><td class="text-center"><input id="fg_rating-1-1" type="radio" class="form-check-input" name="fg_rating_quality" value="2" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: OK"></td><td class="text-center"><input id="fg_rating-1-2" type="radio" class="form-check-input" name="fg_rating_quality" value="3" data-fg-path="rating" data-fg-kind="matrix" data-fg-row="quality" aria-label="Quality: Great"></td></tr>
              </tbody>
            </table>
          </div>
          <p id="fg_rating-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column fg-field">
          <legend class="form-label fw-semibold small mb-0 fg-label">Where do you use each feature?</legend>
          <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle small mb-0 fg-matrix">
              <thead><tr><td></td><th scope="col" class="text-center fw-semibold text-body-secondary">Web</th><th scope="col" class="text-center fw-semibold text-body-secondary">Mobile</th></tr></thead>
              <tbody>
              <tr><th scope="row" class="text-start fw-medium">Forms</th><td class="text-center"><input id="fg_usage" type="checkbox" class="form-check-input" name="fg_usage_forms" value="web" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="forms" aria-label="Forms: Web"></td><td class="text-center"><input id="fg_usage-0-1" type="checkbox" class="form-check-input" name="fg_usage_forms" value="mobile" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="forms" aria-label="Forms: Mobile"></td></tr>
              <tr><th scope="row" class="text-start fw-medium">Reports</th><td class="text-center"><input id="fg_usage-1-0" type="checkbox" class="form-check-input" name="fg_usage_reports" value="web" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="reports" aria-label="Reports: Web"></td><td class="text-center"><input id="fg_usage-1-1" type="checkbox" class="form-check-input" name="fg_usage_reports" value="mobile" data-fg-path="usage" data-fg-kind="matrix" data-fg-row="reports" aria-label="Reports: Mobile"></td></tr>
              </tbody>
            </table>
          </div>
          <p id="fg_usage-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <input id="fg_source" type="hidden" value="kitchen-sink" data-fg-path="source" data-fg-kind="text">
