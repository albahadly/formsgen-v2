  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: ""
  },
  plan: null,
  interests: [],
  channels: [],
  contact_method: null,
  contact_phone: "",
