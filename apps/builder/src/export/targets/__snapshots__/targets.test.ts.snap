              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_avatar">Profile picture</label>
                  <input id="fg_account_avatar" type="file" className="block w-full text-sm file:me-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white" accept="image/*" aria-invalid={errors['account.avatar'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('account.avatar', e.target)} />
                  {form.account.avatar.length > 0 && (
                    <ul className="flex flex-col gap-1.5">
                      {form.account.avatar.map((file, fi) => (
                        <li key={fi} className="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                        {file.type.startsWith('image/') && <img className="h-10 w-10 rounded object-cover" src={fgThumb(file)} alt="" width={40} height={40} />}
                          <span className="min-w-0 flex-1 truncate">{file.name}</span>
                          <span className="text-xs text-gray-500 dark:text-gray-400">{fgFileSize(file.size)}</span>
                          <button type="button" className="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('account.avatar', fi)}>×</button>
                        </li>
                      ))}
                    </ul>
                  )}
                  {errors['account.avatar'] && <p className="text-xs text-red-600" role="alert">{errors['account.avatar']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <fieldset className="flex flex-col gap-1.5">
            <legend className="text-sm font-semibold">Plan<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></legend>
            <div className="flex flex-col gap-1.5">
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_plan_free">
                <input id="fg_plan_free" type="radio" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                <span>Free</span>
              </label>
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_plan_pro">
                <input id="fg_plan_pro" type="radio" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                <span>Pro</span>
              </label>
            </div>
          </fieldset>
            {errors['plan'] && <p className="text-xs text-red-600" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <fieldset className="flex flex-col gap-1.5">
            <legend className="text-sm font-semibold">Interests</legend>
            <div className="flex flex-col gap-1.5">
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                <span>News</span>
              </label>
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                <span>Product updates</span>
              </label>
            </div>
          </fieldset>
            {errors['interests'] && <p className="text-xs text-red-600" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="text-xs text-red-600" role="alert">{errors['channels']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_topics">Topics</label>
            <div className="flex flex-wrap items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              {form.topics.map((tag, index) => (
                <span key={tag} className="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">{tag} <button type="button" className="text-gray-500 hover:text-red-600" aria-label={'Remove ' + (tag)} onClick={() => fgRemoveTag('topics', form.topics, index)}>×</button></span>
              ))}
              <input id="fg_topics" type="text" className="min-w-24 flex-1 border-none bg-transparent text-sm focus:outline-none" value={tagDrafts['topics'] ?? ''} placeholder="Type and press Enter" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setTagDrafts((d) => ({ ...d, 'topics': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddTag('topics', form.topics) } }} onBlur={() => { fgAddTag('topics', form.topics); touch('topics') }} />
            </div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Free-text tags</p>
            {errors['topics'] && <p className="text-xs text-red-600" role="alert">{errors['topics']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <fieldset className="flex flex-col gap-1.5">
            <legend className="text-sm font-semibold">Billing</legend>
            <div className="flex flex-wrap">
              <label className="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" htmlFor="fg_billing_monthly">
                <input id="fg_billing_monthly" type="radio" className="sr-only" checked={form.billing === 'monthly'} onChange={() => { setField('billing', 'monthly'); touch('billing') }} />
                <span>Monthly</span>
              </label>
              <label className="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" htmlFor="fg_billing_yearly">
                <input id="fg_billing_yearly" type="radio" className="sr-only" checked={form.billing === 'yearly'} onChange={() => { setField('billing', 'yearly'); touch('billing') }} />
                <span>Yearly</span>
              </label>
            </div>
          </fieldset>
            {errors['billing'] && <p className="text-xs text-red-600" role="alert">{errors['billing']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <fieldset className="flex flex-col gap-1.5">
            <legend className="text-sm font-semibold">Extras</legend>
            <div className="flex flex-col gap-2">
              <label className="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-sm has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" htmlFor="fg_extras_support">
                <input id="fg_extras_support" type="checkbox" className="h-4 w-4 accent-indigo-600" checked={form.extras.includes('support')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'support'] : form.extras.filter((v) => v !== 'support')); touch('extras') }} />
                <span>Priority support</span>
              </label>
              <label className="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-sm has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" htmlFor="fg_extras_backup">
                <input id="fg_extras_backup" type="checkbox" className="h-4 w-4 accent-indigo-600" checked={form.extras.includes('backup')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'backup'] : form.extras.filter((v) => v !== 'backup')); touch('extras') }} />
                <span>Daily backups</span>
              </label>
            </div>
          </fieldset>
            {errors['extras'] && <p className="text-xs text-red-600" role="alert">{errors['extras']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <div className="flex items-center gap-2">
              <input id="fg_notify" type="checkbox" role="switch" checked={form.notify} className="relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-gray-300 transition-colors before:absolute before:start-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-white before:shadow before:transition-all before:content-[''] checked:bg-indigo-600 checked:before:start-[1.125rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300 dark:bg-gray-600" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('notify', e.target.checked); touch('notify') }} />
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_notify">Email notifications</label>
            </div>
            {errors['notify'] && <p className="text-xs text-red-600" role="alert">{errors['notify']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_appointment">Appointment</label>
            <input id="fg_appointment" type="datetime-local" value={form.appointment} className={errors['appointment'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('appointment', e.target.value)} onBlur={() => touch('appointment')} />
            {errors['appointment'] && <p className="text-xs text-red-600" role="alert">{errors['appointment']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_brand_color">Brand color</label>
            <input id="fg_brand_color" type="color" value={form.brand_color} className={errors['brand_color'] ? "h-10 w-16 cursor-pointer rounded-md border border-gray-300 bg-white p-1 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "h-10 w-16 cursor-pointer rounded-md border border-gray-300 bg-white p-1 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('brand_color', e.target.value)} onBlur={() => touch('brand_color')} />
            {errors['brand_color'] && <p className="text-xs text-red-600" role="alert">{errors['brand_color']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_volume">Volume</label>
            <input id="fg_volume" type="range" value={form.volume} className="w-full accent-indigo-600" min="0" max="10" step="1" aria-orientation="vertical" style={{ writingMode: 'vertical-lr', direction: 'rtl', alignSelf: 'flex-start', width: 'auto', height: '10rem' }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('volume', Number(e.target.value)); touch('volume') }} />
            <p className="text-xs text-gray-500 dark:text-gray-400">{form.volume}</p>
            {errors['volume'] && <p className="text-xs text-red-600" role="alert">{errors['volume']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50" data-fg-repeater="references">
            <legend className="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">References</legend>
            <div className="flex flex-col gap-4">
              {form.references.map((item, i) => (
                <fieldset key={fgKeyAt('references', i)} className="min-w-0 rounded-lg border border-gray-300 p-4 dark:border-gray-600" data-fg-item tabIndex={-1}>
                  <legend className="px-1 text-sm font-semibold">{fgItemLabel('references', i)}</legend>
                  <div className="grid grid-cols-12 gap-4">
                    <div className="col-span-12 md:col-span-12">
                      <div className="flex flex-col gap-1.5">
                        <label className="text-sm font-semibold" htmlFor={'fg_references_' + i + '_name'}>Name<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                        <input id={'fg_references_' + i + '_name'} type="text" value={item.name} className={errors[('references.' + i + '.name')] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.name'), e.target.value)} onBlur={() => touch(('references.' + i + '.name'))} />
                        {errors[('references.' + i + '.name')] && <p className="text-xs text-red-600" role="alert">{errors[('references.' + i + '.name')]}</p>}
                      </div>
                    </div>
                    <div className="col-span-12 md:col-span-12">
                      <div className="flex flex-col gap-1.5">
                        <div className="flex items-center gap-2">
                          <input id={'fg_references_' + i + '_may_contact'} type="checkbox" checked={item.may_contact} className="h-4 w-4 rounded border-gray-300 accent-indigo-600" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField(('references.' + i + '.may_contact'), e.target.checked); touch(('references.' + i + '.may_contact')) }} />
                          <label className="inline-flex items-center gap-2 text-sm" htmlFor={'fg_references_' + i + '_may_contact'}>May we contact them?</label>
                        </div>
                        {errors[('references.' + i + '.may_contact')] && <p className="text-xs text-red-600" role="alert">{errors[('references.' + i + '.may_contact')]}</p>}
                      </div>
                    </div>
                    {((item.may_contact === true)) && (
                      <div className="col-span-12 md:col-span-12">
                        <div className="flex flex-col gap-1.5">
                          <label className="text-sm font-semibold" htmlFor={'fg_references_' + i + '_email'}>Their email</label>
                          <input id={'fg_references_' + i + '_email'} type="email" value={item.email} className={errors[('references.' + i + '.email')] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.email'), e.target.value)} onBlur={() => touch(('references.' + i + '.email'))} />
                          {errors[('references.' + i + '.email')] && <p className="text-xs text-red-600" role="alert">{errors[('references.' + i + '.email')]}</p>}
                        </div>
                      </div>
                    )}
                  </div>
                  <div className="mt-3 flex justify-end">
                    <button type="button" className="text-sm text-red-600 underline hover:text-red-700 dark:text-red-400" aria-label={fgRemoveLabel('references', i)} onClick={() => fgRemoveItem('references', i)}>Remove</button>
                  </div>
                </fieldset>
              ))}
            </div>
            {form.references.length < 3 && <button type="button" className="mt-4 rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-add="references" onClick={() => fgAddItem('references')}>Add reference</button>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_attachments">Attachments<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <input id="fg_attachments" type="file" className="block w-full text-sm file:me-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white" accept=".pdf,.doc,.docx" multiple aria-invalid={errors['attachments'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('attachments', e.target)} />
            {form.attachments.length > 0 && (
              <ul className="flex flex-col gap-1.5">
                {form.attachments.map((file, fi) => (
                  <li key={fi} className="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                    <span className="min-w-0 flex-1 truncate">{file.name}</span>
                    <span className="text-xs text-gray-500 dark:text-gray-400">{fgFileSize(file.size)}</span>
                    <button type="button" className="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('attachments', fi)}>×</button>
                  </li>
                ))}
              </ul>
            )}
            <p className="text-xs text-gray-500 dark:text-gray-400">Up to 3 PDF or Word files, 5 MB each</p>
            {errors['attachments'] && <p className="text-xs text-red-600" role="alert">{errors['attachments']}</p>}
          </div>
        </div>
        {((!fgIsBlank(form.attachments))) && (
          <div className="col-span-12 md:col-span-12">
            <div className="flex flex-col gap-1.5">
              <label className="text-sm font-semibold" htmlFor="fg_attachments_note">Notes about the attachments</label>
              <textarea id="fg_attachments_note" rows={3} value={form.attachments_note} className={errors['attachments_note'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('attachments_note', e.target.value)} onBlur={() => touch('attachments_note')} />
              {errors['attachments_note'] && <p className="text-xs text-red-600" role="alert">{errors['attachments_note']}</p>}
            </div>
          </div>
        )}
        <div className="col-span-12 md:col-span-12">
          <figure className="border-s-4 border-gray-300 ps-4 dark:border-gray-600">
            <blockquote className="text-base italic">
