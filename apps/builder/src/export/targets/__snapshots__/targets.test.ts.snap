      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <div>
          <ol class="fg-step-list">
            <li :class="fgSec_ks_wizard === 0 ? 'fg-step-item fg-step-item--active' : 'fg-step-item'">1. Shipping</li>
            <li :class="fgSec_ks_wizard === 1 ? 'fg-step-item fg-step-item--active' : 'fg-step-item'">2. Review</li>
          </ol>
          <div v-show="fgSec_ks_wizard === 0">
            <div class="fg-grid">
              <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_shipping_city">Shipping city<span class="fg-required" aria-hidden="true">*</span></label>
                  <input id="fg_shipping_city" v-model="form.shipping_city" type="text" class="fg-input" :class="{ 'fg-invalid': !!errors['shipping_city'] }" @blur="touch('shipping_city')" @input="revalidate('shipping_city')">
                  <p v-if="errors['shipping_city']" class="fg-error" role="alert">{{ errors['shipping_city'] }}</p>
                </div>
              </div>
            </div>
          </div>
          <div v-show="fgSec_ks_wizard === 1">
            <div class="fg-grid">
              <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_order_notes">Order notes</label>
                  <textarea id="fg_order_notes" v-model="form.order_notes" class="fg-textarea" rows="3" :class="{ 'fg-invalid': !!errors['order_notes'] }" @blur="touch('order_notes')" @input="revalidate('order_notes')"></textarea>
                  <p v-if="errors['order_notes']" class="fg-error" role="alert">{{ errors['order_notes'] }}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="fg-step-actions">
            <button v-if="fgSec_ks_wizard > 0" type="button" class="fg-button fg-button--secondary" @click="fgGo_ks_wizard(fgSec_ks_wizard - 1)">Back</button>
            <button v-if="fgSec_ks_wizard < 1" type="button" class="fg-button fg-button--primary" @click="fgNext_ks_wizard()">Next</button>
            <button v-if="fgSec_ks_wizard === 1" type="submit" class="fg-button fg-button--primary" :disabled="fgCaptchaToken === ''" :aria-describedby="fgCaptchaToken === '' && !fgCaptchaFailed ? 'fg_captcha_hint' : undefined">Submit</button>
          </div>
