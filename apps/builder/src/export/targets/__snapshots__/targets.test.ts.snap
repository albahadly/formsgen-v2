                          @if (Model.References.Count > 1)
                          {
                              <span class="px-1 fs-5 lh-1 text-body-secondary user-select-none fg-repeater-handle" data-fg-handle draggable="true" aria-hidden="true" title="Drag to reorder">⠿</span>
