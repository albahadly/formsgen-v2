// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`blazor target > snapshot (bootstrap5) 1`] = `
"@* Generated by FormsGen (.NET 8). *@
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms

<EditForm EditContext="fgEdit" OnSubmit="FgSubmit" novalidate dir="ltr">
    <div class="container py-4" @onpointerdown="FgPointerDown" @onpointerup="FgPointerEnd" @onpointerleave="FgPointerEnd" @onpointercancel="FgPointerEnd">
    <div class="row g-3">
        <div class="col-12 col-md-12 text-center">
          <h2 class="fw-semibold text-primary">Kitchen Sink</h2>
        </div>
        <div class="col-12 col-md-12 text-center">
          <p class="text-secondary">Every implemented element appears in this form.</p>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_full_name">Full name<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <InputText id="fg_full_name" @bind-Value="Model.FullName" class="form-control" placeholder="Jane Doe" />
            <ValidationMessage For="@(() => Model.FullName)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_email">Email<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <InputText id="fg_email" type="email" @bind-Value="Model.Email" class="form-control" placeholder="jane&#64;example.com" />
            <ValidationMessage For="@(() => Model.Email)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_website">Website</label>
            <InputText id="fg_website" type="url" @bind-Value="Model.Website" class="form-control form-control-sm" />
            <ValidationMessage For="@(() => Model.Website)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_seats">Seats</label>
            <InputNumber id="fg_seats" @bind-Value="Model.Seats" class="form-control" />
            <ValidationMessage For="@(() => Model.Seats)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" @bind="Model.Satisfaction" @bind:event="oninput" class="form-range" min="0" max="10" step="1" />
            <ValidationMessage For="@(() => Model.Satisfaction)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <hr class="border-top border-primary opacity-100" />
        </div>
        <div class="col-12 col-md-12">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_city">City</label>
                <InputText id="fg_city" @bind-Value="Model.City" class="form-control" />
                <ValidationMessage For="@(() => Model.City)" class="invalid-feedback d-block mt-0" />
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="d-flex flex-column gap-1">
                <label class="visually-hidden" for="fg_zip">ZIP</label>
                <InputText id="fg_zip" @bind-Value="Model.Zip" class="form-control" />
                <ValidationMessage For="@(() => Model.Zip)" class="invalid-feedback d-block mt-0" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-12 account-box">
          <fieldset class="border rounded p-3 bg-body-tertiary">
            <legend class="fw-semibold text-secondary small px-1">Account</legend>
            <div class="row g-3">
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column gap-1">
                  <label class="form-label fw-semibold mb-0" for="fg_account_username">Username<span class="text-danger ms-1" aria-hidden="true">*</span></label>
                  <InputText id="fg_account_username" @bind-Value="Model.AccountUsername" class="form-control" />
                  <ValidationMessage For="@(() => Model.AccountUsername)" class="invalid-feedback d-block mt-0" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column gap-1">
                  <label class="form-label fw-semibold mb-0" for="fg_account_password">Password</label>
                  <InputText id="fg_account_password" type="password" @bind-Value="Model.AccountPassword" class="form-control" />
                  <ValidationMessage For="@(() => Model.AccountPassword)" class="invalid-feedback d-block mt-0" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column gap-1">
                  <label class="form-label fw-semibold mb-0" for="fg_account_bio">Bio</label>
                  <InputTextArea id="fg_account_bio" @bind-Value="Model.AccountBio" class="form-control form-control-lg" rows="4" />
                  <ValidationMessage For="@(() => Model.AccountBio)" class="invalid-feedback d-block mt-0" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column gap-1">
                  <label class="form-label fw-semibold mb-0" for="fg_account_birthday">Birthday</label>
                  <InputText id="fg_account_birthday" type="date" @bind-Value="Model.AccountBirthday" class="form-control" />
                  <ValidationMessage For="@(() => Model.AccountBirthday)" class="invalid-feedback d-block mt-0" />
                </div>
              </div>
              <div class="col-12 col-md-12">
                <div class="d-flex flex-column gap-1">
                  <label class="form-label fw-semibold mb-0" for="fg_account_avatar">Profile picture</label>
                  <InputFile @key='fgFileKeys["AccountAvatar"]' @ref='fgFileInputs["AccountAvatar"]' id="fg_account_avatar" class="form-control" accept="image/*" OnChange='@(e => FgPickFiles(Model.AccountAvatar, e, false, 2097152L, true, "AccountAvatar"))' />
                  @if (Model.AccountAvatar.Count > 0)
                  {
                      <ul class="list-group mt-2">
                          @foreach (var file in Model.AccountAvatar.ToList())
                          {
                              <li @key="file" class="list-group-item d-flex align-items-center gap-2">
                                  @if (file.Thumb != null)
                                  {
                                      <img class="rounded object-fit-cover" src="@file.Thumb" alt="" width="40" height="40" />
                                  }
                                  <span class="flex-grow-1 text-truncate">@file.Name</span>
                                  <span class="text-body-secondary small">@FgFileSize(file.Size)</span>
                                  <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.AccountAvatar, file, "AccountAvatar")'>×</button>
                              </li>
                          }
                      </ul>
                  }
                  <ValidationMessage For="@(() => Model.AccountAvatar)" class="invalid-feedback d-block mt-0" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column gap-1">
            <legend class="form-label fw-semibold mb-0">Plan<span class="text-danger ms-1" aria-hidden="true">*</span></legend>
            <InputRadioGroup @bind-Value="Model.Plan">
              <div class="d-flex flex-column gap-1">
                <label class="form-check" for="fg_plan_free">
                  <InputRadio id="fg_plan_free" class="form-check-input" Value="@("free")" />
                  <span>Free</span>
                </label>
                <label class="form-check" for="fg_plan_pro">
                  <InputRadio id="fg_plan_pro" class="form-check-input" Value="@("pro")" />
                  <span>Pro</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Plan)" class="invalid-feedback d-block mt-0" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column gap-1">
            <legend class="form-label fw-semibold mb-0">Interests</legend>
            <div class="d-flex flex-column gap-1">
              <label class="form-check" for="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" class="form-check-input" checked='@Model.Interests.Contains("news")' @onchange='e => FgToggle(Model.Interests, "news", e)' />
                <span>News</span>
              </label>
              <label class="form-check" for="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" class="form-check-input" checked='@Model.Interests.Contains("product")' @onchange='e => FgToggle(Model.Interests, "product", e)' />
                <span>Product updates</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Interests)" class="invalid-feedback d-block mt-0" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_channels">Notification channels</label>
            <InputSelect id="fg_channels" multiple @bind-Value="Model.Channels" class="form-select">
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.Channels)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_topics">Topics</label>
            <div class="form-control d-flex flex-wrap align-items-center gap-1">
              @for (var i = 0; i < Model.Topics.Count; i++)
              {
                  var fgIdx_topics = i;
                  <span class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">@Model.Topics[fgIdx_topics] <button type="button" class="border-0 bg-transparent p-0 ms-1 text-white" aria-label="Remove @(Model.Topics[fgIdx_topics])" @onclick="() => Model.Topics.RemoveAt(fgIdx_topics)">&times;</button></span>
              }
              <input id="fg_topics" type="text" class="border-0 p-0 flex-grow-1 shadow-none bg-transparent" placeholder="Type and press Enter" @bind='fgTagDrafts["topics"]' @bind:after='() => FgAddTag(Model.Topics, "topics")'>
            </div>
            <p class="form-text mt-0">Free-text tags</p>
            <ValidationMessage For="@(() => Model.Topics)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column gap-1">
            <legend class="form-label fw-semibold mb-0">Billing</legend>
            <InputRadioGroup @bind-Value="Model.Billing">
              <div class="btn-group flex-wrap">
                <InputRadio id="fg_billing_monthly" class="btn-check" Value="@("monthly")" />
                <label class="btn btn-outline-primary" for="fg_billing_monthly">Monthly</label>
                <InputRadio id="fg_billing_yearly" class="btn-check" Value="@("yearly")" />
                <label class="btn btn-outline-primary" for="fg_billing_yearly">Yearly</label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Billing)" class="invalid-feedback d-block mt-0" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column gap-1">
            <legend class="form-label fw-semibold mb-0">Extras</legend>
            <div class="d-grid gap-2">
              <input id="fg_extras_support" type="checkbox" class="btn-check" checked='@Model.Extras.Contains("support")' @onchange='e => FgToggle(Model.Extras, "support", e)' />
              <label class="btn btn-outline-primary text-start" for="fg_extras_support">Priority support</label>
              <input id="fg_extras_backup" type="checkbox" class="btn-check" checked='@Model.Extras.Contains("backup")' @onchange='e => FgToggle(Model.Extras, "backup", e)' />
              <label class="btn btn-outline-primary text-start" for="fg_extras_backup">Daily backups</label>
            </div>
            <ValidationMessage For="@(() => Model.Extras)" class="invalid-feedback d-block mt-0" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <div class="form-check form-switch">
              <InputCheckbox id="fg_notify" role="switch" @bind-Value="Model.Notify" class="form-check-input" />
              <label class="form-check-label" for="fg_notify">Email notifications</label>
            </div>
            <ValidationMessage For="@(() => Model.Notify)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_appointment">Appointment</label>
            <InputText id="fg_appointment" type="datetime-local" @bind-Value="Model.Appointment" class="form-control" />
            <ValidationMessage For="@(() => Model.Appointment)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_brand_color">Brand color</label>
            <InputText id="fg_brand_color" type="color" @bind-Value="Model.BrandColor" class="form-control form-control-color" />
            <ValidationMessage For="@(() => Model.BrandColor)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_volume">Volume</label>
            <input id="fg_volume" type="range" @bind="Model.Volume" @bind:event="oninput" class="form-range" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" />
            <ValidationMessage For="@(() => Model.Volume)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="border rounded p-3 bg-body-tertiary" data-fg-repeater="references">
            <legend class="fw-semibold text-secondary small px-1">References</legend>
            <div class="d-flex flex-column gap-3">
              @foreach (var (item, i) in Model.References.Select((x, n) => (x, n)).ToList())
              {
                  <fieldset @key="item" class="border rounded p-3" data-fg-item tabindex="-1" @ref="fgItemRefs[item]">
                      <legend class="float-none w-auto px-1 fs-6 fw-semibold mb-0">@FgItemLabel("references", i)</legend>
                      <div class="row g-3">
                        <div class="col-12 col-md-12">
                          <div class="d-flex flex-column gap-1">
                            <label class="form-label fw-semibold mb-0" for="@($"fg_references_{i}_name")">Name<span class="text-danger ms-1" aria-hidden="true">*</span></label>
                            <InputText id="@($"fg_references_{i}_name")" @bind-Value="item.Name" class="form-control" />
                            <ValidationMessage For="@(() => item.Name)" class="invalid-feedback d-block mt-0" />
                          </div>
                        </div>
                        <div class="col-12 col-md-12">
                          <div class="d-flex flex-column gap-1">
                            <div class="form-check">
                              <InputCheckbox id="@($"fg_references_{i}_may_contact")" @bind-Value="item.MayContact" class="form-check-input" />
                              <label class="form-check-label" for="@($"fg_references_{i}_may_contact")">May we contact them?</label>
                            </div>
                            <ValidationMessage For="@(() => item.MayContact)" class="invalid-feedback d-block mt-0" />
                          </div>
                        </div>
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-12 col-md-12">
                              <div class="d-flex flex-column gap-1">
                                <label class="form-label fw-semibold mb-0" for="@($"fg_references_{i}_email")">Their email</label>
                                <InputText id="@($"fg_references_{i}_email")" type="email" @bind-Value="item.Email" class="form-control" />
                                <ValidationMessage For="@(() => item.Email)" class="invalid-feedback d-block mt-0" />
                              </div>
                            </div>
                        }
                      </div>
                      <div class="mt-2 d-flex justify-content-end">
                          <button type="button" class="btn btn-link link-danger p-0" aria-label='@FgRemoveLabel("references", i)' @onclick='() => FgRemoveItem(Model.References, "references", i, 0, fgItemFields_references)'>Remove</button>
                      </div>
                  </fieldset>
              }
            </div>
            @if (Model.References.Count < 3)
            {
                <button type="button" class="btn btn-outline-secondary mt-3" data-fg-add="references" @ref="fgAddRef_references" @onclick='() => FgAddItem(Model.References, "references", 3)'>Add reference</button>
            }
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_attachments">Attachments<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="form-control" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' />
            @if (Model.Attachments.Count > 0)
            {
                <ul class="list-group mt-2">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="list-group-item d-flex align-items-center gap-2">
                            <span class="flex-grow-1 text-truncate">@file.Name</span>
                            <span class="text-body-secondary small">@FgFileSize(file.Size)</span>
                            <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            <p class="form-text mt-0">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="form-control" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="invalid-feedback d-block mt-0" />
              </div>
            </div>
        }
        <div class="col-12 col-md-12">
          <figure class="mb-0">
            <blockquote class="blockquote">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="blockquote-footer mb-0">FormsGen</figcaption>
          </figure>
        </div>
        <div class="col-12 col-md-12">
          <a class="link-primary" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <label class="form-label fw-semibold mb-0" for="fg_contact_method">Preferred contact method<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="form-select">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        @if ((Equals(Model.ContactMethod, "phone")))
        {
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_contact_phone">Phone number</label>
                <InputText id="fg_contact_phone" type="tel" @bind-Value="Model.ContactPhone" class="form-control" />
                <ValidationMessage For="@(() => Model.ContactPhone)" class="invalid-feedback d-block mt-0" />
              </div>
            </div>
        }
        @if ((Equals(Model.ContactMethod, "other")))
        {
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_contact_other">Describe your preferred method</label>
                <InputTextArea id="fg_contact_other" @bind-Value="Model.ContactOther" class="form-control" rows="3" />
                <ValidationMessage For="@(() => Model.ContactOther)" class="invalid-feedback d-block mt-0" />
              </div>
            </div>
        }
        <div class="col-12 col-md-12">
          <div>
            <div class="nav nav-tabs mb-3" role="tablist">
              <button type="button" class="@(fgSec_ks_social_tabs == 0 ? "nav-link active" : "nav-link")" @onclick="() => fgSec_ks_social_tabs = 0">Social</button>
              <button type="button" class="@(fgSec_ks_social_tabs == 1 ? "nav-link active" : "nav-link")" @onclick="() => fgSec_ks_social_tabs = 1">Code</button>
            </div>
          @if (fgSec_ks_social_tabs == 0)
          {
              <div class="row g-3">
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="fg_twitter">Twitter handle</label>
                    <InputText id="fg_twitter" @bind-Value="Model.Twitter" class="form-control" />
                    <ValidationMessage For="@(() => Model.Twitter)" class="invalid-feedback d-block mt-0" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_social_tabs == 1)
          {
              <div class="row g-3">
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="fg_github">GitHub username</label>
                    <InputText id="fg_github" @bind-Value="Model.Github" class="form-control" />
                    <ValidationMessage For="@(() => Model.Github)" class="invalid-feedback d-block mt-0" />
                  </div>
                </div>
              </div>
          }
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div>
            <ol class="nav mb-3 gap-3 small text-secondary list-unstyled d-flex flex-wrap">
              <li class="@(fgSec_ks_wizard == 0 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2")">1. Shipping</li>
              <li class="@(fgSec_ks_wizard == 1 ? "d-inline-flex align-items-center gap-2 fw-semibold text-body" : "d-inline-flex align-items-center gap-2")">2. Review</li>
            </ol>
          @if (fgSec_ks_wizard == 0)
          {
              <div class="row g-3">
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="fg_shipping_city">Shipping city<span class="text-danger ms-1" aria-hidden="true">*</span></label>
                    <InputText id="fg_shipping_city" @bind-Value="Model.ShippingCity" class="form-control" />
                    <ValidationMessage For="@(() => Model.ShippingCity)" class="invalid-feedback d-block mt-0" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_wizard == 1)
          {
              <div class="row g-3">
                <div class="col-12 col-md-12">
                  <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="fg_order_notes">Order notes</label>
                    <InputTextArea id="fg_order_notes" @bind-Value="Model.OrderNotes" class="form-control" rows="3" />
                    <ValidationMessage For="@(() => Model.OrderNotes)" class="invalid-feedback d-block mt-0" />
                  </div>
                </div>
              </div>
          }
            <div class="mt-3 d-flex justify-content-between gap-2">
              @if (fgSec_ks_wizard > 0)
              {
                  <button type="button" class="btn btn-outline-secondary" @onclick="() => FgGo_ks_wizard(fgSec_ks_wizard - 1)">Back</button>
              }
              @if (fgSec_ks_wizard < 1)
              {
                  <button type="button" class="btn btn-primary" @onclick="FgNext_ks_wizard">Next</button>
              }
              @if (fgSec_ks_wizard == 1)
              {
                  <button class="btn btn-primary" type="submit">Submit</button>
              }
            </div>
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <div class="form-check">
              <InputCheckbox id="fg_newsletter" @bind-Value="Model.Newsletter" class="form-check-input" />
              <label class="form-check-label" for="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            <ValidationMessage For="@(() => Model.Newsletter)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column gap-1">
            <div class="form-check">
              <InputCheckbox id="fg_terms" @bind-Value="Model.Terms" class="form-check-input" />
              <label class="form-check-label" for="fg_terms">I accept the terms<span class="text-danger ms-1" aria-hidden="true">*</span></label>
            </div>
            <ValidationMessage For="@(() => Model.Terms)" class="invalid-feedback d-block mt-0" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <button type="button" class="btn btn-outline-secondary" @onclick="FgReset">Start over</button>
        </div>
    </div>
    <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@fgAnnouncement</div>
    @if (ResultJson is not null)
    {
        <pre class="mt-3 p-3 bg-dark text-success rounded small overflow-auto">@ResultJson</pre>
    }
    </div>
</EditForm>

@code {
    private KitchenSinkFormModel Model { get; set; } = new();
    private string? ResultJson { get; set; }

    private int fgSec_ks_social_tabs = 0;
    private int fgSec_ks_wizard = 0;

    private EditContext fgEdit = default!;
    private ValidationMessageStore fgMessages = default!;
    private bool fgPressing;
    private readonly HashSet<string> fgDeferredFields = new();

    protected override void OnInitialized() => FgInitEdit();

    private void FgInitEdit()
    {
        fgEdit = new EditContext(Model);
        fgMessages = new ValidationMessageStore(fgEdit);
        fgEdit.OnValidationRequested += (_, _) => FgValidateAll();
        fgEdit.OnFieldChanged += (_, e) => FgFieldChanged(e.FieldIdentifier);
    }

    private void FgPointerDown(PointerEventArgs _)
    {
        FgFlushDeferred();
        fgPressing = true;
    }

    private void FgPointerEnd(PointerEventArgs _)
    {
        fgPressing = false;
        FgFlushDeferred();
    }

    private void FgFieldChanged(string name)
    {
        if (fgPressing)
        {
            fgDeferredFields.Add(name);
            return;
        }
        FgValidateMembers(new[] { name });
    }

    private void FgFlushDeferred()
    {
        if (fgDeferredItemFields.Count > 0)
        {
            var items = fgDeferredItemFields.ToArray();
            fgDeferredItemFields.Clear();
            foreach (var field in items) FgValidateItemField(field);
        }
        if (fgDeferredFields.Count == 0) return;
        var names = fgDeferredFields.ToArray();
        fgDeferredFields.Clear();
        FgValidateMembers(names);
    }

    private void FgValidateAll()
    {
        fgDeferredFields.Clear();
        fgMessages.Clear();
        FgValidateMembers(fgAllMembers);
        FgValidateRepeater_references();
    }

    private object? FgValue(string name) => name switch
    {
            "FullName" => Model.FullName,
            "Email" => Model.Email,
            "Website" => Model.Website,
            "Seats" => Model.Seats,
            "Satisfaction" => Model.Satisfaction,
            "City" => Model.City,
            "Zip" => Model.Zip,
            "AccountUsername" => Model.AccountUsername,
            "AccountPassword" => Model.AccountPassword,
            "AccountBio" => Model.AccountBio,
            "AccountBirthday" => Model.AccountBirthday,
            "AccountAvatar" => Model.AccountAvatar,
            "Plan" => Model.Plan,
            "Interests" => Model.Interests,
            "Channels" => Model.Channels,
            "Topics" => Model.Topics,
            "Billing" => Model.Billing,
            "Extras" => Model.Extras,
            "Notify" => Model.Notify,
            "Appointment" => Model.Appointment,
            "BrandColor" => Model.BrandColor,
            "Volume" => Model.Volume,
            "Source" => Model.Source,
            "Attachments" => Model.Attachments,
            "AttachmentsNote" => Model.AttachmentsNote,
            "ContactMethod" => Model.ContactMethod,
            "ContactPhone" => Model.ContactPhone,
            "ContactOther" => Model.ContactOther,
            "Twitter" => Model.Twitter,
            "Github" => Model.Github,
            "ShippingCity" => Model.ShippingCity,
            "OrderNotes" => Model.OrderNotes,
            "Newsletter" => Model.Newsletter,
            "Terms" => Model.Terms,
        _ => null,
    };

    // Attribute rules per property, plus the model's Validate() results for
    // the same members (DataAnnotations alone skips Validate() while any
    // attribute rule fails, which hid errors such as a required checkbox).
    private bool FgValidateMembers(string[] members)
    {
        var ok = true;
        foreach (var name in members)
        {
            var field = new FieldIdentifier(Model, name);
            fgMessages.Clear(field);
            var results = new List<ValidationResult>();
            var context = new ValidationContext(Model) { MemberName = name };
            if (!Validator.TryValidateProperty(FgValue(name), context, results)) ok = false;
            if (results.Count > 0) fgMessages.Add(field, results[0].ErrorMessage ?? "Invalid");
        }
        foreach (var result in ((IValidatableObject)Model).Validate(new ValidationContext(Model)))
        {
            foreach (var name in result.MemberNames)
            {
                if (Array.IndexOf(members, name) < 0) continue;
                ok = false;
                var field = new FieldIdentifier(Model, name);
                // One message per field (the first), as in the other targets.
                if (!fgMessages[field].Any()) fgMessages.Add(field, result.ErrorMessage ?? "Invalid");
            }
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private async Task FgSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await HandleValidSubmit();
            return;
        }
        await FgOnInvalidSubmit(context);
    }

    private string fgAnnouncement = "";

    private async Task FgAnnounce(string message)
    {
        fgAnnouncement = "";
        StateHasChanged();
        await Task.Delay(50);
        fgAnnouncement = message;
        StateHasChanged();
    }

    private static readonly Dictionary<string, string> fgErrorForms = new() { ["one"] = "1 error. Please fix the highlighted fields.", ["other"] = "{n} errors. Please fix the highlighted fields." };

    private static string FgErrorsText(int count)
    {
        var category = count == 1 ? "one" : "other";
        var text = fgErrorForms.TryGetValue(category, out var form) ? form : fgErrorForms["other"];
        return text.Replace("{n}", count.ToString());
    }

    private static readonly string[] fgAllMembers =
    {
        "FullName",
        "Email",
        "Website",
        "Seats",
        "Satisfaction",
        "City",
        "Zip",
        "AccountUsername",
        "AccountPassword",
        "AccountBio",
        "AccountBirthday",
        "AccountAvatar",
        "Plan",
        "Interests",
        "Channels",
        "Topics",
        "Billing",
        "Extras",
        "Notify",
        "Appointment",
        "BrandColor",
        "Volume",
        "Source",
        "Attachments",
        "AttachmentsNote",
        "ContactMethod",
        "ContactPhone",
        "ContactOther",
        "Twitter",
        "Github",
        "ShippingCity",
        "OrderNotes",
        "Newsletter",
        "Terms",
    };

    private async Task FgOnInvalidSubmit(EditContext context)
    {
        FgJumpToError();
        var count = fgAllMembers.Count(m => context.GetValidationMessages(new FieldIdentifier(Model, m)).Any()) + FgItemErrorCount();
        await FgAnnounce(FgErrorsText(count));
    }

    private static readonly string[] fgSecAnnounce_ks_wizard =
    {
        "Step 1 of 2: Shipping",
        "Step 2 of 2: Review",
    };

    private async Task FgGo_ks_wizard(int index)
    {
        fgSec_ks_wizard = index;
        await FgAnnounce(fgSecAnnounce_ks_wizard[index]);
    }

    private async Task FgNext_ks_wizard()
    {
        var members = fgSec_ks_wizard switch
        {
            0 => new[] { nameof(KitchenSinkFormModel.ShippingCity) },
            1 => new[] { nameof(KitchenSinkFormModel.OrderNotes) },
            _ => Array.Empty<string>(),
        };
        if (FgValidateMembers(members) && fgSec_ks_wizard < 1) await FgGo_ks_wizard(fgSec_ks_wizard + 1);
    }

    private static readonly string[][] fgSecMembers_ks_social_tabs =
    {
        new[] { "Twitter" },
        new[] { "Github" },
    };

    private static readonly string[][] fgSecMembers_ks_wizard =
    {
        new[] { "ShippingCity" },
        new[] { "OrderNotes" },
    };

    private bool FgHasMessages(string[] members)
    {
        foreach (var name in members)
        {
            if (fgEdit.GetValidationMessages(new FieldIdentifier(Model, name)).Any()) return true;
        }
        return false;
    }

    private void FgJumpToError()
    {
        if (!FgHasMessages(fgSecMembers_ks_social_tabs[fgSec_ks_social_tabs]))
        {
            for (var i = 0; i < fgSecMembers_ks_social_tabs.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_social_tabs[i])) { fgSec_ks_social_tabs = i; break; }
            }
        }
        if (!FgHasMessages(fgSecMembers_ks_wizard[fgSec_ks_wizard]))
        {
            for (var i = 0; i < fgSecMembers_ks_wizard.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_wizard[i])) { fgSec_ks_wizard = i; break; }
            }
        }
    }

    private static void FgToggle(List<string> list, string value, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on) { if (!list.Contains(value)) list.Add(value); }
        else { list.Remove(value); }
    }

    private readonly Dictionary<string, string> fgTagDrafts = new() { ["topics"] = "" };

    private void FgAddTag(List<string> list, string key)
    {
        var draft = (fgTagDrafts.TryGetValue(key, out var value) ? value : "").Trim();
        if (draft.Length > 0 && !list.Contains(draft)) list.Add(draft);
        fgTagDrafts[key] = "";
    }

    private static readonly string[] fgItemFields_references = { "Name", "Email" };
    private ElementReference fgAddRef_references;

    private bool FgRepeaterHasErrors_references() =>
        Model.References.Any(item => fgItemFields_references.Any(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any()));

    private bool FgValidateRepeater_references()
    {
        var ok = true;
        foreach (var item in Model.References)
        {
            foreach (var name in fgItemFields_references) ok &= FgValidateItemField(new FieldIdentifier(item, name), false);
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private readonly HashSet<FieldIdentifier> fgDeferredItemFields = new();
    private readonly Dictionary<object, ElementReference> fgItemRefs = new();
    private object? fgFocusItem;
    private string? fgFocusAdd;

    private void FgFieldChanged(FieldIdentifier field)
    {
        if (ReferenceEquals(field.Model, Model))
        {
            FgFieldChanged(field.FieldName);
            return;
        }
        if (fgPressing)
        {
            fgDeferredItemFields.Add(field);
            return;
        }
        FgValidateItemField(field);
    }

    /** First rule violation of an item field (null when valid or hidden). */
    private string? FgItemError(object model, string name)
    {
        switch (model)
        {
            case FgReferencesItem item:
                switch (name)
                {
                    case "Name":
                    {
                        if (string.IsNullOrWhiteSpace(item.Name)) return "This field is required";
                        return null;
                    }
                    case "Email":
                    {
                        if (!((Equals(item.MayContact, true)))) return null;
                        if (!(string.IsNullOrWhiteSpace(item.Email)) && (!System.Text.RegularExpressions.Regex.IsMatch(item.Email, @"^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))) return "Must be a valid email address";
                        return null;
                    }
                }
                break;
        }
        return null;
    }

    private bool FgValidateItemField(FieldIdentifier field, bool notify = true)
    {
        fgMessages.Clear(field);
        var error = FgItemError(field.Model, field.FieldName);
        if (error != null) fgMessages.Add(field, error);
        if (notify) fgEdit.NotifyValidationStateChanged();
        return error == null;
    }

    private int FgItemErrorCount()
    {
        var count = 0;
        foreach (var item in Model.References) count += fgItemFields_references.Count(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any());
        return count;
    }

    private static string FgItemLabel(string path, int index) => (path switch
    {
        "references" => "Reference {n}",
        _ => "{n}",
    }).Replace("{n}", (index + 1).ToString());

    private static string FgRemoveLabel(string path, int index) =>
        "Remove {label}".Replace("{label}", FgItemLabel(path, index));

    private async Task FgAddItem<T>(List<T> list, string path, int max) where T : class, new()
    {
        if (list.Count >= max) return;
        var item = new T();
        list.Add(item);
        fgFocusItem = item;
        await FgAnnounce("{label} added".Replace("{label}", FgItemLabel(path, list.Count - 1)));
    }

    private async Task FgRemoveItem<T>(List<T> list, string path, int index, int min, string[] fields) where T : class
    {
        if (list.Count <= min || index >= list.Count) return;
        var label = FgItemLabel(path, index);
        var item = list[index];
        foreach (var name in fields) fgMessages.Clear(new FieldIdentifier(item, name));
        fgItemRefs.Remove(item);
        list.RemoveAt(index);
        fgEdit.NotifyValidationStateChanged();
        if (list.Count > 0) fgFocusItem = list[Math.Min(index, list.Count - 1)];
        else fgFocusAdd = path;
        await FgAnnounce("{label} removed".Replace("{label}", label));
    }

    private async Task FgFocusRepeaters()
    {
        if (fgFocusItem != null && fgItemRefs.TryGetValue(fgFocusItem, out var itemRef))
        {
            fgFocusItem = null;
            await itemRef.FocusAsync();
        }
        else if (fgFocusAdd != null)
        {
            var path = fgFocusAdd;
            fgFocusAdd = null;
            var addRef = path switch
            {
                "references" => fgAddRef_references,
                _ => default,
            };
            if (addRef.Context != null) await addRef.FocusAsync();
        }
    }

    public sealed record FgUpload(string Name, long Size, string ContentType, byte[]? Data, string? Thumb);

    private readonly Dictionary<string, int> fgFileKeys = new() { ["AccountAvatar"] = 0, ["Attachments"] = 0 };
    private readonly Dictionary<string, InputFile> fgFileInputs = new();
    private string? fgFocusFile;

    private async Task FgPickFiles(List<FgUpload> list, InputFileChangeEventArgs e, bool multiple, long maxBytes, bool thumbs, string member)
    {
        var picked = new List<FgUpload>();
        foreach (var file in e.GetMultipleFiles(multiple ? int.MaxValue : 1))
        {
            byte[]? data = null;
            if (maxBytes <= 0 || file.Size <= maxBytes)
            {
                using var buffer = new System.IO.MemoryStream();
                await file.OpenReadStream(maxBytes > 0 ? maxBytes : long.MaxValue).CopyToAsync(buffer);
                data = buffer.ToArray();
            }
            string? thumb = null;
            if (thumbs && file.ContentType.StartsWith("image/"))
            {
                try
                {
                    var small = await file.RequestImageFileAsync("image/png", 80, 80);
                    using var buffer = new System.IO.MemoryStream();
                    await small.OpenReadStream(long.MaxValue).CopyToAsync(buffer);
                    thumb = "data:image/png;base64," + Convert.ToBase64String(buffer.ToArray());
                }
                catch (Exception) { }
            }
            picked.Add(new FgUpload(file.Name, file.Size, file.ContentType, data, thumb));
        }
        if (picked.Count == 0) return;
        if (!multiple) list.Clear();
        list.AddRange(picked);
        fgFileKeys[member]++;
        fgFocusFile = member;
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private void FgRemoveFile(List<FgUpload> list, FgUpload file, string member)
    {
        list.RemoveAll(f => ReferenceEquals(f, file));
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private static string FgFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024d))} KB";

    private static string FgRemoveFileLabel(string name) => "Remove {name}".Replace("{name}", name);

    /** Payload entry for an upload: { name, size, type } per file; the files become parts named by data path. */
    private static List<Dictionary<string, object?>> FgFilesPart(List<(string Path, FgUpload File)> parts, string path, List<FgUpload> files)
    {
        foreach (var file in files) parts.Add((path, file));
        return files.Select(f => new Dictionary<string, object?> { ["name"] = f.Name, ["size"] = f.Size, ["type"] = f.ContentType }).ToList();
    }

    private async Task FgFocusUploads()
    {
        if (fgFocusFile == null) return;
        var member = fgFocusFile;
        fgFocusFile = null;
        if (fgFileInputs.TryGetValue(member, out var input) && input.Element is ElementReference element) await element.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FgFocusRepeaters();
        await FgFocusUploads();
    }

    private async Task FgReset()
    {
        Model = new();
        FgInitEdit();
        fgItemRefs.Clear();
        fgDeferredFields.Clear();
        ResultJson = null;
        foreach (var key in fgTagDrafts.Keys.ToList()) fgTagDrafts[key] = "";
        await FgAnnounce("The form was reset.");
    }

    private static bool FgIsBlank(object? value) => value switch
    {
        null => true,
        string text => string.IsNullOrWhiteSpace(text),
        bool on => !on,
        System.Collections.ICollection list => list.Count == 0,
        _ => false,
    };

    private static bool FgAccepts(FgUpload file, string accept)
    {
        var name = file.Name.ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        return accept.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).Any(t =>
            t.StartsWith('.') ? name.EndsWith(t) : t.EndsWith("/*") ? type.StartsWith(t[..^1]) : type == t);
    }

    private async Task HandleValidSubmit()
    {
        var parts = new List<(string Path, FgUpload File)>();
        var payload = BuildPayload(parts);
        ResultJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await FgAnnounce("Form submitted.");
    }

    private Dictionary<string, object?> BuildPayload(List<(string Path, FgUpload File)> parts)
    {
        var payload = new Dictionary<string, object?>();
        payload["full_name"] = Model.FullName;
        payload["email"] = Model.Email;
        payload["website"] = Model.Website;
        payload["seats"] = Model.Seats;
        payload["satisfaction"] = Model.Satisfaction;
        payload["city"] = Model.City;
        payload["zip"] = Model.Zip;
        var dict0 = new Dictionary<string, object?>();
        dict0["username"] = Model.AccountUsername;
        dict0["password"] = Model.AccountPassword;
        dict0["bio"] = Model.AccountBio;
        dict0["birthday"] = Model.AccountBirthday;
        dict0["avatar"] = FgFilesPart(parts, "account.avatar", Model.AccountAvatar);
        payload["account"] = dict0;
        payload["plan"] = string.IsNullOrEmpty(Model.Plan) ? null : Model.Plan;
        payload["interests"] = Model.Interests;
        payload["channels"] = Model.Channels;
        payload["topics"] = Model.Topics;
        payload["billing"] = string.IsNullOrEmpty(Model.Billing) ? null : Model.Billing;
        payload["extras"] = Model.Extras;
        payload["notify"] = Model.Notify;
        payload["appointment"] = Model.Appointment;
        payload["brand_color"] = Model.BrandColor;
        payload["volume"] = Model.Volume;
        payload["source"] = Model.Source;
        var list1 = new List<Dictionary<string, object?>>();
        foreach (var item in Model.References)
        {
            var item1 = new Dictionary<string, object?>();
            item1["name"] = item.Name;
            item1["may_contact"] = item.MayContact;
            if ((Equals(item.MayContact, true))) item1["email"] = item.Email;
            list1.Add(item1);
        }
        payload["references"] = list1;
        payload["attachments"] = FgFilesPart(parts, "attachments", Model.Attachments);
        if (((!FgIsBlank(Model.Attachments)))) payload["attachments_note"] = Model.AttachmentsNote;
        payload["contact_method"] = string.IsNullOrEmpty(Model.ContactMethod) ? null : Model.ContactMethod;
        if (((Equals(Model.ContactMethod, "phone")))) payload["contact_phone"] = Model.ContactPhone;
        if (((Equals(Model.ContactMethod, "other")))) payload["contact_other"] = Model.ContactOther;
        payload["twitter"] = Model.Twitter;
        payload["github"] = Model.Github;
        payload["shipping_city"] = Model.ShippingCity;
        payload["order_notes"] = Model.OrderNotes;
        payload["newsletter"] = Model.Newsletter;
        payload["terms"] = Model.Terms;
        return payload;
    }

    public class KitchenSinkFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "This field is required")]
        [MinLength(2, ErrorMessage = "Must be at least 2")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Must be a valid email address")]
        public string Email { get; set; } = "";

        public string Website { get; set; } = "";

        public double? Seats { get; set; }

        public double Satisfaction { get; set; } = 5;

        public string City { get; set; } = "";

        [RegularExpression(@"^[0-9]{4,6}$", ErrorMessage = "Invalid format")]
        public string Zip { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [MinLength(3, ErrorMessage = "Must be between 3 and 20")]
        [MaxLength(20, ErrorMessage = "Must be between 3 and 20")]
        public string AccountUsername { get; set; } = "";

        public string AccountPassword { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Must be at most 200")]
        public string AccountBio { get; set; } = "";

        public string AccountBirthday { get; set; } = "";

        public List<FgUpload> AccountAvatar { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string Plan { get; set; } = "";

        public List<string> Interests { get; set; } = new();

        public string[] Channels { get; set; } = Array.Empty<string>();

        public List<string> Topics { get; set; } = new();

        public string Billing { get; set; } = "";

        public List<string> Extras { get; set; } = new();

        public bool Notify { get; set; } = true;

        public string Appointment { get; set; } = "";

        public string BrandColor { get; set; } = "#000000";

        public double Volume { get; set; } = 0;

        public string Source { get; set; } = "kitchen-sink";

        public List<FgUpload> Attachments { get; set; } = new();

        public string AttachmentsNote { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ContactMethod { get; set; } = "";

        public string ContactPhone { get; set; } = "";

        public string ContactOther { get; set; } = "";

        public string Twitter { get; set; } = "";

        public string Github { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ShippingCity { get; set; } = "";

        public string OrderNotes { get; set; } = "";

        public bool Newsletter { get; set; } = true;

        public bool Terms { get; set; }

        public List<FgReferencesItem> References { get; set; } = new() { new(), };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
        if (!(string.IsNullOrWhiteSpace(Website)) && (!Uri.TryCreate(Website, UriKind.Absolute, out _))) yield return new ValidationResult("Must be a valid URL", new[] { nameof(Website) });
        if (!(!Seats.HasValue) && (Seats!.Value < 1)) yield return new ValidationResult("Must be at least 1", new[] { nameof(Seats) });
        if (!(!Seats.HasValue) && (Seats!.Value > 50)) yield return new ValidationResult("Must be at most 50", new[] { nameof(Seats) });
        if (!(Topics.Count == 0) && (Topics.Count > 5)) yield return new ValidationResult("At most 5 topics", new[] { nameof(Topics) });
        if (Attachments.Count == 0) yield return new ValidationResult("This field is required", new[] { nameof(Attachments) });
        if (Attachments.Count > 3) yield return new ValidationResult("Choose at most 3 files", new[] { nameof(Attachments) });
        foreach (var file in Attachments)
        {
            if (!FgAccepts(file, ".pdf,.doc,.docx")) { yield return new ValidationResult("{name} is not an accepted file type".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
            if (file.Size > 5242880L) { yield return new ValidationResult("{name} is larger than 5 MB".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
        }
        if (!Terms) yield return new ValidationResult("This field is required", new[] { nameof(Terms) });
        }
    }

    public class FgReferencesItem
    {
        public string Name { get; set; } = "";
        public bool MayContact { get; set; }
        public string Email { get; set; } = "";
    }
}
"
`;

exports[`blazor target > snapshot (tailwind) 1`] = `
"@* Generated by FormsGen (.NET 8). *@
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms

<EditForm EditContext="fgEdit" OnSubmit="FgSubmit" novalidate dir="ltr">
    <div class="mx-auto max-w-2xl p-6 font-sans text-gray-900 dark:text-gray-100" @onpointerdown="FgPointerDown" @onpointerup="FgPointerEnd" @onpointerleave="FgPointerEnd" @onpointercancel="FgPointerEnd">
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 md:col-span-12 text-center">
          <h2 class="font-semibold text-indigo-600 dark:text-indigo-400">Kitchen Sink</h2>
        </div>
        <div class="col-span-12 md:col-span-12 text-center">
          <p class="text-sm text-gray-600 dark:text-gray-300">Every implemented element appears in this form.</p>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_full_name">Full name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputText id="fg_full_name" @bind-Value="Model.FullName" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" placeholder="Jane Doe" />
            <ValidationMessage For="@(() => Model.FullName)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_email">Email<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputText id="fg_email" type="email" @bind-Value="Model.Email" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" placeholder="jane&#64;example.com" />
            <ValidationMessage For="@(() => Model.Email)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_website">Website</label>
            <InputText id="fg_website" type="url" @bind-Value="Model.Website" class="w-full rounded-md border border-gray-300 bg-white px-2 py-1 text-xs shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
            <ValidationMessage For="@(() => Model.Website)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_seats">Seats</label>
            <InputNumber id="fg_seats" @bind-Value="Model.Seats" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
            <ValidationMessage For="@(() => Model.Seats)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" @bind="Model.Satisfaction" @bind:event="oninput" class="w-full accent-indigo-600" min="0" max="10" step="1" />
            <ValidationMessage For="@(() => Model.Satisfaction)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <hr class="border-t border-indigo-500" />
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="grid grid-cols-12 gap-4">
            <div class="col-span-12 md:col-span-6">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_city">City</label>
                <InputText id="fg_city" @bind-Value="Model.City" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                <ValidationMessage For="@(() => Model.City)" class="text-xs text-red-600" />
              </div>
            </div>
            <div class="col-span-12 md:col-span-6">
              <div class="flex flex-col gap-1.5">
                <label class="sr-only" for="fg_zip">ZIP</label>
                <InputText id="fg_zip" @bind-Value="Model.Zip" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                <ValidationMessage For="@(() => Model.Zip)" class="text-xs text-red-600" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-12 md:col-span-12 account-box">
          <fieldset class="rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50">
            <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">Account</legend>
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-semibold" for="fg_account_username">Username<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                  <InputText id="fg_account_username" @bind-Value="Model.AccountUsername" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                  <ValidationMessage For="@(() => Model.AccountUsername)" class="text-xs text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-semibold" for="fg_account_password">Password</label>
                  <InputText id="fg_account_password" type="password" @bind-Value="Model.AccountPassword" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                  <ValidationMessage For="@(() => Model.AccountPassword)" class="text-xs text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-semibold" for="fg_account_bio">Bio</label>
                  <InputTextArea id="fg_account_bio" @bind-Value="Model.AccountBio" class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="4" />
                  <ValidationMessage For="@(() => Model.AccountBio)" class="text-xs text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-semibold" for="fg_account_birthday">Birthday</label>
                  <InputText id="fg_account_birthday" type="date" @bind-Value="Model.AccountBirthday" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                  <ValidationMessage For="@(() => Model.AccountBirthday)" class="text-xs text-red-600" />
                </div>
              </div>
              <div class="col-span-12 md:col-span-12">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-semibold" for="fg_account_avatar">Profile picture</label>
                  <InputFile @key='fgFileKeys["AccountAvatar"]' @ref='fgFileInputs["AccountAvatar"]' id="fg_account_avatar" class="block w-full text-sm file:me-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white" accept="image/*" OnChange='@(e => FgPickFiles(Model.AccountAvatar, e, false, 2097152L, true, "AccountAvatar"))' />
                  @if (Model.AccountAvatar.Count > 0)
                  {
                      <ul class="flex flex-col gap-1.5">
                          @foreach (var file in Model.AccountAvatar.ToList())
                          {
                              <li @key="file" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                                  @if (file.Thumb != null)
                                  {
                                      <img class="h-10 w-10 rounded object-cover" src="@file.Thumb" alt="" width="40" height="40" />
                                  }
                                  <span class="min-w-0 flex-1 truncate">@file.Name</span>
                                  <span class="text-xs text-gray-500 dark:text-gray-400">@FgFileSize(file.Size)</span>
                                  <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.AccountAvatar, file, "AccountAvatar")'>×</button>
                              </li>
                          }
                      </ul>
                  }
                  <ValidationMessage For="@(() => Model.AccountAvatar)" class="text-xs text-red-600" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5">
            <legend class="text-sm font-semibold">Plan<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></legend>
            <InputRadioGroup @bind-Value="Model.Plan">
              <div class="flex flex-col gap-1.5">
                <label class="inline-flex items-center gap-2 text-sm" for="fg_plan_free">
                  <InputRadio id="fg_plan_free" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" Value="@("free")" />
                  <span>Free</span>
                </label>
                <label class="inline-flex items-center gap-2 text-sm" for="fg_plan_pro">
                  <InputRadio id="fg_plan_pro" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" Value="@("pro")" />
                  <span>Pro</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Plan)" class="text-xs text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5">
            <legend class="text-sm font-semibold">Interests</legend>
            <div class="flex flex-col gap-1.5">
              <label class="inline-flex items-center gap-2 text-sm" for="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked='@Model.Interests.Contains("news")' @onchange='e => FgToggle(Model.Interests, "news", e)' />
                <span>News</span>
              </label>
              <label class="inline-flex items-center gap-2 text-sm" for="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked='@Model.Interests.Contains("product")' @onchange='e => FgToggle(Model.Interests, "product", e)' />
                <span>Product updates</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Interests)" class="text-xs text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_channels">Notification channels</label>
            <InputSelect id="fg_channels" multiple @bind-Value="Model.Channels" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.Channels)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_topics">Topics</label>
            <div class="flex flex-wrap items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              @for (var i = 0; i < Model.Topics.Count; i++)
              {
                  var fgIdx_topics = i;
                  <span class="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">@Model.Topics[fgIdx_topics] <button type="button" class="text-gray-500 hover:text-red-600" aria-label="Remove @(Model.Topics[fgIdx_topics])" @onclick="() => Model.Topics.RemoveAt(fgIdx_topics)">&times;</button></span>
              }
              <input id="fg_topics" type="text" class="min-w-24 flex-1 border-none bg-transparent text-sm focus:outline-none" placeholder="Type and press Enter" @bind='fgTagDrafts["topics"]' @bind:after='() => FgAddTag(Model.Topics, "topics")'>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Free-text tags</p>
            <ValidationMessage For="@(() => Model.Topics)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5">
            <legend class="text-sm font-semibold">Billing</legend>
            <InputRadioGroup @bind-Value="Model.Billing">
              <div class="flex flex-wrap">
                <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing_monthly">
                  <InputRadio id="fg_billing_monthly" class="sr-only" Value="@("monthly")" />
                  <span>Monthly</span>
                </label>
                <label class="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" for="fg_billing_yearly">
                  <InputRadio id="fg_billing_yearly" class="sr-only" Value="@("yearly")" />
                  <span>Yearly</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Billing)" class="text-xs text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5">
            <legend class="text-sm font-semibold">Extras</legend>
            <div class="flex flex-col gap-2">
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-sm has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" for="fg_extras_support">
                <input id="fg_extras_support" type="checkbox" class="h-4 w-4 accent-indigo-600" checked='@Model.Extras.Contains("support")' @onchange='e => FgToggle(Model.Extras, "support", e)' />
                <span>Priority support</span>
              </label>
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-sm has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" for="fg_extras_backup">
                <input id="fg_extras_backup" type="checkbox" class="h-4 w-4 accent-indigo-600" checked='@Model.Extras.Contains("backup")' @onchange='e => FgToggle(Model.Extras, "backup", e)' />
                <span>Daily backups</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Extras)" class="text-xs text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_notify" role="switch" @bind-Value="Model.Notify" class="relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-gray-300 transition-colors before:absolute before:start-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-white before:shadow before:transition-all before:content-[''] checked:bg-indigo-600 checked:before:start-[1.125rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300 dark:bg-gray-600" />
              <label class="inline-flex items-center gap-2 text-sm" for="fg_notify">Email notifications</label>
            </div>
            <ValidationMessage For="@(() => Model.Notify)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_appointment">Appointment</label>
            <InputText id="fg_appointment" type="datetime-local" @bind-Value="Model.Appointment" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
            <ValidationMessage For="@(() => Model.Appointment)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_brand_color">Brand color</label>
            <InputText id="fg_brand_color" type="color" @bind-Value="Model.BrandColor" class="h-10 w-16 cursor-pointer rounded-md border border-gray-300 bg-white p-1 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
            <ValidationMessage For="@(() => Model.BrandColor)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_volume">Volume</label>
            <input id="fg_volume" type="range" @bind="Model.Volume" @bind:event="oninput" class="w-full accent-indigo-600" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" />
            <ValidationMessage For="@(() => Model.Volume)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="rounded-lg border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50" data-fg-repeater="references">
            <legend class="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">References</legend>
            <div class="flex flex-col gap-4">
              @foreach (var (item, i) in Model.References.Select((x, n) => (x, n)).ToList())
              {
                  <fieldset @key="item" class="min-w-0 rounded-lg border border-gray-300 p-4 dark:border-gray-600" data-fg-item tabindex="-1" @ref="fgItemRefs[item]">
                      <legend class="px-1 text-sm font-semibold">@FgItemLabel("references", i)</legend>
                      <div class="grid grid-cols-12 gap-4">
                        <div class="col-span-12 md:col-span-12">
                          <div class="flex flex-col gap-1.5">
                            <label class="text-sm font-semibold" for="@($"fg_references_{i}_name")">Name<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                            <InputText id="@($"fg_references_{i}_name")" @bind-Value="item.Name" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                            <ValidationMessage For="@(() => item.Name)" class="text-xs text-red-600" />
                          </div>
                        </div>
                        <div class="col-span-12 md:col-span-12">
                          <div class="flex flex-col gap-1.5">
                            <div class="flex items-center gap-2">
                              <InputCheckbox id="@($"fg_references_{i}_may_contact")" @bind-Value="item.MayContact" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
                              <label class="inline-flex items-center gap-2 text-sm" for="@($"fg_references_{i}_may_contact")">May we contact them?</label>
                            </div>
                            <ValidationMessage For="@(() => item.MayContact)" class="text-xs text-red-600" />
                          </div>
                        </div>
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="col-span-12 md:col-span-12">
                              <div class="flex flex-col gap-1.5">
                                <label class="text-sm font-semibold" for="@($"fg_references_{i}_email")">Their email</label>
                                <InputText id="@($"fg_references_{i}_email")" type="email" @bind-Value="item.Email" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                                <ValidationMessage For="@(() => item.Email)" class="text-xs text-red-600" />
                              </div>
                            </div>
                        }
                      </div>
                      <div class="mt-3 flex justify-end">
                          <button type="button" class="text-sm text-red-600 underline hover:text-red-700 dark:text-red-400" aria-label='@FgRemoveLabel("references", i)' @onclick='() => FgRemoveItem(Model.References, "references", i, 0, fgItemFields_references)'>Remove</button>
                      </div>
                  </fieldset>
              }
            </div>
            @if (Model.References.Count < 3)
            {
                <button type="button" class="mt-4 rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-add="references" @ref="fgAddRef_references" @onclick='() => FgAddItem(Model.References, "references", 3)'>Add reference</button>
            }
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_attachments">Attachments<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="block w-full text-sm file:me-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' />
            @if (Model.Attachments.Count > 0)
            {
                <ul class="flex flex-col gap-1.5">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                            <span class="min-w-0 flex-1 truncate">@file.Name</span>
                            <span class="text-xs text-gray-500 dark:text-gray-400">@FgFileSize(file.Size)</span>
                            <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            <p class="text-xs text-gray-500 dark:text-gray-400">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="text-xs text-red-600" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="text-xs text-red-600" />
              </div>
            </div>
        }
        <div class="col-span-12 md:col-span-12">
          <figure class="border-s-4 border-gray-300 ps-4 dark:border-gray-600">
            <blockquote class="text-base italic">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">FormsGen</figcaption>
          </figure>
        </div>
        <div class="col-span-12 md:col-span-12">
          <a class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold" for="fg_contact_method">Preferred contact method<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="text-xs text-red-600" />
          </div>
        </div>
        @if ((Equals(Model.ContactMethod, "phone")))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_contact_phone">Phone number</label>
                <InputText id="fg_contact_phone" type="tel" @bind-Value="Model.ContactPhone" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                <ValidationMessage For="@(() => Model.ContactPhone)" class="text-xs text-red-600" />
              </div>
            </div>
        }
        @if ((Equals(Model.ContactMethod, "other")))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-semibold" for="fg_contact_other">Describe your preferred method</label>
                <InputTextArea id="fg_contact_other" @bind-Value="Model.ContactOther" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                <ValidationMessage For="@(() => Model.ContactOther)" class="text-xs text-red-600" />
              </div>
            </div>
        }
        <div class="col-span-12 md:col-span-12">
          <div>
            <div class="mb-4 flex flex-wrap gap-1 border-b border-gray-200 dark:border-gray-700" role="tablist">
              <button type="button" class="@(fgSec_ks_social_tabs == 0 ? "-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600" : "-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700")" @onclick="() => fgSec_ks_social_tabs = 0">Social</button>
              <button type="button" class="@(fgSec_ks_social_tabs == 1 ? "-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600" : "-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700")" @onclick="() => fgSec_ks_social_tabs = 1">Code</button>
            </div>
          @if (fgSec_ks_social_tabs == 0)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-semibold" for="fg_twitter">Twitter handle</label>
                    <InputText id="fg_twitter" @bind-Value="Model.Twitter" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                    <ValidationMessage For="@(() => Model.Twitter)" class="text-xs text-red-600" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_social_tabs == 1)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-semibold" for="fg_github">GitHub username</label>
                    <InputText id="fg_github" @bind-Value="Model.Github" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                    <ValidationMessage For="@(() => Model.Github)" class="text-xs text-red-600" />
                  </div>
                </div>
              </div>
          }
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div>
            <ol class="mb-4 flex flex-wrap gap-4 text-sm text-gray-500">
              <li class="@(fgSec_ks_wizard == 0 ? "flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100" : "flex items-center gap-2")">1. Shipping</li>
              <li class="@(fgSec_ks_wizard == 1 ? "flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100" : "flex items-center gap-2")">2. Review</li>
            </ol>
          @if (fgSec_ks_wizard == 0)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-semibold" for="fg_shipping_city">Shipping city<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                    <InputText id="fg_shipping_city" @bind-Value="Model.ShippingCity" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" />
                    <ValidationMessage For="@(() => Model.ShippingCity)" class="text-xs text-red-600" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_wizard == 1)
          {
              <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 md:col-span-12">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-semibold" for="fg_order_notes">Order notes</label>
                    <InputTextArea id="fg_order_notes" @bind-Value="Model.OrderNotes" class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                    <ValidationMessage For="@(() => Model.OrderNotes)" class="text-xs text-red-600" />
                  </div>
                </div>
              </div>
          }
            <div class="mt-4 flex justify-between gap-2">
              @if (fgSec_ks_wizard > 0)
              {
                  <button type="button" class="rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @onclick="() => FgGo_ks_wizard(fgSec_ks_wizard - 1)">Back</button>
              }
              @if (fgSec_ks_wizard < 1)
              {
                  <button type="button" class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300" @onclick="FgNext_ks_wizard">Next</button>
              }
              @if (fgSec_ks_wizard == 1)
              {
                  <button class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300" type="submit">Submit</button>
              }
            </div>
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_newsletter" @bind-Value="Model.Newsletter" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
              <label class="inline-flex items-center gap-2 text-sm" for="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            <ValidationMessage For="@(() => Model.Newsletter)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2">
              <InputCheckbox id="fg_terms" @bind-Value="Model.Terms" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
              <label class="inline-flex items-center gap-2 text-sm" for="fg_terms">I accept the terms<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            </div>
            <ValidationMessage For="@(() => Model.Terms)" class="text-xs text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <button type="button" class="rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" @onclick="FgReset">Start over</button>
        </div>
    </div>
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">@fgAnnouncement</div>
    @if (ResultJson is not null)
    {
        <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-xs text-green-300">@ResultJson</pre>
    }
    </div>
</EditForm>

@code {
    private KitchenSinkFormModel Model { get; set; } = new();
    private string? ResultJson { get; set; }

    private int fgSec_ks_social_tabs = 0;
    private int fgSec_ks_wizard = 0;

    private EditContext fgEdit = default!;
    private ValidationMessageStore fgMessages = default!;
    private bool fgPressing;
    private readonly HashSet<string> fgDeferredFields = new();

    protected override void OnInitialized() => FgInitEdit();

    private void FgInitEdit()
    {
        fgEdit = new EditContext(Model);
        fgMessages = new ValidationMessageStore(fgEdit);
        fgEdit.OnValidationRequested += (_, _) => FgValidateAll();
        fgEdit.OnFieldChanged += (_, e) => FgFieldChanged(e.FieldIdentifier);
    }

    private void FgPointerDown(PointerEventArgs _)
    {
        FgFlushDeferred();
        fgPressing = true;
    }

    private void FgPointerEnd(PointerEventArgs _)
    {
        fgPressing = false;
        FgFlushDeferred();
    }

    private void FgFieldChanged(string name)
    {
        if (fgPressing)
        {
            fgDeferredFields.Add(name);
            return;
        }
        FgValidateMembers(new[] { name });
    }

    private void FgFlushDeferred()
    {
        if (fgDeferredItemFields.Count > 0)
        {
            var items = fgDeferredItemFields.ToArray();
            fgDeferredItemFields.Clear();
            foreach (var field in items) FgValidateItemField(field);
        }
        if (fgDeferredFields.Count == 0) return;
        var names = fgDeferredFields.ToArray();
        fgDeferredFields.Clear();
        FgValidateMembers(names);
    }

    private void FgValidateAll()
    {
        fgDeferredFields.Clear();
        fgMessages.Clear();
        FgValidateMembers(fgAllMembers);
        FgValidateRepeater_references();
    }

    private object? FgValue(string name) => name switch
    {
            "FullName" => Model.FullName,
            "Email" => Model.Email,
            "Website" => Model.Website,
            "Seats" => Model.Seats,
            "Satisfaction" => Model.Satisfaction,
            "City" => Model.City,
            "Zip" => Model.Zip,
            "AccountUsername" => Model.AccountUsername,
            "AccountPassword" => Model.AccountPassword,
            "AccountBio" => Model.AccountBio,
            "AccountBirthday" => Model.AccountBirthday,
            "AccountAvatar" => Model.AccountAvatar,
            "Plan" => Model.Plan,
            "Interests" => Model.Interests,
            "Channels" => Model.Channels,
            "Topics" => Model.Topics,
            "Billing" => Model.Billing,
            "Extras" => Model.Extras,
            "Notify" => Model.Notify,
            "Appointment" => Model.Appointment,
            "BrandColor" => Model.BrandColor,
            "Volume" => Model.Volume,
            "Source" => Model.Source,
            "Attachments" => Model.Attachments,
            "AttachmentsNote" => Model.AttachmentsNote,
            "ContactMethod" => Model.ContactMethod,
            "ContactPhone" => Model.ContactPhone,
            "ContactOther" => Model.ContactOther,
            "Twitter" => Model.Twitter,
            "Github" => Model.Github,
            "ShippingCity" => Model.ShippingCity,
            "OrderNotes" => Model.OrderNotes,
            "Newsletter" => Model.Newsletter,
            "Terms" => Model.Terms,
        _ => null,
    };

    // Attribute rules per property, plus the model's Validate() results for
    // the same members (DataAnnotations alone skips Validate() while any
    // attribute rule fails, which hid errors such as a required checkbox).
    private bool FgValidateMembers(string[] members)
    {
        var ok = true;
        foreach (var name in members)
        {
            var field = new FieldIdentifier(Model, name);
            fgMessages.Clear(field);
            var results = new List<ValidationResult>();
            var context = new ValidationContext(Model) { MemberName = name };
            if (!Validator.TryValidateProperty(FgValue(name), context, results)) ok = false;
            if (results.Count > 0) fgMessages.Add(field, results[0].ErrorMessage ?? "Invalid");
        }
        foreach (var result in ((IValidatableObject)Model).Validate(new ValidationContext(Model)))
        {
            foreach (var name in result.MemberNames)
            {
                if (Array.IndexOf(members, name) < 0) continue;
                ok = false;
                var field = new FieldIdentifier(Model, name);
                // One message per field (the first), as in the other targets.
                if (!fgMessages[field].Any()) fgMessages.Add(field, result.ErrorMessage ?? "Invalid");
            }
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private async Task FgSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await HandleValidSubmit();
            return;
        }
        await FgOnInvalidSubmit(context);
    }

    private string fgAnnouncement = "";

    private async Task FgAnnounce(string message)
    {
        fgAnnouncement = "";
        StateHasChanged();
        await Task.Delay(50);
        fgAnnouncement = message;
        StateHasChanged();
    }

    private static readonly Dictionary<string, string> fgErrorForms = new() { ["one"] = "1 error. Please fix the highlighted fields.", ["other"] = "{n} errors. Please fix the highlighted fields." };

    private static string FgErrorsText(int count)
    {
        var category = count == 1 ? "one" : "other";
        var text = fgErrorForms.TryGetValue(category, out var form) ? form : fgErrorForms["other"];
        return text.Replace("{n}", count.ToString());
    }

    private static readonly string[] fgAllMembers =
    {
        "FullName",
        "Email",
        "Website",
        "Seats",
        "Satisfaction",
        "City",
        "Zip",
        "AccountUsername",
        "AccountPassword",
        "AccountBio",
        "AccountBirthday",
        "AccountAvatar",
        "Plan",
        "Interests",
        "Channels",
        "Topics",
        "Billing",
        "Extras",
        "Notify",
        "Appointment",
        "BrandColor",
        "Volume",
        "Source",
        "Attachments",
        "AttachmentsNote",
        "ContactMethod",
        "ContactPhone",
        "ContactOther",
        "Twitter",
        "Github",
        "ShippingCity",
        "OrderNotes",
        "Newsletter",
        "Terms",
    };

    private async Task FgOnInvalidSubmit(EditContext context)
    {
        FgJumpToError();
        var count = fgAllMembers.Count(m => context.GetValidationMessages(new FieldIdentifier(Model, m)).Any()) + FgItemErrorCount();
        await FgAnnounce(FgErrorsText(count));
    }

    private static readonly string[] fgSecAnnounce_ks_wizard =
    {
        "Step 1 of 2: Shipping",
        "Step 2 of 2: Review",
    };

    private async Task FgGo_ks_wizard(int index)
    {
        fgSec_ks_wizard = index;
        await FgAnnounce(fgSecAnnounce_ks_wizard[index]);
    }

    private async Task FgNext_ks_wizard()
    {
        var members = fgSec_ks_wizard switch
        {
            0 => new[] { nameof(KitchenSinkFormModel.ShippingCity) },
            1 => new[] { nameof(KitchenSinkFormModel.OrderNotes) },
            _ => Array.Empty<string>(),
        };
        if (FgValidateMembers(members) && fgSec_ks_wizard < 1) await FgGo_ks_wizard(fgSec_ks_wizard + 1);
    }

    private static readonly string[][] fgSecMembers_ks_social_tabs =
    {
        new[] { "Twitter" },
        new[] { "Github" },
    };

    private static readonly string[][] fgSecMembers_ks_wizard =
    {
        new[] { "ShippingCity" },
        new[] { "OrderNotes" },
    };

    private bool FgHasMessages(string[] members)
    {
        foreach (var name in members)
        {
            if (fgEdit.GetValidationMessages(new FieldIdentifier(Model, name)).Any()) return true;
        }
        return false;
    }

    private void FgJumpToError()
    {
        if (!FgHasMessages(fgSecMembers_ks_social_tabs[fgSec_ks_social_tabs]))
        {
            for (var i = 0; i < fgSecMembers_ks_social_tabs.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_social_tabs[i])) { fgSec_ks_social_tabs = i; break; }
            }
        }
        if (!FgHasMessages(fgSecMembers_ks_wizard[fgSec_ks_wizard]))
        {
            for (var i = 0; i < fgSecMembers_ks_wizard.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_wizard[i])) { fgSec_ks_wizard = i; break; }
            }
        }
    }

    private static void FgToggle(List<string> list, string value, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on) { if (!list.Contains(value)) list.Add(value); }
        else { list.Remove(value); }
    }

    private readonly Dictionary<string, string> fgTagDrafts = new() { ["topics"] = "" };

    private void FgAddTag(List<string> list, string key)
    {
        var draft = (fgTagDrafts.TryGetValue(key, out var value) ? value : "").Trim();
        if (draft.Length > 0 && !list.Contains(draft)) list.Add(draft);
        fgTagDrafts[key] = "";
    }

    private static readonly string[] fgItemFields_references = { "Name", "Email" };
    private ElementReference fgAddRef_references;

    private bool FgRepeaterHasErrors_references() =>
        Model.References.Any(item => fgItemFields_references.Any(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any()));

    private bool FgValidateRepeater_references()
    {
        var ok = true;
        foreach (var item in Model.References)
        {
            foreach (var name in fgItemFields_references) ok &= FgValidateItemField(new FieldIdentifier(item, name), false);
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private readonly HashSet<FieldIdentifier> fgDeferredItemFields = new();
    private readonly Dictionary<object, ElementReference> fgItemRefs = new();
    private object? fgFocusItem;
    private string? fgFocusAdd;

    private void FgFieldChanged(FieldIdentifier field)
    {
        if (ReferenceEquals(field.Model, Model))
        {
            FgFieldChanged(field.FieldName);
            return;
        }
        if (fgPressing)
        {
            fgDeferredItemFields.Add(field);
            return;
        }
        FgValidateItemField(field);
    }

    /** First rule violation of an item field (null when valid or hidden). */
    private string? FgItemError(object model, string name)
    {
        switch (model)
        {
            case FgReferencesItem item:
                switch (name)
                {
                    case "Name":
                    {
                        if (string.IsNullOrWhiteSpace(item.Name)) return "This field is required";
                        return null;
                    }
                    case "Email":
                    {
                        if (!((Equals(item.MayContact, true)))) return null;
                        if (!(string.IsNullOrWhiteSpace(item.Email)) && (!System.Text.RegularExpressions.Regex.IsMatch(item.Email, @"^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))) return "Must be a valid email address";
                        return null;
                    }
                }
                break;
        }
        return null;
    }

    private bool FgValidateItemField(FieldIdentifier field, bool notify = true)
    {
        fgMessages.Clear(field);
        var error = FgItemError(field.Model, field.FieldName);
        if (error != null) fgMessages.Add(field, error);
        if (notify) fgEdit.NotifyValidationStateChanged();
        return error == null;
    }

    private int FgItemErrorCount()
    {
        var count = 0;
        foreach (var item in Model.References) count += fgItemFields_references.Count(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any());
        return count;
    }

    private static string FgItemLabel(string path, int index) => (path switch
    {
        "references" => "Reference {n}",
        _ => "{n}",
    }).Replace("{n}", (index + 1).ToString());

    private static string FgRemoveLabel(string path, int index) =>
        "Remove {label}".Replace("{label}", FgItemLabel(path, index));

    private async Task FgAddItem<T>(List<T> list, string path, int max) where T : class, new()
    {
        if (list.Count >= max) return;
        var item = new T();
        list.Add(item);
        fgFocusItem = item;
        await FgAnnounce("{label} added".Replace("{label}", FgItemLabel(path, list.Count - 1)));
    }

    private async Task FgRemoveItem<T>(List<T> list, string path, int index, int min, string[] fields) where T : class
    {
        if (list.Count <= min || index >= list.Count) return;
        var label = FgItemLabel(path, index);
        var item = list[index];
        foreach (var name in fields) fgMessages.Clear(new FieldIdentifier(item, name));
        fgItemRefs.Remove(item);
        list.RemoveAt(index);
        fgEdit.NotifyValidationStateChanged();
        if (list.Count > 0) fgFocusItem = list[Math.Min(index, list.Count - 1)];
        else fgFocusAdd = path;
        await FgAnnounce("{label} removed".Replace("{label}", label));
    }

    private async Task FgFocusRepeaters()
    {
        if (fgFocusItem != null && fgItemRefs.TryGetValue(fgFocusItem, out var itemRef))
        {
            fgFocusItem = null;
            await itemRef.FocusAsync();
        }
        else if (fgFocusAdd != null)
        {
            var path = fgFocusAdd;
            fgFocusAdd = null;
            var addRef = path switch
            {
                "references" => fgAddRef_references,
                _ => default,
            };
            if (addRef.Context != null) await addRef.FocusAsync();
        }
    }

    public sealed record FgUpload(string Name, long Size, string ContentType, byte[]? Data, string? Thumb);

    private readonly Dictionary<string, int> fgFileKeys = new() { ["AccountAvatar"] = 0, ["Attachments"] = 0 };
    private readonly Dictionary<string, InputFile> fgFileInputs = new();
    private string? fgFocusFile;

    private async Task FgPickFiles(List<FgUpload> list, InputFileChangeEventArgs e, bool multiple, long maxBytes, bool thumbs, string member)
    {
        var picked = new List<FgUpload>();
        foreach (var file in e.GetMultipleFiles(multiple ? int.MaxValue : 1))
        {
            byte[]? data = null;
            if (maxBytes <= 0 || file.Size <= maxBytes)
            {
                using var buffer = new System.IO.MemoryStream();
                await file.OpenReadStream(maxBytes > 0 ? maxBytes : long.MaxValue).CopyToAsync(buffer);
                data = buffer.ToArray();
            }
            string? thumb = null;
            if (thumbs && file.ContentType.StartsWith("image/"))
            {
                try
                {
                    var small = await file.RequestImageFileAsync("image/png", 80, 80);
                    using var buffer = new System.IO.MemoryStream();
                    await small.OpenReadStream(long.MaxValue).CopyToAsync(buffer);
                    thumb = "data:image/png;base64," + Convert.ToBase64String(buffer.ToArray());
                }
                catch (Exception) { }
            }
            picked.Add(new FgUpload(file.Name, file.Size, file.ContentType, data, thumb));
        }
        if (picked.Count == 0) return;
        if (!multiple) list.Clear();
        list.AddRange(picked);
        fgFileKeys[member]++;
        fgFocusFile = member;
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private void FgRemoveFile(List<FgUpload> list, FgUpload file, string member)
    {
        list.RemoveAll(f => ReferenceEquals(f, file));
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private static string FgFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024d))} KB";

    private static string FgRemoveFileLabel(string name) => "Remove {name}".Replace("{name}", name);

    /** Payload entry for an upload: { name, size, type } per file; the files become parts named by data path. */
    private static List<Dictionary<string, object?>> FgFilesPart(List<(string Path, FgUpload File)> parts, string path, List<FgUpload> files)
    {
        foreach (var file in files) parts.Add((path, file));
        return files.Select(f => new Dictionary<string, object?> { ["name"] = f.Name, ["size"] = f.Size, ["type"] = f.ContentType }).ToList();
    }

    private async Task FgFocusUploads()
    {
        if (fgFocusFile == null) return;
        var member = fgFocusFile;
        fgFocusFile = null;
        if (fgFileInputs.TryGetValue(member, out var input) && input.Element is ElementReference element) await element.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FgFocusRepeaters();
        await FgFocusUploads();
    }

    private async Task FgReset()
    {
        Model = new();
        FgInitEdit();
        fgItemRefs.Clear();
        fgDeferredFields.Clear();
        ResultJson = null;
        foreach (var key in fgTagDrafts.Keys.ToList()) fgTagDrafts[key] = "";
        await FgAnnounce("The form was reset.");
    }

    private static bool FgIsBlank(object? value) => value switch
    {
        null => true,
        string text => string.IsNullOrWhiteSpace(text),
        bool on => !on,
        System.Collections.ICollection list => list.Count == 0,
        _ => false,
    };

    private static bool FgAccepts(FgUpload file, string accept)
    {
        var name = file.Name.ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        return accept.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).Any(t =>
            t.StartsWith('.') ? name.EndsWith(t) : t.EndsWith("/*") ? type.StartsWith(t[..^1]) : type == t);
    }

    private async Task HandleValidSubmit()
    {
        var parts = new List<(string Path, FgUpload File)>();
        var payload = BuildPayload(parts);
        ResultJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await FgAnnounce("Form submitted.");
    }

    private Dictionary<string, object?> BuildPayload(List<(string Path, FgUpload File)> parts)
    {
        var payload = new Dictionary<string, object?>();
        payload["full_name"] = Model.FullName;
        payload["email"] = Model.Email;
        payload["website"] = Model.Website;
        payload["seats"] = Model.Seats;
        payload["satisfaction"] = Model.Satisfaction;
        payload["city"] = Model.City;
        payload["zip"] = Model.Zip;
        var dict0 = new Dictionary<string, object?>();
        dict0["username"] = Model.AccountUsername;
        dict0["password"] = Model.AccountPassword;
        dict0["bio"] = Model.AccountBio;
        dict0["birthday"] = Model.AccountBirthday;
        dict0["avatar"] = FgFilesPart(parts, "account.avatar", Model.AccountAvatar);
        payload["account"] = dict0;
        payload["plan"] = string.IsNullOrEmpty(Model.Plan) ? null : Model.Plan;
        payload["interests"] = Model.Interests;
        payload["channels"] = Model.Channels;
        payload["topics"] = Model.Topics;
        payload["billing"] = string.IsNullOrEmpty(Model.Billing) ? null : Model.Billing;
        payload["extras"] = Model.Extras;
        payload["notify"] = Model.Notify;
        payload["appointment"] = Model.Appointment;
        payload["brand_color"] = Model.BrandColor;
        payload["volume"] = Model.Volume;
        payload["source"] = Model.Source;
        var list1 = new List<Dictionary<string, object?>>();
        foreach (var item in Model.References)
        {
            var item1 = new Dictionary<string, object?>();
            item1["name"] = item.Name;
            item1["may_contact"] = item.MayContact;
            if ((Equals(item.MayContact, true))) item1["email"] = item.Email;
            list1.Add(item1);
        }
        payload["references"] = list1;
        payload["attachments"] = FgFilesPart(parts, "attachments", Model.Attachments);
        if (((!FgIsBlank(Model.Attachments)))) payload["attachments_note"] = Model.AttachmentsNote;
        payload["contact_method"] = string.IsNullOrEmpty(Model.ContactMethod) ? null : Model.ContactMethod;
        if (((Equals(Model.ContactMethod, "phone")))) payload["contact_phone"] = Model.ContactPhone;
        if (((Equals(Model.ContactMethod, "other")))) payload["contact_other"] = Model.ContactOther;
        payload["twitter"] = Model.Twitter;
        payload["github"] = Model.Github;
        payload["shipping_city"] = Model.ShippingCity;
        payload["order_notes"] = Model.OrderNotes;
        payload["newsletter"] = Model.Newsletter;
        payload["terms"] = Model.Terms;
        return payload;
    }

    public class KitchenSinkFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "This field is required")]
        [MinLength(2, ErrorMessage = "Must be at least 2")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Must be a valid email address")]
        public string Email { get; set; } = "";

        public string Website { get; set; } = "";

        public double? Seats { get; set; }

        public double Satisfaction { get; set; } = 5;

        public string City { get; set; } = "";

        [RegularExpression(@"^[0-9]{4,6}$", ErrorMessage = "Invalid format")]
        public string Zip { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [MinLength(3, ErrorMessage = "Must be between 3 and 20")]
        [MaxLength(20, ErrorMessage = "Must be between 3 and 20")]
        public string AccountUsername { get; set; } = "";

        public string AccountPassword { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Must be at most 200")]
        public string AccountBio { get; set; } = "";

        public string AccountBirthday { get; set; } = "";

        public List<FgUpload> AccountAvatar { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string Plan { get; set; } = "";

        public List<string> Interests { get; set; } = new();

        public string[] Channels { get; set; } = Array.Empty<string>();

        public List<string> Topics { get; set; } = new();

        public string Billing { get; set; } = "";

        public List<string> Extras { get; set; } = new();

        public bool Notify { get; set; } = true;

        public string Appointment { get; set; } = "";

        public string BrandColor { get; set; } = "#000000";

        public double Volume { get; set; } = 0;

        public string Source { get; set; } = "kitchen-sink";

        public List<FgUpload> Attachments { get; set; } = new();

        public string AttachmentsNote { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ContactMethod { get; set; } = "";

        public string ContactPhone { get; set; } = "";

        public string ContactOther { get; set; } = "";

        public string Twitter { get; set; } = "";

        public string Github { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ShippingCity { get; set; } = "";

        public string OrderNotes { get; set; } = "";

        public bool Newsletter { get; set; } = true;

        public bool Terms { get; set; }

        public List<FgReferencesItem> References { get; set; } = new() { new(), };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
        if (!(string.IsNullOrWhiteSpace(Website)) && (!Uri.TryCreate(Website, UriKind.Absolute, out _))) yield return new ValidationResult("Must be a valid URL", new[] { nameof(Website) });
        if (!(!Seats.HasValue) && (Seats!.Value < 1)) yield return new ValidationResult("Must be at least 1", new[] { nameof(Seats) });
        if (!(!Seats.HasValue) && (Seats!.Value > 50)) yield return new ValidationResult("Must be at most 50", new[] { nameof(Seats) });
        if (!(Topics.Count == 0) && (Topics.Count > 5)) yield return new ValidationResult("At most 5 topics", new[] { nameof(Topics) });
        if (Attachments.Count == 0) yield return new ValidationResult("This field is required", new[] { nameof(Attachments) });
        if (Attachments.Count > 3) yield return new ValidationResult("Choose at most 3 files", new[] { nameof(Attachments) });
        foreach (var file in Attachments)
        {
            if (!FgAccepts(file, ".pdf,.doc,.docx")) { yield return new ValidationResult("{name} is not an accepted file type".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
            if (file.Size > 5242880L) { yield return new ValidationResult("{name} is larger than 5 MB".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
        }
        if (!Terms) yield return new ValidationResult("This field is required", new[] { nameof(Terms) });
        }
    }

    public class FgReferencesItem
    {
        public string Name { get; set; } = "";
        public bool MayContact { get; set; }
        public string Email { get; set; } = "";
    }
}
"
`;

exports[`blazor target > snapshot (vanilla) 1`] = `
"@* Generated by FormsGen (.NET 8). *@
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms

<EditForm EditContext="fgEdit" OnSubmit="FgSubmit" novalidate dir="ltr">
    <div class="fg-form" @onpointerdown="FgPointerDown" @onpointerup="FgPointerEnd" @onpointerleave="FgPointerEnd" @onpointercancel="FgPointerEnd">
    <div class="fg-grid">
        <div class="fg-cell fg-align-center" style="grid-column: span 12 / span 12">
          <h2 class="fg-heading fg-tone-primary">Kitchen Sink</h2>
        </div>
        <div class="fg-cell fg-align-center" style="grid-column: span 12 / span 12">
          <p class="fg-paragraph">Every implemented element appears in this form.</p>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_full_name">Full name<span class="fg-required" aria-hidden="true">*</span></label>
            <InputText id="fg_full_name" @bind-Value="Model.FullName" class="fg-input" placeholder="Jane Doe" />
            <ValidationMessage For="@(() => Model.FullName)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_email">Email<span class="fg-required" aria-hidden="true">*</span></label>
            <InputText id="fg_email" type="email" @bind-Value="Model.Email" class="fg-input" placeholder="jane&#64;example.com" />
            <ValidationMessage For="@(() => Model.Email)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_website">Website</label>
            <InputText id="fg_website" type="url" @bind-Value="Model.Website" class="fg-input fg-control--sm" />
            <ValidationMessage For="@(() => Model.Website)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_seats">Seats</label>
            <InputNumber id="fg_seats" @bind-Value="Model.Seats" class="fg-input" />
            <ValidationMessage For="@(() => Model.Seats)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" @bind="Model.Satisfaction" @bind:event="oninput" class="fg-range" min="0" max="10" step="1" />
            <ValidationMessage For="@(() => Model.Satisfaction)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <hr class="fg-divider fg-tone-primary" />
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 6 / span 6">
              <div class="fg-field">
                <label class="fg-label" for="fg_city">City</label>
                <InputText id="fg_city" @bind-Value="Model.City" class="fg-input" />
                <ValidationMessage For="@(() => Model.City)" class="fg-error" />
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 6 / span 6">
              <div class="fg-field">
                <label class="fg-sr-only" for="fg_zip">ZIP</label>
                <InputText id="fg_zip" @bind-Value="Model.Zip" class="fg-input" />
                <ValidationMessage For="@(() => Model.Zip)" class="fg-error" />
              </div>
            </div>
          </div>
        </div>
        <div class="fg-cell account-box" style="grid-column: span 12 / span 12">
          <fieldset class="fg-group">
            <legend class="fg-group-label">Account</legend>
            <div class="fg-grid">
              <div class="fg-cell" style="grid-column: span 12 / span 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_account_username">Username<span class="fg-required" aria-hidden="true">*</span></label>
                  <InputText id="fg_account_username" @bind-Value="Model.AccountUsername" class="fg-input" />
                  <ValidationMessage For="@(() => Model.AccountUsername)" class="fg-error" />
                </div>
              </div>
              <div class="fg-cell" style="grid-column: span 12 / span 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_account_password">Password</label>
                  <InputText id="fg_account_password" type="password" @bind-Value="Model.AccountPassword" class="fg-input" />
                  <ValidationMessage For="@(() => Model.AccountPassword)" class="fg-error" />
                </div>
              </div>
              <div class="fg-cell" style="grid-column: span 12 / span 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_account_bio">Bio</label>
                  <InputTextArea id="fg_account_bio" @bind-Value="Model.AccountBio" class="fg-textarea fg-control--lg" rows="4" />
                  <ValidationMessage For="@(() => Model.AccountBio)" class="fg-error" />
                </div>
              </div>
              <div class="fg-cell" style="grid-column: span 12 / span 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_account_birthday">Birthday</label>
                  <InputText id="fg_account_birthday" type="date" @bind-Value="Model.AccountBirthday" class="fg-input" />
                  <ValidationMessage For="@(() => Model.AccountBirthday)" class="fg-error" />
                </div>
              </div>
              <div class="fg-cell" style="grid-column: span 12 / span 12">
                <div class="fg-field">
                  <label class="fg-label" for="fg_account_avatar">Profile picture</label>
                  <InputFile @key='fgFileKeys["AccountAvatar"]' @ref='fgFileInputs["AccountAvatar"]' id="fg_account_avatar" class="fg-file-input" accept="image/*" OnChange='@(e => FgPickFiles(Model.AccountAvatar, e, false, 2097152L, true, "AccountAvatar"))' />
                  @if (Model.AccountAvatar.Count > 0)
                  {
                      <ul class="fg-file-list">
                          @foreach (var file in Model.AccountAvatar.ToList())
                          {
                              <li @key="file" class="fg-file-item">
                                  @if (file.Thumb != null)
                                  {
                                      <img class="fg-file-thumb" src="@file.Thumb" alt="" width="40" height="40" />
                                  }
                                  <span class="fg-file-name">@file.Name</span>
                                  <span class="fg-file-size">@FgFileSize(file.Size)</span>
                                  <button type="button" class="fg-file-remove" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.AccountAvatar, file, "AccountAvatar")'>×</button>
                              </li>
                          }
                      </ul>
                  }
                  <ValidationMessage For="@(() => Model.AccountAvatar)" class="fg-error" />
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Plan<span class="fg-required" aria-hidden="true">*</span></legend>
            <InputRadioGroup @bind-Value="Model.Plan">
              <div class="fg-options">
                <label class="fg-option" for="fg_plan_free">
                  <InputRadio id="fg_plan_free" class="fg-checkbox" Value="@("free")" />
                  <span>Free</span>
                </label>
                <label class="fg-option" for="fg_plan_pro">
                  <InputRadio id="fg_plan_pro" class="fg-checkbox" Value="@("pro")" />
                  <span>Pro</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Plan)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Interests</legend>
            <div class="fg-options">
              <label class="fg-option" for="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" class="fg-checkbox" checked='@Model.Interests.Contains("news")' @onchange='e => FgToggle(Model.Interests, "news", e)' />
                <span>News</span>
              </label>
              <label class="fg-option" for="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" class="fg-checkbox" checked='@Model.Interests.Contains("product")' @onchange='e => FgToggle(Model.Interests, "product", e)' />
                <span>Product updates</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Interests)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_channels">Notification channels</label>
            <InputSelect id="fg_channels" multiple @bind-Value="Model.Channels" class="fg-select">
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.Channels)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_topics">Topics</label>
            <div class="fg-tags">
              @for (var i = 0; i < Model.Topics.Count; i++)
              {
                  var fgIdx_topics = i;
                  <span class="fg-tag">@Model.Topics[fgIdx_topics] <button type="button" class="fg-tag-remove" aria-label="Remove @(Model.Topics[fgIdx_topics])" @onclick="() => Model.Topics.RemoveAt(fgIdx_topics)">&times;</button></span>
              }
              <input id="fg_topics" type="text" class="fg-tags-input" placeholder="Type and press Enter" @bind='fgTagDrafts["topics"]' @bind:after='() => FgAddTag(Model.Topics, "topics")'>
            </div>
            <p class="fg-description">Free-text tags</p>
            <ValidationMessage For="@(() => Model.Topics)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Billing</legend>
            <InputRadioGroup @bind-Value="Model.Billing">
              <div class="fg-options fg-options--buttons">
                <label class="fg-option fg-option--button" for="fg_billing_monthly">
                  <InputRadio id="fg_billing_monthly" class="fg-sr-only" Value="@("monthly")" />
                  <span>Monthly</span>
                </label>
                <label class="fg-option fg-option--button" for="fg_billing_yearly">
                  <InputRadio id="fg_billing_yearly" class="fg-sr-only" Value="@("yearly")" />
                  <span>Yearly</span>
                </label>
              </div>
            </InputRadioGroup>
            <ValidationMessage For="@(() => Model.Billing)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Extras</legend>
            <div class="fg-options fg-options--blocks">
              <label class="fg-option fg-option--block" for="fg_extras_support">
                <input id="fg_extras_support" type="checkbox" class="fg-checkbox" checked='@Model.Extras.Contains("support")' @onchange='e => FgToggle(Model.Extras, "support", e)' />
                <span>Priority support</span>
              </label>
              <label class="fg-option fg-option--block" for="fg_extras_backup">
                <input id="fg_extras_backup" type="checkbox" class="fg-checkbox" checked='@Model.Extras.Contains("backup")' @onchange='e => FgToggle(Model.Extras, "backup", e)' />
                <span>Daily backups</span>
              </label>
            </div>
            <ValidationMessage For="@(() => Model.Extras)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <div class="fg-checkbox-row">
              <InputCheckbox id="fg_notify" role="switch" @bind-Value="Model.Notify" class="fg-switch" />
              <label class="fg-checkbox-label" for="fg_notify">Email notifications</label>
            </div>
            <ValidationMessage For="@(() => Model.Notify)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_appointment">Appointment</label>
            <InputText id="fg_appointment" type="datetime-local" @bind-Value="Model.Appointment" class="fg-input" />
            <ValidationMessage For="@(() => Model.Appointment)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_brand_color">Brand color</label>
            <InputText id="fg_brand_color" type="color" @bind-Value="Model.BrandColor" class="fg-input fg-input--color" />
            <ValidationMessage For="@(() => Model.BrandColor)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_volume">Volume</label>
            <input id="fg_volume" type="range" @bind="Model.Volume" @bind:event="oninput" class="fg-range" min="0" max="10" step="1" aria-orientation="vertical" style="writing-mode: vertical-lr; direction: rtl; align-self: flex-start; width: auto; height: 10rem" />
            <ValidationMessage For="@(() => Model.Volume)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <fieldset class="fg-group" data-fg-repeater="references">
            <legend class="fg-group-label">References</legend>
            <div class="fg-repeater-items">
              @foreach (var (item, i) in Model.References.Select((x, n) => (x, n)).ToList())
              {
                  <fieldset @key="item" class="fg-repeater-item" data-fg-item tabindex="-1" @ref="fgItemRefs[item]">
                      <legend class="fg-repeater-item-label">@FgItemLabel("references", i)</legend>
                      <div class="fg-grid">
                        <div class="fg-cell" style="grid-column: span 12 / span 12">
                          <div class="fg-field">
                            <label class="fg-label" for="@($"fg_references_{i}_name")">Name<span class="fg-required" aria-hidden="true">*</span></label>
                            <InputText id="@($"fg_references_{i}_name")" @bind-Value="item.Name" class="fg-input" />
                            <ValidationMessage For="@(() => item.Name)" class="fg-error" />
                          </div>
                        </div>
                        <div class="fg-cell" style="grid-column: span 12 / span 12">
                          <div class="fg-field">
                            <div class="fg-checkbox-row">
                              <InputCheckbox id="@($"fg_references_{i}_may_contact")" @bind-Value="item.MayContact" class="fg-checkbox" />
                              <label class="fg-checkbox-label" for="@($"fg_references_{i}_may_contact")">May we contact them?</label>
                            </div>
                            <ValidationMessage For="@(() => item.MayContact)" class="fg-error" />
                          </div>
                        </div>
                        @if ((Equals(item.MayContact, true)))
                        {
                            <div class="fg-cell" style="grid-column: span 12 / span 12">
                              <div class="fg-field">
                                <label class="fg-label" for="@($"fg_references_{i}_email")">Their email</label>
                                <InputText id="@($"fg_references_{i}_email")" type="email" @bind-Value="item.Email" class="fg-input" />
                                <ValidationMessage For="@(() => item.Email)" class="fg-error" />
                              </div>
                            </div>
                        }
                      </div>
                      <div class="fg-repeater-item-actions">
                          <button type="button" class="fg-repeater-remove" aria-label='@FgRemoveLabel("references", i)' @onclick='() => FgRemoveItem(Model.References, "references", i, 0, fgItemFields_references)'>Remove</button>
                      </div>
                  </fieldset>
              }
            </div>
            @if (Model.References.Count < 3)
            {
                <button type="button" class="fg-button fg-button--secondary fg-repeater-add" data-fg-add="references" @ref="fgAddRef_references" @onclick='() => FgAddItem(Model.References, "references", 3)'>Add reference</button>
            }
          </fieldset>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_attachments">Attachments<span class="fg-required" aria-hidden="true">*</span></label>
            <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="fg-file-input" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' />
            @if (Model.Attachments.Count > 0)
            {
                <ul class="fg-file-list">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="fg-file-item">
                            <span class="fg-file-name">@file.Name</span>
                            <span class="fg-file-size">@FgFileSize(file.Size)</span>
                            <button type="button" class="fg-file-remove" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            <p class="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="fg-error" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="fg-textarea" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="fg-error" />
              </div>
            </div>
        }
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <figure class="fg-quote">
            <blockquote class="fg-quote-text">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="fg-quote-cite">FormsGen</figcaption>
          </figure>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <a class="fg-link" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="fg-sr-only"> (opens in a new tab)</span></a>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_contact_method">Preferred contact method<span class="fg-required" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="fg-select">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="fg-error" />
          </div>
        </div>
        @if ((Equals(Model.ContactMethod, "phone")))
        {
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_contact_phone">Phone number</label>
                <InputText id="fg_contact_phone" type="tel" @bind-Value="Model.ContactPhone" class="fg-input" />
                <ValidationMessage For="@(() => Model.ContactPhone)" class="fg-error" />
              </div>
            </div>
        }
        @if ((Equals(Model.ContactMethod, "other")))
        {
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_contact_other">Describe your preferred method</label>
                <InputTextArea id="fg_contact_other" @bind-Value="Model.ContactOther" class="fg-textarea" rows="3" />
                <ValidationMessage For="@(() => Model.ContactOther)" class="fg-error" />
              </div>
            </div>
        }
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div>
            <div class="fg-tab-list" role="tablist">
              <button type="button" class="@(fgSec_ks_social_tabs == 0 ? "fg-tab-button fg-tab-button--active" : "fg-tab-button")" @onclick="() => fgSec_ks_social_tabs = 0">Social</button>
              <button type="button" class="@(fgSec_ks_social_tabs == 1 ? "fg-tab-button fg-tab-button--active" : "fg-tab-button")" @onclick="() => fgSec_ks_social_tabs = 1">Code</button>
            </div>
          @if (fgSec_ks_social_tabs == 0)
          {
              <div class="fg-grid">
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_twitter">Twitter handle</label>
                    <InputText id="fg_twitter" @bind-Value="Model.Twitter" class="fg-input" />
                    <ValidationMessage For="@(() => Model.Twitter)" class="fg-error" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_social_tabs == 1)
          {
              <div class="fg-grid">
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_github">GitHub username</label>
                    <InputText id="fg_github" @bind-Value="Model.Github" class="fg-input" />
                    <ValidationMessage For="@(() => Model.Github)" class="fg-error" />
                  </div>
                </div>
              </div>
          }
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div>
            <ol class="fg-step-list">
              <li class="@(fgSec_ks_wizard == 0 ? "fg-step-item fg-step-item--active" : "fg-step-item")">1. Shipping</li>
              <li class="@(fgSec_ks_wizard == 1 ? "fg-step-item fg-step-item--active" : "fg-step-item")">2. Review</li>
            </ol>
          @if (fgSec_ks_wizard == 0)
          {
              <div class="fg-grid">
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_shipping_city">Shipping city<span class="fg-required" aria-hidden="true">*</span></label>
                    <InputText id="fg_shipping_city" @bind-Value="Model.ShippingCity" class="fg-input" />
                    <ValidationMessage For="@(() => Model.ShippingCity)" class="fg-error" />
                  </div>
                </div>
              </div>
          }
          @if (fgSec_ks_wizard == 1)
          {
              <div class="fg-grid">
                <div class="fg-cell" style="grid-column: span 12 / span 12">
                  <div class="fg-field">
                    <label class="fg-label" for="fg_order_notes">Order notes</label>
                    <InputTextArea id="fg_order_notes" @bind-Value="Model.OrderNotes" class="fg-textarea" rows="3" />
                    <ValidationMessage For="@(() => Model.OrderNotes)" class="fg-error" />
                  </div>
                </div>
              </div>
          }
            <div class="fg-step-actions">
              @if (fgSec_ks_wizard > 0)
              {
                  <button type="button" class="fg-button fg-button--secondary" @onclick="() => FgGo_ks_wizard(fgSec_ks_wizard - 1)">Back</button>
              }
              @if (fgSec_ks_wizard < 1)
              {
                  <button type="button" class="fg-button fg-button--primary" @onclick="FgNext_ks_wizard">Next</button>
              }
              @if (fgSec_ks_wizard == 1)
              {
                  <button class="fg-button fg-button--primary" type="submit">Submit</button>
              }
            </div>
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <div class="fg-checkbox-row">
              <InputCheckbox id="fg_newsletter" @bind-Value="Model.Newsletter" class="fg-checkbox" />
              <label class="fg-checkbox-label" for="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            <ValidationMessage For="@(() => Model.Newsletter)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <div class="fg-field">
            <div class="fg-checkbox-row">
              <InputCheckbox id="fg_terms" @bind-Value="Model.Terms" class="fg-checkbox" />
              <label class="fg-checkbox-label" for="fg_terms">I accept the terms<span class="fg-required" aria-hidden="true">*</span></label>
            </div>
            <ValidationMessage For="@(() => Model.Terms)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="grid-column: span 12 / span 12">
          <button type="button" class="fg-button fg-button--secondary" @onclick="FgReset">Start over</button>
        </div>
    </div>
    <div class="fg-sr-only" role="status" aria-live="polite" aria-atomic="true">@fgAnnouncement</div>
    @if (ResultJson is not null)
    {
        <pre class="fg-payload">@ResultJson</pre>
    }
    </div>
</EditForm>

@code {
    private KitchenSinkFormModel Model { get; set; } = new();
    private string? ResultJson { get; set; }

    private int fgSec_ks_social_tabs = 0;
    private int fgSec_ks_wizard = 0;

    private EditContext fgEdit = default!;
    private ValidationMessageStore fgMessages = default!;
    private bool fgPressing;
    private readonly HashSet<string> fgDeferredFields = new();

    protected override void OnInitialized() => FgInitEdit();

    private void FgInitEdit()
    {
        fgEdit = new EditContext(Model);
        fgMessages = new ValidationMessageStore(fgEdit);
        fgEdit.OnValidationRequested += (_, _) => FgValidateAll();
        fgEdit.OnFieldChanged += (_, e) => FgFieldChanged(e.FieldIdentifier);
    }

    private void FgPointerDown(PointerEventArgs _)
    {
        FgFlushDeferred();
        fgPressing = true;
    }

    private void FgPointerEnd(PointerEventArgs _)
    {
        fgPressing = false;
        FgFlushDeferred();
    }

    private void FgFieldChanged(string name)
    {
        if (fgPressing)
        {
            fgDeferredFields.Add(name);
            return;
        }
        FgValidateMembers(new[] { name });
    }

    private void FgFlushDeferred()
    {
        if (fgDeferredItemFields.Count > 0)
        {
            var items = fgDeferredItemFields.ToArray();
            fgDeferredItemFields.Clear();
            foreach (var field in items) FgValidateItemField(field);
        }
        if (fgDeferredFields.Count == 0) return;
        var names = fgDeferredFields.ToArray();
        fgDeferredFields.Clear();
        FgValidateMembers(names);
    }

    private void FgValidateAll()
    {
        fgDeferredFields.Clear();
        fgMessages.Clear();
        FgValidateMembers(fgAllMembers);
        FgValidateRepeater_references();
    }

    private object? FgValue(string name) => name switch
    {
            "FullName" => Model.FullName,
            "Email" => Model.Email,
            "Website" => Model.Website,
            "Seats" => Model.Seats,
            "Satisfaction" => Model.Satisfaction,
            "City" => Model.City,
            "Zip" => Model.Zip,
            "AccountUsername" => Model.AccountUsername,
            "AccountPassword" => Model.AccountPassword,
            "AccountBio" => Model.AccountBio,
            "AccountBirthday" => Model.AccountBirthday,
            "AccountAvatar" => Model.AccountAvatar,
            "Plan" => Model.Plan,
            "Interests" => Model.Interests,
            "Channels" => Model.Channels,
            "Topics" => Model.Topics,
            "Billing" => Model.Billing,
            "Extras" => Model.Extras,
            "Notify" => Model.Notify,
            "Appointment" => Model.Appointment,
            "BrandColor" => Model.BrandColor,
            "Volume" => Model.Volume,
            "Source" => Model.Source,
            "Attachments" => Model.Attachments,
            "AttachmentsNote" => Model.AttachmentsNote,
            "ContactMethod" => Model.ContactMethod,
            "ContactPhone" => Model.ContactPhone,
            "ContactOther" => Model.ContactOther,
            "Twitter" => Model.Twitter,
            "Github" => Model.Github,
            "ShippingCity" => Model.ShippingCity,
            "OrderNotes" => Model.OrderNotes,
            "Newsletter" => Model.Newsletter,
            "Terms" => Model.Terms,
        _ => null,
    };

    // Attribute rules per property, plus the model's Validate() results for
    // the same members (DataAnnotations alone skips Validate() while any
    // attribute rule fails, which hid errors such as a required checkbox).
    private bool FgValidateMembers(string[] members)
    {
        var ok = true;
        foreach (var name in members)
        {
            var field = new FieldIdentifier(Model, name);
            fgMessages.Clear(field);
            var results = new List<ValidationResult>();
            var context = new ValidationContext(Model) { MemberName = name };
            if (!Validator.TryValidateProperty(FgValue(name), context, results)) ok = false;
            if (results.Count > 0) fgMessages.Add(field, results[0].ErrorMessage ?? "Invalid");
        }
        foreach (var result in ((IValidatableObject)Model).Validate(new ValidationContext(Model)))
        {
            foreach (var name in result.MemberNames)
            {
                if (Array.IndexOf(members, name) < 0) continue;
                ok = false;
                var field = new FieldIdentifier(Model, name);
                // One message per field (the first), as in the other targets.
                if (!fgMessages[field].Any()) fgMessages.Add(field, result.ErrorMessage ?? "Invalid");
            }
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private async Task FgSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await HandleValidSubmit();
            return;
        }
        await FgOnInvalidSubmit(context);
    }

    private string fgAnnouncement = "";

    private async Task FgAnnounce(string message)
    {
        fgAnnouncement = "";
        StateHasChanged();
        await Task.Delay(50);
        fgAnnouncement = message;
        StateHasChanged();
    }

    private static readonly Dictionary<string, string> fgErrorForms = new() { ["one"] = "1 error. Please fix the highlighted fields.", ["other"] = "{n} errors. Please fix the highlighted fields." };

    private static string FgErrorsText(int count)
    {
        var category = count == 1 ? "one" : "other";
        var text = fgErrorForms.TryGetValue(category, out var form) ? form : fgErrorForms["other"];
        return text.Replace("{n}", count.ToString());
    }

    private static readonly string[] fgAllMembers =
    {
        "FullName",
        "Email",
        "Website",
        "Seats",
        "Satisfaction",
        "City",
        "Zip",
        "AccountUsername",
        "AccountPassword",
        "AccountBio",
        "AccountBirthday",
        "AccountAvatar",
        "Plan",
        "Interests",
        "Channels",
        "Topics",
        "Billing",
        "Extras",
        "Notify",
        "Appointment",
        "BrandColor",
        "Volume",
        "Source",
        "Attachments",
        "AttachmentsNote",
        "ContactMethod",
        "ContactPhone",
        "ContactOther",
        "Twitter",
        "Github",
        "ShippingCity",
        "OrderNotes",
        "Newsletter",
        "Terms",
    };

    private async Task FgOnInvalidSubmit(EditContext context)
    {
        FgJumpToError();
        var count = fgAllMembers.Count(m => context.GetValidationMessages(new FieldIdentifier(Model, m)).Any()) + FgItemErrorCount();
        await FgAnnounce(FgErrorsText(count));
    }

    private static readonly string[] fgSecAnnounce_ks_wizard =
    {
        "Step 1 of 2: Shipping",
        "Step 2 of 2: Review",
    };

    private async Task FgGo_ks_wizard(int index)
    {
        fgSec_ks_wizard = index;
        await FgAnnounce(fgSecAnnounce_ks_wizard[index]);
    }

    private async Task FgNext_ks_wizard()
    {
        var members = fgSec_ks_wizard switch
        {
            0 => new[] { nameof(KitchenSinkFormModel.ShippingCity) },
            1 => new[] { nameof(KitchenSinkFormModel.OrderNotes) },
            _ => Array.Empty<string>(),
        };
        if (FgValidateMembers(members) && fgSec_ks_wizard < 1) await FgGo_ks_wizard(fgSec_ks_wizard + 1);
    }

    private static readonly string[][] fgSecMembers_ks_social_tabs =
    {
        new[] { "Twitter" },
        new[] { "Github" },
    };

    private static readonly string[][] fgSecMembers_ks_wizard =
    {
        new[] { "ShippingCity" },
        new[] { "OrderNotes" },
    };

    private bool FgHasMessages(string[] members)
    {
        foreach (var name in members)
        {
            if (fgEdit.GetValidationMessages(new FieldIdentifier(Model, name)).Any()) return true;
        }
        return false;
    }

    private void FgJumpToError()
    {
        if (!FgHasMessages(fgSecMembers_ks_social_tabs[fgSec_ks_social_tabs]))
        {
            for (var i = 0; i < fgSecMembers_ks_social_tabs.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_social_tabs[i])) { fgSec_ks_social_tabs = i; break; }
            }
        }
        if (!FgHasMessages(fgSecMembers_ks_wizard[fgSec_ks_wizard]))
        {
            for (var i = 0; i < fgSecMembers_ks_wizard.Length; i++)
            {
                if (FgHasMessages(fgSecMembers_ks_wizard[i])) { fgSec_ks_wizard = i; break; }
            }
        }
    }

    private static void FgToggle(List<string> list, string value, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on) { if (!list.Contains(value)) list.Add(value); }
        else { list.Remove(value); }
    }

    private readonly Dictionary<string, string> fgTagDrafts = new() { ["topics"] = "" };

    private void FgAddTag(List<string> list, string key)
    {
        var draft = (fgTagDrafts.TryGetValue(key, out var value) ? value : "").Trim();
        if (draft.Length > 0 && !list.Contains(draft)) list.Add(draft);
        fgTagDrafts[key] = "";
    }

    private static readonly string[] fgItemFields_references = { "Name", "Email" };
    private ElementReference fgAddRef_references;

    private bool FgRepeaterHasErrors_references() =>
        Model.References.Any(item => fgItemFields_references.Any(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any()));

    private bool FgValidateRepeater_references()
    {
        var ok = true;
        foreach (var item in Model.References)
        {
            foreach (var name in fgItemFields_references) ok &= FgValidateItemField(new FieldIdentifier(item, name), false);
        }
        fgEdit.NotifyValidationStateChanged();
        return ok;
    }

    private readonly HashSet<FieldIdentifier> fgDeferredItemFields = new();
    private readonly Dictionary<object, ElementReference> fgItemRefs = new();
    private object? fgFocusItem;
    private string? fgFocusAdd;

    private void FgFieldChanged(FieldIdentifier field)
    {
        if (ReferenceEquals(field.Model, Model))
        {
            FgFieldChanged(field.FieldName);
            return;
        }
        if (fgPressing)
        {
            fgDeferredItemFields.Add(field);
            return;
        }
        FgValidateItemField(field);
    }

    /** First rule violation of an item field (null when valid or hidden). */
    private string? FgItemError(object model, string name)
    {
        switch (model)
        {
            case FgReferencesItem item:
                switch (name)
                {
                    case "Name":
                    {
                        if (string.IsNullOrWhiteSpace(item.Name)) return "This field is required";
                        return null;
                    }
                    case "Email":
                    {
                        if (!((Equals(item.MayContact, true)))) return null;
                        if (!(string.IsNullOrWhiteSpace(item.Email)) && (!System.Text.RegularExpressions.Regex.IsMatch(item.Email, @"^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))) return "Must be a valid email address";
                        return null;
                    }
                }
                break;
        }
        return null;
    }

    private bool FgValidateItemField(FieldIdentifier field, bool notify = true)
    {
        fgMessages.Clear(field);
        var error = FgItemError(field.Model, field.FieldName);
        if (error != null) fgMessages.Add(field, error);
        if (notify) fgEdit.NotifyValidationStateChanged();
        return error == null;
    }

    private int FgItemErrorCount()
    {
        var count = 0;
        foreach (var item in Model.References) count += fgItemFields_references.Count(n => fgEdit.GetValidationMessages(new FieldIdentifier(item, n)).Any());
        return count;
    }

    private static string FgItemLabel(string path, int index) => (path switch
    {
        "references" => "Reference {n}",
        _ => "{n}",
    }).Replace("{n}", (index + 1).ToString());

    private static string FgRemoveLabel(string path, int index) =>
        "Remove {label}".Replace("{label}", FgItemLabel(path, index));

    private async Task FgAddItem<T>(List<T> list, string path, int max) where T : class, new()
    {
        if (list.Count >= max) return;
        var item = new T();
        list.Add(item);
        fgFocusItem = item;
        await FgAnnounce("{label} added".Replace("{label}", FgItemLabel(path, list.Count - 1)));
    }

    private async Task FgRemoveItem<T>(List<T> list, string path, int index, int min, string[] fields) where T : class
    {
        if (list.Count <= min || index >= list.Count) return;
        var label = FgItemLabel(path, index);
        var item = list[index];
        foreach (var name in fields) fgMessages.Clear(new FieldIdentifier(item, name));
        fgItemRefs.Remove(item);
        list.RemoveAt(index);
        fgEdit.NotifyValidationStateChanged();
        if (list.Count > 0) fgFocusItem = list[Math.Min(index, list.Count - 1)];
        else fgFocusAdd = path;
        await FgAnnounce("{label} removed".Replace("{label}", label));
    }

    private async Task FgFocusRepeaters()
    {
        if (fgFocusItem != null && fgItemRefs.TryGetValue(fgFocusItem, out var itemRef))
        {
            fgFocusItem = null;
            await itemRef.FocusAsync();
        }
        else if (fgFocusAdd != null)
        {
            var path = fgFocusAdd;
            fgFocusAdd = null;
            var addRef = path switch
            {
                "references" => fgAddRef_references,
                _ => default,
            };
            if (addRef.Context != null) await addRef.FocusAsync();
        }
    }

    public sealed record FgUpload(string Name, long Size, string ContentType, byte[]? Data, string? Thumb);

    private readonly Dictionary<string, int> fgFileKeys = new() { ["AccountAvatar"] = 0, ["Attachments"] = 0 };
    private readonly Dictionary<string, InputFile> fgFileInputs = new();
    private string? fgFocusFile;

    private async Task FgPickFiles(List<FgUpload> list, InputFileChangeEventArgs e, bool multiple, long maxBytes, bool thumbs, string member)
    {
        var picked = new List<FgUpload>();
        foreach (var file in e.GetMultipleFiles(multiple ? int.MaxValue : 1))
        {
            byte[]? data = null;
            if (maxBytes <= 0 || file.Size <= maxBytes)
            {
                using var buffer = new System.IO.MemoryStream();
                await file.OpenReadStream(maxBytes > 0 ? maxBytes : long.MaxValue).CopyToAsync(buffer);
                data = buffer.ToArray();
            }
            string? thumb = null;
            if (thumbs && file.ContentType.StartsWith("image/"))
            {
                try
                {
                    var small = await file.RequestImageFileAsync("image/png", 80, 80);
                    using var buffer = new System.IO.MemoryStream();
                    await small.OpenReadStream(long.MaxValue).CopyToAsync(buffer);
                    thumb = "data:image/png;base64," + Convert.ToBase64String(buffer.ToArray());
                }
                catch (Exception) { }
            }
            picked.Add(new FgUpload(file.Name, file.Size, file.ContentType, data, thumb));
        }
        if (picked.Count == 0) return;
        if (!multiple) list.Clear();
        list.AddRange(picked);
        fgFileKeys[member]++;
        fgFocusFile = member;
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private void FgRemoveFile(List<FgUpload> list, FgUpload file, string member)
    {
        list.RemoveAll(f => ReferenceEquals(f, file));
        fgEdit.NotifyFieldChanged(new FieldIdentifier(Model, member));
    }

    private static string FgFileSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024d))} KB";

    private static string FgRemoveFileLabel(string name) => "Remove {name}".Replace("{name}", name);

    /** Payload entry for an upload: { name, size, type } per file; the files become parts named by data path. */
    private static List<Dictionary<string, object?>> FgFilesPart(List<(string Path, FgUpload File)> parts, string path, List<FgUpload> files)
    {
        foreach (var file in files) parts.Add((path, file));
        return files.Select(f => new Dictionary<string, object?> { ["name"] = f.Name, ["size"] = f.Size, ["type"] = f.ContentType }).ToList();
    }

    private async Task FgFocusUploads()
    {
        if (fgFocusFile == null) return;
        var member = fgFocusFile;
        fgFocusFile = null;
        if (fgFileInputs.TryGetValue(member, out var input) && input.Element is ElementReference element) await element.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FgFocusRepeaters();
        await FgFocusUploads();
    }

    private async Task FgReset()
    {
        Model = new();
        FgInitEdit();
        fgItemRefs.Clear();
        fgDeferredFields.Clear();
        ResultJson = null;
        foreach (var key in fgTagDrafts.Keys.ToList()) fgTagDrafts[key] = "";
        await FgAnnounce("The form was reset.");
    }

    private static bool FgIsBlank(object? value) => value switch
    {
        null => true,
        string text => string.IsNullOrWhiteSpace(text),
        bool on => !on,
        System.Collections.ICollection list => list.Count == 0,
        _ => false,
    };

    private static bool FgAccepts(FgUpload file, string accept)
    {
        var name = file.Name.ToLowerInvariant();
        var type = (file.ContentType ?? "").ToLowerInvariant();
        return accept.Split(',').Select(t => t.Trim().ToLowerInvariant()).Where(t => t.Length > 0).Any(t =>
            t.StartsWith('.') ? name.EndsWith(t) : t.EndsWith("/*") ? type.StartsWith(t[..^1]) : type == t);
    }

    private async Task HandleValidSubmit()
    {
        var parts = new List<(string Path, FgUpload File)>();
        var payload = BuildPayload(parts);
        ResultJson = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await FgAnnounce("Form submitted.");
    }

    private Dictionary<string, object?> BuildPayload(List<(string Path, FgUpload File)> parts)
    {
        var payload = new Dictionary<string, object?>();
        payload["full_name"] = Model.FullName;
        payload["email"] = Model.Email;
        payload["website"] = Model.Website;
        payload["seats"] = Model.Seats;
        payload["satisfaction"] = Model.Satisfaction;
        payload["city"] = Model.City;
        payload["zip"] = Model.Zip;
        var dict0 = new Dictionary<string, object?>();
        dict0["username"] = Model.AccountUsername;
        dict0["password"] = Model.AccountPassword;
        dict0["bio"] = Model.AccountBio;
        dict0["birthday"] = Model.AccountBirthday;
        dict0["avatar"] = FgFilesPart(parts, "account.avatar", Model.AccountAvatar);
        payload["account"] = dict0;
        payload["plan"] = string.IsNullOrEmpty(Model.Plan) ? null : Model.Plan;
        payload["interests"] = Model.Interests;
        payload["channels"] = Model.Channels;
        payload["topics"] = Model.Topics;
        payload["billing"] = string.IsNullOrEmpty(Model.Billing) ? null : Model.Billing;
        payload["extras"] = Model.Extras;
        payload["notify"] = Model.Notify;
        payload["appointment"] = Model.Appointment;
        payload["brand_color"] = Model.BrandColor;
        payload["volume"] = Model.Volume;
        payload["source"] = Model.Source;
        var list1 = new List<Dictionary<string, object?>>();
        foreach (var item in Model.References)
        {
            var item1 = new Dictionary<string, object?>();
            item1["name"] = item.Name;
            item1["may_contact"] = item.MayContact;
            if ((Equals(item.MayContact, true))) item1["email"] = item.Email;
            list1.Add(item1);
        }
        payload["references"] = list1;
        payload["attachments"] = FgFilesPart(parts, "attachments", Model.Attachments);
        if (((!FgIsBlank(Model.Attachments)))) payload["attachments_note"] = Model.AttachmentsNote;
        payload["contact_method"] = string.IsNullOrEmpty(Model.ContactMethod) ? null : Model.ContactMethod;
        if (((Equals(Model.ContactMethod, "phone")))) payload["contact_phone"] = Model.ContactPhone;
        if (((Equals(Model.ContactMethod, "other")))) payload["contact_other"] = Model.ContactOther;
        payload["twitter"] = Model.Twitter;
        payload["github"] = Model.Github;
        payload["shipping_city"] = Model.ShippingCity;
        payload["order_notes"] = Model.OrderNotes;
        payload["newsletter"] = Model.Newsletter;
        payload["terms"] = Model.Terms;
        return payload;
    }

    public class KitchenSinkFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "This field is required")]
        [MinLength(2, ErrorMessage = "Must be at least 2")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Must be a valid email address")]
        public string Email { get; set; } = "";

        public string Website { get; set; } = "";

        public double? Seats { get; set; }

        public double Satisfaction { get; set; } = 5;

        public string City { get; set; } = "";

        [RegularExpression(@"^[0-9]{4,6}$", ErrorMessage = "Invalid format")]
        public string Zip { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        [MinLength(3, ErrorMessage = "Must be between 3 and 20")]
        [MaxLength(20, ErrorMessage = "Must be between 3 and 20")]
        public string AccountUsername { get; set; } = "";

        public string AccountPassword { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Must be at most 200")]
        public string AccountBio { get; set; } = "";

        public string AccountBirthday { get; set; } = "";

        public List<FgUpload> AccountAvatar { get; set; } = new();

        [Required(ErrorMessage = "This field is required")]
        public string Plan { get; set; } = "";

        public List<string> Interests { get; set; } = new();

        public string[] Channels { get; set; } = Array.Empty<string>();

        public List<string> Topics { get; set; } = new();

        public string Billing { get; set; } = "";

        public List<string> Extras { get; set; } = new();

        public bool Notify { get; set; } = true;

        public string Appointment { get; set; } = "";

        public string BrandColor { get; set; } = "#000000";

        public double Volume { get; set; } = 0;

        public string Source { get; set; } = "kitchen-sink";

        public List<FgUpload> Attachments { get; set; } = new();

        public string AttachmentsNote { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ContactMethod { get; set; } = "";

        public string ContactPhone { get; set; } = "";

        public string ContactOther { get; set; } = "";

        public string Twitter { get; set; } = "";

        public string Github { get; set; } = "";

        [Required(ErrorMessage = "This field is required")]
        public string ShippingCity { get; set; } = "";

        public string OrderNotes { get; set; } = "";

        public bool Newsletter { get; set; } = true;

        public bool Terms { get; set; }

        public List<FgReferencesItem> References { get; set; } = new() { new(), };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
        if (!(string.IsNullOrWhiteSpace(Website)) && (!Uri.TryCreate(Website, UriKind.Absolute, out _))) yield return new ValidationResult("Must be a valid URL", new[] { nameof(Website) });
        if (!(!Seats.HasValue) && (Seats!.Value < 1)) yield return new ValidationResult("Must be at least 1", new[] { nameof(Seats) });
        if (!(!Seats.HasValue) && (Seats!.Value > 50)) yield return new ValidationResult("Must be at most 50", new[] { nameof(Seats) });
        if (!(Topics.Count == 0) && (Topics.Count > 5)) yield return new ValidationResult("At most 5 topics", new[] { nameof(Topics) });
        if (Attachments.Count == 0) yield return new ValidationResult("This field is required", new[] { nameof(Attachments) });
        if (Attachments.Count > 3) yield return new ValidationResult("Choose at most 3 files", new[] { nameof(Attachments) });
        foreach (var file in Attachments)
        {
            if (!FgAccepts(file, ".pdf,.doc,.docx")) { yield return new ValidationResult("{name} is not an accepted file type".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
            if (file.Size > 5242880L) { yield return new ValidationResult("{name} is larger than 5 MB".Replace("{name}", file.Name), new[] { nameof(Attachments) }); break; }
        }
        if (!Terms) yield return new ValidationResult("This field is required", new[] { nameof(Terms) });
        }
    }

    public class FgReferencesItem
    {
        public string Name { get; set; } = "";
        public bool MayContact { get; set; }
        public string Email { get; set; } = "";
    }
}
"
`;

exports[`html target > snapshot (bootstrap5) 1`] = `
"<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kitchen Sink</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <form id="fg-form" class="container py-4" novalidate>
    <div class="row g-3">
      <div class="col-12 col-md-12 text-center">
        <h2 class="fw-semibold text-primary">Kitchen Sink</h2>
      </div>
      <div class="col-12 col-md-12 text-center">
        <p class="text-secondary">Every implemented element appears in this form.</p>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_full_name">Full name<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_full_name" type="text" class="form-control" data-fg-path="full_name" data-fg-kind="text" placeholder="Jane Doe">
          <p id="fg_err_full_name" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_email">Email<span class="text-danger ms-1" aria-hidden="true">*</span></label>
          <input id="fg_email" type="email" class="form-control" data-fg-path="email" data-fg-kind="text" placeholder="jane&#64;example.com">
          <p id="fg_err_email" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="form-control form-control-sm" data-fg-path="website" data-fg-kind="text">
          <p id="fg_err_website" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_seats">Seats</label>
          <input id="fg_seats" type="number" class="form-control" data-fg-path="seats" data-fg-kind="number" min="1" max="50">
          <p id="fg_err_seats" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="form-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_err_satisfaction" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <hr class="border-top border-primary opacity-100">
      </div>
      <div class="col-12 col-md-12">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-1">
              <label class="form-label fw-semibold mb-0" for="fg_city">City</label>
              <input id="fg_city" type="text" class="form-control" data-fg-path="city" data-fg-kind="text">
              <p id="fg_err_city" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-1">
              <label class="visually-hidden" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="form-control" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_err_zip" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12 account-box">
        <fieldset class="border rounded p-3 bg-body-tertiary">
          <legend class="fw-semibold text-secondary small px-1">Account</legend>
          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_username">Username<span class="text-danger ms-1" aria-hidden="true">*</span></label>
                <input id="fg_account_username" type="text" class="form-control" data-fg-path="account.username" data-fg-kind="text">
                <p id="fg_err_account_username" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="form-control" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_err_account_password" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="form-control form-control-lg" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_err_account_bio" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="form-control" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_err_account_birthday" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
              </div>
            </div>
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column gap-1">
                <label class="form-label fw-semibold mb-0" for="fg_account_avatar">Profile picture</label>
                <input id="fg_account_avatar" type="file" class="form-control" accept="image/*" data-fg-path="account.avatar" data-fg-kind="files" data-fg-thumbs>
                <ul class="list-group mt-2" data-fg-file-list="account.avatar" hidden></ul>
                <p id="fg_err_account_avatar" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column gap-1">
          <legend class="form-label fw-semibold mb-0">Plan<span class="text-danger ms-1" aria-hidden="true">*</span></legend>
          <div class="d-flex flex-column gap-1">
            <label class="form-check" for="fg_plan_free">
              <input id="fg_plan_free" type="radio" name="plan" class="form-check-input" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="form-check" for="fg_plan_pro">
              <input id="fg_plan_pro" type="radio" name="plan" class="form-check-input" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_err_plan" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column gap-1">
          <legend class="form-label fw-semibold mb-0">Interests</legend>
          <div class="d-flex flex-column gap-1">
            <label class="form-check" for="fg_interests_news">
              <input id="fg_interests_news" type="checkbox" class="form-check-input" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="form-check" for="fg_interests_product">
              <input id="fg_interests_product" type="checkbox" class="form-check-input" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_err_interests" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="form-select" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_err_channels" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column gap-1">
          <label class="form-label fw-semibold mb-0" for="fg_topics">Topics</label>
          <div class="form-control d-flex flex-wrap align-items-center gap-1" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="border-0 p-0 flex-grow-1 shadow-none bg-transparent" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="form-text mt-0">Free-text tags</p>
          <p id="fg_err_topics" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <fieldset class="d-flex flex-column gap-1">
          <legend class="form-label fw-semibold mb-0">Billing</legend>
          <div class="btn-group flex-wrap">
            <input id="fg_billing_monthly" type="radio" name="billing" class="btn-check" value="monthly" data-fg-path="billing" data-fg-kind="radio">
            <label class="btn btn-outline-primary" for="fg_billing_monthly">Monthly</label>
            <input id="fg_billing_yearly" type="radio" name="billing" class="btn-check" value="yearly" data-fg-path="billing" data-fg-kind="radio">
            <label class="btn btn-outline-primary" for="fg_billing_yearly">Yearly</label>
          </div>
          <p id="fg_err_billing" class="invalid-feedback d-block mt-0" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="col-12 col-md-12">
