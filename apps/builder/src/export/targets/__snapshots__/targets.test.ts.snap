          <p id="fg_err_seats" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="fg-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_err_satisfaction" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <hr class="fg-divider fg-tone-primary">
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-grid">
          <div class="fg-cell" style="grid-column: span 6 / span 6">
            <div class="fg-field">
              <label class="fg-label" for="fg_city">City</label>
              <input id="fg_city" type="text" class="fg-input" data-fg-path="city" data-fg-kind="text">
              <p id="fg_err_city" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
          <div class="fg-cell" style="grid-column: span 6 / span 6">
            <div class="fg-field">
              <label class="fg-sr-only" for="fg_zip">ZIP</label>
              <input id="fg_zip" type="text" class="fg-input" data-fg-path="zip" data-fg-kind="text">
              <p id="fg_err_zip" class="fg-error" role="alert" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="fg-cell account-box" style="grid-column: span 12 / span 12">
        <fieldset class="fg-group">
          <legend class="fg-group-label">Account</legend>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_username">Username<span class="fg-required" aria-hidden="true">*</span></label>
                <input id="fg_account_username" type="text" class="fg-input" data-fg-path="account.username" data-fg-kind="text">
                <p id="fg_err_account_username" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_password">Password</label>
                <input id="fg_account_password" type="password" class="fg-input" data-fg-path="account.password" data-fg-kind="text">
                <p id="fg_err_account_password" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_bio">Bio</label>
                <textarea id="fg_account_bio" class="fg-textarea fg-control--lg" rows="4" data-fg-path="account.bio" data-fg-kind="text"></textarea>
                <p id="fg_err_account_bio" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_account_birthday">Birthday</label>
                <input id="fg_account_birthday" type="date" class="fg-input" data-fg-path="account.birthday" data-fg-kind="text">
                <p id="fg_err_account_birthday" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Plan<span class="fg-required" aria-hidden="true">*</span></legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_plan_free">
              <input id="fg_plan_free" type="radio" name="plan" class="fg-checkbox" value="free" data-fg-path="plan" data-fg-kind="radio">
              <span>Free</span>
            </label>
            <label class="fg-option" for="fg_plan_pro">
              <input id="fg_plan_pro" type="radio" name="plan" class="fg-checkbox" value="pro" data-fg-path="plan" data-fg-kind="radio">
              <span>Pro</span>
            </label>
          </div>
          <p id="fg_err_plan" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Interests</legend>
          <div class="fg-options">
            <label class="fg-option" for="fg_interests_news">
              <input id="fg_interests_news" type="checkbox" class="fg-checkbox" value="news" data-fg-path="interests" data-fg-kind="checks">
              <span>News</span>
            </label>
            <label class="fg-option" for="fg_interests_product">
              <input id="fg_interests_product" type="checkbox" class="fg-checkbox" value="product" data-fg-path="interests" data-fg-kind="checks">
              <span>Product updates</span>
            </label>
          </div>
          <p id="fg_err_interests" class="fg-error" role="alert" hidden></p>
        </fieldset>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_channels">Notification channels</label>
          <select id="fg_channels" multiple class="fg-select" data-fg-path="channels" data-fg-kind="multiselect">
            <option value="email">Email</option>
            <option value="sms">SMS</option>
            <option value="push">Push</option>
          </select>
          <p id="fg_err_channels" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_topics">Topics</label>
          <div class="fg-tags" data-fg-path="topics" data-fg-kind="tags">
            <span data-fg-tags-chips="topics"></span>
            <input id="fg_topics" type="text" class="fg-tags-input" data-fg-tags-input="topics" placeholder="Type and press Enter">
          </div>
          <p class="fg-description">Free-text tags</p>
          <p id="fg_err_topics" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_method">Preferred contact method<span class="fg-required" aria-hidden="true">*</span></label>
          <select id="fg_contact_method" class="fg-select" data-fg-path="contact_method" data-fg-kind="select">
            <option value="" disabled selected>—</option>
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="other">Other</option>
          </select>
          <p id="fg_err_contact_method" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-cond="0">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_phone">Phone number</label>
          <input id="fg_contact_phone" type="tel" class="fg-input" data-fg-path="contact_phone" data-fg-kind="text">
          <p id="fg_err_contact_phone" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" data-fg-cond="1">
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_other">Describe your preferred method</label>
          <textarea id="fg_contact_other" class="fg-textarea" rows="3" data-fg-path="contact_other" data-fg-kind="text"></textarea>
          <p id="fg_err_contact_other" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div>
          <div class="fg-tab-list" role="tablist">
            <button type="button" class="fg-tab-button fg-tab-button--active" data-fg-sec-btn="ks_social_tabs:0">Social</button>
            <button type="button" class="fg-tab-button" data-fg-sec-btn="ks_social_tabs:1">Code</button>
          </div>
          <div data-fg-sec-panel="ks_social_tabs:0">
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_twitter">Twitter handle</label>
                <input id="fg_twitter" type="text" class="fg-input" data-fg-path="twitter" data-fg-kind="text">
                <p id="fg_err_twitter" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_social_tabs:1" hidden>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_github">GitHub username</label>
                <input id="fg_github" type="text" class="fg-input" data-fg-path="github" data-fg-kind="text">
                <p id="fg_err_github" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div>
          <ol class="fg-step-list">
            <li class="fg-step-item fg-step-item--active" data-fg-sec-item="ks_wizard:0">1. Shipping</li>
            <li class="fg-step-item" data-fg-sec-item="ks_wizard:1">2. Review</li>
          </ol>
          <div data-fg-sec-panel="ks_wizard:0">
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_shipping_city">Shipping city<span class="fg-required" aria-hidden="true">*</span></label>
                <input id="fg_shipping_city" type="text" class="fg-input" data-fg-path="shipping_city" data-fg-kind="text">
                <p id="fg_err_shipping_city" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_wizard:1" hidden>
          <div class="fg-grid">
            <div class="fg-cell" style="grid-column: span 12 / span 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_order_notes">Order notes</label>
                <textarea id="fg_order_notes" class="fg-textarea" rows="3" data-fg-path="order_notes" data-fg-kind="text"></textarea>
                <p id="fg_err_order_notes" class="fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div class="fg-step-actions">
            <button type="button" class="fg-button fg-button--secondary" data-fg-step-back="ks_wizard" hidden>Back</button>
            <button type="button" class="fg-button fg-button--primary" data-fg-step-next="ks_wizard">Next</button>
            <button type="submit" class="fg-button fg-button--primary" data-fg-submit hidden>Submit</button>
          </div>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_newsletter" type="checkbox" class="fg-checkbox" data-fg-path="newsletter" data-fg-kind="checkbox" checked>
            <label class="fg-checkbox-label" for="fg_newsletter">Subscribe to the newsletter</label>
          </div>
          <p id="fg_err_newsletter" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_terms" type="checkbox" class="fg-checkbox" data-fg-path="terms" data-fg-kind="checkbox">
            <label class="fg-checkbox-label" for="fg_terms">I accept the terms<span class="fg-required" aria-hidden="true">*</span></label>
          </div>
          <p id="fg_err_terms" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
    </div>
    <div id="fg-live" class="fg-sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <pre id="fg-result" class="fg-payload" hidden></pre>
  </form>
  <script>
  (function () {
    'use strict'
    function fgIsEmpty(v) {
      if (v === null || v === undefined) return true
      if (typeof v === 'string') return v.trim() === ''
      if (Array.isArray(v)) return v.length === 0
      return false
    }
    function fgSize(v) {
      if (typeof v === 'number') return Number.isFinite(v) ? v : null
      if (typeof v === 'string') return v.length
      if (Array.isArray(v)) return v.length
      return null
    }

    var fgTags = {}
    function fgControl(path) {
      return document.querySelector('[data-fg-path="' + path + '"]')
    }
    function fgGet(path) {
      var el = fgControl(path)
      if (!el) return undefined
      var kind = el.getAttribute('data-fg-kind')
      if (kind === 'checkbox') return el.checked
      if (kind === 'select') return el.value === '' ? null : el.value
      if (kind === 'number') return el.value === '' ? null : Number(el.value)
      if (kind === 'radio') {
        var checked = document.querySelector('[data-fg-path="' + path + '"]:checked')
        return checked ? checked.value : null
      }
      if (kind === 'multiselect') {
        return Array.prototype.map.call(el.selectedOptions, function (option) { return option.value })
      }
      if (kind === 'tags') return (fgTags[path] || []).slice()
      if (kind === 'checks') {
        return Array.prototype.map.call(
          document.querySelectorAll('[data-fg-path="' + path + '"]:checked'),
          function (box) { return box.value },
        )
      }
      return el.value
    }

    function fgVisible_contact_phone() {
      return ((fgGet("contact_method") === "phone"))
    }
    function fgVisible_contact_other() {
      return ((fgGet("contact_method") === "other"))
    }

    var FG_CONDITIONS = [
      { index: 0, test: function () { return (fgGet("contact_method") === "phone") } },
      { index: 1, test: function () { return (fgGet("contact_method") === "other") } },
    ]

    var FG_VALIDATORS = {
      'full_name': function () {
      const v = fgGet("full_name")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
      return null
      },
      'email': function () {
      const v = fgGet("email")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
      },
      'website': function () {
      const v = fgGet("website")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
      return null
      },
      'seats': function () {
      const v = fgGet("seats")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
      return null
      },
      'zip': function () {
      const v = fgGet("zip")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
      return null
      },
      'account.username': function () {
      const v = fgGet("account.username")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
      return null
      },
      'account.bio': function () {
      const v = fgGet("account.bio")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
      return null
      },
      'plan': function () {
      const v = fgGet("plan")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      return null
      },
      'topics': function () {
      const v = fgGet("topics")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
      return null
      },
      'contact_method': function () {
      const v = fgGet("contact_method")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      return null
      },
      'shipping_city': function () {
      const v = fgGet("shipping_city")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      return null
      },
      'terms': function () {
      const v = fgGet("terms")
      if (fgIsEmpty(v) || v === false) return "This field is required"
      return null
      },
    }

    var touched = {}

    function fgKey(path) { return path.replace(/\\./g, '_') }

    function setError(path, message) {
      var el = document.getElementById('fg_err_' + fgKey(path))
      var control = fgControl(path)
      var invalid = "fg-invalid".split(' ').filter(Boolean)
      if (el) {
        el.textContent = message || ''
        el.hidden = !message
      }
      if (control) {
        invalid.forEach(function (cls) { control.classList.toggle(cls, Boolean(message)) })
      }
    }

    function validateField(path) {
      var validate = FG_VALIDATORS[path]
      if (!validate) return true
      var message = validate()
      setError(path, message)
      return !message
    }

    function fgHasError(path) {
      var validate = FG_VALIDATORS[path]
      return validate ? Boolean(validate()) : false
    }

    function updateConditions() {
      FG_CONDITIONS.forEach(function (c) {
        var el = document.querySelector('[data-fg-cond="' + c.index + '"]')
        if (el) el.hidden = !c.test()
      })
    }

    // Tags (chips) fields: value lives in fgTags, chips are painted into
    // the [data-fg-tags-chips] span, Enter/comma/blur adds the draft.
    Array.prototype.forEach.call(document.querySelectorAll('[data-fg-kind="tags"]'), function (wrap) {
      var path = wrap.getAttribute('data-fg-path')
      fgTags[path] = []
      var chips = wrap.querySelector('[data-fg-tags-chips="' + path + '"]')
      var input = wrap.querySelector('[data-fg-tags-input="' + path + '"]')
      if (!chips || !input) return
      function paint() {
        chips.textContent = ''
        fgTags[path].forEach(function (tag, index) {
          var chip = document.createElement('span')
          chip.className = "fg-tag"
          chip.appendChild(document.createTextNode(tag + ' '))
          var remove = document.createElement('button')
          remove.type = 'button'
          remove.className = "fg-tag-remove"
          remove.setAttribute('aria-label', 'Remove ' + (tag))
          remove.textContent = '\\u00d7'
          remove.addEventListener('click', function () {
            fgTags[path].splice(index, 1)
            paint()
            if (touched[path]) validateField(path)
            updateConditions()
          })
          chip.appendChild(remove)
          chips.appendChild(chip)
        })
      }
      function addDraft() {
        var draft = input.value.trim()
        if (draft !== '' && fgTags[path].indexOf(draft) === -1) {
          fgTags[path].push(draft)
          paint()
        }
        input.value = ''
        if (touched[path]) validateField(path)
        updateConditions()
      }
      input.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ',') { event.preventDefault(); addDraft() }
      })
      input.addEventListener('blur', function () {
        addDraft()
        fgBlurValidate(path)
      })
    })

    // Polite aria-live region; cleared first so repeated text re-announces.
    function fgAnnounce(message) {
      var live = document.getElementById('fg-live')
      if (!live) return
      live.textContent = ''
      setTimeout(function () { live.textContent = message }, 50)
    }
    function fgErrorsText(count) {
      const forms = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
      const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
      return text.split('{n}').join(String(count))
    }

    var FG_SECTIONS = [{"key":"ks_social_tabs","kind":"tabs","count":2,"tabActive":"fg-tab-button fg-tab-button--active","tabBase":"fg-tab-button","stepActive":"fg-step-item fg-step-item--active","stepBase":"fg-step-item","stepPaths":[["twitter"],["github"]],"announce":[]},{"key":"ks_wizard","kind":"steps","count":2,"tabActive":"fg-tab-button fg-tab-button--active","tabBase":"fg-tab-button","stepActive":"fg-step-item fg-step-item--active","stepBase":"fg-step-item","stepPaths":[["shipping_city"],["order_notes"]],"announce":["Step 1 of 2: Shipping","Step 2 of 2: Review"]}]
    var FG_SUBMIT_GATE = ["ks_wizard"]
    var fgSecState = {}
    function fgUpdateSubmit() {
      var btn = document.querySelector('[data-fg-submit]')
      if (!btn || FG_SUBMIT_GATE.length === 0) return
      var ready = FG_SUBMIT_GATE.every(function (key) {
        var meta = null
        FG_SECTIONS.forEach(function (m) { if (m.key === key) meta = m })
        return !meta || (fgSecState[key] || 0) >= meta.count - 1
      })
      btn.hidden = !ready
    }
    function fgSetSec(meta, index, speak) {
      fgSecState[meta.key] = index
      if (speak && meta.announce[index]) fgAnnounce(meta.announce[index])
      var panels = document.querySelectorAll('[data-fg-sec-panel]')
      Array.prototype.forEach.call(panels, function (panel) {
        var value = panel.getAttribute('data-fg-sec-panel')
        if (value.indexOf(meta.key + ':') === 0) panel.hidden = value !== meta.key + ':' + index
      })
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          var active = btn.getAttribute('data-fg-sec-btn') === meta.key + ':' + index
          btn.className = active ? meta.tabActive : meta.tabBase
        },
      )
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-item^="' + meta.key + ':"]'),
        function (item) {
          var active = item.getAttribute('data-fg-sec-item') === meta.key + ':' + index
          item.className = active ? meta.stepActive : meta.stepBase
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.hidden = index === 0
      if (nextBtn) nextBtn.hidden = index >= meta.count - 1
      fgUpdateSubmit()
    }
    FG_SECTIONS.forEach(function (meta) {
      fgSecState[meta.key] = 0
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          btn.addEventListener('click', function () {
            fgSetSec(meta, Number(btn.getAttribute('data-fg-sec-btn').split(':')[1]))
          })
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.addEventListener('click', function () {
        fgSetSec(meta, Math.max(0, fgSecState[meta.key] - 1), true)
      })
      if (nextBtn) nextBtn.addEventListener('click', function () {
        var ok = true
        var paths = meta.stepPaths[fgSecState[meta.key]] || []
        paths.forEach(function (path) {
          touched[path] = true
          if (!validateField(path)) ok = false
        })
        if (ok) fgSetSec(meta, Math.min(meta.count - 1, fgSecState[meta.key] + 1), true)
      })
      fgSetSec(meta, 0)
    })

    function buildPayload() {
      return {
        "full_name": fgGet("full_name"),
        "email": fgGet("email"),
        "website": fgGet("website"),
        "seats": fgGet("seats"),
        "satisfaction": fgGet("satisfaction"),
        "city": fgGet("city"),
        "zip": fgGet("zip"),
        "account": {
          "username": fgGet("account.username"),
          "password": fgGet("account.password"),
          "bio": fgGet("account.bio"),
          "birthday": fgGet("account.birthday"),
        },
        "plan": fgGet("plan"),
        "interests": fgGet("interests"),
        "channels": fgGet("channels"),
        "topics": fgGet("topics"),
        "contact_method": fgGet("contact_method"),
        ...(fgVisible_contact_phone() ? { "contact_phone": fgGet("contact_phone") } : {}),
        ...(fgVisible_contact_other() ? { "contact_other": fgGet("contact_other") } : {}),
        "twitter": fgGet("twitter"),
        "github": fgGet("github"),
        "shipping_city": fgGet("shipping_city"),
        "order_notes": fgGet("order_notes"),
        "newsletter": fgGet("newsletter"),
        "terms": fgGet("terms"),
      }
    }

    var form = document.getElementById('fg-form')
    // A blur error appearing while a pointer is held reflows the form and
    // the release misses its target; defer blur validation until the press
    // ends (after the click has been dispatched).
    var fgPressing = false
    var fgDeferred = []
    function fgBlurValidate(path) {
      touched[path] = true
      if (fgPressing) {
        if (fgDeferred.indexOf(path) === -1) fgDeferred.push(path)
        return
      }
      validateField(path)
    }
    function fgFlushDeferred() {
      var paths = fgDeferred
      fgDeferred = []
      paths.forEach(function (path) { validateField(path) })
    }
    function fgPointerEnd() {
      if (!fgPressing) return
      fgPressing = false
      setTimeout(fgFlushDeferred, 0)
    }
    form.addEventListener('pointerdown', function () {
      fgFlushDeferred()
      fgPressing = true
    }, true)
    window.addEventListener('pointerup', fgPointerEnd)
    window.addEventListener('pointercancel', fgPointerEnd)
    form.addEventListener('focusout', function (event) {
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path) fgBlurValidate(path)
    })
    form.addEventListener('input', onFieldEvent)
    form.addEventListener('change', onFieldEvent)
    function onFieldEvent(event) {
      updateConditions()
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path && touched[path]) validateField(path)
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault()
      var failed = 0
      Object.keys(FG_VALIDATORS).forEach(function (path) {
        touched[path] = true
        if (!validateField(path)) failed++
      })
      if (failed > 0) {
        fgAnnounce(fgErrorsText(failed))
        // Move each tabs/steps host to its first section holding an error
        // (unless the visible one already shows one).
        FG_SECTIONS.forEach(function (meta) {
          var current = meta.stepPaths[fgSecState[meta.key]] || []
          if (current.some(fgHasError)) return
          for (var i = 0; i < meta.stepPaths.length; i++) {
            if ((meta.stepPaths[i] || []).some(fgHasError)) { fgSetSec(meta, i); break }
          }
        })
        return
      }
      var data = buildPayload()
      var out = document.getElementById('fg-result')
      out.textContent = JSON.stringify(data, null, 2)
      out.hidden = false
      fgAnnounce("Form submitted.")
      console.log('Form submitted', data)
    })

    updateConditions()
  })()
  </script>
</body>
</html>
"
`;

exports[`react target > snapshot (bootstrap5) 1`] = `
"// Generated by FormsGen — no runtime dependencies beyond React.
import React, { useEffect, useRef, useState } from 'react'

function fgIsEmpty(v) {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
function fgSize(v) {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}

type FormData = {
  full_name: string
  email: string
  website: string
  seats: number | null
  satisfaction: number
  city: string
  zip: string
  account: {
    username: string
    password: string
    bio: string
    birthday: string
  }
  plan: string | null
  interests: string[]
  channels: string[]
  topics: string[]
  contact_method: string | null
  contact_phone: string
  contact_other: string
  twitter: string
  github: string
  shipping_city: string
  order_notes: string
  newsletter: boolean
  terms: boolean
}

const INITIAL: FormData = {
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: ""
  },
  plan: null,
  interests: [],
  channels: [],
  topics: [],
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false
}

function fgVisible_contact_phone(data: FormData) {
  return ((data.contact_method === "phone"))
}
function fgVisible_contact_other(data: FormData) {
  return ((data.contact_method === "other"))
}

const validators: Record<string, (data: FormData) => string | null> = {
  'full_name': function (data: FormData) {
  const v = data.full_name
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function (data: FormData) {
  const v = data.email
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function (data: FormData) {
  const v = data.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function (data: FormData) {
  const v = data.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'plan': function (data: FormData) {
  const v = data.plan
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'topics': function (data: FormData) {
  const v = data.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'shipping_city': function (data: FormData) {
  const v = data.shipping_city
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "website": data.website,
    "seats": data.seats,
    "satisfaction": data.satisfaction,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "password": data.account.password,
      "bio": data.account.bio,
      "birthday": data.account.birthday,
    },
    "plan": data.plan,
    "interests": data.interests,
    "channels": data.channels,
    "topics": data.topics,
    "contact_method": data.contact_method,
    ...(fgVisible_contact_phone(data) ? { "contact_phone": data.contact_phone } : {}),
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "twitter": data.twitter,
    "github": data.github,
    "shipping_city": data.shipping_city,
    "order_notes": data.order_notes,
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]

function fgErrorsText(count: number): string {
  const forms: Record<string, string> = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgAnnouncement, setFgAnnouncement] = useState('')
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)
  const [tagDrafts, setTagDrafts] = useState<Record<string, string>>({})

  // Polite aria-live region; cleared first so repeated text re-announces.
  function fgAnnounce(message: string): void {
    setFgAnnouncement('')
    setTimeout(() => setFgAnnouncement(message), 50)
  }

  function fgGo_ks_wizard(index: number): void {
    setFgSec_ks_wizard(index)
    fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
  }

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = validators[path]
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) fgGo_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = validators[path]
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
