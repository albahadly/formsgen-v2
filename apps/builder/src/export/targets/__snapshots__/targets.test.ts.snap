      input.addEventListener('blur', function () {
        addDraft()
        fgBlurValidate(path)
      })
    })

    // Polite aria-live region; cleared first so repeated text re-announces.
    function fgAnnounce(message) {
      var live = document.getElementById('fg-live')
      if (!live) return
      live.textContent = ''
      setTimeout(function () { live.textContent = message }, 50)
    }
    function fgErrorsText(count) {
      const forms = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
      const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
      return text.split('{n}').join(String(count))
    }

    var FG_SECTIONS = [{"key":"ks_social_tabs","kind":"tabs","count":2,"tabActive":"-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600","tabBase":"-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700","stepActive":"flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100","stepBase":"flex items-center gap-2","stepPaths":[["twitter"],["github"]],"announce":[]},{"key":"ks_wizard","kind":"steps","count":2,"tabActive":"-mb-px border-b-2 border-indigo-600 px-3 py-2 text-sm font-semibold text-indigo-600","tabBase":"-mb-px border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700","stepActive":"flex items-center gap-2 font-semibold text-gray-900 dark:text-gray-100","stepBase":"flex items-center gap-2","stepPaths":[["shipping_city"],["order_notes"]],"announce":["Step 1 of 2: Shipping","Step 2 of 2: Review"]}]
    var FG_SUBMIT_GATE = ["ks_wizard"]
    var fgSecState = {}
    function fgUpdateSubmit() {
      var btn = document.querySelector('[data-fg-submit]')
      if (!btn || FG_SUBMIT_GATE.length === 0) return
      var ready = FG_SUBMIT_GATE.every(function (key) {
        var meta = null
        FG_SECTIONS.forEach(function (m) { if (m.key === key) meta = m })
        return !meta || (fgSecState[key] || 0) >= meta.count - 1
      })
      btn.hidden = !ready
    }
    function fgSetSec(meta, index, speak) {
      fgSecState[meta.key] = index
      if (speak && meta.announce[index]) fgAnnounce(meta.announce[index])
      var panels = document.querySelectorAll('[data-fg-sec-panel]')
      Array.prototype.forEach.call(panels, function (panel) {
        var value = panel.getAttribute('data-fg-sec-panel')
        if (value.indexOf(meta.key + ':') === 0) panel.hidden = value !== meta.key + ':' + index
      })
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          var active = btn.getAttribute('data-fg-sec-btn') === meta.key + ':' + index
          btn.className = active ? meta.tabActive : meta.tabBase
        },
      )
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-item^="' + meta.key + ':"]'),
        function (item) {
          var active = item.getAttribute('data-fg-sec-item') === meta.key + ':' + index
          item.className = active ? meta.stepActive : meta.stepBase
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.hidden = index === 0
      if (nextBtn) nextBtn.hidden = index >= meta.count - 1
      fgUpdateSubmit()
    }
    FG_SECTIONS.forEach(function (meta) {
      fgSecState[meta.key] = 0
      Array.prototype.forEach.call(
        document.querySelectorAll('[data-fg-sec-btn^="' + meta.key + ':"]'),
        function (btn) {
          btn.addEventListener('click', function () {
            fgSetSec(meta, Number(btn.getAttribute('data-fg-sec-btn').split(':')[1]))
          })
        },
      )
      var back = document.querySelector('[data-fg-step-back="' + meta.key + '"]')
      var nextBtn = document.querySelector('[data-fg-step-next="' + meta.key + '"]')
      if (back) back.addEventListener('click', function () {
        fgSetSec(meta, Math.max(0, fgSecState[meta.key] - 1), true)
      })
      if (nextBtn) nextBtn.addEventListener('click', function () {
        var ok = true
        var paths = meta.stepPaths[fgSecState[meta.key]] || []
        paths.forEach(function (path) {
          touched[path] = true
          if (!validateField(path)) ok = false
        })
        if (ok) fgSetSec(meta, Math.min(meta.count - 1, fgSecState[meta.key] + 1), true)
      })
      fgSetSec(meta, 0)
    })

    function buildPayload() {
      return {
        "full_name": fgGet("full_name"),
        "email": fgGet("email"),
        "website": fgGet("website"),
        "seats": fgGet("seats"),
        "satisfaction": fgGet("satisfaction"),
        "city": fgGet("city"),
        "zip": fgGet("zip"),
        "account": {
          "username": fgGet("account.username"),
          "password": fgGet("account.password"),
          "bio": fgGet("account.bio"),
          "birthday": fgGet("account.birthday"),
        },
        "plan": fgGet("plan"),
        "interests": fgGet("interests"),
        "channels": fgGet("channels"),
        "topics": fgGet("topics"),
        "contact_method": fgGet("contact_method"),
        ...(fgVisible_contact_phone() ? { "contact_phone": fgGet("contact_phone") } : {}),
        ...(fgVisible_contact_other() ? { "contact_other": fgGet("contact_other") } : {}),
        "twitter": fgGet("twitter"),
        "github": fgGet("github"),
        "shipping_city": fgGet("shipping_city"),
        "order_notes": fgGet("order_notes"),
        "newsletter": fgGet("newsletter"),
        "terms": fgGet("terms"),
      }
    }

    var form = document.getElementById('fg-form')
    // A blur error appearing while a pointer is held reflows the form and
    // the release misses its target; defer blur validation until the press
    // ends (after the click has been dispatched).
    var fgPressing = false
    var fgDeferred = []
    function fgBlurValidate(path) {
      touched[path] = true
      if (fgPressing) {
        if (fgDeferred.indexOf(path) === -1) fgDeferred.push(path)
        return
      }
      validateField(path)
    }
    function fgFlushDeferred() {
      var paths = fgDeferred
      fgDeferred = []
      paths.forEach(function (path) { validateField(path) })
    }
    function fgPointerEnd() {
      if (!fgPressing) return
      fgPressing = false
      setTimeout(fgFlushDeferred, 0)
    }
    form.addEventListener('pointerdown', function () {
      fgFlushDeferred()
      fgPressing = true
    }, true)
    window.addEventListener('pointerup', fgPointerEnd)
    window.addEventListener('pointercancel', fgPointerEnd)
    form.addEventListener('focusout', function (event) {
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path) fgBlurValidate(path)
    })
    form.addEventListener('input', onFieldEvent)
    form.addEventListener('change', onFieldEvent)
    function onFieldEvent(event) {
      updateConditions()
      var path = event.target.getAttribute && event.target.getAttribute('data-fg-path')
      if (path && touched[path]) validateField(path)
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault()
      var failed = 0
      Object.keys(FG_VALIDATORS).forEach(function (path) {
        touched[path] = true
        if (!validateField(path)) failed++
      })
      if (failed > 0) {
        fgAnnounce(fgErrorsText(failed))
        // Move each tabs/steps host to its first section holding an error
        // (unless the visible one already shows one).
        FG_SECTIONS.forEach(function (meta) {
          var current = meta.stepPaths[fgSecState[meta.key]] || []
          if (current.some(fgHasError)) return
          for (var i = 0; i < meta.stepPaths.length; i++) {
            if ((meta.stepPaths[i] || []).some(fgHasError)) { fgSetSec(meta, i); break }
          }
        })
        return
      }
      var data = buildPayload()
      var out = document.getElementById('fg-result')
      out.textContent = JSON.stringify(data, null, 2)
      out.hidden = false
      fgAnnounce("Form submitted.")
      console.log('Form submitted', data)
    })

    updateConditions()
  })()
  </script>
</body>
</html>
"
`;

exports[`html target > snapshot (vanilla) 1`] = `
"<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
