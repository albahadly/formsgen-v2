        {((form.contact_method === "phone")) && (
          <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
            <div className="fg-field">
              <label className="fg-label" htmlFor="fg_contact_phone">Phone number</label>
              <input id="fg_contact_phone" type="tel" value={form.contact_phone} className={errors['contact_phone'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('contact_phone', e.target.value)} onBlur={() => touch('contact_phone')} />
              {errors['contact_phone'] && <p className="fg-error" role="alert">{errors['contact_phone']}</p>}
            </div>
          </div>
        )}
        {((form.contact_method === "other")) && (
          <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
            <div className="fg-field">
              <label className="fg-label" htmlFor="fg_contact_other">Describe your preferred method</label>
              <textarea id="fg_contact_other" rows={3} value={form.contact_other} className={errors['contact_other'] ? "fg-textarea fg-invalid" : "fg-textarea"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('contact_other', e.target.value)} onBlur={() => touch('contact_other')} />
              {errors['contact_other'] && <p className="fg-error" role="alert">{errors['contact_other']}</p>}
            </div>
          </div>
        )}
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div>
            <div className="fg-tab-list" role="tablist">
              <button type="button" className={fgSec_ks_social_tabs === 0 ? "fg-tab-button fg-tab-button--active" : "fg-tab-button"} onClick={() => setFgSec_ks_social_tabs(0)}>Social</button>
              <button type="button" className={fgSec_ks_social_tabs === 1 ? "fg-tab-button fg-tab-button--active" : "fg-tab-button"} onClick={() => setFgSec_ks_social_tabs(1)}>Code</button>
            </div>
            <div style={{ display: fgSec_ks_social_tabs === 0 ? undefined : 'none' }}>
              <div className="fg-grid">
                <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                  <div className="fg-field">
                    <label className="fg-label" htmlFor="fg_twitter">Twitter handle</label>
                    <input id="fg_twitter" type="text" value={form.twitter} className={errors['twitter'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('twitter', e.target.value)} onBlur={() => touch('twitter')} />
                    {errors['twitter'] && <p className="fg-error" role="alert">{errors['twitter']}</p>}
                  </div>
