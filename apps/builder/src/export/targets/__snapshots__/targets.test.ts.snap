      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">How did we do?<span class="fg-required" aria-hidden="true">*</span></legend>
          <div class="fg-matrix-scroll">
            <table class="fg-matrix">
              <thead><tr><td></td><th scope="col">Poor</th><th scope="col">OK</th><th scope="col">Great</th></tr></thead>
              <tbody>
              <tr><th scope="row">Speed</th><td><input id="fg_rating" type="radio" name="fg_rating_speed" value="1" v-model="form.rating['speed']" aria-label="Speed: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td><input id="fg_rating-0-1" type="radio" name="fg_rating_speed" value="2" v-model="form.rating['speed']" aria-label="Speed: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td><input id="fg_rating-0-2" type="radio" name="fg_rating_speed" value="3" v-model="form.rating['speed']" aria-label="Speed: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              <tr><th scope="row">Quality</th><td><input id="fg_rating-1-0" type="radio" name="fg_rating_quality" value="1" v-model="form.rating['quality']" aria-label="Quality: Poor" @change="revalidate('rating')" @blur="touch('rating')"></td><td><input id="fg_rating-1-1" type="radio" name="fg_rating_quality" value="2" v-model="form.rating['quality']" aria-label="Quality: OK" @change="revalidate('rating')" @blur="touch('rating')"></td><td><input id="fg_rating-1-2" type="radio" name="fg_rating_quality" value="3" v-model="form.rating['quality']" aria-label="Quality: Great" @change="revalidate('rating')" @blur="touch('rating')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['rating']" class="fg-error" role="alert">{{ errors['rating'] }}</p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-field">
          <legend class="fg-label">Where do you use each feature?</legend>
          <div class="fg-matrix-scroll">
            <table class="fg-matrix">
              <thead><tr><td></td><th scope="col">Web</th><th scope="col">Mobile</th></tr></thead>
              <tbody>
              <tr><th scope="row">Forms</th><td><input id="fg_usage" type="checkbox" name="fg_usage_forms" value="web" :checked="form.usage['forms'].includes('web')" aria-label="Forms: Web" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td><input id="fg_usage-0-1" type="checkbox" name="fg_usage_forms" value="mobile" :checked="form.usage['forms'].includes('mobile')" aria-label="Forms: Mobile" @change="form.usage['forms'] = fgToggleCell(['web', 'mobile'], form.usage['forms'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              <tr><th scope="row">Reports</th><td><input id="fg_usage-1-0" type="checkbox" name="fg_usage_reports" value="web" :checked="form.usage['reports'].includes('web')" aria-label="Reports: Web" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'web'); revalidate('usage')" @blur="touch('usage')"></td><td><input id="fg_usage-1-1" type="checkbox" name="fg_usage_reports" value="mobile" :checked="form.usage['reports'].includes('mobile')" aria-label="Reports: Mobile" @change="form.usage['reports'] = fgToggleCell(['web', 'mobile'], form.usage['reports'], 'mobile'); revalidate('usage')" @blur="touch('usage')"></td></tr>
              </tbody>
            </table>
          </div>
          <p v-if="errors['usage']" class="fg-error" role="alert">{{ errors['usage'] }}</p>
        </fieldset>
      </div>
      <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
        <fieldset class="fg-group" data-fg-repeater="references">
          <legend class="fg-group-label">References</legend>
          <div class="fg-repeater-items">
            <fieldset v-for="(item, i) in form.references" :key="fgKeyOf(item)" class="fg-repeater-item" data-fg-item tabindex="-1" :data-fg-drag="fgDragMark('references', i)" :data-fg-drop="fgDropMark('references', i)" @dragover="fgDragOver($event, 'references', i)" @drop="fgDropItem($event, 'references', i)">
              <legend class="fg-repeater-item-label">{{ fgItemLabel('references', i) }}</legend>
              <div class="fg-grid">
                <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                  <div class="fg-field">
                    <label class="fg-label" :for="'fg_references_' + i + '_name'">Name<span class="fg-required" aria-hidden="true">*</span></label>
                    <input :id="'fg_references_' + i + '_name'" v-model="item.name" type="text" class="fg-input" :class="{ 'fg-invalid': !!errors[('references.' + i + '.name')] }" @blur="touch(('references.' + i + '.name'))" @input="revalidate(('references.' + i + '.name'))">
                    <p v-if="errors[('references.' + i + '.name')]" class="fg-error" role="alert">{{ errors[('references.' + i + '.name')] }}</p>
                  </div>
                </div>
                <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
                  <div class="fg-field">
                    <div class="fg-checkbox-row">
                      <input :id="'fg_references_' + i + '_may_contact'" v-model="item.may_contact" type="checkbox" class="fg-checkbox" @change="touch(('references.' + i + '.may_contact'))">
                      <label class="fg-checkbox-label" :for="'fg_references_' + i + '_may_contact'">May we contact them?</label>
                    </div>
                    <p v-if="errors[('references.' + i + '.may_contact')]" class="fg-error" role="alert">{{ errors[('references.' + i + '.may_contact')] }}</p>
