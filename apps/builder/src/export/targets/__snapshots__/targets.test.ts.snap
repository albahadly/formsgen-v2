            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_account_avatar">Profile picture</label>
                <div class="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary">
                  <span class="fw-medium">Choose a file or drag it here</span>
                  <input id="fg_account_avatar" type="file" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept="image/*" :aria-invalid="errors['account.avatar'] ? 'true' : undefined" @change="fgPickFiles('account.avatar', $event)" @dragenter="fgDrag($event.currentTarget, true)" @dragleave="fgDrag($event.currentTarget, false)" @drop="fgDropFiles('account.avatar', $event)">
                </div>
                <ul v-if="form.account.avatar.length" class="list-group mt-2">
                  <li v-for="(file, fi) in form.account.avatar" :key="fi" class="list-group-item d-flex align-items-center gap-2">
                    <img v-if="file.type.startsWith('image/')" class="rounded object-fit-cover" :src="fgThumb(file)" alt="" width="40" height="40">
                    <span class="flex-grow-1 text-truncate">{{ file.name }}</span>
                    <span class="text-body-secondary small">{{ fgFileSize(file.size) }}</span>
                    <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" :aria-label="fgRemoveFileLabel(file.name)" @click="fgRemoveFile('account.avatar', fi)">×</button>
                  </li>
                </ul>
                <p v-if="fgFileNotes['account.avatar']" class="form-text mt-0 mb-0 fg-description" data-fg-file-note>{{ fgFileNotes['account.avatar'] }}</p>
                <p v-if="errors['account.avatar']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['account.avatar'] }}</p>
              </div>
            </div>
          </div>
        </fieldset>
