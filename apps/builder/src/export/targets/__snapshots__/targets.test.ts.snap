                <span v-if="form.references.length > 1" class="cursor-grab select-none px-1 text-xl leading-none text-gray-500 dark:text-gray-400" data-fg-handle draggable="true" aria-hidden="true" title="Drag to reorder" @dragstart="fgDragStart($event, 'references', i)" @dragend="fgDragEnd()">⠿</span>
                <button v-if="i > 0" type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600" data-fg-move="up" :aria-label="fgMoveLabel('references', i, 'up')" @click="fgMoveItem('references', i, -1)">↑</button>
                <button v-if="i < form.references.length - 1" type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600" data-fg-move="down" :aria-label="fgMoveLabel('references', i, 'down')" @click="fgMoveItem('references', i, 1)">↓</button>
                <button type="button" class="ms-auto text-sm text-red-600 underline hover:text-red-700 dark:text-red-400" :aria-label="fgRemoveLabel('references', i)" @click="fgRemoveItem('references', i)">Remove</button>
              </div>
            </fieldset>
          </div>
          <button v-if="form.references.length < 3" type="button" class="mt-4 rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-add="references" @click="fgAddItem('references')">Add reference</button>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_attachments">Attachments<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          <div class="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
            <span class="font-medium">Choose files or drag them here</span>
            <input id="fg_attachments" type="file" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept=".pdf,.doc,.docx" multiple :aria-invalid="errors['attachments'] ? 'true' : undefined" @change="fgPickFiles('attachments', $event)" @dragenter="fgDrag($event.currentTarget, true)" @dragleave="fgDrag($event.currentTarget, false)" @drop="fgDropFiles('attachments', $event)">
          </div>
          <ul v-if="form.attachments.length" class="flex flex-col gap-1.5">
            <li v-for="(file, fi) in form.attachments" :key="fi" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
              <span class="min-w-0 flex-1 truncate">{{ file.name }}</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">{{ fgFileSize(file.size) }}</span>
              <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" :aria-label="fgRemoveFileLabel(file.name)" @click="fgRemoveFile('attachments', fi)">×</button>
            </li>
          </ul>
          <p v-if="fgFileNotes['attachments']" class="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>{{ fgFileNotes['attachments'] }}</p>
          <p class="text-sm text-gray-500 dark:text-gray-400">Up to 3 PDF or Word files, 5 MB each</p>
          <p v-if="errors['attachments']" class="text-sm text-red-600" role="alert">{{ errors['attachments'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12" v-if='(!fgIsBlank(form.attachments))'>
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_attachments_note">Notes about the attachments</label>
          <textarea id="fg_attachments_note" v-model="form.attachments_note" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" :class="{ 'border-red-500 focus:ring-red-200': !!errors['attachments_note'] }" @blur="touch('attachments_note')" @input="revalidate('attachments_note')"></textarea>
          <p v-if="errors['attachments_note']" class="text-sm text-red-600" role="alert">{{ errors['attachments_note'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <div class="text-sm font-semibold"><span id="fg_about-label">About you</span></div>
          <div class="rounded-md border border-gray-300 bg-white shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-rich>
            <div class="flex flex-wrap gap-1 border-b border-gray-200 p-1 dark:border-gray-700" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
              <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
              <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
              <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
              <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
              <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
            </div>
            <div id="fg_about" class="min-h-24 px-3 py-2 text-base outline-none [overflow-wrap:anywhere] [&_ol]:list-decimal [&_ol]:ps-6 [&_ul]:list-disc [&_ul]:ps-6 [&_a]:text-indigo-600 [&_a]:underline [&_p]:mb-2" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" @blur="touch('about')"></div>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400">Bold, lists and links are kept.</p>
          <p v-if="errors['about']" class="text-sm text-red-600" role="alert">{{ errors['about'] }}</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">Meeting point</legend>
          <div class="flex flex-col gap-2" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
            <div class="isolate z-0 w-full rounded-md border border-gray-300 dark:border-gray-600" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
            <div class="flex flex-wrap items-end gap-2">
              <label class="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                <span>Latitude</span>
                <input id="fg_meet" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat>
              </label>
              <label class="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                <span>Longitude</span>
                <input id="fg_meet-lng" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng>
              </label>
              <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-mine>Use my location</button>
              <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-clear>Clear</button>
            </div>
            <p class="m-0 text-sm text-gray-600 empty:hidden dark:text-gray-400" aria-live="polite" data-fg-loc-status></p>
          </div>
          <p v-if="errors['meet']" class="text-sm text-red-600" role="alert">{{ errors['meet'] }}</p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <legend class="text-sm font-semibold">Signature</legend>
          <div class="flex flex-col gap-2" data-fg-sign>
            <canvas id="fg_signature" class="block w-full touch-none cursor-crosshair rounded-md border border-dashed border-gray-300 bg-white dark:border-gray-600" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature"></canvas>
            <div class="flex justify-end gap-2 [&>input]:min-w-0 [&>input]:flex-1">
              <input type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
              <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-sign-clear>Clear</button>
            </div>
          </div>
          <p v-if="errors['signature']" class="text-sm text-red-600" role="alert">{{ errors['signature'] }}</p>
        </fieldset>
      </div>
      <div class="col-span-12 md:col-span-12">
        <figure class="border-s-4 border-gray-300 ps-4 dark:border-gray-600">
          <blockquote class="text-base italic">
            <p>Forms are conversations.</p>
          </blockquote>
          <figcaption class="mt-1 text-sm text-gray-500 dark:text-gray-400">FormsGen</figcaption>
        </figure>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="fg-html text-base [&_a]:underline"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. &#123;&#123; not.vue }} &#64;razor &#123;jsx}</p><a>unsafe link</a><iframe :src="'https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7'" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
      </div>
      <div class="col-span-12 md:col-span-12">
        <a class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="col-span-12 md:col-span-12">
        <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
          <label class="text-sm font-semibold" for="fg_contact_method">Preferred contact method<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
          <select id="fg_contact_method" v-model="form.contact_method" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]" :class="{ 'border-red-500 focus:ring-red-200': !!errors['contact_method'] }" @blur="touch('contact_method')" @change="revalidate('contact_method')">
            <option value="" disabled>—</option>
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="other">Other</option>
          </select>
          <p v-if="errors['contact_method']" class="text-sm text-red-600" role="alert">{{ errors['contact_method'] }}</p>
        </div>
      </div>
