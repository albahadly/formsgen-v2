        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_attachments">Attachments<span className="text-danger fg-required" aria-hidden="true">*</span></label>
            <div className="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary">
              <span className="fw-medium">Choose files or drag them here</span>
              <input id="fg_attachments" type="file" className="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept=".pdf,.doc,.docx" multiple aria-invalid={errors['attachments'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('attachments', e.target)} onDragEnter={(e) => fgDrag(e.currentTarget, true)} onDragLeave={(e) => fgDrag(e.currentTarget, false)} onDrop={(e) => fgDropFiles('attachments', e)} />
            </div>
            {form.attachments.length > 0 && (
              <ul className="list-group mt-2">
                {form.attachments.map((file, fi) => (
                  <li key={fi} className="list-group-item d-flex align-items-center gap-2">
                    <span className="flex-grow-1 text-truncate">{file.name}</span>
                    <span className="text-body-secondary small">{fgFileSize(file.size)}</span>
                    <button type="button" className="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('attachments', fi)}>×</button>
                  </li>
                ))}
              </ul>
            )}
            {fgFileNotes['attachments'] && <p className="form-text mt-0 mb-0 fg-description" data-fg-file-note>{fgFileNotes['attachments']}</p>}
            <p className="form-text mt-0 mb-0 fg-description">Up to 3 PDF or Word files, 5 MB each</p>
            {errors['attachments'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['attachments']}</p>}
          </div>
        </div>
        {((!fgIsBlank(form.attachments))) && (
          <div className="col-12 col-md-12">
            <div className="d-flex flex-column fg-field">
              <label className="form-label fw-semibold small mb-0 fg-label" htmlFor="fg_attachments_note">Notes about the attachments</label>
              <textarea id="fg_attachments_note" rows={3} value={form.attachments_note} className={errors['attachments_note'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('attachments_note', e.target.value)} onBlur={() => touch('attachments_note')} />
              {errors['attachments_note'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['attachments_note']}</p>}
            </div>
          </div>
        )}
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column fg-field">
            <div className="form-label fw-semibold small mb-0 fg-label"><span id="fg_about-label">About you</span></div>
            <div className="border rounded bg-body" data-fg-rich>
              <div className="d-flex flex-wrap gap-1 border-bottom p-1" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" className="btn btn-sm btn-light fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabIndex={0}><b>B</b></button>
                <button type="button" className="btn btn-sm btn-light fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabIndex={-1}><i>I</i></button>
                <button type="button" className="btn btn-sm btn-light fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabIndex={-1}>•</button>
                <button type="button" className="btn btn-sm btn-light fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabIndex={-1}><span dir="ltr">1.</span></button>
                <button type="button" className="btn btn-sm btn-light fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabIndex={-1}>🔗</button>
              </div>
              <div id="fg_about" className="fg-richtext-editor" contentEditable role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext="about" onBlur={() => touch('about')}></div>
            </div>
            <p className="form-text mt-0 mb-0 fg-description">Bold, lists and links are kept.</p>
            {errors['about'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['about']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Meeting point</legend>
            <div className="d-flex flex-column gap-2" data-fg-loc="meet" data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div className="fg-location-map w-100 border rounded" style={{ height: '220px' }} role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div className="d-flex flex-wrap align-items-end gap-2">
                <label className="fg-location-coord d-flex flex-column gap-1 small">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" className="form-control" step="any" min="-90" max="90" inputMode="decimal" data-fg-loc-lat />
                </label>
                <label className="fg-location-coord d-flex flex-column gap-1 small">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" className="form-control" step="any" min="-180" max="180" inputMode="decimal" data-fg-loc-lng />
                </label>
                <button type="button" className="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-mine>Use my location</button>
                <button type="button" className="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-clear>Clear</button>
              </div>
              <p className="fg-location-status small mb-0" aria-live="polite" data-fg-loc-status></p>
            </div>
            {errors['meet'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['meet']}</p>}
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="d-flex flex-column fg-field">
            <legend className="form-label fw-semibold small mb-0 fg-label">Signature</legend>
            <div className="d-flex flex-column gap-2" data-fg-sign>
              <canvas id="fg_signature" className="fg-signature-pad d-block w-100 border rounded bg-white" style={{ height: '140px' }} role="img" aria-label="Signature pad: draw your signature here" data-fg-signature="signature"></canvas>
              <div className="d-flex justify-content-end gap-2">
                <input type="text" className="form-control" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type />
                <button type="button" className="btn btn-outline-secondary fw-semibold px-3" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            {errors['signature'] && <p className="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{errors['signature']}</p>}
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <figure className="mb-0 border-start border-4 ps-3">
            <blockquote className="blockquote fs-6 fst-italic mb-0">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption className="small text-body-secondary mt-1 mb-0">FormsGen</figcaption>
          </figure>
        </div>
        <div className="col-12 col-md-12">
          <div className="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style={{ color: "#b91c1c" }}>{"Closed on holidays. {{ not.vue }} @razor {jsx}"}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerPolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
        <div className="col-12 col-md-12">
          <a className="link-primary" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span className="visually-hidden"> (opens in a new tab)</span></a>
        </div>
