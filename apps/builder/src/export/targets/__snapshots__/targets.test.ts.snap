    setTagDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveTag(path: string, current: string[], index: number): void {
    setField(path, current.filter((_, i) => i !== index))
  }

  function fgPickFiles(path: string, input: HTMLInputElement): void {
    const picked = Array.from(input.files ?? [])
    input.value = ''
    if (picked.length === 0) return
    touched.current.add(path)
    setField(path, FG_FILE_MULTIPLE[path] ? [...fgFileList(form, path), ...picked] : picked.slice(0, 1))
  }

  function fgRemoveFile(path: string, index: number): void {
    const list = fgFileList(form, path)
    const file = list[index]
    if (file) fgReleaseThumb(file)
    touched.current.add(path)
    setField(path, list.filter((_, i) => i !== index))
  }

  function fgKeyAt(path: string, index: number): number {
    const keys = (fgKeys.current[path] ??= [])
    while (keys.length <= index) keys.push(fgNextKey.current++)
    return keys[index]!
  }

  function fgAddItem(path: string): void {
    const list = fgList(form, path)
    if (list.length >= (FG_ITEM_LIMITS[path]?.max ?? Number.POSITIVE_INFINITY)) return
    setField(path, [...list, FG_ITEM_DEFAULTS[path]!()])
    fgPendingFocus.current = { path, index: list.length }
    fgAnnounce("{label} added".split('{label}').join(fgItemLabel(path, list.length)))
  }

  function fgRemoveItem(path: string, index: number): void {
    const list = fgList(form, path)
    if (list.length <= (FG_ITEM_LIMITS[path]?.min ?? 0)) return
    const label = fgItemLabel(path, index)
    fgKeyAt(path, list.length - 1)
    fgKeys.current[path]!.splice(index, 1)
    const nextTouched = [...touched.current].map((k) => fgShiftKey(k, path, index)).filter((k): k is string => k !== null)
    touched.current = new Set(nextTouched)
    setErrors((prev) => {
      const next: Record<string, string> = {}
      for (const [key, message] of Object.entries(prev)) {
        const target = fgShiftKey(key, path, index)
        if (target !== null) next[target] = message
      }
      return next
    })
    setField(path, list.filter((_, i) => i !== index))
    fgPendingFocus.current = { path, index: -1 - index }
    fgAnnounce("{label} removed".split('{label}').join(label))
  }

  // After an add: focus the new item's first control. After a remove
  // (negative index): focus the item that took its place, or the add button.
  useEffect(() => {
    const pending = fgPendingFocus.current
    if (!pending) return
    fgPendingFocus.current = null
    const repeater = fgRoot.current?.querySelector(\`[data-fg-repeater="\${pending.path}"]\`)
    const items = Array.from(repeater?.querySelectorAll<HTMLElement>(':scope > div > [data-fg-item]') ?? [])
    if (pending.index >= 0) {
      const item = items[pending.index]
      const control = item?.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')
      ;(control ?? item)?.focus()
    } else {
      const removed = -1 - pending.index
      const target = items[Math.min(removed, items.length - 1)]
      ;(target ?? repeater?.querySelector<HTMLElement>('[data-fg-add]'))?.focus()
    }
  })

  function fgReset(): void {
    setForm(INITIAL)
    setErrors({})
    touched.current.clear()
    fgKeys.current = {}
    setResult(null)
    setTagDrafts({})
    fgAnnounce("The form was reset.")
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of fgAllPaths(form)) {
      touched.current.add(path)
      const message = fgValidatorFor(path)?.(form) ?? null
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) {
      if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_social_tabs(target)
      }
      if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_wizard(target)
      }
      fgAnnounce(fgErrorsText(Object.keys(nextErrors).length))
      return
    }
    const data = buildPayload(form)
    setResult(data)
    fgAnnounce("Form submitted.")
    onSubmit?.(data)
  }

  return (
    <form ref={fgRoot} className="container py-4" dir="ltr" noValidate onSubmit={handleSubmit} onPointerDownCapture={() => { fgFlush.current(); fgPressing.current = true }}>
      <div className="row g-3">
        <div className="col-12 col-md-12 text-center">
          <h2 className="fw-semibold text-primary">Kitchen Sink</h2>
        </div>
        <div className="col-12 col-md-12 text-center">
          <p className="text-secondary">Every implemented element appears in this form.</p>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_full_name">Full name<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "form-control is-invalid" : "form-control"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_email">Email<span className="text-danger ms-1" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "form-control is-invalid" : "form-control"} placeholder="jane&#64;example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "form-control form-control-sm is-invalid" : "form-control form-control-sm"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_seats">Seats</label>
            <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "form-control is-invalid" : "form-control"} min="1" max="50" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
            {errors['seats'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="form-range" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="form-text mt-0">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <hr className="border-top border-primary opacity-100" />
        </div>
        <div className="col-12 col-md-12">
          <div className="row g-3">
            <div className="col-12 col-md-6">
              <div className="d-flex flex-column gap-1">
                <label className="form-label fw-semibold mb-0" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="col-12 col-md-6">
              <div className="d-flex flex-column gap-1">
                <label className="visually-hidden" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="col-12 col-md-12 account-box">
          <fieldset className="border rounded p-3 bg-body-tertiary">
            <legend className="fw-semibold text-secondary small px-1">Account</legend>
            <div className="row g-3">
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_username">Username<span className="text-danger ms-1" aria-hidden="true">*</span></label>
                  <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  {errors['account.username'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "form-control form-control-lg is-invalid" : "form-control form-control-lg"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.bio']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_birthday">Birthday</label>
                  <input id="fg_account_birthday" type="date" value={form.account.birthday} className={errors['account.birthday'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.birthday', e.target.value)} onBlur={() => touch('account.birthday')} />
                  {errors['account.birthday'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.birthday']}</p>}
                </div>
              </div>
              <div className="col-12 col-md-12">
                <div className="d-flex flex-column gap-1">
                  <label className="form-label fw-semibold mb-0" htmlFor="fg_account_avatar">Profile picture</label>
                  <input id="fg_account_avatar" type="file" className="form-control" accept="image/*" aria-invalid={errors['account.avatar'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('account.avatar', e.target)} />
                  {form.account.avatar.length > 0 && (
                    <ul className="list-group mt-2">
                      {form.account.avatar.map((file, fi) => (
                        <li key={fi} className="list-group-item d-flex align-items-center gap-2">
                        {file.type.startsWith('image/') && <img className="rounded object-fit-cover" src={fgThumb(file)} alt="" width={40} height={40} />}
                          <span className="flex-grow-1 text-truncate">{file.name}</span>
                          <span className="text-body-secondary small">{fgFileSize(file.size)}</span>
                          <button type="button" className="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('account.avatar', fi)}>×</button>
                        </li>
                      ))}
                    </ul>
                  )}
                  {errors['account.avatar'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['account.avatar']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
            <legend className="form-label fw-semibold mb-0">Plan<span className="text-danger ms-1" aria-hidden="true">*</span></legend>
            <div className="d-flex flex-column gap-1">
              <label className="form-check" htmlFor="fg_plan_free">
                <input id="fg_plan_free" type="radio" className="form-check-input" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                <span>Free</span>
              </label>
              <label className="form-check" htmlFor="fg_plan_pro">
                <input id="fg_plan_pro" type="radio" className="form-check-input" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                <span>Pro</span>
              </label>
            </div>
          </fieldset>
            {errors['plan'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
            <legend className="form-label fw-semibold mb-0">Interests</legend>
            <div className="d-flex flex-column gap-1">
              <label className="form-check" htmlFor="fg_interests_news">
                <input id="fg_interests_news" type="checkbox" className="form-check-input" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                <span>News</span>
              </label>
              <label className="form-check" htmlFor="fg_interests_product">
                <input id="fg_interests_product" type="checkbox" className="form-check-input" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                <span>Product updates</span>
              </label>
            </div>
          </fieldset>
            {errors['interests'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "form-select is-invalid" : "form-select"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['channels']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_topics">Topics</label>
            <div className="form-control d-flex flex-wrap align-items-center gap-1">
              {form.topics.map((tag, index) => (
                <span key={tag} className="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1">{tag} <button type="button" className="border-0 bg-transparent p-0 ms-1 text-white" aria-label={'Remove ' + (tag)} onClick={() => fgRemoveTag('topics', form.topics, index)}>×</button></span>
              ))}
              <input id="fg_topics" type="text" className="border-0 p-0 flex-grow-1 shadow-none bg-transparent" value={tagDrafts['topics'] ?? ''} placeholder="Type and press Enter" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setTagDrafts((d) => ({ ...d, 'topics': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddTag('topics', form.topics) } }} onBlur={() => { fgAddTag('topics', form.topics); touch('topics') }} />
            </div>
            <p className="form-text mt-0">Free-text tags</p>
            {errors['topics'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['topics']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
            <legend className="form-label fw-semibold mb-0">Billing</legend>
            <div className="btn-group flex-wrap">
              <input id="fg_billing_monthly" type="radio" className="btn-check" checked={form.billing === 'monthly'} onChange={() => { setField('billing', 'monthly'); touch('billing') }} />
              <label className="btn btn-outline-primary" htmlFor="fg_billing_monthly">Monthly</label>
              <input id="fg_billing_yearly" type="radio" className="btn-check" checked={form.billing === 'yearly'} onChange={() => { setField('billing', 'yearly'); touch('billing') }} />
              <label className="btn btn-outline-primary" htmlFor="fg_billing_yearly">Yearly</label>
            </div>
          </fieldset>
            {errors['billing'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['billing']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <fieldset className="d-flex flex-column gap-1">
            <legend className="form-label fw-semibold mb-0">Extras</legend>
            <div className="d-grid gap-2">
              <input id="fg_extras_support" type="checkbox" className="btn-check" checked={form.extras.includes('support')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'support'] : form.extras.filter((v) => v !== 'support')); touch('extras') }} />
              <label className="btn btn-outline-primary text-start" htmlFor="fg_extras_support">Priority support</label>
              <input id="fg_extras_backup" type="checkbox" className="btn-check" checked={form.extras.includes('backup')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'backup'] : form.extras.filter((v) => v !== 'backup')); touch('extras') }} />
              <label className="btn btn-outline-primary text-start" htmlFor="fg_extras_backup">Daily backups</label>
            </div>
          </fieldset>
            {errors['extras'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['extras']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <div className="form-check form-switch">
              <input id="fg_notify" type="checkbox" role="switch" checked={form.notify} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('notify', e.target.checked); touch('notify') }} />
              <label className="form-check-label" htmlFor="fg_notify">Email notifications</label>
            </div>
            {errors['notify'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['notify']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_appointment">Appointment</label>
            <input id="fg_appointment" type="datetime-local" value={form.appointment} className={errors['appointment'] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('appointment', e.target.value)} onBlur={() => touch('appointment')} />
            {errors['appointment'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['appointment']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_brand_color">Brand color</label>
            <input id="fg_brand_color" type="color" value={form.brand_color} className={errors['brand_color'] ? "form-control form-control-color is-invalid" : "form-control form-control-color"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('brand_color', e.target.value)} onBlur={() => touch('brand_color')} />
            {errors['brand_color'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['brand_color']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <div className="d-flex flex-column gap-1">
            <label className="form-label fw-semibold mb-0" htmlFor="fg_volume">Volume</label>
            <input id="fg_volume" type="range" value={form.volume} className="form-range" min="0" max="10" step="1" aria-orientation="vertical" style={{ writingMode: 'vertical-lr', direction: 'rtl', alignSelf: 'flex-start', width: 'auto', height: '10rem' }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('volume', Number(e.target.value)); touch('volume') }} />
            <p className="form-text mt-0">{form.volume}</p>
            {errors['volume'] && <p className="invalid-feedback d-block mt-0" role="alert">{errors['volume']}</p>}
          </div>
        </div>
        <div className="col-12 col-md-12">
          <fieldset className="border rounded p-3 bg-body-tertiary" data-fg-repeater="references">
            <legend className="fw-semibold text-secondary small px-1">References</legend>
            <div className="d-flex flex-column gap-3">
              {form.references.map((item, i) => (
                <fieldset key={fgKeyAt('references', i)} className="border rounded p-3" data-fg-item tabIndex={-1}>
                  <legend className="float-none w-auto px-1 fs-6 fw-semibold mb-0">{fgItemLabel('references', i)}</legend>
                  <div className="row g-3">
                    <div className="col-12 col-md-12">
                      <div className="d-flex flex-column gap-1">
                        <label className="form-label fw-semibold mb-0" htmlFor={'fg_references_' + i + '_name'}>Name<span className="text-danger ms-1" aria-hidden="true">*</span></label>
                        <input id={'fg_references_' + i + '_name'} type="text" value={item.name} className={errors[('references.' + i + '.name')] ? "form-control is-invalid" : "form-control"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.name'), e.target.value)} onBlur={() => touch(('references.' + i + '.name'))} />
                        {errors[('references.' + i + '.name')] && <p className="invalid-feedback d-block mt-0" role="alert">{errors[('references.' + i + '.name')]}</p>}
                      </div>
                    </div>
                    <div className="col-12 col-md-12">
                      <div className="d-flex flex-column gap-1">
                        <div className="form-check">
                          <input id={'fg_references_' + i + '_may_contact'} type="checkbox" checked={item.may_contact} className="form-check-input" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField(('references.' + i + '.may_contact'), e.target.checked); touch(('references.' + i + '.may_contact')) }} />
                          <label className="form-check-label" htmlFor={'fg_references_' + i + '_may_contact'}>May we contact them?</label>
                        </div>
                        {errors[('references.' + i + '.may_contact')] && <p className="invalid-feedback d-block mt-0" role="alert">{errors[('references.' + i + '.may_contact')]}</p>}
