            <input id="fg_attachments" type="file" className="form-control" accept=".pdf,.doc,.docx" multiple aria-invalid={errors['attachments'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('attachments', e.target)} />
            {form.attachments.length > 0 && (
              <ul className="list-group mt-2">
