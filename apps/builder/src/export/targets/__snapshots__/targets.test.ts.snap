                    <textarea id="fg_order_notes" rows={3} value={form.order_notes} className={errors['order_notes'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('order_notes', e.target.value)} onBlur={() => touch('order_notes')} />
                    {errors['order_notes'] && <p className="text-xs text-red-600" role="alert">{errors['order_notes']}</p>}
                  </div>
                </div>
              </div>
            </div>
            <div className="mt-4 flex justify-between gap-2">
              {fgSec_ks_wizard > 0 && <button type="button" className="rounded-md border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" onClick={() => fgGo_ks_wizard(fgSec_ks_wizard - 1)}>Back</button>}
              {fgSec_ks_wizard < 1 && <button type="button" className="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300" onClick={fgNext_ks_wizard}>Next</button>}
              {fgSec_ks_wizard === 1 && <button type="submit" className="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300">Submit</button>}
            </div>
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <div className="flex items-center gap-2">
              <input id="fg_newsletter" type="checkbox" checked={form.newsletter} className="h-4 w-4 rounded border-gray-300 accent-indigo-600" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('newsletter', e.target.checked); touch('newsletter') }} />
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_newsletter">Subscribe to the newsletter</label>
            </div>
            {errors['newsletter'] && <p className="text-xs text-red-600" role="alert">{errors['newsletter']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5">
            <div className="flex items-center gap-2">
              <input id="fg_terms" type="checkbox" checked={form.terms} className="h-4 w-4 rounded border-gray-300 accent-indigo-600" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('terms', e.target.checked); touch('terms') }} />
              <label className="inline-flex items-center gap-2 text-sm" htmlFor="fg_terms">I accept the terms<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            </div>
            {errors['terms'] && <p className="text-xs text-red-600" role="alert">{errors['terms']}</p>}
          </div>
        </div>
      </div>
      <div className="sr-only" role="status" aria-live="polite" aria-atomic="true">{fgAnnouncement}</div>
      {result && <pre className="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-xs text-green-300">{JSON.stringify(result, null, 2)}</pre>}
    </form>
  )
}
"
`;

exports[`react target > snapshot (vanilla) 1`] = `
"// Generated by FormsGen — no runtime dependencies beyond React.
import React, { useEffect, useRef, useState } from 'react'
import './KitchenSinkForm.css'

function fgIsEmpty(v) {
  if (v === null || v === undefined) return true
  if (typeof v === 'string') return v.trim() === ''
  if (Array.isArray(v)) return v.length === 0
  return false
}
function fgSize(v) {
  if (typeof v === 'number') return Number.isFinite(v) ? v : null
  if (typeof v === 'string') return v.length
  if (Array.isArray(v)) return v.length
  return null
}

type FormData = {
  full_name: string
  email: string
  website: string
  seats: number | null
  satisfaction: number
  city: string
  zip: string
  account: {
    username: string
    password: string
    bio: string
    birthday: string
  }
  plan: string | null
  interests: string[]
  channels: string[]
  topics: string[]
  contact_method: string | null
  contact_phone: string
  contact_other: string
  twitter: string
  github: string
  shipping_city: string
  order_notes: string
  newsletter: boolean
  terms: boolean
}

const INITIAL: FormData = {
  full_name: "",
  email: "",
  website: "",
  seats: null,
  satisfaction: 5,
  city: "",
  zip: "",
  account: {
    username: "",
    password: "",
    bio: "",
    birthday: ""
  },
  plan: null,
  interests: [],
  channels: [],
  topics: [],
  contact_method: null,
  contact_phone: "",
  contact_other: "",
  twitter: "",
  github: "",
  shipping_city: "",
  order_notes: "",
  newsletter: true,
  terms: false
}

function fgVisible_contact_phone(data: FormData) {
  return ((data.contact_method === "phone"))
}
function fgVisible_contact_other(data: FormData) {
  return ((data.contact_method === "other"))
}

const validators: Record<string, (data: FormData) => string | null> = {
  'full_name': function (data: FormData) {
  const v = data.full_name
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
  return null
  },
  'email': function (data: FormData) {
  const v = data.email
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
  return null
  },
  'website': function (data: FormData) {
  const v = data.website
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
  return null
  },
  'seats': function (data: FormData) {
  const v = data.seats
  if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
  return null
  },
  'zip': function (data: FormData) {
  const v = data.zip
  if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
  return null
  },
  'account.username': function (data: FormData) {
  const v = data.account.username
  if (fgIsEmpty(v) || v === false) return "This field is required"
  if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
  return null
  },
  'account.bio': function (data: FormData) {
  const v = data.account.bio
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
  return null
  },
  'plan': function (data: FormData) {
  const v = data.plan
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'topics': function (data: FormData) {
  const v = data.topics
  if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
  return null
  },
  'contact_method': function (data: FormData) {
  const v = data.contact_method
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'shipping_city': function (data: FormData) {
  const v = data.shipping_city
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
  'terms': function (data: FormData) {
  const v = data.terms
  if (fgIsEmpty(v) || v === false) return "This field is required"
  return null
  },
}

function buildPayload(data: FormData): Record<string, unknown> {
  return {
    "full_name": data.full_name,
    "email": data.email,
    "website": data.website,
    "seats": data.seats,
    "satisfaction": data.satisfaction,
    "city": data.city,
    "zip": data.zip,
    "account": {
      "username": data.account.username,
      "password": data.account.password,
      "bio": data.account.bio,
      "birthday": data.account.birthday,
    },
    "plan": data.plan,
    "interests": data.interests,
    "channels": data.channels,
    "topics": data.topics,
    "contact_method": data.contact_method,
    ...(fgVisible_contact_phone(data) ? { "contact_phone": data.contact_phone } : {}),
    ...(fgVisible_contact_other(data) ? { "contact_other": data.contact_other } : {}),
    "twitter": data.twitter,
    "github": data.github,
    "shipping_city": data.shipping_city,
    "order_notes": data.order_notes,
    "newsletter": data.newsletter,
    "terms": data.terms,
  }
}

const fgSecPaths_ks_social_tabs = [["twitter"], ["github"]]
const fgSecPaths_ks_wizard = [["shipping_city"], ["order_notes"]]
const fgSecAnnounce_ks_wizard = ["Step 1 of 2: Shipping", "Step 2 of 2: Review"]

function fgErrorsText(count: number): string {
  const forms: Record<string, string> = { one: "1 error. Please fix the highlighted fields.", other: "{n} errors. Please fix the highlighted fields." }
  const text = forms[count == 1 ? 'one' : 'other'] ?? forms.other
  return text.split('{n}').join(String(count))
}

export default function KitchenSinkForm({
  onSubmit,
}: {
  onSubmit?: (data: Record<string, unknown>) => void
}) {
  const [form, setForm] = useState<FormData>(INITIAL)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [result, setResult] = useState<Record<string, unknown> | null>(null)
  const touched = useRef(new Set<string>())
  const [fgAnnouncement, setFgAnnouncement] = useState('')
  const [fgSec_ks_social_tabs, setFgSec_ks_social_tabs] = useState(0)
  const [fgSec_ks_wizard, setFgSec_ks_wizard] = useState(0)
  const [tagDrafts, setTagDrafts] = useState<Record<string, string>>({})

  // Polite aria-live region; cleared first so repeated text re-announces.
  function fgAnnounce(message: string): void {
    setFgAnnouncement('')
    setTimeout(() => setFgAnnouncement(message), 50)
  }

  function fgGo_ks_wizard(index: number): void {
    setFgSec_ks_wizard(index)
    fgAnnounce(fgSecAnnounce_ks_wizard[index] ?? '')
  }

  function fgNext_ks_wizard(): void {
    let ok = true
    const next = { ...errors }
    for (const path of fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []) {
      touched.current.add(path)
      const validate = validators[path]
      const message = validate ? validate(form) : null
      if (message) { next[path] = message; ok = false } else { delete next[path] }
    }
    setErrors(next)
    if (ok && fgSec_ks_wizard < 1) fgGo_ks_wizard(fgSec_ks_wizard + 1)
  }


  function applyError(path: string, message: string | null): void {
    setErrors((prev) => {
      const next = { ...prev }
      if (message) next[path] = message
      else delete next[path]
      return next
    })
  }

  function validateField(path: string, data: FormData): void {
    const validate = validators[path]
    if (validate) applyError(path, validate(data))
  }

  function setField(path: string, value: unknown): void {
    const next = structuredClone(form) as unknown as Record<string, unknown>
    const segments = path.split('.')
    let target = next
    for (const segment of segments.slice(0, -1)) {
      target = target[segment] as Record<string, unknown>
    }
    target[segments[segments.length - 1] as keyof typeof target] = value
    const typed = next as unknown as FormData
    setForm(typed)
    if (touched.current.has(path)) validateField(path, typed)
  }

  // A blur error appearing while a pointer is held reflows the form and the
  // release misses its target; defer blur validation until the press ends.
  // Deferred work reads the latest state through refs, not this closure.
  const formRef = useRef(form)
  formRef.current = form
  const fgPressing = useRef(false)
  const fgDeferred = useRef(new Set<string>())
  const fgFlush = useRef(() => {})
  fgFlush.current = () => {
    const paths = [...fgDeferred.current]
    fgDeferred.current.clear()
    for (const path of paths) {
      touched.current.add(path)
      validateField(path, formRef.current)
    }
  }
  useEffect(() => {
    function end(): void {
      if (!fgPressing.current) return
      fgPressing.current = false
      setTimeout(() => fgFlush.current(), 0)
    }
    window.addEventListener('pointerup', end)
    window.addEventListener('pointercancel', end)
    return () => {
      window.removeEventListener('pointerup', end)
      window.removeEventListener('pointercancel', end)
    }
  }, [])

  function touch(path: string): void {
    if (fgPressing.current) {
      fgDeferred.current.add(path)
      return
    }
    touched.current.add(path)
    validateField(path, form)
  }

  function fgAddTag(path: string, current: string[]): void {
    const draft = (tagDrafts[path] ?? '').trim()
    if (draft !== '' && !current.includes(draft)) setField(path, [...current, draft])
    setTagDrafts((d) => ({ ...d, [path]: '' }))
  }

  function fgRemoveTag(path: string, current: string[], index: number): void {
    setField(path, current.filter((_, i) => i !== index))
  }

  function handleSubmit(event: React.FormEvent): void {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}
    for (const path of Object.keys(validators)) {
      touched.current.add(path)
      const message = validators[path]!(form)
      if (message) nextErrors[path] = message
    }
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) {
      if (!(fgSecPaths_ks_social_tabs[fgSec_ks_social_tabs] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_social_tabs.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_social_tabs(target)
      }
      if (!(fgSecPaths_ks_wizard[fgSec_ks_wizard] ?? []).some((p) => nextErrors[p])) {
        const target = fgSecPaths_ks_wizard.findIndex((paths) => paths.some((p) => nextErrors[p]))
        if (target !== -1) setFgSec_ks_wizard(target)
      }
      fgAnnounce(fgErrorsText(Object.keys(nextErrors).length))
      return
    }
    const data = buildPayload(form)
    setResult(data)
    fgAnnounce("Form submitted.")
    onSubmit?.(data)
  }

  return (
    <form className="fg-form" dir="ltr" noValidate onSubmit={handleSubmit} onPointerDownCapture={() => { fgFlush.current(); fgPressing.current = true }}>
      <div className="fg-grid">
        <div className="fg-cell fg-align-center" style={{ gridColumn: 'span 12 / span 12' }}>
          <h2 className="fg-heading fg-tone-primary">Kitchen Sink</h2>
        </div>
        <div className="fg-cell fg-align-center" style={{ gridColumn: 'span 12 / span 12' }}>
          <p className="fg-paragraph">Every implemented element appears in this form.</p>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_full_name">Full name<span className="fg-required" aria-hidden="true">*</span></label>
            <input id="fg_full_name" type="text" value={form.full_name} className={errors['full_name'] ? "fg-input fg-invalid" : "fg-input"} placeholder="Jane Doe" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('full_name', e.target.value)} onBlur={() => touch('full_name')} />
            {errors['full_name'] && <p className="fg-error" role="alert">{errors['full_name']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_email">Email<span className="fg-required" aria-hidden="true">*</span></label>
            <input id="fg_email" type="email" value={form.email} className={errors['email'] ? "fg-input fg-invalid" : "fg-input"} placeholder="jane@example.com" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('email', e.target.value)} onBlur={() => touch('email')} />
            {errors['email'] && <p className="fg-error" role="alert">{errors['email']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_website">Website</label>
            <input id="fg_website" type="url" value={form.website} className={errors['website'] ? "fg-input fg-control--sm fg-invalid" : "fg-input fg-control--sm"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('website', e.target.value)} onBlur={() => touch('website')} />
            {errors['website'] && <p className="fg-error" role="alert">{errors['website']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_seats">Seats</label>
            <input id="fg_seats" type="number" value={form.seats ?? ''} className={errors['seats'] ? "fg-input fg-invalid" : "fg-input"} min="1" max="50" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('seats', e.target.value === '' ? null : Number(e.target.value))} onBlur={() => touch('seats')} />
            {errors['seats'] && <p className="fg-error" role="alert">{errors['seats']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-field">
            <label className="fg-label" htmlFor="fg_satisfaction">Satisfaction</label>
            <input id="fg_satisfaction" type="range" value={form.satisfaction} className="fg-range" min="0" max="10" step="1" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('satisfaction', Number(e.target.value)); touch('satisfaction') }} />
            <p className="fg-description">{form.satisfaction}</p>
            {errors['satisfaction'] && <p className="fg-error" role="alert">{errors['satisfaction']}</p>}
          </div>
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <hr className="fg-divider fg-tone-primary" />
        </div>
        <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
          <div className="fg-grid">
            <div className="fg-cell" style={{ gridColumn: 'span 6 / span 6' }}>
              <div className="fg-field">
                <label className="fg-label" htmlFor="fg_city">City</label>
                <input id="fg_city" type="text" value={form.city} className={errors['city'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('city', e.target.value)} onBlur={() => touch('city')} />
                {errors['city'] && <p className="fg-error" role="alert">{errors['city']}</p>}
              </div>
            </div>
            <div className="fg-cell" style={{ gridColumn: 'span 6 / span 6' }}>
              <div className="fg-field">
                <label className="fg-sr-only" htmlFor="fg_zip">ZIP</label>
                <input id="fg_zip" type="text" value={form.zip} className={errors['zip'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('zip', e.target.value)} onBlur={() => touch('zip')} />
                {errors['zip'] && <p className="fg-error" role="alert">{errors['zip']}</p>}
              </div>
            </div>
          </div>
        </div>
        <div className="fg-cell account-box" style={{ gridColumn: 'span 12 / span 12' }}>
          <fieldset className="fg-group">
            <legend className="fg-group-label">Account</legend>
            <div className="fg-grid">
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_username">Username<span className="fg-required" aria-hidden="true">*</span></label>
                  <input id="fg_account_username" type="text" value={form.account.username} className={errors['account.username'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.username', e.target.value)} onBlur={() => touch('account.username')} />
                  {errors['account.username'] && <p className="fg-error" role="alert">{errors['account.username']}</p>}
                </div>
              </div>
              <div className="fg-cell" style={{ gridColumn: 'span 12 / span 12' }}>
                <div className="fg-field">
                  <label className="fg-label" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "fg-input fg-invalid" : "fg-input"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="fg-error" role="alert">{errors['account.password']}</p>}
                </div>
