                  <label className="text-sm font-semibold" htmlFor="fg_account_password">Password</label>
                  <input id="fg_account_password" type="password" value={form.account.password} className={errors['account.password'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.password', e.target.value)} onBlur={() => touch('account.password')} />
                  {errors['account.password'] && <p className="text-sm text-red-600" role="alert">{errors['account.password']}</p>}
                </div>
              </div>
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_bio">Bio</label>
                  <textarea id="fg_account_bio" rows={4} value={form.account.bio} className={errors['account.bio'] ? "w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-xl leading-normal shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-4 py-2 text-xl leading-normal shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLTextAreaElement>) => setField('account.bio', e.target.value)} onBlur={() => touch('account.bio')} />
                  {errors['account.bio'] && <p className="text-sm text-red-600" role="alert">{errors['account.bio']}</p>}
                </div>
              </div>
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_birthday">Birthday</label>
                  <input id="fg_account_birthday" type="date" value={form.account.birthday} className={errors['account.birthday'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('account.birthday', e.target.value)} onBlur={() => touch('account.birthday')} />
                  {errors['account.birthday'] && <p className="text-sm text-red-600" role="alert">{errors['account.birthday']}</p>}
                </div>
              </div>
              <div className="col-span-12 md:col-span-12">
                <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                  <label className="text-sm font-semibold" htmlFor="fg_account_avatar">Profile picture</label>
                  <div className="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400">
                    <span className="font-medium">Choose a file or drag it here</span>
                    <input id="fg_account_avatar" type="file" className="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept="image/*" aria-invalid={errors['account.avatar'] ? true : undefined} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgPickFiles('account.avatar', e.target)} onDragEnter={(e) => fgDrag(e.currentTarget, true)} onDragLeave={(e) => fgDrag(e.currentTarget, false)} onDrop={(e) => fgDropFiles('account.avatar', e)} />
                  </div>
                  {form.account.avatar.length > 0 && (
                    <ul className="flex flex-col gap-1.5">
                      {form.account.avatar.map((file, fi) => (
                        <li key={fi} className="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                        {file.type.startsWith('image/') && <img className="h-10 w-10 rounded object-cover" src={fgThumb(file)} alt="" width={40} height={40} />}
                          <span className="min-w-0 flex-1 truncate">{file.name}</span>
                          <span className="text-sm text-gray-500 dark:text-gray-400">{fgFileSize(file.size)}</span>
                          <button type="button" className="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label={fgRemoveFileLabel(file.name)} onClick={() => fgRemoveFile('account.avatar', fi)}>×</button>
                        </li>
                      ))}
                    </ul>
                  )}
                  {fgFileNotes['account.avatar'] && <p className="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>{fgFileNotes['account.avatar']}</p>}
                  {errors['account.avatar'] && <p className="text-sm text-red-600" role="alert">{errors['account.avatar']}</p>}
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5" aria-labelledby="fg_plan-legend">
            <legend className="text-sm font-semibold"><span id="fg_plan-legend">Plan</span><span className="ms-0.5 text-red-600" aria-hidden="true">*</span><span className="fg-tip"><button type="button" className="fg-tip-button" aria-label="More information" aria-describedby="fg_plan-tip">?</button><span role="tooltip" id="fg_plan-tip" className="fg-tip-text">You can switch plans at any time</span></span></legend>
            <div className="flex flex-col gap-1.5">
              <label className="inline-flex items-center gap-2 text-base" htmlFor="fg_plan-free">
                <input id="fg_plan-free" type="radio" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.plan === 'free'} onChange={() => { setField('plan', 'free'); touch('plan') }} />
                <span>Free</span>
              </label>
              <label className="inline-flex items-center gap-2 text-base" htmlFor="fg_plan-pro">
                <input id="fg_plan-pro" type="radio" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.plan === 'pro'} onChange={() => { setField('plan', 'pro'); touch('plan') }} />
                <span>Pro</span>
              </label>
            </div>
          </fieldset>
            {errors['plan'] && <p className="text-sm text-red-600" role="alert">{errors['plan']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Interests</legend>
            <div className="flex flex-col gap-1.5">
              <label className="inline-flex items-center gap-2 text-base" htmlFor="fg_interests-news">
                <input id="fg_interests-news" type="checkbox" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.interests.includes('news')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'news'] : form.interests.filter((v) => v !== 'news')); touch('interests') }} />
                <span>News</span>
              </label>
              <label className="inline-flex items-center gap-2 text-base" htmlFor="fg_interests-product">
                <input id="fg_interests-product" type="checkbox" className="h-4 w-4 rounded border-gray-300 accent-indigo-600" checked={form.interests.includes('product')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('interests', e.target.checked ? [...form.interests, 'product'] : form.interests.filter((v) => v !== 'product')); touch('interests') }} />
                <span>Product updates</span>
              </label>
            </div>
          </fieldset>
            {errors['interests'] && <p className="text-sm text-red-600" role="alert">{errors['interests']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_channels">Notification channels</label>
            <select id="fg_channels" multiple value={form.channels} className={errors['channels'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem] border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]"} onChange={(e: React.ChangeEvent<HTMLSelectElement>) => { setField('channels', Array.from(e.target.selectedOptions).map((o) => o.value)); touch('channels') }}>
              <option value="email">Email</option>
              <option value="sms">SMS</option>
              <option value="push">Push</option>
            </select>
            {errors['channels'] && <p className="text-sm text-red-600" role="alert">{errors['channels']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_topics">Topics</label>
            <div className="flex flex-wrap items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800">
              {form.topics.map((tag, index) => (
                <span key={tag} className="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">{tag} <button type="button" className="text-gray-500 hover:text-red-600" aria-label={'Remove ' + (tag)} onClick={() => fgRemoveTag('topics', form.topics, index)}>×</button></span>
              ))}
              <input id="fg_topics" type="text" className="min-w-24 flex-1 border-none bg-transparent py-0 text-base focus:outline-none" value={tagDrafts['topics'] ?? ''} placeholder="Type and press Enter" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setTagDrafts((d) => ({ ...d, 'topics': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddTag('topics', form.topics) } }} onBlur={() => { fgAddTag('topics', form.topics); touch('topics') }} />
            </div>
            <p className="text-sm text-gray-500 dark:text-gray-400">Free-text tags</p>
            {errors['topics'] && <p className="text-sm text-red-600" role="alert">{errors['topics']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Billing</legend>
            <div className="flex flex-wrap">
              <label className="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" htmlFor="fg_billing-monthly">
                <input id="fg_billing-monthly" type="radio" className="sr-only" checked={form.billing === 'monthly'} onChange={() => { setField('billing', 'monthly'); touch('billing') }} />
                <span>Monthly</span>
              </label>
              <label className="relative -ms-px cursor-pointer border border-gray-300 px-4 py-2 text-sm font-semibold first:ms-0 first:rounded-s-md last:rounded-e-md has-[:checked]:z-10 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-600 has-[:checked]:text-white has-[:focus-visible]:z-20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 dark:border-gray-600" htmlFor="fg_billing-yearly">
                <input id="fg_billing-yearly" type="radio" className="sr-only" checked={form.billing === 'yearly'} onChange={() => { setField('billing', 'yearly'); touch('billing') }} />
                <span>Yearly</span>
              </label>
            </div>
          </fieldset>
            {errors['billing'] && <p className="text-sm text-red-600" role="alert">{errors['billing']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Extras</legend>
            <div className="flex flex-col gap-2">
              <label className="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-base has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" htmlFor="fg_extras-support">
                <input id="fg_extras-support" type="checkbox" className="h-4 w-4 accent-indigo-600" checked={form.extras.includes('support')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'support'] : form.extras.filter((v) => v !== 'support')); touch('extras') }} />
                <span>Priority support</span>
              </label>
              <label className="flex cursor-pointer items-center gap-3 rounded-md border border-gray-300 px-3 py-2 text-base has-[:checked]:border-indigo-600 has-[:checked]:ring-1 has-[:checked]:ring-indigo-600 dark:border-gray-600" htmlFor="fg_extras-backup">
                <input id="fg_extras-backup" type="checkbox" className="h-4 w-4 accent-indigo-600" checked={form.extras.includes('backup')} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('extras', e.target.checked ? [...form.extras, 'backup'] : form.extras.filter((v) => v !== 'backup')); touch('extras') }} />
                <span>Daily backups</span>
              </label>
            </div>
          </fieldset>
            {errors['extras'] && <p className="text-sm text-red-600" role="alert">{errors['extras']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div className="flex items-center gap-2">
              <input id="fg_notify" type="checkbox" role="switch" checked={form.notify} className="relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-gray-300 transition-colors before:absolute before:start-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-white before:shadow before:transition-all before:content-[''] checked:bg-indigo-600 checked:before:start-[1.125rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300 dark:bg-gray-600" onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('notify', e.target.checked); touch('notify') }} />
              <label className="text-base" htmlFor="fg_notify">Email notifications</label>
            </div>
            {errors['notify'] && <p className="text-sm text-red-600" role="alert">{errors['notify']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_appointment">Appointment</label>
            <input id="fg_appointment" type="datetime-local" value={form.appointment} className={errors['appointment'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('appointment', e.target.value)} onBlur={() => touch('appointment')} />
            {errors['appointment'] && <p className="text-sm text-red-600" role="alert">{errors['appointment']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_brand_color">Brand color</label>
            <input id="fg_brand_color" type="color" value={form.brand_color} className={errors['brand_color'] ? "h-[2.375rem] w-12 cursor-pointer rounded-md border border-gray-300 bg-white p-1.5 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 border-red-500 focus:ring-red-200" : "h-[2.375rem] w-12 cursor-pointer rounded-md border border-gray-300 bg-white p-1.5 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('brand_color', e.target.value)} onBlur={() => touch('brand_color')} />
            {errors['brand_color'] && <p className="text-sm text-red-600" role="alert">{errors['brand_color']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_volume">Volume</label>
            <input id="fg_volume" type="range" value={form.volume} className="h-6 w-full accent-indigo-600" min="0" max="10" step="1" aria-orientation="vertical" style={{ writingMode: 'vertical-lr', direction: 'rtl', alignSelf: 'flex-start', width: 'auto', height: '10rem' }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => { setField('volume', Number(e.target.value)); touch('volume') }} />
            <p className="text-sm text-gray-500 dark:text-gray-400">{form.volume}</p>
            {errors['volume'] && <p className="text-sm text-red-600" role="alert">{errors['volume']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_budget">Budget</label>
            <div className="fg-dual">
              <div className="fg-dual-track"><div className="fg-dual-fill" style={fgDualFill(form.budget, 0, 1000)}></div></div>
              <input id="fg_budget" type="range" min="0" max="1000" step="50" value={form.budget.from} aria-label="Budget: Minimum" style={{ zIndex: fgDualFromOnTop(form.budget, 0, 1000) ? 3 : 1 }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgDualChange('budget', form.budget, 'from', Number(e.target.value))} />
              <input id="fg_budget-to" type="range" min="0" max="1000" step="50" value={form.budget.to} aria-label="Budget: Maximum" style={{ zIndex: 2 }} onChange={(e: React.ChangeEvent<HTMLInputElement>) => fgDualChange('budget', form.budget, 'to', Number(e.target.value))} />
            </div>
            <p className="text-sm text-gray-500 dark:text-gray-400">{form.budget.from} – {form.budget.to}</p>
            {errors['budget'] && <p className="text-sm text-red-600" role="alert">{errors['budget']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_stay">Stay<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <div className="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
              <input id="fg_stay" type="date" value={form.stay.from} className={errors['stay'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} aria-label="Stay: Start date" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('stay', { ...form.stay, from: e.target.value })} onBlur={() => touch('stay')} />
              <span aria-hidden="true">–</span>
              <input id="fg_stay-to" type="date" value={form.stay.to} className={errors['stay'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} min={form.stay.from || undefined} aria-label="Stay: End date" onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField('stay', { ...form.stay, to: e.target.value })} onBlur={() => touch('stay')} />
            </div>
            {errors['stay'] && <p className="text-sm text-red-600" role="alert">{errors['stay']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label className="text-sm font-semibold" htmlFor="fg_days">Available days</label>
            <div className="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
              <input id="fg_days" type="date" value={dateDrafts['days'] ?? ''} className={errors['days'] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setDateDrafts((d) => ({ ...d, 'days': e.target.value }))} onKeyDown={(e: React.KeyboardEvent) => { if (e.key === 'Enter') { e.preventDefault(); fgAddDate('days', form.days) } }} />
              <button type="button" className="shrink-0 whitespace-nowrap rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" onClick={() => fgAddDate('days', form.days)}>Add date</button>
            </div>
            {form.days.length > 0 && (
              <div className="mt-2 flex flex-wrap gap-1.5">
                {form.days.map((date, index) => (
                  <span key={date} className="inline-flex items-center gap-1 rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-xs dark:border-gray-600 dark:bg-gray-700">{date} <button type="button" className="text-gray-500 hover:text-red-600" aria-label={'Remove ' + (date)} onClick={() => fgRemoveDate('days', form.days, index)}>×</button></span>
                ))}
              </div>
            )}
            {errors['days'] && <p className="text-sm text-red-600" role="alert">{errors['days']}</p>}
          </div>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">How did we do?<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></legend>
            <div className="overflow-x-auto">
              <table className="w-full border-collapse text-sm">
                <thead><tr><td></td><th scope="col" className="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Poor</th><th scope="col" className="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">OK</th><th scope="col" className="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Great</th></tr></thead>
                <tbody>
                <tr className="border-t border-gray-200 dark:border-gray-700"><th scope="row" className="px-2 py-2 text-start font-medium leading-5">Speed</th><td className="px-2 py-2 text-center leading-5"><input id="fg_rating" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="1" checked={form.rating["speed"] === "1"} aria-label="Speed: Poor" onChange={() => setField('rating', { ...form.rating, ["speed"]: "1" })} onBlur={() => touch('rating')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_rating-0-1" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="2" checked={form.rating["speed"] === "2"} aria-label="Speed: OK" onChange={() => setField('rating', { ...form.rating, ["speed"]: "2" })} onBlur={() => touch('rating')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_rating-0-2" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_speed" value="3" checked={form.rating["speed"] === "3"} aria-label="Speed: Great" onChange={() => setField('rating', { ...form.rating, ["speed"]: "3" })} onBlur={() => touch('rating')} /></td></tr>
                <tr className="border-t border-gray-200 dark:border-gray-700"><th scope="row" className="px-2 py-2 text-start font-medium leading-5">Quality</th><td className="px-2 py-2 text-center leading-5"><input id="fg_rating-1-0" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="1" checked={form.rating["quality"] === "1"} aria-label="Quality: Poor" onChange={() => setField('rating', { ...form.rating, ["quality"]: "1" })} onBlur={() => touch('rating')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_rating-1-1" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="2" checked={form.rating["quality"] === "2"} aria-label="Quality: OK" onChange={() => setField('rating', { ...form.rating, ["quality"]: "2" })} onBlur={() => touch('rating')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_rating-1-2" type="radio" className="h-4 w-4 align-middle accent-indigo-600" name="fg_rating_quality" value="3" checked={form.rating["quality"] === "3"} aria-label="Quality: Great" onChange={() => setField('rating', { ...form.rating, ["quality"]: "3" })} onBlur={() => touch('rating')} /></td></tr>
                </tbody>
              </table>
            </div>
            {errors['rating'] && <p className="text-sm text-red-600" role="alert">{errors['rating']}</p>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend className="text-sm font-semibold">Where do you use each feature?</legend>
            <div className="overflow-x-auto">
              <table className="w-full border-collapse text-sm">
                <thead><tr><td></td><th scope="col" className="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Web</th><th scope="col" className="px-2 py-2 text-center font-semibold leading-5 text-gray-500 dark:text-gray-400">Mobile</th></tr></thead>
                <tbody>
                <tr className="border-t border-gray-200 dark:border-gray-700"><th scope="row" className="px-2 py-2 text-start font-medium leading-5">Forms</th><td className="px-2 py-2 text-center leading-5"><input id="fg_usage" type="checkbox" className="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="web" checked={form.usage["forms"].includes("web")} aria-label="Forms: Web" onChange={() => setField('usage', { ...form.usage, ["forms"]: fgToggleCell(['web', 'mobile'], form.usage["forms"], 'web') })} onBlur={() => touch('usage')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_usage-0-1" type="checkbox" className="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_forms" value="mobile" checked={form.usage["forms"].includes("mobile")} aria-label="Forms: Mobile" onChange={() => setField('usage', { ...form.usage, ["forms"]: fgToggleCell(['web', 'mobile'], form.usage["forms"], 'mobile') })} onBlur={() => touch('usage')} /></td></tr>
                <tr className="border-t border-gray-200 dark:border-gray-700"><th scope="row" className="px-2 py-2 text-start font-medium leading-5">Reports</th><td className="px-2 py-2 text-center leading-5"><input id="fg_usage-1-0" type="checkbox" className="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="web" checked={form.usage["reports"].includes("web")} aria-label="Reports: Web" onChange={() => setField('usage', { ...form.usage, ["reports"]: fgToggleCell(['web', 'mobile'], form.usage["reports"], 'web') })} onBlur={() => touch('usage')} /></td><td className="px-2 py-2 text-center leading-5"><input id="fg_usage-1-1" type="checkbox" className="h-4 w-4 align-middle accent-indigo-600" name="fg_usage_reports" value="mobile" checked={form.usage["reports"].includes("mobile")} aria-label="Reports: Mobile" onChange={() => setField('usage', { ...form.usage, ["reports"]: fgToggleCell(['web', 'mobile'], form.usage["reports"], 'mobile') })} onBlur={() => touch('usage')} /></td></tr>
                </tbody>
              </table>
            </div>
            {errors['usage'] && <p className="text-sm text-red-600" role="alert">{errors['usage']}</p>}
          </fieldset>
        </div>
        <div className="col-span-12 md:col-span-12">
          <fieldset className="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/50" data-fg-repeater="references">
            <legend className="px-1 text-sm font-semibold text-gray-500 dark:text-gray-400">References</legend>
            <div className="flex flex-col gap-4">
              {form.references.map((item, i) => (
                <fieldset key={fgKeyAt('references', i)} className="min-w-0 rounded-md border border-gray-300 p-4 dark:border-gray-600 data-[fg-drag]:opacity-50 data-[fg-drop=before]:shadow-[0_-3px_0_0_#4f46e5] data-[fg-drop=after]:shadow-[0_3px_0_0_#4f46e5]" data-fg-item tabIndex={-1} data-fg-drag={fgDragMark('references', i)} data-fg-drop={fgDropMark('references', i)} onDragOver={(e) => fgDragOver(e, 'references', i)} onDrop={(e) => fgDropItem(e, 'references', i)}>
                  <legend className="px-1 text-sm font-semibold">{fgItemLabel('references', i)}</legend>
                  <div className="grid grid-cols-12 gap-4">
                    <div className="col-span-12 md:col-span-12">
                      <div className="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                        <label className="text-sm font-semibold" htmlFor={'fg_references_' + i + '_name'}>Name<span className="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
                        <input id={'fg_references_' + i + '_name'} type="text" value={item.name} className={errors[('references.' + i + '.name')] ? "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0 border-red-500 focus:ring-red-200" : "w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0"} onChange={(e: React.ChangeEvent<HTMLInputElement>) => setField(('references.' + i + '.name'), e.target.value)} onBlur={() => touch(('references.' + i + '.name'))} />
