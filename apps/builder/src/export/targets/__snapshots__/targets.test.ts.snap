                            </div>
                        }
                      </div>
                      <div class="fg-repeater-item-actions">
                          @if (Model.References.Count > 1)
                          {
                              <span class="fg-repeater-handle" data-fg-handle draggable="true" aria-hidden="true" title="Drag to reorder">⠿</span>
                          }
                          @if (i > 0)
                          {
                              <button type="button" class="fg-repeater-move" data-fg-move="up" aria-label='@FgMoveLabel("references", i, true)' @ref="fgMoveUpRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, -1)'>↑</button>
                          }
                          @if (i < Model.References.Count - 1)
                          {
                              <button type="button" class="fg-repeater-move" data-fg-move="down" aria-label='@FgMoveLabel("references", i, false)' @ref="fgMoveDownRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, 1)'>↓</button>
                          }
                          <button type="button" class="fg-repeater-remove" aria-label='@FgRemoveLabel("references", i)' @onclick='() => FgRemoveItem(Model.References, "references", i, 0, fgItemFields_references)'>Remove</button>
                      </div>
                  </fieldset>
              }
            </div>
            @if (Model.References.Count < 3)
            {
                <button type="button" class="fg-button fg-button--secondary fg-repeater-add" data-fg-add="references" @ref='fgAddRefs["references"]' @onclick='() => FgAddItem(Model.References, "references", 3)'>Add reference</button>
            }
          </fieldset>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_attachments">Attachments<span class="fg-required" aria-hidden="true">*</span></label>
            <div class="fg-file-drop" data-fg-dragging='@(fgDragging["Attachments"] ? "" : null)'>
              <span class="fg-file-drop-text">Choose files or drag them here</span>
              <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="fg-file-input" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' @ondragenter='() => fgDragging["Attachments"] = true' @ondragleave='() => fgDragging["Attachments"] = false' @ondrop='() => fgDragging["Attachments"] = false' />
            </div>
            @if (Model.Attachments.Count > 0)
            {
                <ul class="fg-file-list">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="fg-file-item">
                            <span class="fg-file-name">@file.Name</span>
                            <span class="fg-file-size">@FgFileSize(file.Size)</span>
                            <button type="button" class="fg-file-remove" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            @if (fgFileNotes["Attachments"] != "")
          {
              <p class="fg-description" data-fg-file-note>@fgFileNotes["Attachments"]</p>
          }
            <p class="fg-description">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="fg-error" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="fg-textarea" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="fg-error" />
              </div>
            </div>
        }
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <div class="fg-field">
            <div class="fg-label"><span id="fg_about-label">About you</span></div>
            <div class="fg-richtext" data-fg-rich>
              <div class="fg-richtext-toolbar" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" class="fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
                <button type="button" class="fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
                <button type="button" class="fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
                <button type="button" class="fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
                <button type="button" class="fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
              </div>
              <div id="fg_about" class="fg-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext='@FgRichKey("About", v => Model.About = v, Model.About)'></div>
            </div>
            <p class="fg-description">Bold, lists and links are kept.</p>
            <ValidationMessage For="@(() => Model.About)" class="fg-error" />
          </div>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Meeting point</legend>
            <div class="fg-location" data-fg-loc='@FgLocKey("Meet", v => Model.Meet = v, Model.Meet)' data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div class="fg-location-map" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div class="fg-location-row">
                <label class="fg-location-coord">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" class="fg-input" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat>
                </label>
                <label class="fg-location-coord">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" class="fg-input" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng>
                </label>
                <button type="button" class="fg-button fg-button--secondary" data-fg-loc-mine>Use my location</button>
                <button type="button" class="fg-button fg-button--secondary" data-fg-loc-clear>Clear</button>
              </div>
              <p class="fg-location-status" aria-live="polite" data-fg-loc-status></p>
            </div>
            <ValidationMessage For="@(() => Model.Meet)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <fieldset class="fg-field">
            <legend class="fg-label">Signature</legend>
            <div class="fg-signature" data-fg-sign>
              <canvas id="fg_signature" class="fg-signature-pad" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature='@FgSignKey(Model.Signature, "Signature")'></canvas>
              <div class="fg-signature-row">
                <input type="text" class="fg-input" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
                <button type="button" class="fg-button fg-button--secondary" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            <ValidationMessage For="@(() => Model.Signature)" class="fg-error" />
          </fieldset>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <figure class="fg-quote">
            <blockquote class="fg-quote-text">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="fg-quote-cite">FormsGen</figcaption>
          </figure>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <div class="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. {{ not.vue }} &#64;razor {jsx}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <a class="fg-link" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="fg-sr-only"> (opens in a new tab)</span></a>
        </div>
        <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
          <div class="fg-field">
            <label class="fg-label" for="fg_contact_method">Preferred contact method<span class="fg-required" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="fg-select">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="fg-error" />
          </div>
        </div>
        @if ((Equals(Model.ContactMethod, "phone")))
        {
            <div class="fg-cell" style="--fg-span: 12; --fg-span-sm: 12; --fg-span-lg: 12">
              <div class="fg-field">
                <label class="fg-label" for="fg_contact_phone">Phone number</label>
                <div class="fg-pair">
                  <select class="fg-select fg-phone-country" aria-label="Country code" value='@FgPhoneCountryOf("ContactPhone", Model.ContactPhone)' @onchange='e => { Model.ContactPhone = FgPhoneSetCountry("ContactPhone", Model.ContactPhone, e); FgChanged("ContactPhone"); }'>
                    <option value="AF">Afghanistan (+93)</option>
                    <option value="AX">Åland Islands (+358)</option>
                    <option value="AL">Albania (+355)</option>
                    <option value="DZ">Algeria (+213)</option>
