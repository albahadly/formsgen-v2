          <div class="d-flex flex-wrap align-items-center gap-2 fg-pair">
            <input id="fg_stay" v-model="form.stay.from" type="date" class="form-control" :class="{ 'is-invalid': !!errors['stay'] }" aria-label="Stay: Start date" @blur="touch('stay')" @change="revalidate('stay')">
            <span aria-hidden="true">–</span>
            <input id="fg_stay-to" v-model="form.stay.to" type="date" class="form-control" :class="{ 'is-invalid': !!errors['stay'] }" :min="form.stay.from || undefined" aria-label="Stay: End date" @blur="touch('stay')" @change="revalidate('stay')">
          </div>
          <p v-if="errors['stay']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['stay'] }}</p>
