                                    <option value="GY">Guyana (+592)</option>
                                    <option value="HT">Haiti (+509)</option>
                                    <option value="HN">Honduras (+504)</option>
                                    <option value="HK">Hong Kong SAR China (+852)</option>
                                    <option value="HU">Hungary (+36)</option>
