          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_twitter">Twitter handle</label>
                <input id="fg_twitter" type="text" class="form-control" data-fg-path="twitter" data-fg-kind="text">
                <p id="fg_twitter-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_social_tabs:1" role="tabpanel" hidden>
          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_github">GitHub username</label>
                <input id="fg_github" type="text" class="form-control" data-fg-path="github" data-fg-kind="text">
                <p id="fg_github-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div>
          <ol class="nav mb-3 gap-3 small text-secondary list-unstyled d-flex flex-wrap">
            <li class="d-inline-flex align-items-center gap-2 fw-semibold text-body" data-fg-sec-item="ks_wizard:0">1. Shipping</li>
            <li class="d-inline-flex align-items-center gap-2" data-fg-sec-item="ks_wizard:1">2. Review</li>
          </ol>
          <div data-fg-sec-panel="ks_wizard:0">
          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_shipping_city">Shipping city<span class="text-danger fg-required" aria-hidden="true">*</span></label>
                <input id="fg_shipping_city" type="text" class="form-control" data-fg-path="shipping_city" data-fg-kind="text">
                <p id="fg_shipping_city-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div data-fg-sec-panel="ks_wizard:1" hidden>
          <div class="row g-3">
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_order_notes">Order notes</label>
                <textarea id="fg_order_notes" class="form-control" rows="3" data-fg-path="order_notes" data-fg-kind="text"></textarea>
                <p id="fg_order_notes-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
              </div>
            </div>
          </div>
          </div>
          <div class="mt-3 d-flex justify-content-between gap-2">
            <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-step-back="ks_wizard" hidden>Back</button>
            <button type="button" class="btn btn-primary fw-semibold px-3" data-fg-step-next="ks_wizard">Next</button>
            <button type="submit" class="btn btn-primary fw-semibold px-3" data-fg-submit hidden>Submit</button>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="form-check mb-0">
            <input id="fg_newsletter" type="checkbox" class="form-check-input" data-fg-path="newsletter" data-fg-kind="checkbox" checked>
            <label class="form-check-label" for="fg_newsletter">Subscribe to the newsletter</label>
          </div>
          <p id="fg_newsletter-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <div class="d-flex flex-column fg-field">
          <div class="form-check mb-0">
            <input id="fg_terms" type="checkbox" class="form-check-input" data-fg-path="terms" data-fg-kind="checkbox">
            <label class="form-check-label" for="fg_terms">I accept the terms<span class="text-danger fg-required" aria-hidden="true">*</span></label><span class="fg-tip"><button type="button" class="fg-tip-button" aria-label="More information" aria-describedby="fg_terms-tip">?</button><span role="tooltip" id="fg_terms-tip" class="fg-tip-text">We never sell your data</span></span>
          </div>
          <p id="fg_terms-err" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="col-12 col-md-12">
        <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-reset>Start over</button>
      </div>
    </div>
    <div class="mt-3 d-flex flex-column gap-1">
      <div data-fg-captcha></div>
      <p class="invalid-feedback d-block mt-0 mb-0 fg-error" data-fg-captcha-failed hidden>The check didn't load. Reload the page to try again.</p>
      <p id="fg_captcha_hint" class="small text-body-secondary mb-0" data-fg-captcha-hint>The form can be sent once the check above has passed.</p>
    </div>
    <div id="fg-live" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
    <pre id="fg-result" class="mt-3 p-3 bg-dark text-success rounded small overflow-auto" hidden></pre>
  </form>
  <script>
  (function () {
    'use strict'
    function fgIsEmpty(v) {
      if (v === null || v === undefined) return true
      if (typeof v === 'string') return v.trim() === ''
      if (Array.isArray(v)) return v.length === 0
      // Composite values ({ from, to }) are empty while any part is.
      if (typeof v === 'object' && Object.getPrototypeOf(v) === Object.prototype) {
        return Object.keys(v).some((k) => fgIsEmpty(v[k]))
      }
      return false
    }
    // Empty, or an unchecked checkbox/toggle (takes any type, so typed targets
    // never compare a string field with false).
    function fgIsBlank(v) {
      return fgIsEmpty(v) || v === false
    }
    function fgSize(v) {
      if (typeof v === 'number') return Number.isFinite(v) ? v : null
      if (typeof v === 'string') return v.length
      if (Array.isArray(v)) return v.length
      return null
    }
    // A date range whose end comes before its start.
    function fgDateOrder(v) {
      var r = v || {}
      return typeof r.from === 'string' && typeof r.to === 'string' && r.from !== '' && r.to !== '' && r.to < r.from
    }
    // The "contains" condition: a substring of text, or an item of a list.
    function fgContains(v, x) {
      if (typeof v === 'string') return v.includes(String(x))
      return Array.isArray(v) && v.includes(x)
    }
    function fgAccepts(file, accept) {
      if (accept.trim() === '') return true
      const name = file.name.toLowerCase()
      const type = (file.type || '').toLowerCase()
      return accept.split(',').map((token) => token.trim().toLowerCase()).filter(Boolean).some((token) =>
        token.startsWith('.') ? name.endsWith(token) : token.endsWith('/*') ? type.startsWith(token.slice(0, -1)) : type === token,
      )
    }
    function fgFileProblem(v, accept, maxMb, maxFiles, m) {
      const files = Array.isArray(v) ? v.filter((f) => f instanceof File) : []
      if (maxFiles > 0 && files.length > maxFiles) return m.tooMany
      for (const file of files) {
        if (!fgAccepts(file, accept)) return m.type.split('{name}').join(file.name)
        if (maxMb > 0 && file.size > maxMb * 1024 * 1024) return m.size.split('{name}').join(file.name)
      }
      return null
    }
    function fgFileJson(_key, value) {
      return value instanceof File ? { name: value.name, size: value.size, type: value.type } : value
    }
    function fgMultipart(payload) {
      const files = []
      const walk = (value, path) => {
        if (value instanceof File) {
          files.push({ path, file: value })
          return fgFileJson('', value)
        }
        if (Array.isArray(value)) {
          const fileList = value.length > 0 && value.every((v) => v instanceof File)
          return value.map((v, i) => walk(v, fileList ? path : path + '.' + i))
        }
        if (value && typeof value === 'object') {
          const out = {}
          for (const [key, v] of Object.entries(value)) out[key] = walk(v, path ? path + '.' + key : key)
          return out
        }
        return value
      }
      const data = walk(payload, '')
      const body = new FormData()
      body.append('data', JSON.stringify(data))
      for (const part of files) body.append(part.path, part.file, part.file.name)
      return body
    }
    // Sends with XMLHttpRequest, which (unlike fetch) reports upload progress.
    function fgSend(url, method, body, onProgress, onDone) {
      const request = new XMLHttpRequest()
      request.open(method, url)
      request.upload.onprogress = (event) => {
        if (event.lengthComputable && event.total > 0) onProgress(Math.round((event.loaded / event.total) * 100))
      }
      request.onload = () => onDone(request.status >= 200 && request.status < 300)
      request.onerror = request.onabort = () => onDone(false)
      request.send(body)
    }

    var fgTags = {}
    /** Each element under root (root included) matching selector. */
    function fgEach(root, selector, fn) {
      if (root.matches && root.matches(selector)) fn(root)
      Array.prototype.forEach.call(root.querySelectorAll(selector), fn)
    }
    function fgControl(path) {
      return document.querySelector('[data-fg-path="' + path + '"]')
    }
    function fgGet(path) {
      var el = fgControl(path)
      if (!el) return undefined
      var kind = el.getAttribute('data-fg-kind')
      if (kind === 'checkbox') return el.checked
      if (kind === 'select') return el.value === '' ? null : el.value
      if (kind === 'number') return el.value === '' ? null : Number(el.value)
      if (kind === 'calculated') {
        var stored = el.getAttribute('data-fg-value')
        return stored === null || stored === '' ? null : Number(stored)
      }
      if (kind === 'radio') {
        var checked = document.querySelector('[data-fg-path="' + path + '"]:checked')
        return checked ? checked.value : null
      }
      if (kind === 'multiselect') {
        return Array.prototype.map.call(el.selectedOptions, function (option) { return option.value })
      }
      if (kind === 'range2' || kind === 'daterange') {
        var parts = {}
        Array.prototype.forEach.call(document.querySelectorAll('[data-fg-path="' + path + '"][data-fg-part]'), function (input) {
          parts[input.getAttribute('data-fg-part')] = kind === 'range2' ? Number(input.value) : input.value
        })
        return { from: parts.from, to: parts.to }
      }
      if (kind === 'dates') return (fgDates[path] || []).slice()
      if (kind === 'matrix') {
        var answers = {}
        // Radios: the chosen column per row; checkboxes: the chosen columns.
        Array.prototype.forEach.call(document.querySelectorAll('[data-fg-path="' + path + '"]'), function (cell) {
          var row = cell.getAttribute('data-fg-row')
          var several = cell.type === 'checkbox'
          if (!(row in answers)) answers[row] = several ? [] : null
          if (cell.checked) {
            if (several) answers[row].push(cell.value)
            else answers[row] = cell.value
          }
        })
        return answers
      }
      if (kind === 'phone') {
        var country = document.querySelector('[data-fg-phone-country="' + path + '"]')
        var dial = country && country.selectedOptions[0] ? country.selectedOptions[0].getAttribute('data-dial') : ''
        return el.value.trim() === '' ? '' : '+' + dial + ' ' + el.value
      }
      if (kind === 'tags') return (fgTags[path] || []).slice()
      if (kind === 'richtext') return fgRichClean(el.innerHTML)
      if (kind === 'location') return fgLocTyped(el.closest('[data-fg-loc]'))
      if (kind === 'files' || kind === 'signature') return (fgFiles[path] || []).slice()
      if (kind === 'checks') {
        return Array.prototype.map.call(
          document.querySelectorAll('[data-fg-path="' + path + '"]:checked'),
          function (box) { return box.value },
        )
      }
      return el.value
    }

    function fgVisible_attachments_note() {
      return ((!fgIsBlank(fgGet("attachments"))))
    }
    function fgVisible_contact_phone() {
      return ((fgGet("contact_method") === "phone"))
    }
    function fgVisible_contact_other() {
      return ((fgGet("contact_method") === "other"))
    }

    var FG_CONDITIONS = [
      { index: 0, test: function () { return (!fgIsBlank(fgGet("attachments"))) } },
      { index: 1, test: function () { return (fgGet("contact_method") === "phone") } },
      { index: 2, test: function () { return (fgGet("contact_method") === "other") } },
    ]

    var FG_VALIDATORS = {
      'full_name': function () {
      const v = fgGet("full_name")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 2)) return "Must be at least 2"
      return null
      },
      'email': function () {
      const v = fgGet("email")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)))) return "Must be a valid email address"
      return null
      },
      'website': function () {
      const v = fgGet("website")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !(() => { try { new URL(v); return true } catch { return false } })()))) return "Must be a valid URL"
      return null
      },
      'seats': function () {
      const v = fgGet("seats")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? -Infinity) < 1)) return "Must be at least 1"
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 50)) return "Must be at most 50"
      return null
      },
      'zip': function () {
      const v = fgGet("zip")
      if (!fgIsEmpty(v) && ((typeof v !== 'string' || !new RegExp("^[0-9]{4,6}$").test(v)))) return "Invalid format"
      return null
      },
      'account.username': function () {
      const v = fgGet("account.username")
      if (fgIsBlank(v)) return "This field is required"
      if (!fgIsEmpty(v) && (((fgSize(v) ?? -Infinity) < 3 || (fgSize(v) ?? Infinity) > 20))) return "Must be between 3 and 20"
      return null
      },
      'account.bio': function () {
      const v = fgGet("account.bio")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 200)) return "Must be at most 200"
      return null
      },
      'account.avatar': function () {
      const v = fgGet("account.avatar")
      { const problem = fgFileProblem(v, "image/*", 2, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 2 MB"}); if (problem) return problem }
      return null
      },
      'plan': function () {
      const v = fgGet("plan")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'topics': function () {
      const v = fgGet("topics")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 5)) return "At most 5 topics"
      return null
      },
      'stay': function () {
      const v = fgGet("stay")
      if (fgIsBlank(v)) return "This field is required"
      { const problem = (fgDateOrder(v) ? "The end date can’t be before the start date" : null); if (problem) return problem }
      return null
      },
      'days': function () {
      const v = fgGet("days")
      if (!fgIsEmpty(v) && ((fgSize(v) ?? Infinity) > 3)) return "Must be at most 3"
      return null
      },
      'rating': function () {
      const v = fgGet("rating")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'attachments': function () {
      const v = fgGet("attachments")
      if (fgIsBlank(v)) return "This field is required"
      { const problem = fgFileProblem(v, ".pdf,.doc,.docx", 5, 3, {"tooMany":"Choose at most 3 files","type":"{name} is not an accepted file type","size":"{name} is larger than 5 MB"}); if (problem) return problem }
      return null
      },
      'signature': function () {
      const v = fgGet("signature")
      { const problem = fgFileProblem(v, "", 0, 1, {"tooMany":"Choose one file at most","type":"{name} is not an accepted file type","size":"{name} is larger than 0 MB"}); if (problem) return problem }
      return null
      },
      'contact_method': function () {
      const v = fgGet("contact_method")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'shipping_city': function () {
      const v = fgGet("shipping_city")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
      'terms': function () {
      const v = fgGet("terms")
      if (fgIsBlank(v)) return "This field is required"
      return null
      },
    }

    var touched = {}

    function fgKey(path) { return path.replace(/\\./g, '_') }

    function setError(path, message) {
      var el = document.getElementById('fg_' + fgKey(path) + '-err')
      var control = fgControl(path)
      var invalid = "is-invalid".split(' ').filter(Boolean)
      if (el) {
        el.textContent = message || ''
        el.hidden = !message
      }
      Array.prototype.forEach.call(control ? document.querySelectorAll('[data-fg-path="' + path + '"]') : [], function (box) {
        invalid.forEach(function (cls) { box.classList.toggle(cls, Boolean(message)) })
        if (message) box.setAttribute('aria-invalid', 'true')
        else box.removeAttribute('aria-invalid')
      })
    }

    function validateField(path) {
      var validate = fgValidatorFor(path)
      if (!validate) return true
      var message = validate()
      setError(path, message)
      return !message
    }

    function fgHasError(path) {
      var validate = fgValidatorFor(path)
      return validate ? Boolean(validate()) : false
    }

    // Calculated fields: an answer as a number (empty 0, yes/no 1/0, a list its size).
    function fgNum(v) {
      if (v === null || v === undefined || v === '') return 0
      if (typeof v === 'boolean') return v ? 1 : 0
      if (typeof v === 'number') return v
      if (typeof v === 'string') {
        const text = v.trim()
        return text === '' ? 0 : /^[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?$/.test(text) ? Number(text) : NaN
      }
      if (Array.isArray(v)) return v.length
      return NaN
    }
    // Days since 1970-01-01 for a valid ISO date, NaN otherwise.
    function fgDay(v) {
      const m = typeof v === 'string' ? /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(v) : null
      if (!m) return NaN
      const ms = Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))
      return new Date(ms).getUTCDate() === Number(m[3]) ? ms / 86400000 : NaN
    }
    function fgDaysRange(v) {
      const r = (v && typeof v === 'object' ? v : {})
      return fgDay(r.to) - fgDay(r.from)
    }
    function fgRound(v, d) {
      const f = 10 ** d
      return Math.floor(v * f + 0.5) / f
    }
    // The stored value: rounded, or null when not a finite number.
    function fgCalcValue(v, d) {
      return Number.isFinite(v) ? fgRound(v, d) : null
    }
    // The value as shown: fixed decimals, or empty.
    function fgFmt(v, d) {
      return typeof v === 'number' && Number.isFinite(v) ? v.toFixed(d) : ''
    }
    // Writes a calculated value into its read-only box (data-fg-value holds the number).
    function fgSetCalc(path, decimals, raw) {
      var el = fgControl(path)
      if (!el) return
      var value = fgCalcValue(raw, decimals)
      var text = value === null ? '' : String(value)
      if (el.getAttribute('data-fg-value') === text) return
      el.setAttribute('data-fg-value', text)
      el.value = fgFmt(value, decimals)
      // After a submit attempt its error follows the new value.
      if (touched[path]) validateField(path)
    }
    // Calculated fields, in order (a field after those it reads).
    function fgCalcAll() {
      fgSetCalc('seat_cost', 2, ((fgNum(fgGet('seats')) * 25) * ((fgNum(fgGet('seats')) >= 10 ? 1 : 0) !== 0 ? 0.8 : 1)))
    }
    // Answers inside text: a value as text ('' when empty).
    function fgAnswer(v, sep) {
      if (v === null || v === undefined || v === '') return ''
      if (Array.isArray(v)) return v.map((x) => (x && typeof x === 'object' && 'name' in x ? String(x.name) : String(x))).join(sep)
      if (typeof v === 'object') {
        const r = v
        // A location: "lat, lng".
        if (typeof r.lat === 'number' && typeof r.lng === 'number') return r.lat + ', ' + r.lng
        const from = r.from === null || r.from === undefined ? '' : String(r.from)
        const to = r.to === null || r.to === undefined ? '' : String(r.to)
        return from !== '' && to !== '' ? from + ' – ' + to : ''
      }
      return String(v)
    }
    function fgPick(v, labels, sep) {
      if (v === null || v === undefined || v === '') return ''
      return (Array.isArray(v) ? v : [v]).map((x) => labels[String(x)] ?? String(x)).join(sep)
    }
    function fgYesNo(v, yes, no) {
      return v === true ? yes : v === false ? no : ''
    }
    function fgOr(text, fallback) {
      return text === '' ? fallback : text
    }
    // Answer formatting by template path ("people.pname").
    var FG_ANSWER_FORMAT = {
      "full_name": function (v) { return fgAnswer(v, ", ") },
      "email": function (v) { return fgAnswer(v, ", ") },
      "website": function (v) { return fgAnswer(v, ", ") },
      "seats": function (v) { return fgAnswer(v, ", ") },
      "seat_cost": function (v) { return fgFmt(v, 2) },
      "satisfaction": function (v) { return fgAnswer(v, ", ") },
      "city": function (v) { return fgAnswer(v, ", ") },
      "zip": function (v) { return fgAnswer(v, ", ") },
      "account.username": function (v) { return fgAnswer(v, ", ") },
      "account.password": function (v) { return fgAnswer(v, ", ") },
      "account.bio": function (v) { return fgAnswer(v, ", ") },
      "account.birthday": function (v) { return fgAnswer(v, ", ") },
      "account.avatar": function (v) { return fgAnswer(v, ", ") },
      "plan": function (v) { return fgPick(v, {"free":"Free","pro":"Pro"}, ", ") },
      "interests": function (v) { return fgPick(v, {"news":"News","product":"Product updates"}, ", ") },
      "channels": function (v) { return fgPick(v, {"email":"Email","sms":"SMS","push":"Push"}, ", ") },
      "topics": function (v) { return fgAnswer(v, ", ") },
      "billing": function (v) { return fgPick(v, {"monthly":"Monthly","yearly":"Yearly"}, ", ") },
      "extras": function (v) { return fgPick(v, {"support":"Priority support","backup":"Daily backups"}, ", ") },
      "notify": function (v) { return fgYesNo(v, "Yes", "No") },
      "appointment": function (v) { return fgAnswer(v, ", ") },
      "brand_color": function (v) { return fgAnswer(v, ", ") },
      "volume": function (v) { return fgAnswer(v, ", ") },
      "budget": function (v) { return fgAnswer(v, ", ") },
      "stay": function (v) { return fgAnswer(v, ", ") },
      "days": function (v) { return fgAnswer(v, ", ") },
      "rating": function (v) { return '' },
      "usage": function (v) { return '' },
      "source": function (v) { return fgAnswer(v, ", ") },
      "references.name": function (v) { return fgAnswer(v, ", ") },
      "references.may_contact": function (v) { return fgYesNo(v, "Yes", "No") },
      "references.email": function (v) { return fgAnswer(v, ", ") },
      "references.phone": function (v) { return fgAnswer(v, ", ") },
