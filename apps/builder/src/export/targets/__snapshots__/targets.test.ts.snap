        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_attachments">Attachments<span class="text-danger fg-required" aria-hidden="true">*</span></label>
            <div class="fg-file-drop position-relative d-flex align-items-center justify-content-center border border-2 rounded p-4 text-center small text-body-secondary bg-body-tertiary" data-fg-dragging='@(fgDragging["Attachments"] ? "" : null)'>
              <span class="fw-medium">Choose files or drag them here</span>
              <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' @ondragenter='() => fgDragging["Attachments"] = true' @ondragleave='() => fgDragging["Attachments"] = false' @ondrop='() => fgDragging["Attachments"] = false' />
            </div>
            @if (Model.Attachments.Count > 0)
            {
                <ul class="list-group mt-2">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="list-group-item d-flex align-items-center gap-2">
                            <span class="flex-grow-1 text-truncate">@file.Name</span>
                            <span class="text-body-secondary small">@FgFileSize(file.Size)</span>
                            <button type="button" class="btn btn-sm btn-link link-danger p-0 text-decoration-none fs-5 lh-1" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            @if (fgFileNotes["Attachments"] != "")
          {
              <p class="form-text mt-0 mb-0 fg-description" data-fg-file-note>@fgFileNotes["Attachments"]</p>
          }
            <p class="form-text mt-0 mb-0 fg-description">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="col-12 col-md-12">
              <div class="d-flex flex-column fg-field">
                <label class="form-label fw-semibold small mb-0 fg-label" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="form-control" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
              </div>
            </div>
        }
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <div class="form-label fw-semibold small mb-0 fg-label"><span id="fg_about-label">About you</span></div>
            <div class="border rounded bg-body" data-fg-rich>
              <div class="d-flex flex-wrap gap-1 border-bottom p-1" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
                <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
                <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
                <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
                <button type="button" class="btn btn-sm btn-light fg-richtext-button" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
              </div>
              <div id="fg_about" class="fg-richtext-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext='@FgRichKey("About", v => Model.About = v, Model.About)'></div>
            </div>
            <p class="form-text mt-0 mb-0 fg-description">Bold, lists and links are kept.</p>
            <ValidationMessage For="@(() => Model.About)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Meeting point</legend>
            <div class="d-flex flex-column gap-2" data-fg-loc='@FgLocKey("Meet", v => Model.Meet = v, Model.Meet)' data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div class="fg-location-map w-100 border rounded" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div class="d-flex flex-wrap align-items-end gap-2">
                <label class="fg-location-coord d-flex flex-column gap-1 small">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" class="form-control" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat>
                </label>
                <label class="fg-location-coord d-flex flex-column gap-1 small">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" class="form-control" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng>
                </label>
                <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-mine>Use my location</button>
                <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-loc-clear>Clear</button>
              </div>
              <p class="fg-location-status small mb-0" aria-live="polite" data-fg-loc-status></p>
            </div>
            <ValidationMessage For="@(() => Model.Meet)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <fieldset class="d-flex flex-column fg-field">
            <legend class="form-label fw-semibold small mb-0 fg-label">Signature</legend>
            <div class="d-flex flex-column gap-2" data-fg-sign>
              <canvas id="fg_signature" class="fg-signature-pad d-block w-100 border rounded bg-white" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature='@FgSignKey(Model.Signature, "Signature")'></canvas>
              <div class="d-flex justify-content-end gap-2">
                <input type="text" class="form-control" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
                <button type="button" class="btn btn-outline-secondary fw-semibold px-3" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            <ValidationMessage For="@(() => Model.Signature)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </fieldset>
        </div>
        <div class="col-12 col-md-12">
          <figure class="mb-0 border-start border-4 ps-3">
            <blockquote class="blockquote fs-6 fst-italic mb-0">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="small text-body-secondary mt-1 mb-0">FormsGen</figcaption>
          </figure>
        </div>
        <div class="col-12 col-md-12">
          <div class="fg-html"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. {{ not.vue }} &#64;razor {jsx}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
        <div class="col-12 col-md-12">
          <a class="link-primary" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
        <div class="col-12 col-md-12">
          <div class="d-flex flex-column fg-field">
            <label class="form-label fw-semibold small mb-0 fg-label" for="fg_contact_method">Preferred contact method<span class="text-danger fg-required" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="form-select">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="invalid-feedback d-block mt-0 mb-0 fg-error" />
          </div>
        </div>
