          <select id="fg_contact_method" v-model="form.contact_method" class="fg-select" :class="{ 'fg-invalid': !!errors['contact_method'] }" @blur="touch('contact_method')" @change="revalidate('contact_method')">
            <option value="" disabled>—</option>
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="other">Other</option>
          </select>
          <p v-if="errors['contact_method']" class="fg-error" role="alert">{{ errors['contact_method'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12" v-if='(form.contact_method === "other")'>
        <div class="fg-field">
          <label class="fg-label" for="fg_contact_other">Describe your preferred method</label>
          <textarea id="fg_contact_other" v-model="form.contact_other" class="fg-textarea" rows="3" :class="{ 'fg-invalid': !!errors['contact_other'] }" @blur="touch('contact_other')" @input="revalidate('contact_other')"></textarea>
          <p v-if="errors['contact_other']" class="fg-error" role="alert">{{ errors['contact_other'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_newsletter" v-model="form.newsletter" type="checkbox" class="fg-checkbox" @change="touch('newsletter')">
            <label class="fg-checkbox-label" for="fg_newsletter">Subscribe to the newsletter</label>
          </div>
          <p v-if="errors['newsletter']" class="fg-error" role="alert">{{ errors['newsletter'] }}</p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <div class="fg-checkbox-row">
            <input id="fg_terms" v-model="form.terms" type="checkbox" class="fg-checkbox" @change="touch('terms')">
            <label class="fg-checkbox-label" for="fg_terms">I accept the terms<span class="fg-required" aria-hidden="true">*</span></label>
          </div>
          <p v-if="errors['terms']" class="fg-error" role="alert">{{ errors['terms'] }}</p>
        </div>
      </div>
    </div>
    <div class="fg-actions">
      <button class="fg-button fg-button--primary" type="submit">Submit</button>
    </div>
    <pre v-if="result" class="fg-payload">{{ JSON.stringify(result, null, 2) }}</pre>
  </form>
</template>

