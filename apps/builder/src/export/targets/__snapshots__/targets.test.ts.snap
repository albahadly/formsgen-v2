          <input id="fg_email" type="email" class="fg-input" data-fg-path="email" data-fg-kind="text" placeholder="jane@example.com">
          <p id="fg_err_email" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_website">Website</label>
          <input id="fg_website" type="url" class="fg-input" data-fg-path="website" data-fg-kind="text">
          <p id="fg_err_website" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_seats">Seats</label>
          <input id="fg_seats" type="number" class="fg-input" data-fg-path="seats" data-fg-kind="number" min="1" max="50">
          <p id="fg_err_seats" class="fg-error" role="alert" hidden></p>
        </div>
      </div>
      <div class="fg-cell" style="grid-column: span 12 / span 12">
        <div class="fg-field">
          <label class="fg-label" for="fg_satisfaction">Satisfaction</label>
          <input id="fg_satisfaction" type="range" class="fg-range" data-fg-path="satisfaction" data-fg-kind="number" min="0" max="10" step="1" value="5">
          <p id="fg_err_satisfaction" class="fg-error" role="alert" hidden></p>
