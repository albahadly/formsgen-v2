                                    <option value="YE">Yemen (+967)</option>
                                    <option value="ZM">Zambia (+260)</option>
                                    <option value="ZW">Zimbabwe (+263)</option>
                                  </select>
                                  <input id="@($"fg_references_{i}_phone")" type="tel" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" autocomplete="tel-national" value='@FgPhoneNumber(item.Phone, FgPhoneCountryOf(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone))' @onchange='e => { item.Phone = FgPhoneInput(FgItemKey(item, "ReferencesIPhone", "Phone"), item.Phone, e); FgChanged(FgItemKey(item, "ReferencesIPhone", "Phone")); }' />
                                </div>
                                <ValidationMessage For="@(() => item.Phone)" class="text-sm text-red-600" />
                              </div>
                            </div>
                        }
                      </div>
                      <div class="mt-2 flex items-center gap-2">
                          @if (Model.References.Count > 1)
                          {
                              <span class="cursor-grab select-none px-1 text-xl leading-none text-gray-500 dark:text-gray-400" data-fg-handle draggable="true" aria-hidden="true" title="Drag to reorder">⠿</span>
                          }
                          @if (i > 0)
                          {
                              <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600" data-fg-move="up" aria-label='@FgMoveLabel("references", i, true)' @ref="fgMoveUpRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, -1)'>↑</button>
                          }
                          @if (i < Model.References.Count - 1)
                          {
                              <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600" data-fg-move="down" aria-label='@FgMoveLabel("references", i, false)' @ref="fgMoveDownRefs[item]" @onclick='() => FgMoveItem(Model.References, "references", i, 1)'>↓</button>
                          }
                          <button type="button" class="ms-auto text-sm text-red-600 underline hover:text-red-700 dark:text-red-400" aria-label='@FgRemoveLabel("references", i)' @onclick='() => FgRemoveItem(Model.References, "references", i, 0, fgItemFields_references)'>Remove</button>
                      </div>
                  </fieldset>
              }
            </div>
            @if (Model.References.Count < 3)
            {
                <button type="button" class="mt-4 rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-add="references" @ref='fgAddRefs["references"]' @onclick='() => FgAddItem(Model.References, "references", 3)'>Add reference</button>
            }
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_attachments">Attachments<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <div class="relative flex min-h-[4.5rem] items-center justify-center rounded-md border-2 border-dashed border-gray-300 bg-gray-50 p-4 text-center text-sm text-gray-500 hover:border-indigo-500 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-indigo-300 data-[fg-dragging]:border-indigo-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-400" data-fg-dragging='@(fgDragging["Attachments"] ? "" : null)'>
              <span class="font-medium">Choose files or drag them here</span>
              <InputFile @key='fgFileKeys["Attachments"]' @ref='fgFileInputs["Attachments"]' id="fg_attachments" class="absolute inset-0 h-full w-full cursor-pointer opacity-0" accept=".pdf,.doc,.docx" multiple OnChange='@(e => FgPickFiles(Model.Attachments, e, true, 5242880L, false, "Attachments"))' @ondragenter='() => fgDragging["Attachments"] = true' @ondragleave='() => fgDragging["Attachments"] = false' @ondrop='() => fgDragging["Attachments"] = false' />
            </div>
            @if (Model.Attachments.Count > 0)
            {
                <ul class="flex flex-col gap-1.5">
                    @foreach (var file in Model.Attachments.ToList())
                    {
                        <li @key="file" class="flex items-center gap-2 rounded-md border border-gray-300 bg-gray-50 px-2 py-1.5 text-sm dark:border-gray-600 dark:bg-gray-800/50">
                            <span class="min-w-0 flex-1 truncate">@file.Name</span>
                            <span class="text-sm text-gray-500 dark:text-gray-400">@FgFileSize(file.Size)</span>
                            <button type="button" class="px-1.5 text-lg leading-none text-gray-500 hover:text-red-600" aria-label='@FgRemoveFileLabel(file.Name)' @onclick='() => FgRemoveFile(Model.Attachments, file, "Attachments")'>×</button>
                        </li>
                    }
                </ul>
            }
            @if (fgFileNotes["Attachments"] != "")
          {
              <p class="text-sm text-gray-500 dark:text-gray-400" data-fg-file-note>@fgFileNotes["Attachments"]</p>
          }
            <p class="text-sm text-gray-500 dark:text-gray-400">Up to 3 PDF or Word files, 5 MB each</p>
            <ValidationMessage For="@(() => Model.Attachments)" class="text-sm text-red-600" />
          </div>
        </div>
        @if ((!FgIsBlank(Model.Attachments)))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_attachments_note">Notes about the attachments</label>
                <InputTextArea id="fg_attachments_note" @bind-Value="Model.AttachmentsNote" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" rows="3" />
                <ValidationMessage For="@(() => Model.AttachmentsNote)" class="text-sm text-red-600" />
              </div>
            </div>
        }
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <div class="text-sm font-semibold"><span id="fg_about-label">About you</span></div>
            <div class="rounded-md border border-gray-300 bg-white shadow-sm focus-within:ring-2 focus-within:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" data-fg-rich>
              <div class="flex flex-wrap gap-1 border-b border-gray-200 p-1 dark:border-gray-700" role="toolbar" aria-label="Formatting" aria-controls="fg_about">
                <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bold" title="Bold" data-fg-rt-cmd="bold" tabindex="0"><b>B</b></button>
                <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Italic" title="Italic" data-fg-rt-cmd="italic" tabindex="-1"><i>I</i></button>
                <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Bulleted list" title="Bulleted list" data-fg-rt-cmd="insertUnorderedList" tabindex="-1">•</button>
                <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Numbered list" title="Numbered list" data-fg-rt-cmd="insertOrderedList" tabindex="-1"><span dir="ltr">1.</span></button>
                <button type="button" class="min-w-8 rounded-md border border-transparent px-2 py-1 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-300" aria-label="Link" title="Link" data-fg-rt-cmd="link" tabindex="-1">🔗</button>
              </div>
              <div id="fg_about" class="min-h-24 px-3 py-2 text-base outline-none [overflow-wrap:anywhere] [&_ol]:list-decimal [&_ol]:ps-6 [&_ul]:list-disc [&_ul]:ps-6 [&_a]:text-indigo-600 [&_a]:underline [&_p]:mb-2" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="fg_about-label" data-fg-richtext='@FgRichKey("About", v => Model.About = v, Model.About)'></div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">Bold, lists and links are kept.</p>
            <ValidationMessage For="@(() => Model.About)" class="text-sm text-red-600" />
          </div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Meeting point</legend>
            <div class="flex flex-col gap-2" data-fg-loc='@FgLocKey("Meet", v => Model.Meet = v, Model.Meet)' data-fg-loc-start="23.588,58.3829,11" data-fg-loc-tiles="https://tile.openstreetmap.org/{z}/{x}/{y}.png" data-fg-loc-attribution="© OpenStreetMap contributors">
              <div class="isolate z-0 w-full rounded-md border border-gray-300 dark:border-gray-600" style="height: 220px" role="group" aria-label="Meeting point: Map: click or tap to place the pin, drag the pin to move it" data-fg-loc-map></div>
              <div class="flex flex-wrap items-end gap-2">
                <label class="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                  <span>Latitude</span>
                  <input id="fg_meet" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-90" max="90" inputmode="decimal" data-fg-loc-lat>
                </label>
                <label class="flex flex-[1_1_8rem] flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
                  <span>Longitude</span>
                  <input id="fg_meet-lng" type="number" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" step="any" min="-180" max="180" inputmode="decimal" data-fg-loc-lng>
                </label>
                <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-mine>Use my location</button>
                <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-loc-clear>Clear</button>
              </div>
              <p class="m-0 text-sm text-gray-600 empty:hidden dark:text-gray-400" aria-live="polite" data-fg-loc-status></p>
            </div>
            <ValidationMessage For="@(() => Model.Meet)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <fieldset class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <legend class="text-sm font-semibold">Signature</legend>
            <div class="flex flex-col gap-2" data-fg-sign>
              <canvas id="fg_signature" class="block w-full touch-none cursor-crosshair rounded-md border border-dashed border-gray-300 bg-white dark:border-gray-600" style="height: 140px" role="img" aria-label="Signature pad: draw your signature here" data-fg-signature='@FgSignKey(Model.Signature, "Signature")'></canvas>
              <div class="flex justify-end gap-2 [&>input]:min-w-0 [&>input]:flex-1">
                <input type="text" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&::-webkit-datetime-edit-fields-wrapper]:p-0" placeholder="Or type your name" aria-label="Or type your name" data-fg-sign-type>
                <button type="button" class="rounded-md border border-gray-300 px-4 py-1.5 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-fg-sign-clear>Clear</button>
              </div>
            </div>
            <ValidationMessage For="@(() => Model.Signature)" class="text-sm text-red-600" />
          </fieldset>
        </div>
        <div class="col-span-12 md:col-span-12">
          <figure class="border-s-4 border-gray-300 ps-4 dark:border-gray-600">
            <blockquote class="text-base italic">
              <p>Forms are conversations.</p>
            </blockquote>
            <figcaption class="mt-1 text-sm text-gray-500 dark:text-gray-400">FormsGen</figcaption>
          </figure>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="fg-html text-base [&_a]:underline"><h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style="color: #b91c1c">Closed on holidays. {{ not.vue }} &#64;razor {jsx}</p><a>unsafe link</a><iframe src="https://www.openstreetmap.org/export/embed.html?bbox=58.3%2C23.5%2C58.5%2C23.7" width="320" height="180" title="Where we are" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></div>
        </div>
        <div class="col-span-12 md:col-span-12">
          <a class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400" href="https://example.com/docs" target="_blank" rel="noopener noreferrer">Read the docs<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <div class="col-span-12 md:col-span-12">
          <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
            <label class="text-sm font-semibold" for="fg_contact_method">Preferred contact method<span class="ms-0.5 text-red-600" aria-hidden="true">*</span></label>
            <InputSelect id="fg_contact_method" @bind-Value="Model.ContactMethod" class="w-full rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800 [&:not([multiple])]:h-[2.375rem]">
              <option value="" disabled>—</option>
              <option value="email">Email</option>
              <option value="phone">Phone</option>
              <option value="other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => Model.ContactMethod)" class="text-sm text-red-600" />
          </div>
        </div>
        @if ((Equals(Model.ContactMethod, "phone")))
        {
            <div class="col-span-12 md:col-span-12">
              <div class="flex flex-col gap-1.5 [&>legend]:mb-1.5">
                <label class="text-sm font-semibold" for="fg_contact_phone">Phone number</label>
                <div class="flex flex-wrap items-center gap-2 [&>input]:w-auto [&>input]:min-w-0 [&>input]:flex-[1_1_10rem]">
                  <select class="w-auto min-w-0 max-w-[45%] shrink rounded-md border border-gray-300 bg-white px-3 py-1.5 text-base shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" aria-label="Country code" value='@FgPhoneCountryOf("ContactPhone", Model.ContactPhone)' @onchange='e => { Model.ContactPhone = FgPhoneSetCountry("ContactPhone", Model.ContactPhone, e); FgChanged("ContactPhone"); }'>
                    <option value="AF">Afghanistan (+93)</option>
                    <option value="AX">Åland Islands (+358)</option>
                    <option value="AL">Albania (+355)</option>
                    <option value="DZ">Algeria (+213)</option>
                    <option value="AS">American Samoa (+1)</option>
                    <option value="AD">Andorra (+376)</option>
                    <option value="AO">Angola (+244)</option>
                    <option value="AI">Anguilla (+1)</option>
                    <option value="AG">Antigua &amp; Barbuda (+1)</option>
                    <option value="AR">Argentina (+54)</option>
                    <option value="AM">Armenia (+374)</option>
                    <option value="AW">Aruba (+297)</option>
                    <option value="AU">Australia (+61)</option>
                    <option value="AT">Austria (+43)</option>
                    <option value="AZ">Azerbaijan (+994)</option>
                    <option value="BS">Bahamas (+1)</option>
                    <option value="BH">Bahrain (+973)</option>
                    <option value="BD">Bangladesh (+880)</option>
                    <option value="BB">Barbados (+1)</option>
                    <option value="BY">Belarus (+375)</option>
                    <option value="BE">Belgium (+32)</option>
                    <option value="BZ">Belize (+501)</option>
                    <option value="BJ">Benin (+229)</option>
                    <option value="BM">Bermuda (+1)</option>
