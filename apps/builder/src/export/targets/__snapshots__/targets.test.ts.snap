          <input id="fg_brand_color" v-model="form.brand_color" type="color" class="h-[2.375rem] w-12 cursor-pointer rounded-md border border-gray-300 bg-white p-1.5 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-gray-600 dark:bg-gray-800" :class="{ 'border-red-500 focus:ring-red-200': !!errors['brand_color'] }" @blur="touch('brand_color')" @input="revalidate('brand_color')">
          <p v-if="errors['brand_color']" class="text-sm text-red-600" role="alert">{{ errors['brand_color'] }}</p>
        </div>
