          <input id="fg_brand_color" v-model="form.brand_color" type="color" class="form-control form-control-color" :class="{ 'is-invalid': !!errors['brand_color'] }" @blur="touch('brand_color')" @input="revalidate('brand_color')">
          <p v-if="errors['brand_color']" class="invalid-feedback d-block mt-0 mb-0 fg-error" role="alert">{{ errors['brand_color'] }}</p>
