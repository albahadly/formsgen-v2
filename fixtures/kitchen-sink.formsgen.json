{
  "$schema": "formsgen/v2",
  "meta": {
    "name": "kitchen_sink",
    "title": "Kitchen Sink",
    "description": "Grows with every phase: every implemented element, rule, condition and container pattern appears here at least once.",
    "locale": "en",
    "dir": "ltr"
  },
  "tree": [
    {
      "id": "ks-intro-heading",
      "style": { "align": "center", "tone": "primary" },
      "type": "heading",
      "props": { "text": "Kitchen Sink", "level": 2 }
    },
    {
      "id": "ks-intro-text",
      "style": { "align": "center" },
      "type": "paragraph",
      "props": { "text": "Every implemented element appears in this form." }
    },
    {
      "id": "ks-intro-rich",
      "type": "paragraph",
      "props": {
        "format": "markdown",
        "text": "Fields marked * are **required**. See the [docs](https://example.com/docs):\n- *one* answer per row in Rating\n- several in Usage"
      }
    },
    {
      "id": "ks-full-name",
      "type": "text",
      "name": "full_name",
      "props": { "label": "Full name", "placeholder": "Jane Doe" },
      "validation": [{ "rule": "required" }, { "rule": "min", "value": 2 }]
    },
    {
      "id": "ks-email",
      "type": "email",
      "name": "email",
      "props": { "label": "Email", "placeholder": "jane@example.com" },
      "validation": [{ "rule": "required" }, { "rule": "email" }]
    },
    {
      "id": "ks-website",
      "style": { "size": "sm" },
      "type": "url",
      "name": "website",
      "props": { "label": "Website" },
      "validation": [{ "rule": "url" }]
    },
    {
      "id": "ks-seats",
      "type": "number",
      "name": "seats",
      "props": { "label": "Seats", "min": 1, "max": 50, "suffix": "people", "tooltip": "Including yourself" },
      "validation": [{ "rule": "min", "value": 1 }, { "rule": "max", "value": 50 }]
    },
    {
      "id": "ks-seat-cost",
      "type": "calculated",
      "name": "seat_cost",
      "props": { "label": "Seat cost", "formula": "{seats} * 25 * if({seats} >= 10, 0.8, 1)", "decimals": 2, "prefix": "$" }
    },
    {
      "id": "ks-satisfaction",
      "type": "range",
      "name": "satisfaction",
      "props": { "label": "Satisfaction", "min": 0, "max": 10, "step": 1, "default": 5 }
    },
    {
      "id": "ks-divider-1",
      "style": { "tone": "primary" },
      "type": "divider",
      "props": {}
    },
    {
      "id": "ks-columns",
      "type": "columns",
      "props": { "count": 2 },
      "children": [
        {
          "id": "ks-city",
          "type": "text",
          "name": "city",
          "props": { "label": "City" },
          "layout": { "colSpan": 6, "colSpanSm": 6, "colSpanLg": 4 }
        },
        {
          "id": "ks-zip",
          "style": { "hideLabel": true },
          "type": "text",
          "name": "zip",
          "props": { "label": "ZIP" },
          "layout": { "colSpan": 6, "colSpanSm": 6, "colSpanLg": 6 },
          "validation": [{ "rule": "regex", "value": "^[0-9]{4,6}$" }]
        }
      ]
    },
    {
      "id": "ks-account",
      "style": { "className": "account-box" },
      "type": "group",
      "name": "account",
      "props": { "label": "Account" },
      "children": [
        {
          "id": "ks-username",
          "type": "text",
          "name": "username",
          "props": { "label": "Username", "prefix": "@" },
          "validation": [{ "rule": "required" }, { "rule": "between", "value": [3, 20] }]
        },
        {
          "id": "ks-password",
          "type": "password",
          "name": "password",
          "props": { "label": "Password" }
        },
        {
          "id": "ks-bio",
          "style": { "size": "lg" },
          "type": "textarea",
          "name": "bio",
          "props": { "label": "Bio", "rows": 4 },
          "validation": [{ "rule": "max", "value": 200 }]
        },
        {
          "id": "ks-birthday",
          "type": "date",
          "name": "birthday",
          "props": { "label": "Birthday" }
        },
        {
          "id": "ks-avatar",
          "type": "imageupload",
          "name": "avatar",
          "props": { "label": "Profile picture", "multiple": false, "accept": "image/*", "maxSizeMb": 2 }
        }
      ]
    },
    {
      "id": "ks-plan",
      "type": "radiogroup",
      "name": "plan",
      "props": {
        "label": "Plan",
        "tooltip": "You can switch plans at any time",
        "items": [
          { "value": "free", "label": "Free" },
          { "value": "pro", "label": "Pro" }
        ]
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-interests",
      "type": "checkboxgroup",
      "name": "interests",
      "props": {
        "label": "Interests",
        "items": [
          { "value": "news", "label": "News" },
          { "value": "product", "label": "Product updates" }
        ]
      }
    },
    {
      "id": "ks-channels",
      "type": "multiselect",
      "name": "channels",
      "props": {
        "label": "Notification channels",
        "items": [
          { "value": "email", "label": "Email" },
          { "value": "sms", "label": "SMS" },
          { "value": "push", "label": "Push" }
        ]
      }
    },
    {
      "id": "ks-topics",
      "type": "tags",
      "name": "topics",
      "props": {
        "label": "Topics",
        "placeholder": "Type and press Enter",
        "description": "Free-text tags"
      },
      "validation": [{ "rule": "max", "value": 5, "message": "At most 5 topics" }]
    },
    {
      "id": "ks-billing",
      "type": "radiogroup",
      "name": "billing",
      "props": {
        "label": "Billing",
        "display": "buttons",
        "items": [
          { "value": "monthly", "label": "Monthly" },
          { "value": "yearly", "label": "Yearly" }
        ]
      }
    },
    {
      "id": "ks-extras",
      "type": "checkboxgroup",
      "name": "extras",
      "props": {
        "label": "Extras",
        "display": "blocks",
        "items": [
          { "value": "support", "label": "Priority support" },
          { "value": "backup", "label": "Daily backups" }
        ]
      }
    },
    {
      "id": "ks-notify",
      "type": "toggle",
      "name": "notify",
      "props": { "label": "Email notifications", "default": true }
    },
    {
      "id": "ks-appointment",
      "type": "datetime",
      "name": "appointment",
      "props": { "label": "Appointment" }
    },
    {
      "id": "ks-brand-color",
      "type": "color",
      "name": "brand_color",
      "props": { "label": "Brand color" }
    },
    {
      "id": "ks-volume",
      "type": "range",
      "name": "volume",
      "props": { "label": "Volume", "min": 0, "max": 10, "step": 1, "orientation": "vertical" }
    },
    {
      "id": "ks-budget",
      "type": "rangeslider",
      "name": "budget",
      "props": { "label": "Budget", "min": 0, "max": 1000, "step": 50, "defaultFrom": 200, "defaultTo": 600 }
    },
    {
      "id": "ks-stay",
      "type": "daterange",
      "name": "stay",
      "props": { "label": "Stay" },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-days",
      "type": "dates",
      "name": "days",
      "props": { "label": "Available days" },
      "validation": [{ "rule": "max", "value": 3 }]
    },
    {
      "id": "ks-rating",
      "type": "matrix",
      "name": "rating",
      "props": {
        "label": "How did we do?",
        "rows": [{ "value": "speed", "label": "Speed" }, { "value": "quality", "label": "Quality" }],
        "columns": [{ "value": "1", "label": "Poor" }, { "value": "2", "label": "OK" }, { "value": "3", "label": "Great" }]
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-usage",
      "type": "matrix",
      "name": "usage",
      "props": {
        "label": "Where do you use each feature?",
        "multiple": true,
        "rows": [{ "value": "forms", "label": "Forms" }, { "value": "reports", "label": "Reports" }],
        "columns": [{ "value": "web", "label": "Web" }, { "value": "mobile", "label": "Mobile" }]
      }
    },
    {
      "id": "ks-source",
      "type": "hidden",
      "name": "source",
      "props": { "value": "kitchen-sink" }
    },
    {
      "id": "ks-references",
      "type": "repeater",
      "name": "references",
      "props": { "label": "References", "itemLabel": "Reference {n}", "addText": "Add reference", "minItems": 0, "maxItems": 3, "initialItems": 1, "sortable": true },
      "children": [
        { "id": "ks-ref-name", "type": "text", "name": "name", "props": { "label": "Name" }, "validation": [{ "rule": "required" }] },
        { "id": "ks-ref-contact", "type": "checkbox", "name": "may_contact", "props": { "label": "May we contact them?" } },
        {
          "id": "ks-ref-email",
          "type": "email",
          "name": "email",
          "props": { "label": "Their email" },
          "validation": [{ "rule": "email" }],
          "conditions": [[{ "field": "references.may_contact", "operator": "equals", "value": true }]]
        },
        {
          "id": "ks-ref-phone",
          "type": "phone",
          "name": "phone",
          "props": { "label": "Their phone", "countrySelect": true, "defaultCountry": "GB" },
          "conditions": [[{ "field": "references.may_contact", "operator": "equals", "value": true }]]
        }
      ]
    },
    {
      "id": "ks-attachments",
      "type": "file",
      "name": "attachments",
      "props": {
        "label": "Attachments",
        "description": "Up to 3 PDF or Word files, 5 MB each",
        "multiple": true,
        "accept": ".pdf,.doc,.docx",
        "maxSizeMb": 5,
        "maxFiles": 3
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-attachments-note",
      "type": "textarea",
      "name": "attachments_note",
      "props": { "label": "Notes about the attachments" },
      "conditions": [[{ "field": "attachments", "operator": "not-empty" }]]
    },
    {
      "id": "ks-quote",
      "type": "quote",
      "props": { "text": "Forms are conversations.", "cite": "FormsGen" }
    },
    {
      "id": "ks-html",
      "type": "html",
      "props": {
        "html": "<h3>Opening hours</h3><ul><li><b>Mon–Fri</b> 9–17</li><li>Sat <em>10–14</em></li></ul><p style=\"color: #b91c1c\">Closed on holidays. {{ not.vue }} @razor {jsx}</p><script>alert(1)</script><a href=\"javascript:alert(1)\" onclick=\"x()\">unsafe link</a>"
      }
    },
    {
      "id": "ks-docs-link",
      "type": "link",
      "props": { "text": "Read the docs", "href": "https://example.com/docs", "newTab": true }
    },
    {
      "id": "ks-contact-method",
      "type": "select",
      "name": "contact_method",
      "props": {
        "label": "Preferred contact method",
        "items": [
          { "value": "email", "label": "Email" },
          { "value": "phone", "label": "Phone" },
          { "value": "other", "label": "Other" }
        ]
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-contact-phone",
      "type": "phone",
      "name": "contact_phone",
      "props": { "label": "Phone number", "countrySelect": true, "defaultCountry": "OM" },
      "conditions": [
        [{ "field": "contact_method", "operator": "equals", "value": "phone" }]
      ]
    },
    {
      "id": "ks-contact-other",
      "type": "textarea",
      "name": "contact_other",
      "props": { "label": "Describe your preferred method" },
      "conditions": [
        [{ "field": "contact_method", "operator": "equals", "value": "other" }]
      ]
    },
    {
      "id": "ks-social-tabs",
      "type": "tabs",
      "props": {},
      "children": [
        {
          "id": "ks-tab-social",
          "type": "tab",
          "props": { "label": "Social" },
          "children": [
            {
              "id": "ks-twitter",
              "type": "text",
              "name": "twitter",
              "props": { "label": "Twitter handle" }
            }
          ]
        },
        {
          "id": "ks-tab-code",
          "type": "tab",
          "props": { "label": "Code" },
          "children": [
            {
              "id": "ks-github",
              "type": "text",
              "name": "github",
              "props": { "label": "GitHub username" }
            }
          ]
        }
      ]
    },
    {
      "id": "ks-wizard",
      "type": "steps",
      "props": {},
      "children": [
        {
          "id": "ks-step-shipping",
          "type": "step",
          "props": { "label": "Shipping" },
          "children": [
            {
              "id": "ks-shipping-city",
              "type": "text",
              "name": "shipping_city",
              "props": { "label": "Shipping city" },
              "validation": [{ "rule": "required" }]
            }
          ]
        },
        {
          "id": "ks-step-review",
          "type": "step",
          "props": { "label": "Review" },
          "children": [
            {
              "id": "ks-order-notes",
              "type": "textarea",
              "name": "order_notes",
              "props": { "label": "Order notes" }
            }
          ]
        }
      ]
    },
    {
      "id": "ks-newsletter",
      "type": "checkbox",
      "name": "newsletter",
      "props": { "label": "Subscribe to the newsletter", "default": true }
    },
    {
      "id": "ks-terms",
      "type": "checkbox",
      "name": "terms",
      "props": { "label": "I accept the terms", "tooltip": "We never sell your data" },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-reset",
      "type": "button",
      "props": { "text": "Start over", "action": "reset", "variant": "secondary" }
    }
  ]
}
