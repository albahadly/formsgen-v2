{
  "$schema": "formsgen/v2",
  "meta": {
    "name": "kitchen_sink",
    "title": "Kitchen Sink",
    "description": "Grows with every phase: every implemented element, rule, condition and container pattern appears here at least once.",
    "locale": "en",
    "dir": "ltr"
  },
  "tree": [
    {
      "id": "ks-intro-heading",
      "type": "heading",
      "props": { "text": "Kitchen Sink", "level": 2 }
    },
    {
      "id": "ks-intro-text",
      "type": "paragraph",
      "props": { "text": "Every implemented element appears in this form." }
    },
    {
      "id": "ks-full-name",
      "type": "text",
      "name": "full_name",
      "props": { "label": "Full name", "placeholder": "Jane Doe" },
      "validation": [{ "rule": "required" }, { "rule": "min", "value": 2 }]
    },
    {
      "id": "ks-email",
      "type": "email",
      "name": "email",
      "props": { "label": "Email", "placeholder": "jane@example.com" },
      "validation": [{ "rule": "required" }, { "rule": "email" }]
    },
    {
      "id": "ks-website",
      "type": "url",
      "name": "website",
      "props": { "label": "Website" },
      "validation": [{ "rule": "url" }]
    },
    {
      "id": "ks-seats",
      "type": "number",
      "name": "seats",
      "props": { "label": "Seats", "min": 1, "max": 50 },
      "validation": [{ "rule": "min", "value": 1 }, { "rule": "max", "value": 50 }]
    },
    {
      "id": "ks-satisfaction",
      "type": "range",
      "name": "satisfaction",
      "props": { "label": "Satisfaction", "min": 0, "max": 10, "step": 1, "default": 5 }
    },
    {
      "id": "ks-divider-1",
      "type": "divider",
      "props": {}
    },
    {
      "id": "ks-columns",
      "type": "columns",
      "props": { "count": 2 },
      "children": [
        {
          "id": "ks-city",
          "type": "text",
          "name": "city",
          "props": { "label": "City" },
          "layout": { "colSpan": 6 }
        },
        {
          "id": "ks-zip",
          "type": "text",
          "name": "zip",
          "props": { "label": "ZIP" },
          "layout": { "colSpan": 6 },
          "validation": [{ "rule": "regex", "value": "^[0-9]{4,6}$" }]
        }
      ]
    },
    {
      "id": "ks-account",
      "type": "group",
      "name": "account",
      "props": { "label": "Account" },
      "children": [
        {
          "id": "ks-username",
          "type": "text",
          "name": "username",
          "props": { "label": "Username" },
          "validation": [{ "rule": "required" }, { "rule": "between", "value": [3, 20] }]
        },
        {
          "id": "ks-password",
          "type": "password",
          "name": "password",
          "props": { "label": "Password" }
        },
        {
          "id": "ks-bio",
          "type": "textarea",
          "name": "bio",
          "props": { "label": "Bio", "rows": 4 },
          "validation": [{ "rule": "max", "value": 200 }]
        },
        {
          "id": "ks-birthday",
          "type": "date",
          "name": "birthday",
          "props": { "label": "Birthday" }
        }
      ]
    },
    {
      "id": "ks-plan",
      "type": "radiogroup",
      "name": "plan",
      "props": {
        "label": "Plan",
        "items": [
          { "value": "free", "label": "Free" },
          { "value": "pro", "label": "Pro" }
        ]
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-interests",
      "type": "checkboxgroup",
      "name": "interests",
      "props": {
        "label": "Interests",
        "items": [
          { "value": "news", "label": "News" },
          { "value": "product", "label": "Product updates" }
        ]
      }
    },
    {
      "id": "ks-channels",
      "type": "multiselect",
      "name": "channels",
      "props": {
        "label": "Notification channels",
        "items": [
          { "value": "email", "label": "Email" },
          { "value": "sms", "label": "SMS" },
          { "value": "push", "label": "Push" }
        ]
      }
    },
    {
      "id": "ks-topics",
      "type": "tags",
      "name": "topics",
      "props": {
        "label": "Topics",
        "placeholder": "Type and press Enter",
        "description": "Free-text tags"
      },
      "validation": [{ "rule": "max", "value": 5, "message": "At most 5 topics" }]
    },
    {
      "id": "ks-contact-method",
      "type": "select",
      "name": "contact_method",
      "props": {
        "label": "Preferred contact method",
        "items": [
          { "value": "email", "label": "Email" },
          { "value": "phone", "label": "Phone" },
          { "value": "other", "label": "Other" }
        ]
      },
      "validation": [{ "rule": "required" }]
    },
    {
      "id": "ks-contact-phone",
      "type": "phone",
      "name": "contact_phone",
      "props": { "label": "Phone number" },
      "conditions": [
        [{ "field": "contact_method", "operator": "equals", "value": "phone" }]
      ]
    },
    {
      "id": "ks-contact-other",
      "type": "textarea",
      "name": "contact_other",
      "props": { "label": "Describe your preferred method" },
      "conditions": [
        [{ "field": "contact_method", "operator": "equals", "value": "other" }]
      ]
    },
    {
      "id": "ks-social-tabs",
      "type": "tabs",
      "props": {},
      "children": [
        {
          "id": "ks-tab-social",
          "type": "tab",
          "props": { "label": "Social" },
          "children": [
            {
              "id": "ks-twitter",
              "type": "text",
              "name": "twitter",
              "props": { "label": "Twitter handle" }
            }
          ]
        },
        {
          "id": "ks-tab-code",
          "type": "tab",
          "props": { "label": "Code" },
          "children": [
            {
              "id": "ks-github",
              "type": "text",
              "name": "github",
              "props": { "label": "GitHub username" }
            }
          ]
        }
      ]
    },
    {
      "id": "ks-wizard",
      "type": "steps",
      "props": {},
      "children": [
        {
          "id": "ks-step-shipping",
          "type": "step",
          "props": { "label": "Shipping" },
          "children": [
            {
              "id": "ks-shipping-city",
              "type": "text",
              "name": "shipping_city",
              "props": { "label": "Shipping city" },
              "validation": [{ "rule": "required" }]
            }
          ]
        },
        {
          "id": "ks-step-review",
          "type": "step",
          "props": { "label": "Review" },
          "children": [
            {
              "id": "ks-order-notes",
              "type": "textarea",
              "name": "order_notes",
              "props": { "label": "Order notes" }
            }
          ]
        }
      ]
    },
    {
      "id": "ks-newsletter",
      "type": "checkbox",
      "name": "newsletter",
      "props": { "label": "Subscribe to the newsletter", "default": true }
    },
    {
      "id": "ks-terms",
      "type": "checkbox",
      "name": "terms",
      "props": { "label": "I accept the terms" },
      "validation": [{ "rule": "required" }]
    }
  ]
}
