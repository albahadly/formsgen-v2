{
  "name": "@albahadly/formsgen-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "FormsGen from the command line: export a form's code, validation rules or project package from its .formsgen.json",
  "license": "MIT",
  "author": "Salwan Albahadly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albahadly/formsgen-v2.git",
    "directory": "packages/cli"
  },
  "homepage": "https://builder.albahadly.com",
  "bugs": "https://github.com/albahadly/formsgen-v2/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "forms",
    "form-builder",
    "cli",
    "codegen",
    "react",
    "vue",
    "blazor",
    "formsgen"
  ],
  "bin": {
    "formsgen": "./dist/formsgen.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@albahadly/formsgen-renderer": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
