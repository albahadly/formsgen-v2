{
  "name": "@formsgen/renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone Vue 3 renderer for FormsGen JSON form schemas",
  "files": [
    "dist"
  ],
  "main": "./dist/formsgen-renderer.umd.cjs",
  "module": "./dist/formsgen-renderer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/formsgen-renderer.js",
      "require": "./dist/formsgen-renderer.umd.cjs"
    },
    "./style.css": "./dist/formsgen-renderer.css"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
