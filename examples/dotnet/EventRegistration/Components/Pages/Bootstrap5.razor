@page "/bootstrap5"
@using EventRegistration.Components.Forms.Bootstrap5

<PageTitle>Event registration (Bootstrap 5)</PageTitle>

@* The Bootstrap export needs Bootstrap's CSS on the page (the stock Blazor
   templates ship it under wwwroot/lib; this example links the CDN build). *@
<HeadContent>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</HeadContent>

<EventRegistrationForm @rendermode="InteractiveServer" />
